@page "/workout/change"
@inject WorkoutFlow Flow
@inject AppNavigation Navigation

<PageTitle>Change</PageTitle>

@if (state is not null && targetId is long id)
{
    var target = state.Exercises[id];
    // The superset it's in now, when it's in one: its other exercises start with it, so doing one of them first is no choice.
    var together = state.SupersetNow(id);
    var others = state.StillToDo().Where(other => other != id && together?.Contains(other) != true).Select(other => state.Exercises[other]).ToList();
    <div class="screen">
        <PageHeader Back="workout" BackText="@state.Name" Label="Today only" Title="@($"Change {target.Name}")" Small="true" Live="true" />

        @* In the superset that's next or running, Change opens on one of its exercises: this picks which of them to change. *@
        @if (together is not null)
        {
            <div class="segmented" role="group" aria-label="Which exercise to change">
                @foreach (var member in together)
                {
                    <button type="button" aria-pressed="@(member == id ? "true" : "false")" @onclick="() => targetId = member">@state.Exercises[member].Name</button>
                }
            </div>
        }
        <p class="note">@(state.Running.Count == 0 ? "The session itself stays as it is." : $"The running {(state.Running.Count > 1 ? "round" : "set")} starts over with whatever you pick. The session itself stays as it is.")</p>

        @* In the superset that's next or running: take it apart, so this one goes on alone, then the others. *@
        @if (together is not null && state.StepNow is { } step)
        {
            var rest = string.Join(" and ", together.Where(other => other != id).Select(other => state.Exercises[other].Name));
            var left = step.TargetSets - (step.SetNumber - 1);
            <div class="stack tight">
                <button type="button" class="btn tall" @onclick="SplitAsync">Split the superset</button>
                <p class="note">@(left is int rounds ? $"{target.Name} goes on alone for the {rounds} {(rounds == 1 ? "set" : "sets")} left, then {rest}." : $"{target.Name} goes on alone, then {rest}.")</p>
            </div>
        }

        @* With Superset, what I pick goes with this one instead: rounds of both, back to back. It needs this one in today's plan. *@
        @if (state.Plan.Any(e => e.ExerciseId == id))
        {
            <label class="goal">
                <input type="checkbox" @bind="superset" />
                <span class="row-text">
                    <span class="name">Superset</span>
                    <span class="note">Do the one you pick together with @target.Name, back to back in rounds, instead of in its place.</span>
                </span>
            </label>
        }

        @if (others.Count > 0)
        {
            <section class="stack" aria-labelledby="first-heading">
                <div class="row-text">
                    <h2 id="first-heading" class="label">@(superset ? "Superset with one still to do" : "Do another one first")</h2>
                    <p class="note">@(superset ? $"It leaves its own spot and goes with {target.Name} in each round left." : $"{target.Name} waits until it's done.")</p>
                </div>
                <ExerciseList Exercises="others" State="state" OnPick="exercise => superset ? SupersetAsync(exercise) : DoFirstAsync(exercise)" />
            </section>
        }

        <ExercisePicker State="state" OnPick="exercise => superset ? SupersetAsync(exercise) : SwapAsync(exercise)" Exclude="@state.Plan.Select(e => e.ExerciseId).ToHashSet()" Id="swap-name"
                        Label="@(superset ? $"Superset {target.Name} with" : $"Swap {target.Name} for")" NewAction="@(superset ? "Superset it" : "Swap it in")" />

        @if (state.Plan.Any(e => e.ExerciseId == id))
        {
            <div class="push-down">
                <button type="button" class="btn-ghost" @onclick="DropAsync">Drop @target.Name today</button>
            </div>
        }
    </div>
}

@code {
    private WorkoutState? state;
    private long? targetId;
    private bool superset;

    /// <summary>The exercise to change, e.g. one of a superset's; without it, the running set's, else the next step's.</summary>
    [SupplyParameterFromQuery] public long? Exercise { get; set; }

    protected override async Task OnInitializedAsync()
    {
        state = Flow.Current ?? await Flow.LoadAsync();
        targetId = Exercise is long id && state?.Exercises.ContainsKey(id) == true ? id : state?.ChangeTarget;
        if (targetId is null) await Navigation.ReturnToAsync(state is null ? "" : "workout");
    }

    private Task DoFirstAsync(Exercise exercise)
    {
        Flow.DoFirst(exercise, targetId!.Value);
        return Navigation.ReturnToAsync("workout");
    }

    private Task SwapAsync(Exercise exercise)
    {
        Flow.SwapFor(exercise, targetId!.Value);
        return Navigation.ReturnToAsync("workout");
    }

    private Task SupersetAsync(Exercise exercise)
    {
        Flow.SupersetWith(exercise, targetId!.Value);
        return Navigation.ReturnToAsync("workout");
    }

    private Task SplitAsync()
    {
        Flow.SplitSuperset(targetId!.Value);
        return Navigation.ReturnToAsync("workout");
    }

    private Task DropAsync()
    {
        Flow.Drop(targetId!.Value);
        return Navigation.ReturnToAsync("workout");
    }
}
