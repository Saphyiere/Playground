@page "/settings"
@using System.Diagnostics
@inject AppSettings AppSettings
@inject WorkoutStore Store
@inject IClaude Claude
@inject IAssistKeyStore Keys
@inject ClaudeKeyFile KeyFile

<PageTitle>Settings</PageTitle>

@{
    var thisYear = DateTime.Now.Year;
    var maintenance = Calories.Maintenance(AppSettings, latestWeight, DateOnly.FromDateTime(DateTime.Now));
    var metric = (latestWeight?.WeightUnit ?? AppSettings.Unit) == WeightUnit.Kilograms;
}
<div class="screen">
    <PageHeader Back="" BackText="Today" Title="Settings" />

    <section class="stack" aria-labelledby="look-heading">
        <h2 id="look-heading" class="label">Look</h2>
        <LookPicker />
    </section>

    @* What I aim to eat in a day, and maintenance: what would keep my weight where it is on a day without a workout, from my body below
       and my latest weigh-in. Each workout adds what it burned on its own day. *@
    <section class="stack" aria-labelledby="calories-heading">
        <h2 id="calories-heading" class="label">Calories</h2>
        <div class="grid-2">
            <div class="field-group">
                <label class="field-label" for="calorie-goal">Goal a day</label>
                <input id="calorie-goal" class="field" type="number" inputmode="numeric" min="0" step="50" @bind="goal"
                       @bind:after="() => SaveAsync(() => AppSettings.CalorieGoal = (goal = goal is > 0 ? goal : new AppSettings().CalorieGoal).Value)" />
            </div>
            <div class="row-text">
                <span class="label">Maintenance</span>
                <span class="name big tabular">@(maintenance is int calories ? calories.ToString("N0", CultureInfo.CurrentCulture) : "Not yet")</span>
            </div>
        </div>
        <p class="note">
            @if (maintenance is not null)
            {
                @($"What would keep your weight where it is on a day without a workout: resting calories for your weight ({latestWeight!.Weight.ToString("0.#", CultureInfo.CurrentCulture)} {(metric ? "kg" : "lb")}), height, age and sex by the Mifflin-St Jeor formula, × {Calories.Factor(AppSettings.DailyActivity).ToString("0.###", CultureInfo.CurrentCulture)} for your usual day. Each workout adds what it burned, on the day you do it.")
            }
            else
            {
                @($"Worked out from your body below and your latest weigh-in{(latestWeight is null ? ", once you've weighed in on Today" : "")}. Until then, Today takes it as {AppSettings.Maintenance.ToString("N0", CultureInfo.CurrentCulture)}.")
            }
        </p>
    </section>

    <section class="stack" aria-labelledby="body-heading">
        <h2 id="body-heading" class="label">Body</h2>
        <div class="segmented" role="group" aria-label="Sex">
            @foreach (var sex in Enum.GetValues<Sex>())
            {
                <button type="button" aria-pressed="@(AppSettings.Sex == sex ? "true" : "false")" @onclick="() => SaveAsync(() => AppSettings.Sex = sex)">@sex</button>
            }
        </div>
        <div class="@(metric ? "grid-2" : "grid-3")">
            <div class="field-group">
                <label class="field-label" for="age">Age</label>
                <input id="age" class="field" type="number" inputmode="numeric" min="1" max="120" @bind="age" @bind:after="() => SaveAsync(() => AppSettings.BirthYear = age is > 0 and < 120 ? thisYear - age : null)" />
            </div>
            @if (metric)
            {
                <div class="field-group">
                    <label class="field-label" for="height-cm">Height, cm</label>
                    <input id="height-cm" class="field" type="number" inputmode="decimal" min="0" step="any" @bind="centimeters" @bind:after="() => SaveAsync(() => AppSettings.HeightCm = centimeters is > 0 ? centimeters : null)" />
                </div>
            }
            else
            {
                <div class="field-group">
                    <label class="field-label" for="height-feet">Height, ft</label>
                    <input id="height-feet" class="field" type="number" inputmode="numeric" min="0" @bind="feet" @bind:after="SaveFeetAndInchesAsync" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="height-inches">in</label>
                    <input id="height-inches" class="field" type="number" inputmode="decimal" min="0" max="11.9" step="any" @bind="inches" @bind:after="SaveFeetAndInchesAsync" />
                </div>
            }
        </div>
        <p class="note">How you spend a usual day, not counting workouts: each one adds its own.</p>
        <div class="ledger" role="group" aria-label="Your usual day, outside workouts">
            @foreach (var (level, name, description) in Levels)
            {
                var chosen = AppSettings.DailyActivity == level;
                <button type="button" class="row" aria-pressed="@(chosen ? "true" : "false")" @onclick="() => SaveAsync(() => AppSettings.DailyActivity = level)">
                    <span class="status">
                        @if (chosen)
                        {
                            <Mark Kind="MarkKind.Tick" Size="28" />
                        }
                    </span>
                    <span class="row-text">
                        <span class="name">@name</span>
                        <span class="note">@description</span>
                    </span>
                    <span class="caption tabular">× @Calories.Factor(level).ToString("0.###", CultureInfo.CurrentCulture)</span>
                </button>
            }
        </div>
    </section>

    @* Claude: the key on this phone, masked, with a line on what last happened to it; the look back after each workout; and this
       month's cost. The key arrives as a file over USB, and lives in secure storage, never in the app's data. *@
    <section class="stack" aria-labelledby="claude-heading">
        <h2 id="claude-heading" class="label">Claude</h2>
        <p class="note">After each workout, Claude looks back at it: what went up, any set that looks wrong, and the weight, reps and rest for each exercise next time, yours with a tap. It uses your Anthropic API key, kept in the phone's secure storage apart from your workouts. Only the workout's sets, their heart rate and your weigh-in are sent.</p>
        <div class="spread baseline">
            <span class="label">Key</span>
            @if (maskedKey is { } masked)
            {
                <span class="name big tabular" aria-label="@($"The key on this phone, ending {masked[^4..]}")">@masked</span>
            }
            else
            {
                <span class="note">None on this phone</span>
            }
        </div>
        @if (maskedKey is null)
        {
            <button type="button" class="btn tall" @onclick="LookForKeyAsync">Look for the key file</button>
        }
        else if (removingKey)
        {
            <div class="grid-2 appear">
                <button type="button" class="btn tall" @onclick="() => removingKey = false">Keep it</button>
                <button type="button" class="btn tall fill" @onclick="RemoveKeyAsync">Remove it</button>
            </div>
        }
        else
        {
            <div class="grid-2">
                <button type="button" class="btn tall" disabled="@testing" @onclick="TestKeyAsync">@(testing ? "Testing…" : "Test")</button>
                <button type="button" class="btn tall" @onclick="() => (removingKey, keyNote) = (true, null)">Remove…</button>
            </div>
        }
        @if (removingKey)
        {
            <p class="note" role="status">The app forgets the key; the next look back needs it pushed again. The key itself stays good in the Claude Console until you disable it there.</p>
        }
        else if (keyNote is { } note)
        {
            <p class="note" role="status">@note</p>
        }
        @if (maskedKey is null)
        {
            <ol class="key-howto note">
                <li>In the Claude Console, make an API key in the workspace for your apps, the one with a monthly spend limit.</li>
                <li>Save the key alone in a text file named claude-key.txt, anywhere but the repo.</li>
                <li>Plug the phone into the PC, open the app once so its folder is there, and copy the file across: <code class="key-command">adb push claude-key.txt /sdcard/Android/data/<wbr />com.saphyiere.adaptiveworkout/<wbr />files/</code></li>
                <li>Delete the file on the PC with Shift+Delete. The app takes the key into secure storage the next time it opens, or now with Look for the key file, and deletes the copy on the phone.</li>
            </ol>
        }
        <div class="field-group">
            <span class="field-label" id="look-back-label">Look back after each workout</span>
            <div class="segmented" role="group" aria-labelledby="look-back-label">
                <button type="button" aria-pressed="@(lookBackOn ? "true" : "false")" @onclick="() => SetLookBackAsync(true)">On</button>
                <button type="button" aria-pressed="@(lookBackOn ? "false" : "true")" @onclick="() => SetLookBackAsync(false)">Off</button>
            </div>
        </div>
        @if (maskedKey is not null || spend.Cost > 0)
        {
            <div class="spread baseline">
                <span class="label">This month</span>
                <span class="name big tabular">@spend.Cost.ToString("$0.00", CultureInfo.InvariantCulture)</span>
            </div>
            <p class="note">What Anthropic charged for @(spend.LookBacks == 1 ? "1 look back" : $"{spend.LookBacks} look backs") this month, as the app counts it. The workspace's monthly spend limit is set in the Claude Console.</p>
        }
    </section>
</div>

@code {
    // How much I move on a usual day, outside my workouts, which add their own.
    private static readonly (DailyActivity Level, string Name, string Description)[] Levels =
    [
        (DailyActivity.Sitting, "Sitting most of the day", "A desk job, not much walking"),
        (DailyActivity.PartlyOnFeet, "On your feet some of the day", "Like teaching, or lots of walking"),
        (DailyActivity.MostlyOnFeet, "On your feet most of the day", "Like waiting tables, nursing or warehouse work"),
        (DailyActivity.PhysicalWork, "Physical work all day", "Like construction or farm work"),
    ];

    private BodyWeightEntry? latestWeight;
    private int? goal;
    private int? age;
    private double? centimeters;
    private int? feet;
    private double? inches;

    // Claude: the key on this phone, masked; what last happened to it; whether Finish opens the look back; and this month's cost.
    private string? maskedKey;
    private string? keyNote;
    private bool testing;
    private bool removingKey;
    private bool lookBackOn = true;
    private ClaudeSpend spend = new(0, 0);

    protected override async Task OnInitializedAsync()
    {
        goal = AppSettings.CalorieGoal;
        age = DateTime.Now.Year - AppSettings.BirthYear;
        if (AppSettings.HeightCm is double height)
        {
            var totalInches = height / 2.54;
            (centimeters, feet, inches) = (Math.Round(height, 1), (int)(totalInches / 12), Math.Round(totalInches % 12, 1));
        }

        // The latest weigh-in, as Today finds it.
        latestWeight = (await Store.GetBodyWeightsSinceAsync(DateTimeOffset.Now.AddDays(-30), 10)).MaxBy(w => w.At);

        maskedKey = await Keys.GetAsync() is { } key ? AssistKey.Mask(key) : null;
        // What became of a key file since the app opened, while it still holds: a key taken in that's since been removed says nothing.
        keyNote = KeyFile.Found switch
        {
            { Result: KeyImportResult.Saved } when maskedKey is not null => $"Key taken in from {AssistKey.FileName}",
            { Result: KeyImportResult.NotAKey } wrong when maskedKey is null => wrong.Detail,
            _ => maskedKey is null ? $"No {AssistKey.FileName} in the app's folder yet" : null,
        };
        lookBackOn = (await Store.GetSettingsAsync()).GetValueOrDefault(Trainer.SettingKey) != "off";
        var now = DateTimeOffset.Now;
        spend = await Store.GetClaudeSpendAsync(new DateTimeOffset(now.Year, now.Month, 1, 0, 0, 0, now.Offset));
    }

    private async Task TestKeyAsync()
    {
        testing = true;
        var watch = Stopwatch.StartNew();
        var answer = await Claude.TestAsync();
        keyNote = answer.Ok ? $"Works: Claude answered in {watch.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.CurrentCulture)} s" : answer.Summary;
        testing = false;
    }

    private async Task RemoveKeyAsync()
    {
        await Keys.RemoveAsync();
        (maskedKey, removingKey, keyNote) = (null, false, "The key is off this phone.");
    }

    private async Task LookForKeyAsync()
    {
        var found = await KeyFile.ImportAsync(Keys);
        maskedKey = await Keys.GetAsync() is { } key ? AssistKey.Mask(key) : null;
        keyNote = found.Result switch
        {
            KeyImportResult.Saved => $"Key taken in from {AssistKey.FileName}",
            KeyImportResult.NotAKey => found.Detail,
            _ => $"No {AssistKey.FileName} in the app's folder yet",
        };
    }

    private Task SetLookBackAsync(bool on)
    {
        lookBackOn = on;
        return Store.SetSettingAsync(Trainer.SettingKey, on ? null : "off");
    }

    // Changes a setting, then saves them all.
    private Task SaveAsync(Action change)
    {
        change();
        return Store.SaveAsync(AppSettings);
    }

    private Task SaveFeetAndInchesAsync() => SaveAsync(() => AppSettings.HeightCm = feet is > 0 ? Math.Round(((feet ?? 0) * 12 + (inches ?? 0)) * 2.54, 1) : null);
}
