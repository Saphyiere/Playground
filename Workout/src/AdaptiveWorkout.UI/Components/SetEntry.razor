@inject WorkoutFlow Flow
@inject AppSettings Settings
@* One stopped set on the rest screen: the exercise's name, then weight × reps and Hit goal on a line, pre-filled, and under them how
   many more reps it had in it, if I say. Every change is saved as it's made, so there's nothing to confirm. The three dots open
   what's rarely needed: Warm-up (a lighter set to get ready: it has no goal or reps left, and isn't one of the exercise's sets),
   Assisted (the weight is help, kept as a minus), and the way to every set of today. *@

@{
    var exercise = State.Exercises[Set.ExerciseId];
    var id = $"set-{Set.Order}";
    var unit = Set.WeightUnit == WeightUnit.Kilograms ? "kg" : "lb";
}
<div class="lift" role="group" aria-label="@exercise.Name">
    <div class="spread lift-head">
        <span class="inline baseline">
            <span class="name">@exercise.Name</span>
            @if (Set.WarmUp)
            {
                <span class="caption">Warm-up</span>
            }
        </span>
        <span class="inline">
            @* What ticking Hit goal does, said only once it's ticked. Bodyweight has no weight to raise. *@
            @if (Set is { HitGoal: true, Weight: double weight })
            {
                <span class="pen-note lift-note">Next time: @SetSummary.WeightText(weight + Settings.HitGoalStep) @unit</span>
            }
            <button type="button" class="icon-btn plain lift-dots" aria-expanded="@(open ? "true" : "false")" aria-label="@($"More for this set of {exercise.Name}")" @onclick="() => open = !open">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path d="M6 12H6.05M12 12H12.05M18 12H18.05" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
            </button>
        </span>
    </div>
    <div class="lift-row">
        <div class="field-group lift-weight">
            <label class="sr-only" for="@id-weight">Weight</label>
            <div class="writing">
                <input id="@id-weight" class="field number-field" type="number" inputmode="decimal" step="any" placeholder="Bodyweight" @bind="Set.Weight" @bind:after="() => Flow.SaveSet(Set)" />
                @if (Set.Weight is not null)
                {
                    <span class="unit">@unit</span>
                }
            </div>
        </div>
        <span class="lift-x" aria-hidden="true">×</span>
        <div class="field-group lift-reps">
            <label class="sr-only" for="@id-reps">Reps</label>
            <div class="writing">
                <input id="@id-reps" class="field number-field" type="number" inputmode="numeric" min="0" @bind="Set.Reps" @bind:after="() => Flow.SaveSet(Set)" />
            </div>
        </div>
        <label class="goal">
            <input type="checkbox" disabled="@Set.WarmUp" @bind="Set.HitGoal" @bind:after="() => Flow.SaveSet(Set)" />
            <span>Hit goal</span>
        </label>
    </div>
    <RepsLeftPicker Id="@($"{id}-tank")" Quiet="true" Disabled="Set.WarmUp" @bind-Value="Set.RepsLeft" @bind-Value:after="() => Flow.SaveSet(Set)" />
    @if (open)
    {
        <div class="lift-more appear">
            <div class="spread">
                <label class="goal">
                    <input type="checkbox" @bind="Set.WarmUp" @bind:after="() => Flow.SaveSet(Set)" />
                    <span>Warm-up</span>
                </label>
                <label class="goal">
                    <input type="checkbox" checked="@(Set.Weight < 0)" disabled="@(Set.Weight is null)" @onchange="() => { Set.Weight = -Set.Weight; Flow.SaveSet(Set); }" />
                    <span>Assisted</span>
                </label>
            </div>
            <a class="btn-ghost" href="workout/sets">Today's sets</a>
        </div>
    }
</div>

@code {
    private bool open;

    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;
    [Parameter, EditorRequired] public WorkoutSet Set { get; set; } = default!;
}
