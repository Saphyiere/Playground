@implements IDisposable
@inject WatchLink Watch
@inject WorkoutFlow Flow
@inject WorkoutStore Store
@* Live heart rate from the watch, and in a rest how far it's fallen since the set stopped. Without a recent reading, it offers to open
   the watch app again. *@
@if (Watch.Connected && Watch.Latest is { } latest && Theme == Theme.Telemetry)
{
    @* The heart channel: its tag and number, and the last minute as a line over a ruler of 5-second ticks. *@
    var minute = Watch.Recent.Where(r => latest.At - r.At <= TimeSpan.FromSeconds(60)).DefaultIfEmpty(latest).ToList();
    var (low, high) = (minute.Min(r => r.Bpm) - 2, minute.Max(r => r.Bpm) + 2);
    double X(HeartRateSample r) => 0.5 + (60 - (latest.At - r.At).TotalSeconds) * 149 / 60;
    double Y(HeartRateSample r) => 2 + (high - r.Bpm) * 22.0 / (high - low);
    var fall = Fall();
    <div class="spread heart-rate">
        <div class="row-text">
            <p class="inline">
                <span class="label tag channel-heart">HR</span>
                <span class="inline baseline">
                    <span class="number sm">@latest.Bpm</span>
                    <span class="unit">bpm</span>
                </span>
            </p>
            @if (fall is { } f)
            {
                <span class="heart-drop channel-heart">@DropText(f)</span>
            }
        </div>
        <svg class="ruler trace-60 channel-heart" viewBox="0 0 150 40" role="img" aria-label="@($"Heart rate over the last minute, from {minute[0].Bpm} to {latest.Bpm}")">
            <RulerTicks Width="150" Bottom="40" Steps="12" MajorEvery="3" />
            @if (AfterSet is { } stop && latest.At - stop is var sinceStop && sinceStop <= TimeSpan.FromSeconds(60) && sinceStop >= TimeSpan.Zero)
            {
                @* Where the set stopped, on the line. *@
                var stopX = 0.5 + (60 - sinceStop.TotalSeconds) * 149 / 60;
                <line class="stop-mark" x1="@N(stopX)" y1="0" x2="@N(stopX)" y2="30"></line>
            }
            @if (minute.Count > 1)
            {
                <polyline class="trace" points="@string.Join(' ', minute.Select(r => $"{N(X(r))},{N(Y(r))}"))"></polyline>
            }
            <circle class="trace-ring" cx="@N(X(latest))" cy="@N(Y(latest))" r="6"></circle>
            <circle class="trace-dot" cx="@N(X(latest))" cy="@N(Y(latest))" r="4"></circle>
        </svg>
    </div>
}
else if (Watch.Connected && Watch.Latest is { } reading)
{
    <p class="inline heart-rate">
        <Icon Name="heart" Size="22" />
        <span class="inline baseline">
            <span class="number sm">@reading.Bpm</span>
            <span class="unit">bpm</span>
        </span>
        @if (Fall() is { } fall)
        {
            <span class="pen-note">@DropText(fall)</span>
        }
    </p>
}
else
{
    <div class="spread heart-rate">
        <span class="inline note">
            <Icon Name="heart" Size="22" Color="var(--ink-muted)" />
            Waiting for the watch
        </span>
        <button type="button" class="btn" @onclick="OpenOnWatch">Open on watch</button>
    </div>
}

@code {
    private readonly CancellationTokenSource stop = new();

    [CascadingParameter] public Theme Theme { get; set; } = Theme.Logbook;

    /// <summary>In a rest: when the set stopped, to say how far heart rate has fallen since. Empty during a set.</summary>
    [Parameter] public DateTimeOffset? AfterSet { get; set; }

    // The peak around the stop, kept once its seconds are past: the watch link holds two minutes of readings, and a rest can be longer.
    private HeartRateSample? peak;
    private DateTimeOffset? peakFor;

    protected override async Task OnParametersSetAsync()
    {
        if (AfterSet is not { } stop || peakFor == stop) return;

        (peak, peakFor) = (null, null);
        if (DateTimeOffset.Now - stop <= HeartRateRecovery.AroundStop || Watch.Recent.Any(r => r.At <= stop - HeartRateRecovery.AroundStop)) return;

        // Opened again after the readings around the stop left the watch link: they're in the store.
        peak = HeartRateRecovery.Peak(await Store.GetHeartRateAsync(stop - HeartRateRecovery.AroundStop, stop + HeartRateRecovery.AroundStop), stop, DateTimeOffset.Now);
        peakFor = stop;
    }

    // How far heart rate has fallen since the set stopped, from the watch link's readings (and the peak kept, for a long rest).
    private HeartRateFall? Fall()
    {
        if (AfterSet is not { } stop) return null;

        var readings = Watch.Recent;
        if (peakFor != stop && DateTimeOffset.Now - stop > HeartRateRecovery.AroundStop && HeartRateRecovery.Peak(readings, stop, DateTimeOffset.Now) is { } found)
            (peak, peakFor) = (found, stop);
        return HeartRateRecovery.Since(peak is not null && peakFor == stop ? [peak, .. readings] : readings, stop, DateTimeOffset.Now);
    }

    // "Down 34 from 152", or while it's still climbing, "Up 4 from 148".
    private static string DropText(HeartRateFall fall) => fall.Drop >= 0 ? $"Down {fall.Drop} from {fall.From}" : $"Up {-fall.Drop} from {fall.From}";

    protected override void OnInitialized()
    {
        Watch.Changed += OnChanged;

        // New readings re-render on their own; this notices when they stop.
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            try
            {
                while (await timer.WaitForNextTickAsync(stop.Token)) await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // SVG numbers, which take a point whatever the phone's language.
    private static string N(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private void OpenOnWatch()
    {
        if (Flow.Current is { } state) Watch.Open(state.Session);
    }

    public void Dispose()
    {
        Watch.Changed -= OnChanged;
        stop.Cancel();
        stop.Dispose();
    }
}
