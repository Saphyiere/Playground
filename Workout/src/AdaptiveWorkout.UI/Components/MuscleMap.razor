@* The muscle map: a figure from the front and one from the back, each muscle shaded by its hard sets. In Logbook it's hatched in ink,
   denser as the sets add up, and cross-hatched from 10; in Telemetry it lights up in the training channel's lime. Each muscle is drawn
   on the figure's right side and mirrored to its left. *@
<svg class="muscle-map" viewBox="0 0 250 262" role="img" aria-labelledby="muscle-map-title">
    <title id="muscle-map-title">@Title</title>
    @if (!telemetry)
    {
        <defs>
            <pattern id="mm-hatch-1" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line class="hatch" x1="0" y1="0" x2="0" y2="5" />
            </pattern>
            <pattern id="mm-hatch-2" width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line class="hatch" x1="0" y1="0" x2="0" y2="2.6" />
            </pattern>
            <pattern id="mm-hatch-3" width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <path class="hatch" d="M0 0V2.6M0 0H2.6" />
            </pattern>
        </defs>
    }
    @foreach (var back in new[] { false, true })
    {
        <g transform="translate(@(back ? 130 : 0) 0)">
            @foreach (var part in back ? BackBody : FrontBody)
            {
                <path class="body" d="@part" />
                <path class="body" d="@part" transform="matrix(-1 0 0 1 120 0)" />
            }
            @foreach (var (muscle, path) in back ? BackMuscles : FrontMuscles)
            {
                // None; under 5; 5 to 9½; 10 and more, the band where growth is well served.
                var level = Counts.FirstOrDefault(c => c.Muscle == muscle)?.Sets switch { null or 0 => 0, < 5 => 1, < Muscles.Low => 2, _ => 3 };
                var fill = telemetry ? null : level == 0 ? "none" : $"url(#mm-hatch-{level})";
                <path class="m lvl-@level" d="@path" fill="@fill" />
                <path class="m lvl-@level" d="@path" fill="@fill" transform="matrix(-1 0 0 1 120 0)" />
            }
            <g>
                <text class="map-label" x="60" y="260" text-anchor="middle">@(back ? "Back" : "Front")</text>
            </g>
        </g>
    }
</svg>

@code {
    /// <summary>Each muscle's hard sets; a muscle not in it has none.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MuscleSets> Counts { get; set; } = [];

    /// <summary>What the drawing shows, for a screen reader.</summary>
    [Parameter] public string Title { get; set; } = "Front and back, shaded by sets";

    [CascadingParameter] public Theme Theme { get; set; } = Theme.Logbook;

    private bool telemetry => Theme == Theme.Telemetry;

