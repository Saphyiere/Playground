@inject WorkoutStore Store
@inject MuscleTagger Tagger
@* Finding an exercise by name: what the screen offers first and the ones done before, until I type; then the names that match,
   and a new one when nothing has that name. *@

@{
    var key = ExerciseNames.Key(query);
}
<div class="field-group">
    <label class="field-label" for="@Id">@Label</label>
    <input id="@Id" class="field" placeholder="Type a name" autocomplete="off" @bind="query" @bind:event="oninput" />
</div>

@if (key.Length == 0)
{
    @BeforeTyping
    var recent = Choices.Recent.Where(e => !Exclude.Contains(e.Id)).Take(6).ToList();
    @if (recent.Count > 0)
    {
        <section class="stack" aria-labelledby="@Id-recent">
            <h2 id="@Id-recent" class="label">Done before</h2>
            <div class="ledger">
                @foreach (var exercise in recent)
                {
                    @Row(exercise)
                }
            </div>
        </section>
    }
}
else
{
    var matches = Choices.All.Where(e => !Leave.Contains(e.Id) && ExerciseNames.Key(e.Name).Contains(key)).OrderBy(e => e.Name).Take(8).ToList();
    @if (matches.Count > 0)
    {
        <section class="stack" aria-labelledby="@Id-matches">
            <h2 id="@Id-matches" class="label">Matches</h2>
            <div class="ledger">
                @foreach (var exercise in matches)
                {
                    @Row(exercise)
                }
            </div>
        </section>
    }
    @if (Choices.All.TrueForAll(e => ExerciseNames.Key(e.Name) != key))
    {
        <section class="stack" aria-labelledby="@Id-new">
            <h2 id="@Id-new" class="label">New exercise</h2>
            <p class="name big">“@ExerciseNames.Clean(query)”</p>
            <p class="note">Track it by</p>
            <div class="segmented" role="group" aria-label="Track by">
                <button type="button" aria-pressed="@(measure == ExerciseMeasure.Weight ? "true" : "false")" @onclick="() => measure = ExerciseMeasure.Weight">Weight and reps</button>
                <button type="button" aria-pressed="@(measure == ExerciseMeasure.Time ? "true" : "false")" @onclick="() => measure = ExerciseMeasure.Time">Time</button>
            </div>
            <button type="button" class="btn tall fill" @onclick="PickNewAsync">@NewAction</button>
        </section>
    }
}

@code {
    private string query = "";
    private ExerciseMeasure measure = ExerciseMeasure.Weight;

    /// <summary>Every exercise, the ones done lately, and how each went the last time.</summary>
    [Parameter, EditorRequired] public ExerciseChoices Choices { get; set; } = default!;

    [Parameter, EditorRequired] public EventCallback<Exercise> OnPick { get; set; }

    /// <summary>Exercises left out of Done before, e.g. the ones the screen lists above it. Typing their name still finds them.</summary>
    [Parameter] public IReadOnlyCollection<long> Exclude { get; set; } = [];

    /// <summary>Exercises never offered, e.g. the one being swapped out.</summary>
    [Parameter] public IReadOnlyCollection<long> Leave { get; set; } = [];

    /// <summary>What a row says under an exercise's name instead of how it went last time, e.g. "in today's workout"; null for the usual.</summary>
    [Parameter] public Func<Exercise, string?>? Note { get; set; }

    [Parameter] public string Id { get; set; } = "exercise-name";
    [Parameter] public string Label { get; set; } = "Exercise";

    /// <summary>The button that creates a new exercise and picks it, e.g. "Start set".</summary>
    [Parameter] public string NewAction { get; set; } = "Pick";

    /// <summary>Shown above the exercises done before until something is typed.</summary>
    [Parameter] public RenderFragment? BeforeTyping { get; set; }

    private RenderFragment Row(Exercise exercise) =>
        @<button type="button" class="row" @onclick="() => OnPick.InvokeAsync(exercise)">
            <span class="row-text">
                <span class="name">@exercise.Name</span>
                <span class="note">@(Note?.Invoke(exercise) ?? (Choices.LastTime(exercise) is { } last ? $"last: {last}" : "not done before"))</span>
            </span>
            <Icon Name="forward" />
        </button>;

    // A new exercise is tagged with its muscles by Claude meanwhile (see MuscleTagger).
    private async Task PickNewAsync()
    {
        var exercise = await Store.GetOrCreateExerciseAsync(query, measure);
        Choices.Add(exercise);
        _ = Tagger.TagAsync();
        await OnPick.InvokeAsync(exercise);
    }
}
