@inject WorkoutFlow Flow
@inject AppNavigation Navigation
@* The break screen's buttons: the next set or exercise, and Finish once there's nothing left to do. A planned cool-down starts in
   Finish's place, and Finish ends it. During the warm-up, the big button starts the first exercise. What's next shows the weight it
   starts at, so it can be ready before the rest is up; more of what I just did is one line, its numbers being the ones just entered.
   Change opens the workout's edit screen on that line. A button keeps its words in its box: a name too long for it gives way to
   plain ones, with the name in full under Next. *@

@if (State.CoolingDown)
{
    <button type="button" class="btn-primary save" @onclick="OnFinish">Finish workout</button>
}
else if (State.Next is { } next)
{
    // Going on with what I just did reads "Start set 3" (or round); anything else, its name.
    var goingOn = State.LastRound.Count > 0 && State.LastRound.All(s => next.Lines.Contains(s.Line));
    // The superset I just did a round of was taken apart: one of its exercises is next, alone, so another round isn't offered.
    var takenApart = State.LastRound.Count > 1 && !next.IsRound && State.LastRound.Any(s => next.Lines.Contains(s.Line));
    var names = State.Names(next.ExerciseIds);
    // More of what I just did starts from the numbers in the rest screen's lines, so with those in view Next is one line, with a
    // word only for an exercise that's gone flat. After a warm-up, or for an exercise that just joined, its starting numbers show.
    @if (goingOn && State.ToConfirm is [_, ..] entered && entered.All(s => !s.WarmUp) && next.Lines.All(line => entered.Exists(s => s.Line == line)))
    {
        <div class="spread next-step">
            <div class="row-text">
                <p class="label">Next · @WorkoutState.StepLabel(next)</p>
                @foreach (var exerciseId in next.ExerciseIds)
                {
                    @if (State.PlateauOf(exerciseId) is { } flat)
                    {
                        <p class="pen-note">@(next.IsRound ? $"{State.Exercises[exerciseId].Name}: flat for {flat.Workouts} workouts" : $"Flat for {flat.Workouts} workouts")</p>
                    }
                }
            </div>
            <a class="btn-ghost" href="workout/edit?line=@next.Lines[0]">Change</a>
        </div>
    }
    else if (next.IsRound)
    {
        @* A superset's round: each of its exercises can be changed on its own. *@
        <div class="stack tight next-step">
            <p class="label">Next · @WorkoutState.StepLabel(next)</p>
            @for (var i = 0; i < next.ExerciseIds.Count; i++)
            {
                var (exerciseId, line) = (next.ExerciseIds[i], next.Lines[i]);
                <div class="spread">
                    <div class="row-text">
                        <p class="body">@State.Exercises[exerciseId].Name</p>
                        @Ready(exerciseId)
                    </div>
                    <a class="btn-ghost" href="workout/edit?line=@line" aria-label="Change @State.Exercises[exerciseId].Name">Change</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="spread next-step">
            <div class="row-text">
                <p class="label">Next · @WorkoutState.StepLabel(next)</p>
                <p class="body">@names</p>
                @Ready(next.ExerciseId)
            </div>
            <a class="btn-ghost" href="workout/edit?line=@next.Lines[0]">Change</a>
        </div>
    }

    @* Other ways on sit above the big button, which stays in the same place on every screen. *@
    @if (State is { CanMoveOn: true, MoveOn: { } moveOn })
    {
        <button type="button" class="btn tall" @onclick="MoveOnAsync"><FitLabel Text="@($"Move on to {State.Names(moveOn.ExerciseIds)}")" Short="Move on" /></button>
    }
    else if (!State.OpenEnded && State.CanMoveOn)
    {
        <div class="grid-2">
            <a class="btn tall" href="workout/edit?add=true">Add more</a>
            <button type="button" class="btn tall" @onclick="FinishAsync">@FinishText</button>
        </div>
    }
    else if (!State.OpenEnded && !goingOn && !takenApart && LastBlock is { } again)
    {
        <button type="button" class="btn tall" @onclick="StartAnotherAsync">
            @if (again.Count == 1)
            {
                <FitLabel Text="@($"Another set of {State.Exercises[again[0].ExerciseId].Name}")" Short="Another set" />
            }
            else
            {
                @("Another round")
            }
        </button>
    }
    @if (State.OpenEnded)
    {
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="@(() => Navigation.Open("workout/exercise"))">Different exercise</button>
            <button type="button" class="btn tall" @onclick="FinishAsync">@FinishText</button>
        </div>
    }
    @* The big button names what it starts when the name fits; the names are in full under Next either way. *@
    <button type="button" class="btn-primary go" @onclick="() => Start(next)">
        @if (goingOn)
        {
            @($"Start {(next.IsRound ? "round" : "set")} {next.SetNumber}")
        }
        else
        {
            <FitLabel Text="@($"Start {names}")" Short="@(next.IsRound ? "Start superset" : "Start next exercise")" />
        }
    </button>
}
else if (State.WarmingUp)
{
    <button type="button" class="btn-primary go" @onclick="@(() => Navigation.Open("workout/exercise"))">Pick an exercise</button>
}
else
{
    <p class="note center">@(State.OpenEnded ? "Pick what's next, or finish." : "Every planned exercise is done.")</p>
    @if (LastBlock is { } again)
    {
        <div class="grid-2">
            <button type="button" class="btn tall" @onclick="StartAnotherAsync">@(again.Count > 1 ? "Another round" : "Another set")</button>
            @AddMore
        </div>
    }
    else
    {
        @AddMore
    }
    <button type="button" class="btn-primary @(State.CoolDownNext ? "go" : "save")" @onclick="FinishAsync">@FinishText</button>
}

@code {
    [Parameter, EditorRequired] public WorkoutState State { get; set; } = default!;

    /// <summary>Called after a set or the cool-down starts, so the page re-renders.</summary>
    [Parameter] public EventCallback OnStarted { get; set; }

    [Parameter] public EventCallback OnFinish { get; set; }

    private string FinishText => State.CoolDownNext ? "Start cool-down" : "Finish workout";

    // What I just did, as it stands in today's workout now: its line's block, which is one exercise once its superset was taken
    // apart. Null before the first set, and once its line is gone.
    private List<TemplateExercise>? LastBlock => State.LastRound is [var last, ..] ? State.BlockOf(last.Line) : null;

    // More to do once everything is done: another exercise picked to start, when just tracking; else the edit screen, on adding one.
    private RenderFragment AddMore => State.OpenEnded
        ? @<button type="button" class="btn tall" @onclick="@(() => Navigation.Open("workout/exercise"))">Different exercise</button>
        : @<a class="btn tall" href="workout/edit?add=true">Add more</a>;

    // What an exercise's next set starts with, to have the weights ready: "120 lb × 10", marked when it went up for a hit goal or came
    // from the plan of the last look back, and when the exercise has gone flat.
    // Nothing for a time exercise, or with nothing to go on.
    private RenderFragment Ready(long exerciseId)
    {
        if (State.NextValues(exerciseId) is not { } values) return _ => { };

        var weight = values.Weight is double amount ? $"{SetSummary.WeightText(amount)} {(values.Unit == WeightUnit.Kilograms ? "kg" : "lb")}" : "Bodyweight";
        return @<p class="row-text">
            <span class="name big tabular">@(values.Reps is int reps ? $"{weight} × {reps}" : weight)</span>
            @if (values.RaisedForGoal)
            {
                <span class="pen-note">Up: you hit your goal last time</span>
            }
            else if (values.FromTrainer)
            {
                <span class="pen-note">From Claude's look back</span>
            }
            @if (State.PlateauOf(exerciseId) is { } flat)
            {
                <span class="pen-note">Flat for @flat.Workouts workouts</span>
            }
        </p>;
    }

    private Task Start(PlanStep step)
    {
        Flow.StartSets(step);
        return OnStarted.InvokeAsync();
    }

    // More of what I just did, past its sets.
    private Task StartAnotherAsync()
    {
        Flow.StartAnother();
        return OnStarted.InvokeAsync();
    }

    // Finish this exercise with the completed sets and start the following block.
    private Task MoveOnAsync()
    {
        Flow.MoveOn();
        return OnStarted.InvokeAsync();
    }

    // With a cool-down planned, finishing starts it instead.
    private Task FinishAsync()
    {
        if (!State.CoolDownNext) return OnFinish.InvokeAsync();

        Flow.StartCoolDown();
        return OnStarted.InvokeAsync();
    }
}
