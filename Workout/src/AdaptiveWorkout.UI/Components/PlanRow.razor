@* One row of the list both editors share: an exercise in its place, or a superset's heading. In a workout its box says where it
   stands: the pen's dot on what's now or next, a tick once it's done, empty until then. Tapping it opens it, and the arrows move
   it a step. *@
<div class="row @(Open ? "picked" : null) @Class">
    <button type="button" class="row-main" aria-expanded="@(Open ? "true" : "false")" @onclick="OnOpen">
        @if (Box is { } box)
        {
            <span class="status">
                @if (box == RowBox.Now)
                {
                    <span class="live-dot"></span>
                }
                else if (box == RowBox.Done)
                {
                    <Mark Kind="MarkKind.Tick" Size="28" />
                }
            </span>
        }
        <span class="row-text">
            @if (Heading is not null)
            {
                <span class="label">@Heading</span>
            }
            else
            {
                <span class="name">@Name</span>
            }
            @if (Caption is { Length: > 0 })
            {
                <span class="caption">@Caption</span>
            }
        </span>
    </button>
    @if (OnMove.HasDelegate)
    {
        @* Arrows with shafts move a row; the kit's bare chevrons are the way on and back. *@
        <span class="move">
            <button type="button" class="icon-btn plain" aria-label="Move @(Heading is null ? Name : MoveName) up" disabled="@(!CanMoveUp)" @onclick="() => OnMove.InvokeAsync(-1)">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M12 19V5M6.5 10.5L12 5L17.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <button type="button" class="icon-btn plain" aria-label="Move @(Heading is null ? Name : MoveName) down" disabled="@(!CanMoveDown)" @onclick="() => OnMove.InvokeAsync(1)">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M12 5V19M6.5 13.5L12 19L17.5 13.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
        </span>
    }
</div>

@code {
    /// <summary>The exercise's name.</summary>
    [Parameter] public string Name { get; set; } = "";

    /// <summary>A superset's heading, in the label's small capitals, in the name's place: "Superset · 3 rounds".</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>What a superset's arrows say they move: its exercises' names.</summary>
    [Parameter] public string MoveName { get; set; } = "";

    [Parameter] public string? Caption { get; set; }

    /// <summary>The box before the name, in a workout; none in a session, where nothing is done or next.</summary>
    [Parameter] public RowBox? Box { get; set; }

    [Parameter] public bool Open { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }

    /// <summary>Called with -1 (up) or 1 (down). Without it the row has no arrows.</summary>
    [Parameter] public EventCallback<int> OnMove { get; set; }

    [Parameter] public bool CanMoveUp { get; set; } = true;
    [Parameter] public bool CanMoveDown { get; set; } = true;
}
