@* How many more reps a set had in it: 0, 1, 2 or 3+, one tap, and optional. Tapping the one chosen clears it. Claude's look back
   reads it; the app's own suggestions don't. On the rest screen it's quiet: hairline boxes until one is picked. *@
<div class="tank @(Quiet ? "quiet" : null)" role="group" aria-labelledby="@Id">
    <span class="field-label" id="@Id">Left in the tank</span>
    <div class="segmented tank-choices">
        @for (var reps = 0; reps <= 3; reps++)
        {
            var value = reps;
            <button type="button" aria-pressed="@(Value == value ? "true" : "false")" aria-label="@Label(value)" disabled="@Disabled" @onclick="() => PickAsync(value)">@(value == 3 ? "3+" : value.ToString(CultureInfo.InvariantCulture))</button>
        }
    </div>
</div>

@code {
    /// <summary>The label's id, unique on the screen.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>0 to 3, where 3 is three or more; empty when not said.</summary>
    [Parameter] public int? Value { get; set; }

    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>Not asked, e.g. of a warm-up set.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Kept in view without drawing the eye, as on the rest screen.</summary>
    [Parameter] public bool Quiet { get; set; }

    private Task PickAsync(int value) => ValueChanged.InvokeAsync(Value == value ? null : value);

    private static string Label(int value) => value switch
    {
        0 => "No more reps left",
        1 => "1 more rep left",
        2 => "2 more reps left",
        _ => "3 or more reps left",
    };
}
