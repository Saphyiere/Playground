<Project>

  <!--
    Visual Studio's design-time builds (the background builds behind IntelliSense) number an Android app's resources with their own
    parser, which counts them differently from the real build. Once the app has been built, they write that numbering over the real
    build's resource designer after a resource edit that adds no resources (a changed color, say), the next builds keep it, and the
    app deployed with it looks its views up by the wrong ids: it stops on start with "No view found for id 0x7f0800f8 … for fragment
    NavigationRootManager_ElementBasedFragment". Design-time builds keep their own copy instead, as they do before the first build.
  -->
  <Target Name="KeepDesignTimeResourceIdsApart" BeforeTargets="_SetupDesignerProperties" Condition="'$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <_DesignerIntermediateOutputPath>$(IntermediateOutputPath)designtime\</_DesignerIntermediateOutputPath>
    </PropertyGroup>
  </Target>

  <!--
    The chips a release is built for, from tools/release/release-app.sh (an app's release.json), joined with + since MSBuild's
    command line splits on semicolons and commas: set on the app alone. Passed as RuntimeIdentifiers on the command line, they'd
    reach every library the app uses too, and the libraries would look for their builds in a folder per chip that isn't there.
    (By this point the Android SDK has turned an app's OutputType into Library, so AndroidApplication is what says it's an app.)
  -->
  <PropertyGroup Condition="'$(ReleaseRuntimeIdentifiers)' != '' and '$(AndroidApplication)' == 'true'">
    <RuntimeIdentifiers>$([MSBuild]::Unescape($(ReleaseRuntimeIdentifiers.Replace('+', '%3B'))))</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Every app, present and future, is signed with the devices' key (Directory.Build.props) in Debug and Release, from Visual Studio
    or the command line, whatever its project says: so any build installs over any other as an update and keeps the app's data,
    and the watch app pairs with the phone's. Only signing given on a build's command line (the Release workflow's) is used instead.
    Left to itself, .NET for Android signs with the same file, but makes a new key there when the file is missing, and nothing a
    new key signs installs over the apps on the devices. Given here as the key store, a missing file stops the build instead: on
    Windows, where the apps are installed from. And should the file be there but hold another key (made afresh by some other build
    while it was missing), the install guard stops any install from this PC that isn't signed with the devices' key, its
    certificate's SHA-256 against PlaygroundSigningSha256. A cloud session can't reach the devices: its first build makes a debug
    key of its own, as usual, and later builds sign with that.
  -->
  <PropertyGroup Condition="'$(AndroidApplication)' == 'true' and '$(PlaygroundSigningGiven)' != 'true' and ('$(OS)' == 'Windows_NT' or Exists('$(PlaygroundSigningKeyStore)'))">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(PlaygroundSigningKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>android</AndroidSigningStorePass>
    <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
  </PropertyGroup>

  <Target Name="PlaygroundCheckSigningKey" BeforeTargets="_ResolveAndroidSigningKey"
          Condition="'$(AndroidApplication)' == 'true' and '$(PlaygroundSigningGiven)' != 'true' and '$(OS)' == 'Windows_NT' and !Exists('$(PlaygroundSigningKeyStore)')">
    <Error Text="The devices' signing key isn't on this PC: $(PlaygroundSigningKeyStore). Every Playground app is signed with it, and an app signed with any other key won't install over the copy on a device, so nothing was signed. Put the file back from your backup (tools/release/README.md, One key for every build)." />
  </Target>

  <!-- Stops an install that would erase an app's data on the device. -->
  <Import Project="$(MSBuildThisFileDirectory)tools/build/InstallGuard.targets" Condition="'$(AndroidApplication)' == 'true'" />

</Project>
