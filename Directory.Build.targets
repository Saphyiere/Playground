<Project>

  <!--
    Visual Studio's design-time builds (the background builds behind IntelliSense) number an Android app's resources with their own
    parser, which counts them differently from the real build. Once the app has been built, they write that numbering over the real
    build's resource designer after a resource edit that adds no resources (a changed color, say), the next builds keep it, and the
    app deployed with it looks its views up by the wrong ids: it stops on start with "No view found for id 0x7f0800f8 … for fragment
    NavigationRootManager_ElementBasedFragment". Design-time builds keep their own copy instead, as they do before the first build.
  -->
  <Target Name="KeepDesignTimeResourceIdsApart" BeforeTargets="_SetupDesignerProperties" Condition="'$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <_DesignerIntermediateOutputPath>$(IntermediateOutputPath)designtime\</_DesignerIntermediateOutputPath>
    </PropertyGroup>
  </Target>

  <!--
    The chips a release is built for, from tools/release/release-app.sh (an app's release.json), joined with + since MSBuild's
    command line splits on semicolons and commas: set on the app alone. Passed as RuntimeIdentifiers on the command line, they'd
    reach every library the app uses too, and the libraries would look for their builds in a folder per chip that isn't there.
    (By this point the Android SDK has turned an app's OutputType into Library, so AndroidApplication is what says it's an app.)
  -->
  <PropertyGroup Condition="'$(ReleaseRuntimeIdentifiers)' != '' and '$(AndroidApplication)' == 'true'">
    <RuntimeIdentifiers>$([MSBuild]::Unescape($(ReleaseRuntimeIdentifiers.Replace('+', '%3B'))))</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
