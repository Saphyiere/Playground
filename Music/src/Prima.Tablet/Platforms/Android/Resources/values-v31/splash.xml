<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Vinyl's splash: the record on the sleeve's teal; Porcelain's and Night's: a card with a staff on the look's ground. Android
         shows the look's from the start after it's chosen (TabletLookSetting, Android 13 and later); Studio's is the app's own
         (MauiSplashScreen). -->
    <style name="Prima.Splash.Vinyl" parent="Maui.SplashTheme">
        <item name="android:windowSplashScreenBackground">#173B3D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vinyl</item>
    </style>
    <style name="Prima.Splash.Porcelain" parent="Maui.SplashTheme">
        <item name="android:windowSplashScreenBackground">#F2F2F2</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_porcelain</item>
    </style>
    <style name="Prima.Splash.Night" parent="Maui.SplashTheme">
        <item name="android:windowSplashScreenBackground">#101114</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_night</item>
    </style>
</resources>
