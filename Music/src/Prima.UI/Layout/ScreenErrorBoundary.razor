@inherits ErrorBoundaryBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject ILogger<ScreenErrorBoundary> Logger
@inject NavigationManager Nav

@* Every screen is drawn inside this. A screen that fails (in drawing itself, or in what a tap does) is kept in the problem log and
   gives way to this card, which says what went wrong and offers it again: Prima still answers every tap, and the rail still goes
   anywhere. Without it, the page stopped answering altogether, Blazor's yellow bar at its foot. Going to another screen, from
   here or the rail, starts afresh. *@
@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <section class="mu-screen problem-screen" role="alert" data-state="screen-stopped">
        <div class="mu-screen-head"><span>Problem</span><span>Kept in Settings</span></div>
        <h2 class="mu-screen-title">This screen stopped</h2>
        <p class="page-panel-line problem-said">@CurrentException.GetType().Name: @CurrentException.Message</p>
        <p class="page-panel-line">Prima kept what happened in Settings › Problems, and in @ProblemLog.FileName in its folder on the tablet. The rest of Prima still works.</p>
        <div class="control-row">
            <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="Recover">Try again</button>
            <a class="mu-btn" data-piano="off" href="settings?tab=app&amp;section=problems">See it in Settings</a>
            <a class="mu-btn" data-piano="off" href="">Today</a>
        </div>
    </section>
}

@code {
    protected override void OnInitialized() => Nav.LocationChanged += Moved;

    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "The screen at /{Screen} stopped: {Message}", Nav.ToBaseRelativePath(Nav.Uri), exception.Message);
        return Task.CompletedTask;
    }

    // Another screen: it starts afresh, whatever this one did.
    private void Moved(object? sender, LocationChangedEventArgs e)
    {
        if (CurrentException is not null) _ = InvokeAsync(Recover);
    }

    public void Dispose() => Nav.LocationChanged -= Moved;
}
