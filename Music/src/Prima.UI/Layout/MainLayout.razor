@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject LookSetting LookSetting
@inject PrimaSettings Settings
@inject PrimaStore Store
@inject IJSRuntime JS
@inject ClaudeKeyFile KeyFile
@inject Playground.AI.Assist.IAssistKeyStore Keys

@* Screens wait for the saved look, so the parts that draw per look don't start in the wrong one, and for the saved settings. *@
@if (loaded)
{
    <CascadingValue Value="LookSetting.Current">
        <div class="shell">
            <PianoButtons />
            <Rail />
            <main class="shell-main">
                <Prima.UI.Transcription.ConversionNotice />
                @Body
            </main>
        </div>
    </CascadingValue>
}

@code {
    private bool loaded;
    private string? shownLook;
    private IJSObjectReference? page;
    private IJSObjectReference? sheet;

    protected override async Task OnInitializedAsync()
    {
        LookSetting.Changed += OnLookChanged;
        // A Claude key copied over USB is taken in as Prima opens; Settings says what became of it.
        await Task.WhenAll(LookSetting.LoadAsync(), Store.LoadAsync(Settings), KeyFile.ImportAsync(Keys));
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page's colors, fonts and shapes follow data-theme on <html>, which index.html restores before the first paint.
        if (!loaded || shownLook == LookSetting.Current.Id) return;

        shownLook = LookSetting.Current.Id;
        try
        {
            page ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Layout/MainLayout.razor.js");
            await page.InvokeVoidAsync("showLook", shownLook);
            // Verovio is a 7 MB script: it loads in the background now, so the first sheet doesn't wait for it.
            if (firstRender || sheet is null)
            {
                sheet = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Components/Sheet.razor.js");
                await sheet.InvokeVoidAsync("warm");
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }

    private void OnLookChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        LookSetting.Changed -= OnLookChanged;
        try
        {
            if (page is not null) await page.DisposeAsync();
            if (sheet is not null) await sheet.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }
}
