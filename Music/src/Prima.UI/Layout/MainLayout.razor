@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject LookSetting LookSetting
@inject LayoutStart Start
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@using System.Text.Json
@using Microsoft.Extensions.Logging

@* Screens wait for the saved look, so the parts that draw per look don't start in the wrong one, and for the saved settings. *@
@if (loaded)
{
    <CascadingValue Value="LookSetting.Current">
        <div class="shell">
            <PianoButtons />
            <Rail />
            <main class="shell-main">
                <ScreenErrorBoundary>
                    <Prima.UI.Transcription.ConversionNotice />
                    @Body
                </ScreenErrorBoundary>
            </main>
        </div>
    </CascadingValue>
}

@code {
    private bool loaded;
    private string? shownLook;
    private IJSObjectReference? page;
    private IJSObjectReference? sheet;

    protected override async Task OnInitializedAsync()
    {
        LookSetting.Changed += OnLookChanged;
        // Read as Prima opens (a Claude key copied over USB is taken in then), and at once for every screen after.
        await Start.ReadyAsync();
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await TakeInPageProblems();

        // The page's colors, fonts and shapes follow data-theme on <html>, which index.html restores before the first paint.
        if (!loaded || shownLook == LookSetting.Current.Id) return;

        shownLook = LookSetting.Current.Id;
        try
        {
            page ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Layout/MainLayout.razor.js");
            await page.InvokeVoidAsync("showLook", shownLook);
            // The first screen is drawn: Prima's opening mark goes as it arrives.
            await page.InvokeVoidAsync("opened");
            // Verovio is a 7 MB script: it loads in the background now, so the first sheet doesn't wait for it.
            if (firstRender || sheet is null)
            {
                sheet = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Components/Sheet.razor.js");
                await sheet.InvokeVoidAsync("warm");
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }

    // What the page kept of its own problems (problems.js): above all, why it last stopped answering, which it can't tell .NET at
    // the time. Each goes in the problem log as of when it happened.
    private async Task TakeInPageProblems()
    {
        try
        {
            var kept = JsonSerializer.Deserialize<List<PageProblem>>(await JS.InvokeAsync<string>("primaProblems.take"), JsonSerializerOptions.Web) ?? [];
            foreach (var problem in kept)
            {
                var at = problem.At.ToLocalTime();
                if (problem.Kind == "stopped") Logger.LogError("The page stopped answering at {Path} ({At:d MMM HH:mm:ss}): {Said}", problem.Path, at, problem.Text);
                else Logger.LogWarning("The page reported a problem ({Kind}) at {Path} ({At:d MMM HH:mm:ss}): {Said}", problem.Kind, problem.Path, at, problem.Text);
            }
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or JsonException)
        {
        }
    }

    private sealed record PageProblem(DateTimeOffset At, string Kind, string Path, string Text);

    private void OnLookChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        LookSetting.Changed -= OnLookChanged;
        try
        {
            if (page is not null) await page.DisposeAsync();
            if (sheet is not null) await sheet.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }
}
