@page "/settings"
@inject LookSetting LookSetting
@inject IKeyboard Keyboard
@inject PrimaSettings Options
@inject PrimaStore Store
@inject AppNavigation Navigation
@inject IClaude Claude
@inject IAssistKeyStore Keys
@inject ClaudeKeyFile KeyFile
@inject Updater Updates
@inject ProblemLog Problems
@inject Playground.Sync.Syncer Sync
@inject IJSRuntime JS
@inject Prima.UI.Host.Click ClickTrack
@inject IServiceProvider Services
@using Playground.AI.Assist
@using Playground.Updates
@implements IDisposable

<PageTitle>Settings · Prima</PageTitle>

@* Settings in six tabs, the one open kept in the address (settings?tab=keyboard) so the way back comes back to it, and a link can
   open a tab, and bring a section into view (settings?tab=app&section=problems). The search beside the heading finds a setting in
   any tab by its name, its choices or what it says, and shows each where it is, under its tab's name; cleared, the tabs come back.
   Each setting is a Setting in a SettingsSection, which hold the words it's found by (SettingsFinder). *@
<PageHead Title="Settings">
    <input class="text-field settings-search" type="search" placeholder="Search settings" aria-label="Search settings" @bind="finder.Query" @bind:event="oninput" />
</PageHead>

@if (!finder.Searching)
{
    <div class="settings-tabs" role="tablist" aria-label="Settings">
        @foreach (var tab in SettingsFinder.Tabs)
        {
            <button type="button" role="tab" id="@($"settings-tab-{tab.Id}")" class="settings-tab" aria-selected="@On(tab.Id == finder.Tab)" aria-controls="settings-panel" @onclick="() => Open(tab.Id)">@tab.Name</button>
        }
    </div>
}
else if (!finder.FoundAny)
{
    <p class="page-note">No settings found for “@finder.Query.Trim()”.</p>
}

<div id="settings-panel" class="settings-panel" role="@(finder.Searching ? null : "tabpanel")" aria-labelledby="@(finder.Searching ? null : $"settings-tab-{finder.Tab}")">
<CascadingValue Value="finder" IsFixed="true">

@* Practice *@
<SettingsSection Tab="practice" Id="practice" Title="Piece feedback">
    <Setting Name="Feedback preset" Words="@($"Custom Simple Hands-on Practicing a piece {string.Join(' ', PrimaSettings.WayNames.Select(w => w.Name))}")" Note="@Options.FeedbackDescription">
        <FeedbackPreset Way="@Options.Way" Chosen="way => Save(() => Options.UseWay(way))" />
    </Setting>
    <details class="routine-history feedback-options" open="@finder.Searching">
        <summary>Customize feedback</summary>
        <Setting Name="Run feedback" Words="Customize feedback After a run None Nothing Summary Review">
            <div class="control-row" role="group" aria-label="Run feedback">
                <span class="control-label">Run feedback</span>
                <button type="button" class="mu-toggle" data-feedback="nothing" aria-pressed="@On(Options.AfterRun == "nothing")" @onclick='() => Save(() => Options.AfterRun = "nothing")'><span class="mu-led"></span>None</button>
                <button type="button" class="mu-toggle" data-feedback="summary" aria-pressed="@On(Options.AfterRun == "summary")" @onclick='() => Save(() => Options.AfterRun = "summary")'><span class="mu-led"></span>Summary</button>
                <button type="button" class="mu-toggle" data-feedback="review" aria-pressed="@On(Options.AfterRun == "review")" @onclick='() => Save(() => Options.AfterRun = "review")'><span class="mu-led"></span>Review</button>
            </div>
        </Setting>
        <Setting Name="Show last loop result" Words="Round a loop Each pass's figure On Off">
            <SettingSwitch Label="Show last loop result" Value="Options.PassFigure" Changed="value => Save(() => Options.PassFigure = value)" />
        </Setting>
        <Setting Name="Pause between repeats" Words="Loop wait after each pass On Off">
            <SettingSwitch Label="Pause between repeats" Value="Options.PassWaits" Changed="value => Save(() => Options.PassWaits = value)" />
        </Setting>
    </details>
</SettingsSection>

<SettingsSection Tab="practice" Id="playback" Title="Playback">
    <Setting Name="Count-in" Words="One bar, Two bars">
        <div class="control-row">
            <span class="control-label">Count-in</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.CountInBars == 1)" @onclick="() => Save(() => Options.CountInBars = 1)"><span class="mu-led"></span>One bar</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.CountInBars == 2)" @onclick="() => Save(() => Options.CountInBars = 2)"><span class="mu-led"></span>Two bars</button>
        </div>
    </Setting>
    <Setting Name="Repeat automatically" Words="At a run's end Go again manual restart Off On" Note='@(Options.AfterRun == "review" ? "The full review pauses playback." : "Starts the next run after the count-in.")'>
        <SettingSwitch Label="Repeat automatically" Value="Options.RunAgain" Changed="value => Save(() => Options.RunAgain = value)" />
    </Setting>
    <Setting Name="On the score" Words="Show cursor, Mark notes as I play, Marks as you play" Note="Timed practice still records your notes when live marks are off.">
        <div class="control-row">
            <span class="control-label">On the score</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.Cursor)" @onclick="() => Save(() => Options.Cursor = !Options.Cursor)"><span class="mu-led"></span>Show cursor</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.LiveMarks)" @onclick="() => Save(() => Options.LiveMarks = !Options.LiveMarks)"><span class="mu-led"></span>Mark notes as I play</button>
        </div>
    </Setting>
</SettingsSection>

<SettingsSection Tab="practice" Id="reading" Title="Sight-reading and note drills">
    <Setting Name="Sight-reading preview" Words="@(string.Join(' ', LookChoices.Select(c => c.Label)))" Note="Time to look at a new passage before the count-in.">
        <div class="control-row">
            <span class="control-label">Sight-reading preview</span>
            @foreach (var (seconds, label) in LookChoices)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(Options.LookSeconds == seconds)" @onclick="() => Save(() => Options.LookSeconds = seconds)"><span class="mu-led"></span>@label</button>
            }
        </div>
    </Setting>
    <Setting Name="Clefs for note drills" Words="@(string.Join(' ', ClefChoices.Select(c => c.Label)))">
        <div class="control-row">
            <span class="control-label">Clefs for note drills</span>
            @foreach (var (value, label) in ClefChoices)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(Options.Clefs == value)" @onclick="() => Save(() => Options.Clefs = value)"><span class="mu-led"></span>@label</button>
            }
        </div>
    </Setting>
    <Setting Name="Show note names after mistakes" Words="After a wrong note Show letter name on staff On Off">
        <SettingSwitch Label="Show note names after mistakes" Value="Options.LetterNames" Changed="value => Save(() => Options.LetterNames = value)" />
    </Setting>
</SettingsSection>

<SettingsSection Tab="practice" Id="profile" Title="Practice goals and profile">
    <Setting Name="Name" Words="Optional">
        <div class="control-row">
            <label class="control-label" for="profile-name">Name</label>
            <input id="profile-name" class="text-field text-field-short" type="text" @bind="name" @bind:after="SaveProfile" placeholder="Optional" />
        </div>
    </Setting>
    <Setting Name="Daily practice goal" Words="@($"Minutes a day {string.Join(' ', Minutes)} min")" Note="@gradually">
        <div class="control-row">
            <span class="control-label">Daily practice goal</span>
            @foreach (var m in Minutes)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(Options.DailyMinutes == m)" @onclick="() => ChooseMinutes(m)"><span class="mu-led"></span>@m min</button>
            }
        </div>
    </Setting>
    <Setting Name="Daily practice note" Note="Shown on Today." Words="When I sit down after dinner, I’ll open Prima">
        <div class="control-row">
            <label class="control-label" for="profile-cue">Daily practice note</label>
            <input id="profile-cue" class="text-field" type="text" @bind="cue" @bind:after="SaveProfile" placeholder="When I sit down after dinner, I’ll open Prima" />
        </div>
    </Setting>
</SettingsSection>

@* Keyboard & sound *@
<SettingsSection Tab="keyboard" Id="keyboard" Title="Keyboard">
    <Setting Words="@($"Plug in your keyboard {Keyboard.Name}")">
        <KeyboardLamp />
    </Setting>
    <Setting Name="Play demo notes on the piano" Words="On, Off" Note="@PianoSoundNote">
        <div class="control-row">
            <span class="control-label">Play demo notes on the piano</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.SendToPiano)" @onclick="() => Save(() => Options.SendToPiano = true)"><span class="mu-led"></span>On</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(!Options.SendToPiano)" @onclick="() => Save(() => Options.SendToPiano = false)"><span class="mu-led"></span>Off</button>
        </div>
    </Setting>
    <Setting Name="Piano shortcuts" Words="On, Off" Note="Between runs, press C♯4 to start or continue, or D♯4 to repeat.">
        <div class="control-row">
            <span class="control-label">Piano shortcuts</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.PianoButtons)" @onclick="() => Save(() => Options.PianoButtons = true)"><span class="mu-led"></span>On</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(!Options.PianoButtons)" @onclick="() => Save(() => Options.PianoButtons = false)"><span class="mu-led"></span>Off</button>
        </div>
    </Setting>
    @* Only in a build from the PC, which has a stand-in piano: Prima plays as if a piano were plugged in, and DevTools plays its
       keys. The piano's own still come through. *@
    @if (Services.GetService(typeof(StandInKeyboard)) is StandInKeyboard standIn)
    {
        <Setting Name="Simulated piano" Words="On, Off, test, without the piano, debug" Note="Use a simulated keyboard for testing.">
            <div class="control-row">
                <span class="control-label">Simulated piano</span>
                <button type="button" class="mu-toggle" data-action="stand-in-on" aria-pressed="@On(standIn.On)" @onclick="() => standIn.Plug(true, StandInKeyboard.Called)"><span class="mu-led"></span>On</button>
                <button type="button" class="mu-toggle" data-action="stand-in-off" aria-pressed="@On(!standIn.On)" @onclick="() => standIn.Plug(false)"><span class="mu-led"></span>Off</button>
            </div>
        </Setting>
    }
    <Setting Name="Timing" Words="Calibrate, Redo timing, Not calibrated yet">
        <div class="control-row">
            <span class="control-label">Timing</span>
            <span class="control-value">@(Options.CalibratedOn is { } day ? $"{Options.TimingOffsetMs:+0;−0;0} ms, from {day.ToString("d MMMM", CultureInfo.InvariantCulture)}" : "Not calibrated yet")</span>
            <a class="mu-btn" href="tools/timing">@(Options.CalibratedOn is null ? "Calibrate" : "Redo timing")</a>
        </div>
    </Setting>
</SettingsSection>

<SettingsSection Tab="keyboard" Id="click" Title="Metronome">
    <Setting Name="Play click through" Words="Tablet, On the piano, headphones" Note="Choose Piano to hear the click through piano headphones. Recalibrate timing after changing the output.">
        <div class="control-row">
            <span class="control-label">Play click through</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(!Options.ClickOnPiano)" @onclick="() => Save(() => Options.ClickOnPiano = false)"><span class="mu-led"></span>Tablet</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.ClickOnPiano)" @onclick="() => Save(() => Options.ClickOnPiano = true)"><span class="mu-led"></span>Piano</button>
        </div>
    </Setting>
    @* The click on the piano: Prima's own, sent as sound over the piano's USB cable (the P-225 is a USB audio interface), or one
       of the piano's own sounds over MIDI. Which work depends on the piano and the tablet, so each can be tried by ear. *@
    <Setting Name="Piano click sound" Words="Prima's click, metronome, wood block, piano key, headphones, USB audio, Preview sound" Note="Preview the sound through the piano or its headphones.">
        <div class="control-row">
            <span class="control-label">Piano click sound</span>
            @foreach (var (sound, name) in PianoClicks)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(Options.PianoClick == sound)" @onclick="() => Save(() => Options.PianoClick = sound)"><span class="mu-led"></span>@name</button>
            }
            <button type="button" class="mu-btn" data-action="try-click" disabled="@(!Keyboard.CanSend)" @onclick="TryClick">@(trying ? "Stop" : "Preview sound")</button>
        </div>
    </Setting>
    <Setting Name="Sound" Words="Wood, Beep">
        <div class="control-row">
            <span class="control-label">Sound</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.ClickSound == ClickSoundKind.Wood)" @onclick="() => Save(() => Options.ClickSound = ClickSoundKind.Wood)"><span class="mu-led"></span>Wood</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.ClickSound == ClickSoundKind.Beep)" @onclick="() => Save(() => Options.ClickSound = ClickSoundKind.Beep)"><span class="mu-led"></span>Beep</button>
        </div>
    </Setting>
    <Setting Name="Volume" Words="Click volume, loud">
        <div class="control-row">
            <span class="control-label">Volume</span>
            <input type="range" class="control-range" min="10" max="100" step="5" value="@Options.ClickVolume" aria-label="Click volume" @onchange="e => Save(() => Options.ClickVolume = int.Parse((string)e.Value!, CultureInfo.InvariantCulture))" />
            <span class="control-value">@Options.ClickVolume%</span>
        </div>
    </Setting>
</SettingsSection>

@* Look & music *@
<SettingsSection Tab="look" Id="look" Title="Theme" Note="The theme changes the controls around the sheet music.">
    <Setting Words="@(string.Join(' ', Look.All.Select(l => $"{l.Name} {l.Description}")))">
        <div class="look-picker">
            @foreach (var look in Look.All)
            {
                @* Each choice wears its own look, so it shows what it gives. *@
                <button type="button" class="look-option" data-theme="@look.Id" aria-pressed="@(look == Current ? "true" : "false")" @onclick="() => LookSetting.Choose(look)">
                    <span class="look-option-head"><span class="mu-led"></span><span class="look-option-name">@look.Name</span></span>
                    <span class="look-option-text">@look.Description</span>
                    <span class="look-option-swatches" aria-hidden="true"><span class="sw-ground"></span><span class="sw-screen"></span><span class="sw-accent"></span><span class="sw-sheet"></span></span>
                </button>
            }
        </div>
    </Setting>
    @* Porcelain's and Night's accent: the key to press, where you are, what's lit. Studio and Vinyl have their own. *@
    @if (Current.TakesAccent)
    {
        <Setting Name="Accent" Words="@($"Accent colour color {string.Join(' ', Accent.All.Select(a => a.Name))}")" Note="The key to press, where you are and what's lit, in Porcelain and Night alike.">
            <div class="control-row">
                <span class="control-label">Accent</span>
                @foreach (var accent in Accent.All)
                {
                    <button type="button" class="mu-toggle accent-choice" aria-pressed="@On(accent == LookSetting.CurrentAccent)" @onclick="() => LookSetting.ChooseAccent(accent)"><span class="accent-dot" style="--swatch: @accent.Color"></span>@accent.Name</button>
                }
            </div>
        </Setting>
    }
</SettingsSection>

@* The font and the size, with the two bars that show them, are one setting: a search for either shows both, and the music. *@
<SettingsSection Tab="look" Id="notation" Title="Notation">
    <Setting Words="@($"Notation font, Music font, {string.Join(", ", Fonts)}, Sheet music size, Sheet size, Smaller, Standard, Printed, Larger")">
        <div class="control-row">
            <span class="control-label">Notation font</span>
            @foreach (var font in Fonts)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(Options.MusicFont == font)" @onclick="() => Save(() => Options.MusicFont = font)"><span class="mu-led"></span>@font</button>
            }
        </div>
        <div class="control-row">
            <span class="control-label">Sheet music size</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.SheetSize < 0)" @onclick="() => Save(() => Options.SheetSize = -1)"><span class="mu-led"></span>Smaller</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.SheetSize == 0)" @onclick="() => Save(() => Options.SheetSize = 0)"><span class="mu-led"></span>Standard</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.SheetSize > 0)" @onclick="() => Save(() => Options.SheetSize = 1)"><span class="mu-led"></span>Larger</button>
        </div>
        <Sheet Mei="@Sample" Class="settings-sheet" />
    </Setting>
    <Setting Name="Show lyrics" Words="On, Off" Note="Show the words below the notes.">
        <div class="control-row">
            <span class="control-label">Show lyrics</span>
            <button type="button" class="mu-toggle" aria-pressed="@On(Options.Lyrics)" @onclick="() => Save(() => Options.Lyrics = true)"><span class="mu-led"></span>On</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(!Options.Lyrics)" @onclick="() => Save(() => Options.Lyrics = false)"><span class="mu-led"></span>Off</button>
        </div>
    </Setting>
</SettingsSection>

@* Claude *@
<SettingsSection Tab="claude" Id="claude" Title="Claude" Note="Claude can turn selected PDF pages into sheet music you can play in Prima. Check the notes before saving.">
    <Setting Name="Anthropic API key" Words="@($"Test key, Remove key, Cancel, Import key file, Look for the key file, {keyNote}")" Note="Stored securely on this tablet. Excluded from backups.">
        <div class="control-row">
            <span class="control-label">Anthropic API key</span>
            @if (maskedKey is { } masked)
            {
                <span class="key-figure" aria-label="@($"The key on this tablet, ending {masked[^4..]}")">@masked</span>
                <button type="button" class="mu-btn" disabled="@testing" @onclick="TestKey">@if (testing) { <Busy /><span>Testing</span> } else { <span>Test key</span> }</button>
                @if (removingKey)
                {
                    <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="RemoveKey">Remove key</button>
                    <button type="button" class="mu-btn" @onclick="() => removingKey = false">Cancel</button>
                }
                else
                {
                    <button type="button" class="mu-btn" @onclick="() => (removingKey, keyNote) = (true, null)">Remove…</button>
                }
            }
            else
            {
                <span class="key-figure none">None on this tablet</span>
                <button type="button" class="mu-btn" @onclick="LookForKey">Import key file</button>
            }
        </div>
        @if (removingKey)
        {
            <p class="section-note" role="status">This removes the key from Prima. You can also revoke it in the Claude Console.</p>
        }
        else if (keyNote is { } note)
        {
            <div class="control-row">
                <span class="control-label" aria-hidden="true"></span>
                <p class="mu-status" data-state="@(keyWorks ? "live" : null)" role="status"><span class="mu-led"></span>@note</p>
            </div>
        }
    </Setting>
    @if (maskedKey is null)
    {
        <Setting Name="How to add a key" Words="Claude Console, an API key in the workspace for your apps, monthly spend limit, claude-key.txt, plug the tablet into the PC, adb push, Shift+Delete, Look for the key file">
            <details class="routine-history" open="@finder.Searching">
                <summary>How to add a key</summary>
                <ol class="key-howto">
                    <li>In the Claude Console, make an API key in the workspace for your apps, the one with a monthly spend limit.</li>
                    <li>Save the key alone in a text file named claude-key.txt, anywhere but the repo.</li>
                    <li>
                        Plug the tablet into the PC, open Prima once so its folder is there, and copy the file across:
                        <pre class="key-command">adb push claude-key.txt /sdcard/Android/data/com.saphyiere.prima/files/</pre>
                    </li>
                    <li>Delete the file on the PC with Shift+Delete. Prima takes the key into secure storage the next time it opens, or when you select Import key file, and deletes the copy on the tablet.</li>
                </ol>
            </details>
        </Setting>
    }
    @if (maskedKey is not null || spend.Count > 0)
    {
        <Setting Name="Estimated cost this month" Words="@($"{SpendText()}, cost, spend")" Note="Based on recorded requests. Manage your spending limit in the Claude Console.">
            <div class="control-row control-row-top">
                <span class="control-label">Estimated cost this month</span>
                <div class="spend">
                    <p class="spend-head"><span class="spend-total">@Money(spend.Sum(s => s.Cost))</span><span class="control-note">@SpendText()</span></p>
                    @if (spend.Count > 0)
                    {
                        <table class="spend-ledger">
                            <tbody>
                                @foreach (var line in spend)
                                {
                                    <tr><td>@(line.Title ?? (line.Piece is null ? "Tests and other questions" : "A piece no longer in the Library"))</td><td class="spend-when">@line.Last.ToLocalTime().ToString("d MMM", CultureInfo.InvariantCulture)</td><td class="spend-cost">@Money(line.Cost)</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </Setting>
    }
</SettingsSection>

@* App & data: Updates, your data, and the problems Prima kept. Another section about the data (keeping it in step with the PC, say)
   joins them as a SettingsSection with Tab="app", its Setting holding the words it's found by. *@
<SettingsSection Tab="app" Id="updates" Title="Updates" Note="Prima backs up your data before installing an update.">
    <Setting Name="Installed version" Words="@($"Check, version, Newest, Install, {Updates.Status.Message}")">
        <div class="control-row">
            <span class="control-label">Installed version</span>
            <span class="key-figure">@(Updates.Status.FromPc ? "1.0 · from the PC" : Updates.Status.Installed)</span>
            <button type="button" class="mu-btn" disabled="@UpdateBusy" @onclick="() => Updates.CheckAsync(evenIfRecent: true)">@if (Updates.Status.Step == UpdateStep.Checking) { <Busy /><span>Checking</span> } else { <span>Check</span> }</button>
        </div>
        @if (Updates.Status is { Latest: { } newest, Step: UpdateStep.Available or UpdateStep.Downloading or UpdateStep.Installing or UpdateStep.Failed })
        {
            <div class="control-row control-row-top">
                <span class="control-label">Newest</span>
                <div class="update-release">
                    <p class="update-head"><span class="update-title">@newest.Title</span><span class="control-note">@newest.Published.ToLocalTime().ToString("d MMM", CultureInfo.InvariantCulture) · @Megabytes(newest.Size)</span></p>
                    @if (Changes(newest) is { Count: > 0 } changes)
                    {
                        <ul class="update-changes">
                            @foreach (var change in changes)
                            {
                                <li>@change</li>
                            }
                        </ul>
                    }
                    <button type="button" class="mu-btn mu-primary" data-piano="off" disabled="@UpdateBusy" @onclick="InstallUpdate">@if (Updates.Status.Step == UpdateStep.Downloading) { <Busy /><span>@($"Downloading {(int)(Updates.Status.Progress * 100)}%")</span> } else { <span>Install</span> }</button>
                    @if (Updates.Status.Step == UpdateStep.Downloading)
                    {
                        <div class="mu-meter meter-slim meter-going" aria-hidden="true">
                            @for (var i = 0; i < 20; i++)
                            {
                                <span class="@(i < (int)Math.Round(Updates.Status.Progress * 20) ? "on" : "")"></span>
                            }
                        </div>
                    }
                    @if (Updates.Status.CopyProblem is not null && !UpdateBusy)
                    {
                        <p class="section-note">Prima keeps a copy of your data before each update, and this time it couldn't. Installed without one, there will be nothing to go back to if the update loses anything.</p>
                        <button type="button" class="mu-btn" data-piano="off" @onclick="InstallUpdateWithoutCopy">Install without a copy</button>
                    }
                </div>
            </div>
        }
        @if (Updates.Status.Message is { Length: > 0 } updateNote)
        {
            <div class="control-row">
                <span class="control-label" aria-hidden="true"></span>
                <p class="mu-status" data-state="@(Updates.Status.Step is UpdateStep.UpToDate or UpdateStep.Installing ? "live" : null)" role="status"><span class="mu-led"></span>@updateNote</p>
            </div>
        }
    </Setting>
</SettingsSection>

@* The copies of everything but Claude's key (DataCopies, through the Kit's sync), then the three keys that start afresh: Start over,
   Remove library and Reset settings. Each is asked twice, the key and then the one that does it, under what goes and what stays,
   and keeps a copy of everything first, held in Your data and named for it; when it can't, it says why, and doing it without a
   copy is a key of its own. *@
<SettingsSection Tab="app" Id="data" Title="Your data" Note="Back up your practice history, settings and library.">
    <Setting Name="Last backup" Words="Last copy, Copies kept, Back up now, Restore from a backup, Export everything, backup, backups, a copy, copies, sync, restore, export, zip, Choose a folder, Choose a file, Documents, Prima backups, Claude's key">
        <DataCopies />
    </Setting>
    <Setting Words="@DataKeyWords">
        <div class="control-row data-keys">
            @if (asking is { } key)
            {
                <button type="button" class="mu-btn mu-primary" data-action="confirm-reset" data-piano="off" disabled="@working" @onclick="() => Do(key, keepCopy: true)">@key.Does</button>
                @if (notKept is not null)
                {
                    @* The copy couldn't be kept first (the note says why): going ahead without one is a choice of its own. *@
                    <button type="button" class="mu-btn" data-action="reset-without-backup" data-piano="off" disabled="@working" @onclick="() => Do(key, keepCopy: false)">@key.WithoutCopy</button>
                }
                <button type="button" class="mu-btn" data-action="cancel-reset" disabled="@working" @onclick="() => (asking, notKept) = (null, null)">Cancel</button>
            }
            else
            {
                @foreach (var each in DataKeys)
                {
                    <button type="button" class="mu-btn" data-setting-reset="@each.Name" @onclick="() => (asking, dataNote) = (each, null)">@(each.Label)…</button>
                }
            }
        </div>
        @if (asking is not null || dataNote is not null)
        {
            <p class="section-note data-keys-note" role="status">@(asking is null ? dataNote : notKept is { } why ? $"A copy couldn't be kept first ({why}), so nothing was {asking.Past}." : asking.Says)</p>
        }
    </Setting>
</SettingsSection>

@* What went wrong, newest first, as Prima kept it: a screen that stopped, the page that stopped answering, a job that failed. Each
   opens on what was said in full, to copy and send. *@
<SettingsSection Tab="app" Id="problems" Title="Problems">
    <Setting Words="@($"Copy, Clear, what went wrong, {ProblemLog.FileName}, {string.Join(", ", problems.Select(p => p.Message))}")">
        @if (problems.Count == 0)
        {
            <p class="section-note">Nothing has gone wrong that Prima noticed. If a screen stops, or Prima stops answering taps, what happened is kept here.</p>
        }
        else
        {
            <ul class="problem-list">
                @foreach (var problem in problems)
                {
                    <li>
                        <details class="problem">
                            <summary>
                                <span class="problem-when">@problem.At.ToString("d MMM HH:mm", CultureInfo.InvariantCulture)</span>
                                <span class="problem-level" data-level="@problem.Level">@problem.Level</span>
                                <span class="problem-source">@problem.Short</span>
                                <span class="problem-message">@problem.Message</span>
                            </summary>
                            @if (problem.Detail.Length > 0)
                            {
                                <pre class="problem-detail">@problem.Detail</pre>
                            }
                        </details>
                    </li>
                }
            </ul>
        }
        <div class="control-row">
            @if (problems.Count > 0)
            {
                <button type="button" class="mu-btn" data-piano="off" @onclick="CopyProblems">Copy</button>
                @if (clearingProblems)
                {
                    <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="ClearProblems">Clear them</button>
                    <button type="button" class="mu-btn" @onclick="() => clearingProblems = false">Keep them</button>
                }
                else
                {
                    <button type="button" class="mu-btn" @onclick="() => clearingProblems = true">Clear…</button>
                }
            }
        </div>
        <p class="section-note" role="status">@(problemNote ?? $"Kept in {ProblemFile()} too, which a PC reaches over USB, even when Prima won't open.")</p>
    </Setting>
</SettingsSection>

@* Tools: the glossary, the metronome, the keyboard check and the timing, each a screen of its own (their addresses are as they
   were: a link or the welcome that opened one still does). *@
<SettingsSection Tab="tools" Id="tools" Title="Practice tools">
    <div class="tool-grid">
        <Setting Name="Glossary" Words="Where the notes live, every symbol and word on a sheet of music, what it is, how it's played, how it sounds">
            <a class="tool-card" href="glossary">
                <span class="tool-card-name">Glossary</span>
                <span class="tool-card-text">Look up notes and symbols on sheet music.</span>
            </a>
        </Setting>
        <Setting Name="Metronome" Words="Count-in, click, fade to the count-in only, silence">
            <a class="tool-card" href="tools/metronome">
                <span class="tool-card-name">Metronome</span>
                <span class="tool-card-text">Set a tempo and practice with a click.</span>
            </a>
        </Setting>
        <Setting Name="Keyboard check" Words="@($"Each key you press, velocity, pedals, the whole keyboard, the MIDI path's jitter, {Keyboard.Name}")">
            <a class="tool-card" href="tools/keyboard">
                <span class="tool-card-name">Keyboard check</span>
                <span class="tool-card-text">Check that Prima receives your keys and pedals.</span>
                <span class="tool-card-meta">@(Keyboard.Name is null ? "No keyboard plugged in" : Keyboard.Name)</span>
            </a>
        </Setting>
        <Setting Name="Timing" Words="Calibrate, the delay taken off every note, 16 beats">
            <a class="tool-card" href="tools/timing">
                <span class="tool-card-name">Timing</span>
                <span class="tool-card-text">Measure the delay between your keyboard and the click.</span>
                <span class="tool-card-meta">@(Options.CalibratedOn is { } day ? $"{Options.TimingOffsetMs:+0;−0;0} ms, {day.ToString("d MMM", CultureInfo.InvariantCulture)}" : "Not calibrated yet")</span>
            </a>
        </Setting>
    </div>
</SettingsSection>

</CascadingValue>
</div>

@code {
    [CascadingParameter] public Look Current { get; set; } = Look.Studio;

    /// <summary>The tab open, as the address has it (<see cref="SettingsFinder.Tabs"/>' ids); none, or one there isn't, is the first.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? TabInAddress { get; set; }

    /// <summary>A section a link brings into view as the page opens, by its id: the stopped screen's card's, Problems.</summary>
    [SupplyParameterFromQuery(Name = "section")] public string? SectionInAddress { get; set; }

    private readonly SettingsFinder finder = new();
    // The address as last read, so a change to it is told from anything else that sets the parameters, like the look.
    private string? tabRead;
    private string? sectionRead;
    private string? bringIntoView;
    private bool loaded;

    private string? name;
    private string? cue;
    private string? gradually;
    // Your data's keys: the one being asked, why the copy kept first couldn't be, whether it's at work, and what it did.
    private DataKey? asking;
    private string? notKept;
    private bool working;
    private string? dataNote;
    // Claude: the key on this tablet, masked; a line on what last happened to it (lit when it works); this month's cost by piece.
    private string? maskedKey;
    private string? keyNote;
    private bool keyWorks;
    private bool testing;
    private bool removingKey;
    private List<ClaudeSpend> spend = [];

    // The problems kept, newest first, and the list follows as more are kept; Clear asks first.
    private IReadOnlyList<Problem> problems = [];
    private bool clearingProblems;
    private string? problemNote;

    // Read before the page first draws, so it opens on the address's tab.
    protected override void OnInitialized() => ReadAddress();

    protected override async Task OnInitializedAsync()
    {
        problems = Problems.Recent(12);
        Problems.Kept += ProblemKept;
        // The updater's status is read straight from it, and the page redraws when it changes; it asks GitHub at most once in 20 hours.
        Updates.Changed += Redraw;
        _ = Updates.CheckAsync();
        (name, cue) = (Options.Name, Options.Cue);
        maskedKey = await Keys.GetAsync() is { } key ? AssistKey.Mask(key) : null;
        (keyNote, keyWorks) = KeyFile.Found switch
        {
            { Result: KeyImportResult.Saved } => ($"Key taken in from {AssistKey.FileName}", true),
            { Result: KeyImportResult.NotAKey } wrong => (wrong.Detail, false),
            _ => (maskedKey is null ? $"No {AssistKey.FileName} in Prima's folder yet" : null, false),
        };
        var now = DateTimeOffset.Now;
        spend = await Store.GetClaudeSpendAsync(new DateTimeOffset(now.Year, now.Month, 1, 0, 0, 0, now.Offset));
        loaded = true;
    }

    protected override void OnParametersSet() => ReadAddress();

    // A tab the address names opens (coming back to Settings, or from a link), in place of anything looked for.
    private void ReadAddress()
    {
        if (TabInAddress != tabRead)
        {
            tabRead = TabInAddress;
            (finder.Tab, finder.Query) = (SettingsFinder.TabFor(TabInAddress).Id, "");
        }
        if (SectionInAddress != sectionRead) (sectionRead, bringIntoView) = (SectionInAddress, SectionInAddress);
    }

    // A tab tapped opens and takes the address's place: the way back comes back to it, and doesn't step through the tabs.
    private void Open(string tab)
    {
        finder.Tab = tab;
        Navigation.Replace($"settings?tab={tab}");
    }

    // The section a link asked for, at the top, once what's above it is drawn.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loaded || bringIntoView is not { } section) return;

        bringIntoView = null;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Pages/Settings.razor.js");
            await module.InvokeVoidAsync("show", section);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }

    private string PianoSoundNote => "Play demos and duet parts through the connected piano."
        + (Keyboard.Name is not null && !Keyboard.CanSend ? " This keyboard cannot play notes sent by the tablet." : "");

    private async Task TestKey()
    {
        testing = true;
        var watch = System.Diagnostics.Stopwatch.StartNew();
        var answer = await Claude.TestAsync();
        (testing, keyWorks) = (false, answer.Ok);
        keyNote = answer.Ok ? $"Works: Claude answered in {watch.Elapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture)} s" : answer.Summary;
    }

    private async Task RemoveKey()
    {
        await Keys.RemoveAsync();
        (maskedKey, removingKey, keyNote, keyWorks) = (null, false, "The key is off this tablet.", false);
    }

    private async Task LookForKey()
    {
        var found = await KeyFile.ImportAsync(Keys);
        maskedKey = await Keys.GetAsync() is { } key ? AssistKey.Mask(key) : null;
        (keyNote, keyWorks) = found.Result switch
        {
            KeyImportResult.Saved => ($"Key taken in from {AssistKey.FileName}", true),
            KeyImportResult.NotAKey => (found.Detail, false),
            _ => ($"No {AssistKey.FileName} in Prima's folder yet", false),
        };
    }

    private string SpendText()
    {
        var pieces = spend.Count(s => s.Piece is not null);
        return pieces switch { 0 => "nothing read yet", 1 => "on 1 piece read", _ => $"on {pieces} pieces read" };
    }

    private static string Money(decimal value) => "$" + value.ToString("0.00", CultureInfo.InvariantCulture);

    private bool UpdateBusy => Updates.Status.Step is UpdateStep.Checking or UpdateStep.Downloading or UpdateStep.Installing;

    private void Redraw(UpdateStatus status) => _ = InvokeAsync(StateHasChanged);

    private void ProblemKept(Problem problem) => _ = InvokeAsync(() =>
    {
        problems = Problems.Recent(12);
        StateHasChanged();
    });

    // Where the file is, as a PC sees the tablet's storage (Android/data/…), or else in full.
    private string ProblemFile()
    {
        var path = Problems.Path.Replace('\\', '/');
        var at = path.IndexOf("/Android/data/", StringComparison.Ordinal);
        return at >= 0 ? path[(at + 1)..] : path;
    }

    // Every problem kept, in full, on the clipboard: to paste into a message. The list shows the newest twelve; what's sent is all
    // of them, the file before this one's too.
    private async Task CopyProblems()
    {
        var all = Problems.All();
        var text = string.Join("\n\n", all.Select(p => $"{p.At:yyyy-MM-dd HH:mm:ss zzz} · {p.Level} · {p.Source}\n{p.Message}{(p.Detail.Length > 0 ? "\n" + p.Detail : "")}"));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            problemNote = $"Copied {all.Count} {(all.Count == 1 ? "problem" : "problems")}.";
        }
        catch (JSException)
        {
            problemNote = $"Couldn't copy them: the file is {ProblemFile()}.";
        }
    }

    private void ClearProblems()
    {
        Problems.Clear();
        (problems, clearingProblems, problemNote) = ([], false, "Cleared.");
    }

    public void Dispose()
    {
        Updates.Changed -= Redraw;
        Problems.Kept -= ProblemKept;
        // A click being tried stops with the screen.
        tryingFor?.Cancel();
        if (trying) ClickTrack.Stop();
    }

    private async Task InstallUpdate()
    {
        // What's still to be written goes into the file first, so the copy kept in Downloads has all of it.
        await Store.FlushAsync();
        await Updates.InstallAsync();
    }

    // Asked a second time, after the copy before the update couldn't be made, knowing there'll be nothing to go back to.
    private async Task InstallUpdateWithoutCopy()
    {
        await Store.FlushAsync();
        await Updates.InstallWithoutCopyAsync();
    }

    /// <summary>A release's changes, from the list in its notes, without the app's name each starts with: five, and how many more.</summary>
    private static List<string> Changes(Release release)
    {
        var lines = release.Notes.Split('\n').Select(l => l.Trim()).Where(l => l.StartsWith("- ", StringComparison.Ordinal))
            .Select(l => l[2..].StartsWith("Prima: ", StringComparison.Ordinal) ? l["- Prima: ".Length..] : l[2..])
            .Select(l => l.Length > 0 ? char.ToUpperInvariant(l[0]) + l[1..] : l).ToList();
        return lines.Count <= 6 ? lines : [.. lines.Take(5), $"And {lines.Count - 5} more"];
    }

    private static string Megabytes(long bytes) => (bytes / 1_000_000.0).ToString("0", CultureInfo.InvariantCulture) + " MB";

    private Task SaveProfile() => Save(() => (Options.Name, Options.Cue) = (string.IsNullOrWhiteSpace(name) ? null : name.Trim(), string.IsNullOrWhiteSpace(cue) ? null : cue.Trim()));

    private async Task ChooseMinutes(int minutes)
    {
        var lastWeek = await Store.GetDaysAsync(DateOnly.FromDateTime(DateTime.Now).AddDays(-7));
        gradually = Prima.Core.Practice.DailyPlan.GoGradually(minutes, lastWeek.Sum(d => d.Minutes) / 7);
        await Save(() => Options.DailyMinutes = minutes);
    }

    /// <summary>
    /// One of Your data's keys: its name, which the copy it keeps first is held under; the key that does it once it's asked, and
    /// the one that does it without a copy; the one that leaves things as they are; what it says goes and what stays; and what it
    /// does, said of nothing when its copy couldn't be kept ("so nothing was cleared").
    /// </summary>
    // Name also identifies the protected backup in existing installations.
    private sealed record DataKey(string Name, string Label, string Does, string WithoutCopy, string Says, string Past);

    private const string CopyFirst = "Prima makes a protected backup first.";

    private static readonly DataKey StartingOver = new("Start over", "Clear practice progress", "Clear practice progress", "Clear without a backup",
        "Clears your practice history, levels, streak, routines and saved practice positions. Your library and settings are kept. " + CopyFirst, "cleared");

    private static readonly DataKey RemovingLibrary = new("Remove library", "Remove library", "Remove all pieces", "Remove without a backup",
        "Removes every piece, including imported files, converted scores and excerpts. Your practice records are kept. " + CopyFirst, "removed");

    private static readonly DataKey ResettingSettings = new("Reset settings", "Reset settings", "Reset settings", "Reset without a backup",
        "Restores default settings, including your profile and keyboard calibration. Your library, practice history, API key and backups are kept. " + CopyFirst, "reset");

    private static readonly DataKey[] DataKeys = [StartingOver, RemovingLibrary, ResettingSettings];

    // What they're found by: their names, their keys' words, and what they're about.
    private static readonly string DataKeyWords = string.Join(", ", DataKeys.SelectMany(k => new[] { k.Name, k.Label, k.Does, k.WithoutCopy, "Cancel" }))
        + ", progress, every piece, Prima's own pieces, the welcome, a new install";

    // Does what the key asked does, a copy of everything kept first and held (Your data shows it), unless keeping one failed and the
    // owner asked to go ahead without. Start over and Reset settings then open Prima's welcome, as on its first open.
    private async Task Do(DataKey key, bool keepCopy)
    {
        working = true;
        try
        {
            if (keepCopy) await Sync.KeepAsync(key.Name);
        }
        catch (Exception e)
        {
            // Nothing is done: the note says why, and going ahead without a copy is offered.
            (notKept, working) = (e.Message.TrimEnd('.'), false);
            return;
        }

        if (key == RemovingLibrary)
        {
            var removed = await Store.RemoveLibraryAsync();
            (asking, notKept, working, dataNote) = (null, null, false, removed == 0
                ? "The Library was empty already. Prima won't put its own pieces in by itself now: the Library has a key for that."
                : $"Took {(removed == 1 ? "1 piece" : $"{removed.ToString("N0", CultureInfo.InvariantCulture)} pieces")} out of the Library. Prima won't put its own back by itself: the Library has a key for that. Your runs on them still count.");
            return;
        }

        if (key == StartingOver) await Store.StartOverAsync();
        else
        {
            // Read again, so every screen has them (the look too) as a new install would.
            await Store.ResetSettingsAsync();
            await Store.LoadAsync(Options);
            await LookSetting.ReloadAsync();
        }
        (asking, notKept, working) = (null, null, false);
        Navigation.Open("welcome");
    }

    private static readonly int[] Minutes = [5, 10, 15, 20, 30, 45];

    private static readonly string[] Fonts = ["Leipzig", "Bravura", "Leland"];

    private static readonly (int Seconds, string Label)[] LookChoices = [(10, "10 s"), (20, "20 s"), (30, "30 s"), (0, "Until I start")];

    private static readonly (string Value, string Label)[] ClefChoices = [("both", "Both clefs"), ("treble", "Treble"), ("bass", "Bass")];

    // Two bars of a grand staff, to show the font and size.
    private static readonly string Sample = MeiWriter.Write(SheetSamples.TwoBars());

    private static string On(bool on) => on ? "true" : "false";

    private Task Save(Action change)
    {
        change();
        return Store.SaveAsync(Options);
    }

    private static readonly (PianoClickSound Sound, string Name)[] PianoClicks =
        [(PianoClickSound.Audio, "Prima's click"), (PianoClickSound.MetronomeClick, "Metronome"), (PianoClickSound.WoodBlock, "Wood block"), (PianoClickSound.PianoKey, "Piano key")];

    // Try it: two bars of the click on the piano in the sound chosen, at 96 a minute, in fours; pressed again, it stops.
    private bool trying;
    private CancellationTokenSource? tryingFor;

    private async Task TryClick()
    {
        tryingFor?.Cancel();
        if (trying)
        {
            (trying, tryingFor) = (false, null);
            ClickTrack.Stop();
            return;
        }

        var stop = tryingFor = new CancellationTokenSource();
        trying = true;
        ClickTrack.Start(new ClickPlan(96, 4, 0, ClickStage.Throughout), Options.PianoClick);
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(8 * 60 / 96.0) + TimeSpan.FromMilliseconds(400), stop.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        ClickTrack.Stop();
        trying = false;
    }
}
