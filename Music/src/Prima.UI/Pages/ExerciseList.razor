@page "/exercises"
@inject PrimaStore Store
@inject NavigationManager Nav
@inject Prima.UI.Routines.RoutineService Routines
@using Prima.Core.Generation

<PageTitle>Exercises · Prima</PageTitle>

<PageHead Title="Exercises" Kicker="Technique, a little at a time">
    <div class="control-row">
        <a class="mu-btn mu-primary" data-piano="off" data-action="ask-routine" href="routine/ask">Ask for routine</a>
        <KeyboardLamp />
    </div>
</PageHead>

@* The exercises in two lists: the ones to play at the piano, which it opens on, and the ones to read and do (how you sit, the
   warm-ups, the ways to practise). Each is by section, as rows: an exercise's name, what you do, when it was last done, and its
   tags. A row opens the exercise, or the drill Prima already has for it. My routine is your own list, of both kinds and without
   the sections, and an exercise opened from it leads on to the routine's next. Start here and Not tried are picks of the ones
   to play. The search narrows the list showing, and says when the other of the two lists has what it's after. *@
<div class="control-row library-filters exercise-filters" aria-busy="@(!ready ? "true" : "false")">
    @foreach (var (key, label) in Views)
    {
        <button type="button" class="mu-toggle" aria-pressed="@(view == key ? "true" : "false")" @onclick="() => See(key)"><span class="mu-led"></span>@label</button>
    }
    <input class="text-field text-field-short" type="search" placeholder="Jump, thumb, pedal…" aria-label="Find an exercise" value="@search" @oninput="e => search = e.Value?.ToString()" />
</div>

@if (view == "routine")
{
    <section class="settings-section" aria-label="Personalised routine">
        @if (activeRoutine is not null)
        {
            <a class="piece-row" data-piano="off" data-action="open-active-routine" href="routine">
                <span class="piece-title">@activeRoutine.Title</span>
                <span class="piece-meta">@activeRoutine.Summary</span>
                <span class="piece-tags"><span class="piece-tag">@activeRoutine.Items.Sum(i => i.Recipe.Minutes) min</span><span class="piece-tag">Today’s default</span></span>
            </a>
        }
        else
        {
            <a class="mu-btn" data-piano="off" href="routine">Routine requests and proposals</a>
        }
        @if (routine.Count > 0) { <h2 class="section-title">Saved exercises</h2> }
    </section>
}

@{
    var shown = Exercises.All.Where(Shown).ToList();
    var bySection = Exercises.Sections.Select(s => (Section: (ExerciseSection?)s, Rows: shown.Where(e => e.Section == s.Key).ToList()));
    List<(ExerciseSection? Section, List<Exercise> Rows)> groups = view == "routine" ? [(null, shown)] : [.. bySection];
    // What the search finds in the other of the two lists.
    var elsewhere = view is "play" or "read" && search is { Length: > 0 } ? Exercises.All.Count(e => e.ToPlay != (view == "play") && Exercises.Matches(e, search)) : 0;
}
@if (elsewhere > 0)
{
    <div class="control-row">
        <button type="button" class="mu-btn" @onclick="@(() => See(view == "play" ? "read" : "play"))">@elsewhere to @(view == "play" ? "read" : "play") @(elsewhere == 1 ? "matches" : "match") “@search”</button>
    </div>
}
@if (view == "routine" && routine.Count == 0)
{
    <p class="section-note">Nothing in your routine yet. Open an exercise and turn on In my routine to keep it here.</p>
}
else if (shown.Count == 0)
{
    <p class="page-note">Nothing here@(search is { Length: > 0 } ? $" for “{search}”" : "").</p>
}

@foreach (var (section, rows) in groups.Where(g => g.Rows.Count > 0))
{
    <section class="settings-section" aria-label="@(section?.Name ?? "My routine")">
        @if (section is not null)
        {
            <h2 class="section-title">@section.Name</h2>
            <p class="section-note">@section.About</p>
        }
        <ul class="piece-list exercise-list">
            @foreach (var exercise in rows)
            {
                var was = Done(exercise);
                <li>
                    <a class="piece-row" href="@(exercise.Route ?? $"exercises/{exercise.Id}{(view == "routine" ? "?from=routine" : "")}")">
                        <span class="piece-title">@exercise.Name</span>
                        <span class="piece-meta">@exercise.Does</span>
                        @if (exercise.Kind != ExerciseKind.Way)
                        {
                            <span class="exercise-done @(was is null ? "" : was.Last == Today ? "today" : "before")">@(was is null ? "Not tried" : was.Last == Today ? "Today" : was.Last.ToString("d MMM", CultureInfo.InvariantCulture))</span>
                        }
                        <span class="piece-tags">
                            @if (view != "routine" && routine.Contains(exercise.Id)) { <span class="piece-tag exercise-tag-routine">Routine</span> }
                            @if (view == "routine" && !exercise.ToPlay) { <span class="piece-tag">To read</span> }
                            @if (exercise.Kind == ExerciseKind.Drill) { <span class="piece-tag">Drill</span> }
                            @if (exercise.Kind == ExerciseKind.Played && exercise.Level == ExerciseLevel.Start) { <span class="piece-tag">Start here</span> }
                            @if (exercise.Level == ExerciseLevel.Intermediate) { <span class="piece-tag">Later</span> }
                            @if (was is { Days: > 1 }) { <span class="piece-tag">@was.Days days</span> }
                        </span>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    // The lists: the two kinds of exercise, then your own, and two picks of the ones to play.
    private static readonly (string Key, string Label)[] Views = [("play", "To play"), ("read", "To read"), ("routine", "My routine"), ("start", "Start here"), ("new", "Not tried")];

    /// <summary>The list showing ("read", "routine", "start", "new"; the ones to play otherwise). It's in the address, so coming back from an exercise comes back to it.</summary>
    [SupplyParameterFromQuery(Name = "show")] public string? Show { get; set; }

    // The kind a drill's attempts are kept under, by its route.
    private static readonly Dictionary<string, string> DrillKinds = new() { ["drills/scales"] = "scale", ["drills/arpeggios"] = "arpeggio", ["drills/independence"] = "independence" };

    private List<DoneRecord> done = [];
    private HashSet<string> routine = [];
    private string view = "play";
    private string? search;
    private Prima.UI.Routines.RoutineDefinition? activeRoutine;
    private bool ready;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        done = await Store.GetDoneAsync("exercise", [.. DrillKinds.Values]);
        routine = [.. await Store.GetTrackAsync<List<string>>("exercise-routine") ?? []];
        activeRoutine = await Routines.ActiveAsync();
        ready = true;
    }

    protected override void OnParametersSet() => view = Views.Any(v => v.Key == Show) ? Show! : "play";

    // Changes the list showing, in place of the one in the address, so the way back still leaves the exercises.
    private void See(string list) => Nav.NavigateTo(list == "play" ? "exercises" : $"exercises?show={list}", replace: true);

    // When an exercise was done: its own attempts, or for a drill every scale, arpeggio or pattern played in it.
    private DoneRecord? Done(Exercise exercise)
    {
        var kind = exercise.Route is { } route ? DrillKinds[route] : "exercise";
        return done.FirstOrDefault(d => d.Kind == kind && (exercise.Route is not null || d.SetId == exercise.Id));
    }

    private bool Shown(Exercise exercise) => Exercises.Matches(exercise, search) && view switch
    {
        "read" => !exercise.ToPlay,
        "routine" => routine.Contains(exercise.Id),
        "start" => exercise.Kind == ExerciseKind.Played && exercise.Level == ExerciseLevel.Start,
        "new" => exercise.ToPlay && Done(exercise) is null,
        _ => exercise.ToPlay,
    };
}
