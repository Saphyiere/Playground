@page "/exercises"
@inject PrimaStore Store
@inject NavigationManager Nav
@inject AppNavigation Navigation
@inject Prima.UI.Routines.RoutineService Routines
@using Prima.Core.Generation
@using Prima.UI.Routines

<PageTitle>@(Heading().Title) · Exercises · Prima</PageTitle>

@* The exercises and the drills as one catalogue, laid out as the Library is: its lists down the left (the ones to start with, not
   tried yet and played lately, then every type, what each trains, or each level), and what's chosen beside them as cards. A
   card shows what an exercise is before a word is read, its shape (how its notes move), with its name, a tag or two and when
   it was last done; it opens the exercise, or the drill, and its + puts it in one of your routines. The drills are a type of
   their own: new every time, each moving you on a step as you get it right. The search looks in every name and word. *@
<div class="lib ex-lib">
    <header class="page-head">
        <div>
            <p class="page-kicker">@($"{Exercises.All.Count} exercises · {Exercises.All.Count(e => e.Kind == ExerciseKind.Drill)} drills")</p>
            <h1 class="page-title">Exercises</h1>
        </div>
        <div class="head-tools">
            <input class="text-field head-search" type="search" placeholder="Find one: trill, pedal…" aria-label="Find an exercise" value="@search" @oninput="e => search = e.Value?.ToString()" />
            <a class="mu-btn" data-piano="off" data-action="new-routine" href="routines?new=1">New routine</a>
        </div>
    </header>
    @if (note is not null)
    {
        <p class="control-note" role="status">@note</p>
    }

    <div class="lib-cols">
        <nav class="lib-col lib-list" aria-label="The exercises' lists" aria-busy="@(ready ? "false" : "true")">
            @foreach (var (key, label) in Picks)
            {
                <a class="col-item" href="@Address(show: key)" aria-current="@Current(show: key)"><span>@label</span><span class="n">@Picked(key).Count()</span></a>
            }
            <a class="col-item" href="@Address(show: "hanon")" aria-current="@Current("hanon")"><span>Hanon</span><span class="n">@Hanon.All.Count</span></a>
            <p class="col-title">Catalogue · @Exercises.All.Count</p>
            <p class="col-by">
                @foreach (var (key, label) in Lists)
                {
                    <a href="@Address(by: key)" aria-current="@(ListShown == key ? "true" : null)" @onclick="@(() => See(by: key))" @onclick:preventDefault>@label</a>
                }
            </p>
            @if (ListShown == "trains")
            {
                @foreach (var focus in ExerciseFocus.All)
                {
                    <a class="col-item" href="@Address(by: "trains", trains: focus.Key)" aria-current="@(Trains == focus.Key && Search is null ? "true" : null)"><span>@focus.Name</span><span class="n">@Exercises.All.Count(e => ExerciseFocus.Trains(e.Id, focus.Key))</span></a>
                }
            }
            else if (ListShown == "levels")
            {
                @foreach (var (level, name) in Levels)
                {
                    <a class="col-item" href="@Address(by: "levels", level: LevelKey(level))" aria-current="@(Level == LevelKey(level) && Search is null ? "true" : null)"><span>@name</span><span class="n">@Exercises.All.Count(e => e.ToPlay && e.Level == level)</span></a>
                }
            }
            else
            {
                @foreach (var section in Exercises.Sections.Where(s => ToPlay(s)))
                {
                    <a class="col-item" href="@Address(type: section.Key)" aria-current="@(Type == section.Key && Search is null ? "true" : null)"><span>@Short(section)</span><span class="n">@InType(section.Key).Count()</span></a>
                }
                <p class="col-title">To read · @Exercises.All.Count(e => !e.ToPlay)</p>
                @foreach (var section in Exercises.Sections.Where(s => !ToPlay(s)))
                {
                    <a class="col-item" href="@Address(type: section.Key)" aria-current="@(Type == section.Key && Search is null ? "true" : null)"><span>@Short(section)</span><span class="n">@InType(section.Key).Count()</span></a>
                }
            }
        </nav>

        <div class="lib-main">
            @{
                var (title, about) = Heading();
                var shown = Shown().ToList();
            }
            <div class="lib-main-head">
                <div>
                    <h2 class="col-head">@title</h2>
                    <p class="col-sub">@(shown.Count == 1 ? "1" : $"{shown.Count}") · @about</p>
                </div>
            </div>
            @if (Current("hanon") is not null)
            {
                <div class="control-row">
                    @if (focusRoutine is not null)
                    {
                        <a class="mu-btn" data-piano="off" href="@($"routines/{focusRoutine}")">Hanon Focus</a>
                    }
                    <a class="mu-btn" data-piano="off" href="routines/hanon/keys">Through the Keys</a>
                    <a class="mu-btn" data-piano="off" href="routines/hanon/book">Complete Hanon</a>
                </div>
            }
            @* Keyed by the list shown, so another list's cards arrive whole. *@
            <div class="lib-col" data-keep="exercises" data-at="@($"{Show} {Type} {Trains} {Level}")" @key="@($"{Show} {Type} {Trains} {Level}")">
                @if (shown.Count == 0)
                {
                    <p class="page-note">@(Search is { } words ? $"No exercises match “{words}”." : "No exercises in this section.")</p>
                }
                @foreach (var group in shown.GroupBy(e => Current("hanon") is null ? "" : e.HanonNumber <= 20 ? "Part I · 1–20" : e.HanonNumber <= 43 ? "Part II · 21–43" : "Part III · 44–60"))
                {
                    @if (group.Key.Length > 0) { <h3 class="col-title">@group.Key</h3> }
                    <div class="ex-cards">
                    @foreach (var exercise in group)
                    {
                        var was = Done(exercise);
                        <div class="ex-card-at">
                        <a class="ex-card" href="@(exercise.Route ?? $"exercises/{exercise.Id}")" data-exercise="@exercise.Id">
                            @if (exercise.ToPlay)
                            {
                                <ExerciseShape Exercise="exercise" Label="@($"How {exercise.Name} goes")" />
                            }
                            else
                            {
                                <span class="ex-shape ex-shape-read" aria-hidden="true">@Short(Exercises.Sections.First(s => s.Key == exercise.Section))</span>
                            }
                            <span class="ex-card-name">@exercise.Name</span>
                            <span class="ex-card-meta">
                                <span class="ex-card-tags">
                                    @foreach (var tag in Tags(exercise))
                                    {
                                        <span class="piece-tag">@tag</span>
                                    }
                                </span>
                                @if (exercise.Kind != ExerciseKind.Way)
                                {
                                    <span class="exercise-done @(was is null ? "" : was.Last == Today ? "today" : "before")">@(was is null ? "Not tried" : was.Last == Today ? "Today" : was.Last.ToString("d MMM", CultureInfo.InvariantCulture))</span>
                                }
                            </span>
                        </a>
                        @if (OwnRoutines.CanHave(exercise))
                        {
                            <button type="button" class="ex-add" aria-pressed="@(InARoutine(exercise) ? "true" : "false")" aria-label="@($"Put {exercise.Name} in one of your routines")" @onclick="e => adding = (exercise, e.ClientX, e.ClientY)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            </button>
                        }
                        </div>
                    }
                </div>
                }
            </div>
        </div>
    </div>
</div>

<RoutineMenu Exercise="adding?.Exercise" X="@(adding?.X ?? 0)" Y="@(adding?.Y ?? 0)" OnClose="() => adding = null" OnSaid="said => note = said" OnChanged="Mine" />

@code {
    // The lists at the top of the left column, before the catalogue's: picks of the ones to play.
    private static readonly (string Key, string Label)[] Picks = [("start", "Start here"), ("new", "Not tried yet"), ("lately", "Played lately")];

    // What the catalogue is listed by, as the Library lists by composers, kinds or levels.
    private static readonly (string Key, string Label)[] Lists = [("types", "Types"), ("trains", "Trains"), ("levels", "Levels")];

    private static readonly (ExerciseLevel Level, string Name)[] Levels = [(ExerciseLevel.Start, "First weeks"), (ExerciseLevel.Beginner, "Beginner"), (ExerciseLevel.Intermediate, "Later")];

    /// <summary>A pick shown ("start", "new", "lately"): the ones to start with when nothing else is chosen.</summary>
    [SupplyParameterFromQuery(Name = "show")] public string? Show { get; set; }

    /// <summary>A type shown, by its section's key ("drills", "broken").</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }

    /// <summary>What they train, by a focus's key ("strength", "wrist").</summary>
    [SupplyParameterFromQuery(Name = "trains")] public string? Trains { get; set; }

    /// <summary>A level: "start", "beginner" or "later".</summary>
    [SupplyParameterFromQuery(Name = "level")] public string? Level { get; set; }

    /// <summary>What the left column lists: "types", "trains" or "levels".</summary>
    [SupplyParameterFromQuery(Name = "by")] public string? By { get; set; }

    private List<DoneRecord> done = [];
    // What's in your routines, each as its kind and id there; the exercise whose + was tapped, and where; and what was done.
    private HashSet<(string Kind, string Target)> mine = [];
    private (Exercise Exercise, double X, double Y)? adding;
    private string? note;
    private string? focusRoutine;
    private string? search;
    private bool ready;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    // The words looked for, when there are any.
    private string? Search => string.IsNullOrWhiteSpace(search) ? null : search.Trim();

    private string ListShown => By is "trains" or "levels" ? By : Trains is not null ? "trains" : Level is not null ? "levels" : "types";

    protected override async Task OnInitializedAsync()
    {
        // What an exercise's or a drill's way back says.
        Navigation.Name("Exercises");
        done = await Store.GetDoneAsync("exercise", [.. Exercises.All.Where(e => e.Route is not null).Select(e => KindOf(e.Route!))]);
        var own = (await Routines.RoutinesAsync()).Where(r => r.Own).ToList();
        focusRoutine = own.FirstOrDefault(r => r.StandardKey == "hanon-focus")?.Revision;
        Mine(own);
        ready = true;
    }

    private void Mine(IReadOnlyList<RoutineDefinition> own) => mine = [.. own.SelectMany(r => r.Items).Select(i => (i.Recipe.Kind, i.Recipe.TargetId))];

    private bool InARoutine(Exercise exercise) => mine.Contains(OwnRoutines.Of(exercise));

    // Each drill's attempts are kept under its own kind: the route's last part, but a scale's and an arpeggio's by one of them.
    private static string KindOf(string route) => route.Split('/')[^1] switch
    {
        "scales" => "scale",
        "arpeggios" => "arpeggio",
        var key => key,
    };

    private static bool ToPlay(ExerciseSection section) => Exercises.All.Any(e => e.Section == section.Key && e.ToPlay);

    // A type's name in the list: its section's, to its first comma or "and" where it's long ("Broken chords and left-hand patterns").
    private static string Short(ExerciseSection section) => section.Key switch
    {
        "arm" => "Arm and wrist",
        "five" => "Five fingers",
        "broken" => "Broken chords",
        "chords" => "Chords",
        "hands" => "Two hands",
        "touch" => "Touch",
        "setup" => "Sitting",
        "warm" => "Warm-ups",
        "ways" => "Ways to practice",
        _ => section.Name,
    };

    // A type's exercises: the drills every drill, wherever its section is; any other its section's.
    private static IEnumerable<Exercise> InType(string type) => type == "drills" ? Exercises.All.Where(e => e.Kind == ExerciseKind.Drill) : Exercises.All.Where(e => e.Section == type);

    private static string LevelKey(ExerciseLevel level) => level switch { ExerciseLevel.Start => "start", ExerciseLevel.Intermediate => "later", _ => "beginner" };

    private IEnumerable<Exercise> Picked(string pick) => pick switch
    {
        "new" => Exercises.All.Where(e => e.ToPlay && Done(e) is null),
        "lately" => Exercises.All.Select(e => (Exercise: e, Done: Done(e))).Where(x => x.Done is { } d && d.Last >= Today.AddDays(-30)).OrderByDescending(x => x.Done!.Last).Select(x => x.Exercise),
        _ => Exercises.All.Where(e => e.ToPlay && e.Level == ExerciseLevel.Start),
    };

    // What's shown beside the lists: what was searched for, or the type, focus or level chosen, or a pick. A pick or a type keeps
    // its own order; the rest go by type, as the catalogue lists the types, a family with its type's others.
    private IEnumerable<Exercise> Shown() =>
        Search is { } words ? ByType(Exercises.All.Where(e => Exercises.Matches(e, words)))
        : Type is { } type ? InType(type)
        : Trains is { } trains ? ByType(Exercises.All.Where(e => ExerciseFocus.Trains(e.Id, trains)))
        : Level is { } level ? ByType(Exercises.All.Where(e => e.ToPlay && LevelKey(e.Level) == level))
        : Show is "lately" ? Picked("lately")
        : Show is "hanon" ? Hanon.All
        : ByType(Picked(Show ?? "start"));

    private static IEnumerable<Exercise> ByType(IEnumerable<Exercise> exercises) =>
        exercises.Select((e, i) => (e, i)).OrderBy(x => Exercises.Sections.ToList().FindIndex(s => s.Key == x.e.Section)).ThenBy(x => x.i).Select(x => x.e);

    private (string Title, string About) Heading() =>
        Search is { } words ? ($"Found for “{words}”", "in every name and word")
        : Type is { } type && Exercises.Sections.FirstOrDefault(s => s.Key == type) is { } section ? (Short(section), section.About)
        : Trains is { } trains && ExerciseFocus.All.FirstOrDefault(f => f.Key == trains) is { } focus ? (focus.Name, focus.About)
        : Level is { } level ? (Levels.First(l => LevelKey(l.Level) == level).Name, level == "start" ? "The ones for the first weeks" : level == "later" ? "For when the basics are easy" : "The heart of it")
        : (Show ?? "start") switch
        {
            "new" => ("Not tried yet", "to play, not played yet"),
            "lately" => ("Played lately", "the last month's, the latest first"),
            "hanon" => ("Hanon", "The Virtuoso Pianist in 60 Exercises"),
            _ => ("Start here", "the ones for the first weeks"),
        };

    // Its tags: a drill, a family with variations, the first weeks' or for later, and one to read. Its + is lit while it's in a
    // routine of yours.
    private IEnumerable<string> Tags(Exercise exercise)
    {
        if (exercise.Kind == ExerciseKind.Drill) yield return "Drill";
        if (ExerciseFamilies.Of(exercise.Id) is not null) yield return "Variations";
        if (!exercise.ToPlay) yield return "To read";
        else if (exercise.Level == ExerciseLevel.Intermediate) yield return "Later";
    }

    // When an exercise was done: its own attempts, or a drill's under its kind.
    private DoneRecord? Done(Exercise exercise) => exercise.Route is { } route
        ? done.FirstOrDefault(d => d.Kind == KindOf(route))
        : done.FirstOrDefault(d => d.Kind == "exercise" && d.SetId == exercise.Id);

    private string? Current(string show) => Search is null && Type is null && Trains is null && Level is null && (Show ?? "start") == show ? "true" : null;

    // The address of a list: a pick, a type, a focus or a level, with the left column's listing kept.
    private string Address(string? show = null, string? type = null, string? trains = null, string? level = null, string? by = null)
    {
        var listed = by ?? (By is "trains" or "levels" ? By : null);
        var parts = new[] { show is null or "start" ? null : $"show={show}", type is null ? null : $"type={Uri.EscapeDataString(type)}", trains is null ? null : $"trains={Uri.EscapeDataString(trains)}", level is null ? null : $"level={level}", listed is null or "types" ? null : $"by={listed}" };
        var query = string.Join('&', parts.Where(p => p is not null));
        // Listing by something else keeps what's shown beside it.
        if (by is not null && show is null && type is null && trains is null && level is null)
        {
            query = string.Join('&', new[] { Show is null ? null : $"show={Show}", Type is null ? null : $"type={Uri.EscapeDataString(Type)}", Trains is null ? null : $"trains={Uri.EscapeDataString(Trains)}", Level is null ? null : $"level={Level}", by == "types" ? null : $"by={by}" }.Where(p => p is not null));
        }
        return query.Length == 0 ? "exercises" : $"exercises?{query}";
    }

    // The left column listed another way, in place of the address shown, so the way back still leaves the exercises.
    private void See(string by) => Nav.NavigateTo(Address(by: by), replace: true);
}
