    // Full screen: the piece alone, the tablet's own bars hidden too; the same button, or leaving the piece, brings them back.
    private async Task ToggleFullScreen()
    {
        fullScreen = !fullScreen;
        await ShowFullScreen();
    }

    // The page as full screen should be, once it can be (with turns.js loaded; until then, as the page next draws). The page
    // changes first, then the tablet's own bars, so the rail goes as the key is pressed.
    private async Task ShowFullScreen()
    {
        if (turns is null || shownFull == fullScreen) return;

        shownFull = fullScreen;
        await Full.SetAsync(fullScreen);
    }


    private async Task SetTempo(double bpm)
    {
        tempo = Math.Clamp(bpm, 20, 240);
        await Store.SetPieceAsync(Id, tempo: tempo);
    }


    // Where the piece is: a PDF's page and how far down it; a notation piece's page, the bar it's to start from, its loop's
    // last bar, and the first bar on the screen.
    private Task SavePosition()
    {
        var place = new Dictionary<string, double> { ["page"] = page, ["y"] = y };
        if (score is not null) place["from"] = from;
        if (loopTo is { } to) place["to"] = to;
        if (seen is { } bar) place["bar"] = bar;
        return Store.SetPieceAsync(Id, position: JsonSerializer.Serialize(place));
    }

    // ——— Playing a notation piece ———

    private int FirstBar => score?.Bars[0].Number ?? 1;

    private int LastBar => score?.Bars[^1].Number ?? 1;

    // From a bar to the end, through the repeats as they're played; or in a loop, its bars again and again (fifty times: until
    // stopped), each time round a pass the play bar scores, with any repeat printed inside the loop played each time round
    // (Score.LoopOrder). The run counts from that bar's downbeat, or from bar 1's for the opening pickup, which comes in the
    // count-in's last beats. Bars are numbered in order, so a bar's index is its number on from the first's. Play along gives
    // the piano the other hand's notes.
    private void StartAt(int bar)
    {
        if (score is null || !barStarts.ContainsKey(bar)) return;

        from = bar;
        if (loopTo is { } to) loopTo = Math.Max(to, bar);
        music = MusicOf(bar, loopTo);
        wholeLoop = music?.LoopBars is not null ? music : null;
        cueBar = null;
    }

    // The music from a bar, for the hand chosen (and the other hand's for the piano, with play along): to the end, or round a loop
    // to its last bar, as many times round as asked (fifty unless said, or one where a loop waits after each pass).
    private PlayMusic? MusicOf(int bar, int? last, int? times = null)
    {
        if (score is null || !barStarts.TryGetValue(bar, out var start)) return null;

        var first = bar - FirstBar;
        var loop = last is { } end ? score.LoopOrder(first, end - FirstBar) : null;
        var passes = times ?? (stage == Stage.Practice && Settings.PassWaits ? 1 : 50);
        IReadOnlyList<int> order = loop is null ? score.PlayOrder(first) : [.. Enumerable.Repeat(loop, passes).SelectMany(r => r)];
        var notes = score.Performed(order);
        var beatZero = Math.Max(0, start);
        double Beats(long ticks) => ticks / (double)score.Meter.BeatTicks;
        var otherHand = playAlong && handStaff is { } staff ? notes.Where(n => n.Staff != staff) : null;
        var other = otherHand?.Select(n => (n.Midi, Beats(n.Tick - beatZero), Beats(n.Sounds))).ToList();
        return new PlayMusic(score, notes.Where(n => handStaff is null || n.Staff == handStaff).ToArray(), beatZero) { PianoPart = other, Order = order, LoopBars = loop?.Count };
    }

    private void Seek(int bar)
    {
        if (wholeLoop is not null && loopTo is { } end)
        {
            var cue = Math.Clamp(bar, from, end);
            if (cueBar == cue) return;
            music = wholeLoop.EnterLoopAt(cue);
            cueBar = music.EntryIndex == 0 ? from : cue;
        }
        else if (music is null || from != bar) StartAt(bar);
    }

    // The start key's words: what it plays, and from where ("Loop bars 13–16", "Play from bar 9"). The hand is the bar's.
    private string StartLabel
    {
        get
        {
            if (loopTo is { } to)
            {
                // Word joiners keep the bars' numbers together where the key's words take two lines.
                var range = $"{from}\u2060–\u2060{to}";
                if (cueBar is { } entry && entry != from) return $"Loop {range} from bar {entry}";
                return to == from ? $"Loop bar {from}" : $"Loop bars {range}";
            }
            return from > FirstBar ? $"Play from bar {from}" : "Play";
        }
    }

    private void SetLoop(int? last)
    {
        loopTo = last is { } to ? Math.Clamp(to, from, LastBar) : null;
        StartAt(from);
    }

    private void SetPlayAlong(bool on)
    {
        playAlong = on;
        StartAt(from);
    }

    // Back moves one bar within the selection. A tapped bar restarts in the same playing or listening mode.
    private Task Back(int bar) => Restart(Math.Max(loopTo is null ? FirstBar : from, bar - 1));

    private async Task Restart(int bar)
    {
        if (play is null) return;

        Seek(bar);
        if (music is null) return;

        restarting = true;
        try { await play.Restart(music); }
        finally { restarting = false; }
    }

    private string HandsKey => $"Library.Hands.{Id}";

    private string? HandName => handStaff switch { 1 => "right", 2 => "left", _ => null };

    // The hands on the bar, and the staff they play: the upper's the right hand, the lower's the left, both none.
    private static Prima.Core.Generation.HandUse HandOf(int? staff) => staff switch { 1 => Prima.Core.Generation.HandUse.Right, 2 => Prima.Core.Generation.HandUse.Left, _ => Prima.Core.Generation.HandUse.Together };

    private static int? StaffOf(Prima.Core.Generation.HandUse hand) => hand switch { Prima.Core.Generation.HandUse.Right => 1, Prima.Core.Generation.HandUse.Left => 2, _ => null };

    // Loop on the bar, as the chosen bar's tab has it: on, it loops the bar chosen (the first, when none is), which a tap on another
    // bar or a handle then stretches; off, the loop goes and its first bar stays chosen to start from.
    private void LoopOnBar(bool on) => SetLoop(on ? from : null);

    private static readonly Prima.Core.Generation.HandUse[] AllHands = [Prima.Core.Generation.HandUse.Right, Prima.Core.Generation.HandUse.Left, Prima.Core.Generation.HandUse.Together];

    private async Task SetHands(int? staff)
    {
        handStaff = staff;
        StartAt(from);
        await Store.SetSettingAsync(HandsKey, HandName);
    }

    // A tap inside a loop cues that bar. At rest a tap outside extends the loop, and its handles resize it.
    [JSInvokable]
    public async Task Chose(int bar)
    {
        if (stage == Stage.Review)
        {
            await PickBar(bar);
            return;
        }
        if (stage != Stage.Practice) return;
        if (playing)
        {
            await Restart(bar);
            return;
        }

        if (loopTo is { } last)
        {
            if (bar < from) StartAt(bar);
            else if (bar > last) SetLoop(bar);
            else Seek(bar);
        }
        else
        {
            chosen = true;
            StartAt(bar);
        }

        if (view == View.Pages && sheet is not null && MeasureOf(bar) is { } id && await sheet.PageOf(id) is > 0 and var on && on != page)
        {
            page = on;
            await SavePosition();
        }
        StateHasChanged();
    }

    // A loop dragged out on the strip, or one of its ends dragged there or on the music: its first bar to its last.
    [JSInvokable]
    public void Looped(int first, int last)
    {
        if (playing) return;

        loopTo = last;
        StartAt(first);
        StateHasChanged();
    }

    // The key on the chosen bar's tab: Loop loops that bar, which taps or a handle then stretch or trim; × takes the loop away.
    [JSInvokable]
    public void Loop(bool on)
    {
        SetLoop(on ? from : null);
        StateHasChanged();
    }

    // Clear the selected start/loop without changing the visible page or scrolling away from the music being read.
    [JSInvokable]
    public void ClearSelection()
    {
        if (playing || stage != Stage.Practice) return;
        chosen = false;
        loopTo = null;
        StartAt(FirstBar);
        StateHasChanged();
    }

    // The piece's bars by their MEI ids, in order (the bars are numbered in order too), for taps on the sheet and for bars.js.
    private List<string> MeasureIds()
    {
        meiDocument ??= mei is null ? null : XDocument.Parse(mei);
        return measureIds ??= meiDocument?.Descendants().Where(e => e.Name.LocalName == "measure").Select(m => (string?)m.Attribute(XNamespace.Xml + "id") ?? "").ToList() ?? [];
    }

    private int? BarOf(string measureId)
    {
        var index = MeasureIds().IndexOf(measureId);
        return score is not null && index >= 0 && index < score.Bars.Count ? score.Bars[index].Number : null;
    }

    private string? MeasureOf(int bar)
    {
        var index = bar - FirstBar;
        return index >= 0 && index < MeasureIds().Count ? MeasureIds()[index] : null;
    }

    // The run plays in the scrolling view, a line at a time: for the run, so a piece kept in Pages opens in Pages the next time.
    private async Task Starting()
    {
        // The same go when it's moved to another bar or counted in again after a slip: its time carries on.
        var same = restarting || play?.Continuing == true;
        NewGo(same);
        (playing, outcome, started, about, explain, explained) = (true, null, same ? started : DateTime.Now, false, false, null);
        if (stage == Stage.Practice) clock?.RunStarted(DateTimeOffset.Now);
        if (stage == Stage.Play) played = null;
        if (view == View.Scroll) return;

        repainted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        view = View.Scroll;
        StateHasChanged();
        await Task.WhenAny(repainted.Task, Task.Delay(4000));
    }

    private async Task Finished(PlayOutcome how)
    {
        // A go slips cut: its parts and its end as one run.
        how = await WholeGo(how);
        // How the run before went, for under this one's figure: runs, not a loop's times round; on a page just opened, the session's
        // last one kept.
        if (how is { Loop: null, InTime: { Expected: > 0 } timed })
        {
            if (lastFigure is null && session is not null)
            {
                lastFigure = (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run)
                    .Where(r => r.Session == session.Id && r.InTime && r.Passes.Count == 0 && r.RightInTime is not null).OrderBy(r => r.At).LastOrDefault()?.RightInTime;
            }
            (previousFigure, lastFigure) = (lastFigure, timed.InTimeAccuracy);
        }
        (playing, outcome) = (false, how);
        if (stage == Stage.Practice) clock?.RunEnded(DateTimeOffset.Now);
        if (stage == Stage.Play) played = how;
        // Stopped before a key that could be judged (in the count-in, or with nothing played): there's no run to keep.
        var kept = how is not { InTime: null, Wait: null or { Notes: 0 } };
        if (kept) await Keep(how);
        if (stage != Stage.Practice) return;

        // A loop waiting after each pass: this pass with those before it, for the bar and the summary (each pass is kept as its own
        // run all the same).
        (int, int?, int?, PlayMode)? loopKey = how.Loop is { } round && Settings.PassWaits ? (round.From, round.To, handStaff, how.Mode) : null;
        if (loopKey is null || loopKey != waitedLoop) (waitedLoop, waited) = (loopKey, []);
        waited.AddRange(how.Passes);
        if (waited.Count > 1) outcome = how with { Passes = [.. waited] };

        // Practice: finishing once the run's kept, if that's what stopped it; then what shows after a run, as Settings say, and
        // whether it goes again by itself.
        if (finishAfterRun)
        {
            finishAfterRun = false;
            await FinishPractice();
        }
        else if (Settings.AfterRun == "review" && kept)
        {
            reviewed = [.. (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).Where(r => r.Id == lastRun)];
            review = SessionReview.Of(reviewed, LastBar);
            await OpenReview(Stage.Practice);
        }
        else if (Settings.AfterRun == "nothing")
        {
            outcome = null;
            if (!Settings.LiveMarks && sheet is not null) await sheet.ClearMarks();
        }
        if (stage == Stage.Practice && Settings.RunAgain && !how.Stopped && (how.Loop is null || !Settings.PassWaits)) startAfterRender = true;
        // The loop, or the bar to look at, in view again, if the summary or the run has left it off the screen.
        else if (stage == Stage.Practice) revealBars = loopTo is { } to ? (from, to) : how.InTime?.WorstBar is { } worst ? (worst, worst) : null;
    }

    // A run kept: how it went, the practice session it was played in (or that it was Play's), what went wrong in each bar (and
    // in each pass round a loop), and the marks it left on the music, for the look back and the in-depth review.
    private async Task Keep(PlayOutcome how)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var (right, notes, clean) = KeptRun.Figures(how);
        var measures = KeptRun.Measures(how, RunFrom(), RunHands(), stage == Stage.Practice ? session?.Id : null, stage == Stage.Play, expected.ToDictionary(n => n.Id, n => n.Bar), (DateTime.Now - started).TotalSeconds);
        lastRun = await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, today, "piece", how.Mode == PlayMode.InTime ? "in time" : "wait", Id, piece!.Level, how.Mode == PlayMode.InTime ? tempo : null, null, null, KeptRun.Keys(how), null, measures, notes == 0 ? null : right / (double)notes, clean, null));
        // Practice's minutes are its clock's, counted as it goes; Play's are its run's.
        if (stage != Stage.Practice) await Store.AddMinutesAsync(today, (DateTime.Now - started).TotalMinutes);
        latestRun = (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).MaxBy(r => (r.At, r.Id));
    }

    // Play's run is the whole piece, both hands, whatever bar and hand Practice has chosen.
    private int RunFrom() => stage == Stage.Play ? FirstBar : from;

    private string RunHands() => stage == Stage.Play ? "both" : HandName ?? "both";

    // ——— A practice session ———

    // Practice: a session starts on the piece, its clock with it, and the page is the piece's with all its tools.
    private async Task StartPractice()
    {
        var now = DateTimeOffset.Now;
        var way = Settings.Way ?? "custom";
        var id = await Store.StartSessionAsync(Id, way, now);
        (session, clock, counted, covered, ticks, stage) = (new PracticeSession(id, Id, now, TimeSpan.Zero, TimeSpan.Zero, false, now, way, null), new PracticeClock(now), TimeSpan.Zero, false, 0, Stage.Practice);
        StartAt(from);
        if (!fullScreen) await ToggleFullScreen();
    }

    // Each second the strip counts: the session kept every half minute, and the page covered as it pauses (or uncovered as a key
    // carries it on).
    private async Task Ticked()
    {
        if (clock is null) return;

        if (clock.Paused != covered)
        {
            covered = clock.Paused;
            await KeepSession();
            StateHasChanged();
        }
        else if (++ticks % 30 == 0) await KeepSession();
    }

    // The session's clock kept as it stands, and the playing time since it was last kept added to the day's minutes. Once it's
    // finished it stays finished, unless it's carried on from its look back.
    private async Task KeepSession(DateTimeOffset? finished = null, bool reopen = false)
    {
        if (session is null || clock is null) return;

        var ended = reopen ? null : finished ?? session.Finished;
        session = session with { Playing = clock.Playing, Idle = clock.Idle, Paused = clock.Paused, LastPlayed = clock.LastPlayed, Finished = ended };
        await Store.SaveSessionAsync(session, reopen);
        var more = clock.Playing - counted;
        counted = clock.Playing;
        if (more > TimeSpan.Zero) await Store.AddMinutesAsync(DateOnly.FromDateTime(DateTime.Now), more.TotalMinutes);
    }

    // Keep practicing, on the pause's cover: the clocks count again from now.
    private async Task KeepPracticing()
    {
        clock?.Resume(DateTimeOffset.Now);
        covered = false;
        await KeepSession();
    }

    // Finish practice: the session ends now, or from its pause as of the last thing played, and its look back takes the page. A
    // run going stops first, and is kept with the session.
    private async Task FinishPractice()
    {
        if (session is null || clock is null) return;
        if (playing && play is not null)
        {
            finishAfterRun = true;
            await play.Stop();
            return;
        }

        var now = DateTimeOffset.Now;
        var end = clock.Paused ? clock.LastPlayed : now;
        clock.Pause(now);
        await KeepSession(end);
        await ShowLookBack();
    }

    // The look back: the session's runs summed up and put in words.
    private async Task ShowLookBack()
    {
        if (session is null) return;

        reviewed = [.. (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).Where(r => r.Session == session.Id).OrderBy(r => r.At)];
        review = SessionReview.Of(reviewed, LastBar);
        // Finished while Print showed a PDF's print: the notation back, for the look back to take the page (the print's would).
        if (print) await TogglePrint();
        (stage, outcome, picked) = (Stage.LookBack, null, null);
        if (fullScreen) await ToggleFullScreen();
    }

    // Keep practicing, from the look back: the same session carries on.
    // The look back's Practice it: Next's bars looped at its tempo (or, with nothing to fix, the piece a notch faster), In time,
    // and the session carried on.
    private async Task PracticeIt(((int From, int To)? Bars, double? Tempo) next)
    {
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        (picked, played, outcome) = (null, null, null);
        if (next.Bars is { } bars && barStarts.ContainsKey(bars.From))
        {
            chosen = bars.From > FirstBar;
            StartAt(bars.From);
            SetLoop(bars.To);
        }
        else
        {
            (loopTo, chosen) = (null, false);
            StartAt(FirstBar);
        }
        if (next.Tempo is { } at) await SetTempo(at);
        await Store.SetSettingAsync(PlayAlong.ModeKeyOf("library"), "time");
        if (session is not null) await CarryOn();
    }

    private async Task CarryOn()
    {
        clock?.Resume(DateTimeOffset.Now);
        (stage, covered) = (Stage.Practice, false);
        await KeepSession(reopen: true);
        StartAt(from);
        if (!fullScreen) await ToggleFullScreen();
    }

    // Done: back to the piece's front, the session over.
    private async Task Done()
    {
        (stage, session, clock, review, reviewed, picked, outcome) = (Stage.Front, null, null, null, [], null, null);
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        if (fullScreen) await ToggleFullScreen();
    }

    private async Task BackToLookBack()
    {
        (stage, picked) = (Stage.LookBack, null);
        if (fullScreen) await ToggleFullScreen();
    }

    // The in-depth review of the runs gone over, taking the screen: the bar still hard at the end picked to start with, as the
    // look back names it, or else the bar put right, or else the bar with most to fix.
    private async Task OpenReview(Stage from, int? requestedBar = null)
    {
        (reviewFrom, stage, marksKept) = (from, Stage.Review, await Store.GetRunMarksAsync([.. reviewed.Select(r => r.Id)]));
        if (!fullScreen) await ToggleFullScreen();
        StateHasChanged();
        var first = requestedBar ?? review?.Hard?.Bar ?? review?.Fixed?.Bar ?? review?.Bars.Values.OrderByDescending(b => b.Weight).ThenBy(b => b.Bar).FirstOrDefault()?.Bar;
        if (first is { } bar) await PickBar(bar);
    }

    // A bar picked in the in-depth review (its cell, or the bar tapped on the music): its music as it was last played there, with
    // the marks the latest run that played it left on its notes, outlined and in view.
    private async Task PickBar(int bar)
    {
        picked = bar;
        if (sheet is null) return;

        var marks = KeptRun.MarksForBar(bar, expected, reviewed, marksKept);
        await sheet.ShowMarks(marks);
        await sheet.Outline(MeasureOf(bar));
    }

    private string ReviewKicker() => reviewFrom switch
    {
        Stage.LookBack when session is not null => $"Practiced · {session.Started.LocalDateTime.ToString("dddd d MMMM", CultureInfo.InvariantCulture)} · {PracticeStrip.Said(session.Playing)} playing",
        Stage.Play => $"Played through · {DateTime.Now.ToString("dddd d MMMM", CultureInfo.InvariantCulture)} · at {tempo:0}",
        _ => reviewed is [var run] ? $"{PieceWords.How(run)} · {DateTime.Now.ToString("dddd d MMMM", CultureInfo.InvariantCulture)}" : "",
    };

    // The piece's bars by number, in order.
    private List<int> BarNumbers() => score is null ? [] : [.. score.Bars.Select(b => b.Number)];

    // Back from the in-depth review to Play or Practice, and the run again if asked; or else back to practicing with the run's
    // marks on the music again, all of them, not just the bar the review showed last.
    private async Task Return(Stage to, bool again)
    {
        (stage, picked, startAfterRender) = (to, null, again);
        if (sheet is not null) await sheet.Outline(null);
        if (to == Stage.Practice && !fullScreen) await ToggleFullScreen();
        if (to == Stage.Practice) StartAt(from);
        if (to == Stage.Practice && !again && outcome is not null && sheet is not null) await sheet.ShowMarks(outcome.Marks);
    }

    // Finish practice from a run's review: as if back to practicing first (the review's outline gone, the run's marks back on the
    // music), then finished.
    private async Task FinishFromReview()
    {
        await Return(Stage.Practice, again: false);
        await FinishPractice();
    }

    // Practice a bar, from Play's quick review, the look back or the in-depth review: the bar looped with a bar either side, the
    // session carried on (or, from Play, one started), the music as it was before the review.
    private async Task PracticeBar(int bar)
    {
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        (from, loopTo, picked, played, outcome) = (Math.Max(FirstBar, bar - 1), Math.Min(LastBar, bar + 1), null, null, null);
        if (session is not null) await CarryOn();
        else await StartPractice();
    }

    // The way of practicing, or whether a loop waits after each pass, chosen on the piece's Options: kept in Settings, for every piece.
    private async Task UseWay(string way)
    {
        Settings.UseWay(way);
        await Store.SaveAsync(Settings);
        StartAt(from);
    }

    private async Task SetPassWaits(bool waits)
    {
        Settings.PassWaits = waits;
        await Store.SaveAsync(Settings);
        StartAt(from);
    }

    // The page out of sight (the tablet asleep, the app put away): the session pauses, as if the piece had been left.
    [JSInvokable]
    public async Task Hidden()
    {
        if (clock is null || stage != Stage.Practice || playing) return;

        clock.Pause(DateTimeOffset.Now);
        covered = true;
        await KeepSession();
        StateHasChanged();
    }

    // Listen ended: its time was playing time. Finish practice pressed while it played finishes the session now, as it does once
    // a run it stopped is kept (Listen keeps nothing), not after the next run.
    private async Task Listened()
    {
        playing = false;
        if (stage == Stage.Practice) clock?.RunEnded(DateTimeOffset.Now);
        if (finishAfterRun)
        {
            finishAfterRun = false;
            await FinishPractice();
        }
    }

    // ——— Play ———

    // Play: the piece through from its first bar, both hands, In time, full screen.
    private async Task OpenPlay()
    {
        if (score is null) return;

        var order = score.PlayOrder();
        playMusic = new PlayMusic(score, score.Performed(order)) { Order = order };
        (stage, played, outcome) = (Stage.Play, null, null);
        if (sheet is not null) await sheet.ClearMarks();
        if (!fullScreen) await ToggleFullScreen();
    }

    private async Task LeavePlay()
    {
        (stage, played, picked) = (Stage.Front, null, null);
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        if (fullScreen) await ToggleFullScreen();
    }

    private Task PlayAgain() => play?.Start() ?? Task.CompletedTask;

    // Play's run gone over in the in-depth review.
    private async Task ReviewPlay()
    {
        reviewed = [.. (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).Where(r => r.Id == lastRun && r.Play)];
        if (reviewed.Count == 0) return;

        review = SessionReview.Of(reviewed, LastBar);
        await OpenReview(Stage.Play);
    }

    // ——— A PDF piece ———

    // The pages whose systems are found so far, while a PDF opened for the first time has them found; null once they all are.
    private int? found;

    private async Task Opened(IReadOnlyList<double> shapes)
    {
        ratios = shapes;
        if (pdf is null) return;

        // Its first page shows first. Then, the first time it's opened, each page's systems are found behind it and kept.
        pages = shapes.Count;
        await ShowPdf();
        if (pdfLayout.Pages.Count != shapes.Count) await FindSystems(pdf, shapes.Count);
    }

    // Each page's systems, found once and kept: staff lines, five to a staff, paired into grand staves. A page at a time, behind
    // the page that's showing, the bar saying which are still to come; kept only once every page's are found, so a piece left
    // meanwhile has them found afresh the next time.
    private async Task FindSystems(PdfPages document, int count)
    {
        var all = new List<List<PageSystem>>();
        for (var n = 1; n <= count; n++)
        {
            found = n - 1;
            StateHasChanged();
            var rows = await document.Profile(n);
            // The piece left, or its pages put away: a page gone has no rows to give. Nothing is kept, nor said any more.
            if (gone || !ReferenceEquals(pdf, document) || rows.Length == 0)
            {
                found = null;
                if (!gone) StateHasChanged();
                return;
            }
            all.Add([.. PdfLayout.FindSystems(rows)]);
        }
        var systems = all.Sum(p => p.Count);
        var barsPerSystem = midi is { Bars: > 0 } && systems > 0 ? Math.Max(1, (int)Math.Round(midi.Bars / (double)systems)) : 4;
        pdfLayout = pdfLayout with { Pages = [.. all.Select(p => p.Select(s => s with { Bars = barsPerSystem }).ToList())] };
        found = null;
        await SaveLayout();
        StateHasChanged();
    }

    // The bar's note while a PDF's systems are being found: the pages still to come.
    private string? PagesNote() => found is not { } done || done >= pages ? null : done + 1 == pages ? $"Page {pages} still coming" : $"Pages {done + 1} to {pages} still coming";

    private Task SaveLayout() => Store.SetPieceAsync(Id, layout: JsonSerializer.Serialize(pdfLayout, PrimaStore.Json));

    // Portrait shows a page at a time, whole; landscape a window down the pages, moved a screen of systems at a time.
    private double frameHeight;
    private double frameWidth;

    private async Task Measure()
    {
        if (turns is null) return;

        var box = await turns.InvokeAsync<double[]>("size", frame);
        (frameWidth, frameHeight) = (box[0], box[1]);
    }

    private async Task ShowPdf()
    {
        if (pdf is null || ratios.Count == 0 || readingNotes) return;
        if (turns is null) { redrawPdf = true; return; }

        await Measure();
        if (readingNotes || frameWidth <= 0 || frameHeight <= 0) return;
        var fit = view == View.Pages && frameHeight >= frameWidth / ratios.Min();
        var portraitFit = view == View.Pages && frameWidth < frameHeight;
        drawnWidth = await pdf.PageWidth(portraitFit || fit);
        if (portraitFit || fit) y = PageTop(Math.Clamp(page, 1, pages));
        var (cover, shown) = half is { } h ? HalfSplit(h - 1) : (0, 0);
        await pdf.Show(y, 0, portraitFit || fit, half, cover, shown);
        await pdf.Band(null);
        // Its first page is drawn: the paper has stopped waiting.
        if (!painted)
        {
            painted = true;
            StateHasChanged();
        }
    }

    private double PageHeight(int n) => drawnWidth / ratios[n - 1];

    private double PageTop(int n) => Enumerable.Range(1, n - 1).Sum(PageHeight);

    private double Scale => drawnWidth / 900;

    // Every system down the pages, in px at the drawn width, with its bars.
    private List<(int Page, double Top, double Bottom, int Bars)> Systems() => [.. pdfLayout.Pages.SelectMany((systems, i) => systems.Select(s => (i + 1, PageTop(i + 1) + s.Top * Scale, PageTop(i + 1) + s.Bottom * Scale, s.Bars)))];

    // A half-page turn from page current to the next, in px as drawn (the systems were found on pages drawn 900 wide).
    private (double Cover, double Shown) HalfSplit(int current)
    {
        if (current < 1 || current >= pdfLayout.Pages.Count) return (PageHeight(Math.Max(1, current)) / 2, PageHeight(Math.Max(1, current)) / 2);

        var (cover, shown) = PdfLayout.HalfTurn(pdfLayout.Pages[current - 1], 900 / ratios[current - 1], pdfLayout.Pages[current]);
        return (cover * Scale, shown * Scale);
    }

    private async Task TurnPdf(int by)
    {
        if (pdf is null || ratios.Count == 0) return;

        await Measure();
        var whole = view == View.Pages && frameWidth < frameHeight;
        if (whole)
        {
            // Half-page turns: on, the next page's top shows over this one's bottom; on again, the next page whole.
            if (by > 0 && halfTurns && half is null && page < pages) half = page + 1;
            else if (by > 0 && page < pages) (page, half) = (page + 1, null);
            else if (by < 0 && half is not null) half = null;
            else if (by < 0 && page > 1) page--;
            await ShowPdf();
            return;
        }

        // A window down the pages: on to the first system that isn't wholly in sight, or back by a screen.
        var systems = Systems();
        var total = PageTop(pages) + PageHeight(pages);
        if (by > 0) y = systems.FirstOrDefault(s => s.Bottom > y + frameHeight - 4).Top is var top && top > y ? top - 12 : Math.Min(total - frameHeight, y + frameHeight * 0.8);
        else y = systems.LastOrDefault(s => s.Top < y - frameHeight * 0.6).Top is var back && back < y ? Math.Max(0, back - 12) : Math.Max(0, y - frameHeight * 0.8);
        y = Math.Clamp(y, 0, Math.Max(0, total - frameHeight / 2));
        page = systems.LastOrDefault(s => s.Top <= y + frameHeight / 3).Page is > 0 and var p ? p : page;
        await pdf.Show(y, 300);
    }

    private async Task ToggleHalf()
    {
        halfTurns = !halfTurns;
        half = null;
        await ShowPdf();
    }

    private async Task SetBeats(int beats)
    {
        pdfLayout = pdfLayout with { BeatsPerBar = Math.Clamp(beats, 1, 12) };
        await SaveLayout();
    }

    private async Task SetBarsPerSystem(int by)
    {
        pdfLayout = pdfLayout with { Pages = [.. pdfLayout.Pages.Select(p => p.Select(s => s with { Bars = Math.Clamp(s.Bars + by, 1, 12) }).ToList())] };
        await SaveLayout();
    }

    private string BarsPerSystemText()
    {
        var counts = pdfLayout.Pages.SelectMany(p => p.Select(s => s.Bars)).Distinct().ToList();
        return counts.Count == 0 ? "4 bars" : counts.Count == 1 ? $"{counts[0]} {(counts[0] == 1 ? "bar" : "bars")}" : $"{counts.Min()}–{counts.Max()} bars";
    }

    // ——— Scrolling a PDF at the tempo ———

    private int CurrentSystem()
    {
        var systems = Systems();
        return Math.Max(0, systems.FindLastIndex(s => s.Top <= y + frameHeight / 3 + 1));
    }

    private int scrollSystem = -1;

    private async Task ToggleScroll()
    {
        if (scrolling)
        {
            StopScroll();
            await pdf!.Band(null);
            return;
        }

        var systems = Systems();
        if (systems.Count == 0) return;

        await Measure();
        scrolling = true;
        scrollSystem = -1;
        // A bar of count-in on the click, then the music; the click goes quiet after the count-in.
        Click.Start(new ClickPlan(tempo, pdfLayout.BeatsPerBar, 1, ClickStage.CountInOnly));
        ticker = new Timer(_ => InvokeAsync(ScrollOn), null, 0, 100);
    }

    private async Task ScrollOn()
    {
        if (!scrolling || pdf is null || Click.Plan is null) return;

        var systems = Systems();
        var beat = (Clock.NowNs - Click.BeatTime(0)) / (double)Click.Plan.BeatNs - Click.Plan.FirstMusicBeat;
        if (beat < 0) return;

        // Which system the music is in: each lasts its bars × beats a bar.
        var elapsed = 0.0;
        var index = 0;
        while (index < systems.Count && elapsed + systems[index].Bars * pdfLayout.BeatsPerBar <= beat) elapsed += systems[index++].Bars * pdfLayout.BeatsPerBar;
        if (index >= systems.Count)
        {
            StopScroll();
            await pdf.Band(null);
            StateHasChanged();
            return;
        }
        if (index == scrollSystem) return;

        scrollSystem = index;
        var system = systems[index];
        y = Math.Max(0, system.Top - frameHeight / 3);
        page = system.Page;
        await pdf.Show(y, 400);
        await pdf.Band(system.Top, system.Bottom);
        StateHasChanged();
    }

    private void StopScroll()
    {
        if (!scrolling) return;

        scrolling = false;
        ticker?.Dispose();
        ticker = null;
        Click.Stop();
    }

    // ——— Hearing a PDF's MIDI on the piano, on Prima's channel ———

    private void ToggleHear()
    {
        if (hearing)
        {
            Keyboard.Silence();
            hearing = false;
            return;
        }
        if (midi is null) return;

        var start = Clock.NowNs + 300_000_000;
        var speed = tempo / midi.Bpm;
        foreach (var note in midi.Notes)
        {
            Keyboard.Send([0x9F, (byte)note.Midi, (byte)Math.Clamp(note.Velocity, 1, 127)], start + (long)(note.Start / speed * 1e9));
            Keyboard.Send([0x8F, (byte)note.Midi, 0], start + (long)(note.End / speed * 1e9));
        }
        hearing = true;
    }

    // Out of the Library with its excerpts and readings, and the files a PDF that isn't Prima's own keeps beside the imports; one of
    // Prima's own, or a collection's, stays out. Back to the list it was opened from, as it was left, which says what went and can
    // put it back (Undo); the Library's home, when it wasn't opened from one.
    private async Task Remove()
    {
        Place.Removed = await Store.RemovePieceAsync(Id);
        await Navigation.ReturnToAsync("library");
    }

    // The page has gone: what it was still doing behind the screen stops.
    private bool gone;

    public async ValueTask DisposeAsync()
    {
        gone = true;
        Keyboard.Received -= Heard;
        // Leaving the piece pauses its session, to carry on or finish when it's opened again.
        if (clock is not null && session is { Finished: null } && stage == Stage.Practice)
        {
            clock.Pause(DateTimeOffset.Now);
            await KeepSession();
        }
        ticker?.Dispose();
        StopScroll();
        if (hearing) Keyboard.Silence();
        if (shownFull) await Full.SetAsync(false);
        try
        {
            if (keys is not null) await keys.InvokeVoidAsync("dispose");
            if (turns is not null) await turns.DisposeAsync();
            if (bars is not null)
            {
                await bars.InvokeVoidAsync("forget", frame);
                await bars.DisposeAsync();
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
        self?.Dispose();
    }
}
