@page "/library/{Id}"
@implements IAsyncDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject ILibraryBundle Bundle
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AppNavigation Navigation
@inject Prima.UI.Library.LibraryPlace Place
@inject Prima.UI.Practice.FullScreen Full
@inject ILogger<Piece> Logger
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using System.Xml.Linq
@using Prima.UI.Glossary
@using Prima.Core.Library
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>@(piece?.Title ?? "Piece") · Prima</PageTitle>

@if (piece is null)
{
    <PageHead Title="Library" Kicker="@(missing ? "Not in the Library" : "Opening…")" Back="@WayBack" OnBack="Leave" />
}
else
{
    @* It fits the screen, only the music scrolling, top to bottom as every screen that plays music is: the head, the music, a
       run's review under it, the play bar, and the foot, with the piece's bars and a session's clocks. The front has About this
       piece under the music; the look back is as long as it needs, and scrolls; so is the page while a PDF's notes are being
       read. *@
    <div class="piece @(readingNotes || stage == Stage.LookBack ? "" : "piece-fit") @(playing ? "piece-playing" : "") @(outcome is not null && stage == Stage.Practice && Settings.AfterRun == "summary" ? "piece-summed" : "") @(Pdf ? "piece-print" : $"piece-{stage.ToString().ToLowerInvariant()}")">
        @{
            var plays = !readingNotes && (Pdf || stage is Stage.Practice or Stage.Play);
        }
        @* The head every screen has: the way back by the name of where it goes (the list the piece was opened from, or the
           Library), the composer and the title; About (its words, in the music's place) where it plays, full screen's key in
           Practice and on a PDF, and the piano's lamp. *@
        <PageHead Title="@piece.Title" Kicker="@Kicker()" Class="full-hide piece-head" Back="@WayBack" OnBack="Leave"
                  OnAbout="@(plays ? EventCallback.Factory.Create(this, ToggleAbout) : default)" AboutOpen="about"
                  FullScreen="@(!readingNotes && (Pdf || stage == Stage.Practice))" OnFullScreen="ToggleFullScreen" Lamp="true" />

        @{
            // The piece's own key in More's group for its music: its print, for a PDF whose notes are read.
            RenderFragment printKey = @<text>
                @if (piece.IsPdf && mei is not null)
                {
                    <div class="control-row">
                        <span class="control-label">Show</span>
                        <button type="button" class="mu-toggle" data-piano="off" data-show="notation" aria-pressed="@On(!print)" disabled="@playing" @onclick="() => print ? TogglePrint() : Task.CompletedTask"><span class="mu-led"></span>The notation</button>
                        <button type="button" class="mu-toggle" data-piano="off" data-show="print" aria-pressed="@On(print)" disabled="@playing" @onclick="() => print ? Task.CompletedTask : TogglePrint()"><span class="mu-led"></span>The print</button>
                    </div>
                }
            </text>;
            // The page turns, first in the bar where the music is in pages: ‹, the page, ›.
            RenderFragment pageTurns = @<div class="page-turns" role="group" aria-label="Pages">
                <button type="button" class="mu-btn" data-piano="off" aria-label="Back a page" @onclick="() => Turn(-1)">‹</button>
                <div class="mu-readout"><span class="mu-readout-label">@(Pdf && view == View.Scroll ? "System" : "Page")</span><span class="mu-readout-value">@PlaceText()</span></div>
                <button type="button" class="mu-btn" data-piano="off" aria-label="On a page" @onclick="() => Turn(1)">›</button>
            </div>;
            // Full screen's way to finish the session: Finish practice first in the bar, away from Play and the run's keys, doing
            // what the foot's does (the look back, out of full screen). Only a tap presses it, and no clocks go with it: full screen
            // is for the music.
            RenderFragment finishInFull = @<text>
                @if (fullScreen && stage == Stage.Practice && clock is not null)
                {
                    <button type="button" class="mu-btn piece-finish" data-piano="off" @onclick="FinishPractice">Finish practice</button>
                }
            </text>;
            // About this piece: what's been done of it, its level, where it's from; on its front under the music, with the keys that
            // read a PDF again or take it out of the Library, and where it plays in the music's place, by About in its head.
            RenderFragment<bool> aboutPiece = keys => @<text>
                <ul class="summary-words">
                    @* The latest recorded run, including short practice attempts. *@
                    @if (latestRun is { } last)
                    {
                        var today = DateOnly.FromDateTime(DateTime.Now);
                        <li>Last practiced @PieceWords.When(last.Day, today) · @PieceWords.How(last)</li>
                    }
                    @if (piece.Reasons is { Length: > 0 } reasons)
                    {
                        <li>Level @piece.Level for @reasons@(piece.TypicalLevel < piece.Level ? $"; most of it reads at {piece.TypicalLevel}" : "").</li>
                    }
                    else if (piece.IsPdf && mei is null && piece.Level is { } anchor)
                    {
                        <li>About level @anchor, where its collection sits. Its notes aren't read yet: Convert to notation, on its bar.</li>
                    }
                    @if (listing is { } listed)
                    {
                        <li>@listed.Sentence</li>
                    }
                    @if (mei is not null && reading is { Kept: { } kept } && JsonSerializer.Deserialize<ReadingDraft>(reading.Result, Playground.AI.Assist.AssistSchema.Json) is { } read)
                    {
                        <li>Its notes were read from the PDF by Claude on @kept.ToLocalTime().ToString("d MMMM", CultureInfo.InvariantCulture), for @("$" + read.Cost.ToString("0.00", CultureInfo.InvariantCulture))@(read.Doubts.Count == 0 ? "" : $"; bar{(read.Doubts.Select(d => d.Bar).Distinct().Count() == 1 ? "" : "s")} {string.Join(", ", read.Doubts.Select(d => d.Bar).Distinct().Order())} {(read.Doubts.Select(d => d.Bar).Distinct().Count() == 1 ? "was" : "were")} still in doubt when kept").</li>
                    }
                    @if (piece.Credit is { Length: > 0 } credit)
                    {
                        <li>@credit @if (piece.LicenceUrl is { Length: > 0 }) { <a href="@piece.LicenceUrl" target="_blank" rel="noopener">@piece.Licence</a> } @if (piece.SourceUrl is { Length: > 0 }) { <span> · </span><a href="@piece.SourceUrl" target="_blank" rel="noopener">Source</a> }</li>
                    }
                    else if (piece.Imported)
                    {
                        // The file as it was named: a PDF is kept under a name of Prima's own, and one imported before its name was
                        // kept says only when.
                        var file = piece.Source ?? (piece.IsPdf ? null : piece.File);
                        <li>Imported @piece.Added.ToLocalTime().ToString("d MMMM", CultureInfo.InvariantCulture)@(file is null ? "" : $" from {file}").</li>
                    }
                </ul>
                @if (keys)
                {
                    <div class="control-row">
                        @if (piece.IsPdf && mei is not null && pdfBytes is not null && !readingNotes)
                        {
                            <button type="button" class="mu-btn" data-piano="off" @onclick="ReadTheNotes">Convert PDF again</button>
                        }
                        @if (removing)
                        {
                            <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="Remove">Remove it</button>
                            <button type="button" class="mu-btn" @onclick="() => removing = false">Keep it</button>
                        }
                        else
                        {
                            <button type="button" class="mu-btn" @onclick="() => removing = true">Remove from the Library…</button>
                        }
                    </div>
                    @* One of Prima's own goes as an import does, and stays out: Prima doesn't put it back by itself. A collection's too. *@
                    @if (removing && piece.Origin == "bundle")
                    {
                        <p class="section-note" role="status">One of Prima's own pieces: it stays out of the Library, and Prima won't put it back by itself (the Library has a key that puts Prima's own back). Your runs on it still count.</p>
                    }
                    else if (removing && piece.Origin == "collection")
                    {
                        <p class="section-note" role="status">From your collection: it stays out of the Library, even when the collection is imported again (the Library has a key that lets it back in). Your runs on it still count.</p>
                    }
                }
            </text>;
        }
        @if (readingNotes)
        {
        }
        else if (Pdf)
        {
        }
        else if (stage == Stage.Front)
        {
            @* The piece's front: its level, and Practice or Play, which only a tap starts. *@
            <section class="reading-bar piece-bar piece-front-bar" aria-label="The piece">
                <div class="mu-readout piece-level"><span class="mu-readout-label">Level</span><span class="mu-readout-value">@LevelText()</span></div>
                @if (piece.Bars is { } count)
                {
                    <div class="mu-readout"><span class="mu-readout-label">Bars</span><span class="mu-readout-value">@count</span></div>
                }
                @* How its music's drawing stands, while it isn't all there; stopped part-way, the key that draws the rest. *@
                @if (BarNote() is { } note)
                {
                    <p class="bar-note" role="status">@note</p>
                }
                @if (drawing is { Drawing: SheetDrawing.Stopped })
                {
                    <button type="button" class="mu-btn bar-note-key" data-piano="off" @onclick="DrawTheRest">Draw the rest</button>
                }
                @* Its keys are off until there's music on the paper to play from: its first lines are enough. *@
                <div class="piece-actions">
                    <button type="button" class="mu-btn mu-primary piece-key" data-piano="off" disabled="@(!Playable)" @onclick="StartPractice">Practice</button>
                    <button type="button" class="mu-btn piece-key" data-piano="off" disabled="@(!Playable)" @onclick="OpenPlay">Play through</button>
                    <a class="mu-btn piece-key" data-piano="off" href="@($"library/{Uri.EscapeDataString(Id)}/history")">Practice history</a>
                </div>
            </section>
        }
        else if (stage == Stage.LookBack && session is not null && review is not null)
        {
            <LookBack Session="session" Review="review" Runs="reviewed" OnKeep="CarryOn" OnReview="() => OpenReview(Stage.LookBack)" OnViewBar="bar => OpenReview(Stage.LookBack, bar)" OnDone="Done"
                      FirstBar="FirstBar" LastBar="LastBar" OnPractice="PracticeIt" />
        }
        else if (stage == Stage.Review && review is not null)
        {
            <DeepReview Kicker="@ReviewKicker()" Title="@piece.Title" Session="@(reviewFrom == Stage.LookBack ? session : null)" Runs="reviewed" PassNumber="@(reviewFrom == Stage.Practice ? waited.Count : 0)" Review="review" Bars="BarNumbers()" Picked="picked" OnPick="PickBar" />
        }

        @* About this piece covers the music, which stays drawn beneath (hidden, not removed, so it needn't be engraved again). While
           a piece plays it scrolls in its frame, the line being played kept in the frame's upper third (data-follow). *@
        <div class="piece-stage @(readingNotes || stage == Stage.LookBack ? "piece-stage-gone" : "")">
            <div class="piece-frame @(Pdf ? "pdf-frame" : "sheet-frame") @(view == View.Scroll && !Pdf ? "piece-frame-scroll" : "") @(about ? "piece-frame-hidden" : "")" @ref="frame"
                 data-follow="@(view == View.Scroll && !Pdf ? "" : null)" @onpointerdown="Down" @onpointerup="Up">
                @if (Pdf)
                {
                    @if (pdfBytes is not null)
                    {
                        <PdfPages @ref="pdf" Data="pdfBytes" Class="piece-pdf" OnOpened="Opened" />
                    }
                    @* Until its first page is drawn, the paper waits as a sheet's does. *@
                    @if (!painted)
                    {
                        <div class="sheet sheet-whole piece-pdf-wait"><SheetWait /></div>
                    }
                    @* While its systems are found: its pages, those still to come in outline. *@
                    @if (found is { } pagesFound && !readingNotes)
                    {
                        <div class="pages-strip" aria-hidden="true">
                            @for (var n = 1; n <= pages; n++)
                            {
                                <span class="@(n > pagesFound ? "wait" : null)">@n</span>
                            }
                        </div>
                    }
                }
                else if (loading || mei is not null)
                {
                    @* The sheet is there from the first, its paper waiting while the music is still being read (no music yet), then
                       while it's laid out; its lines show as they're drawn. *@
                    <Sheet @ref="sheet" Mei="@SheetMusic" Layout="@(view == View.Pages ? "page" : "scroll")" Page="page" Class="@(HandName is { } hand ? $"piece-sheet hands-{hand}" : "piece-sheet")" Lyrics="Settings.Lyrics" OnPages="Pages" OnPainted="Painted" OnProgress="Progressed" OnBarTapped="@(id => BarOf(id) is { } bar ? Chose(bar) : Task.CompletedTask)" Explain="explain" OnSymbolTapped="SymbolTapped" />
                }
                @* A PDF's pages turn by its outer thirds too. A notation piece's thirds are its bars, to tap, so it turns by a swipe, ‹ ›
                   or the piano. *@
                @if (Pdf && view == View.Pages)
                {
                    <button type="button" class="turn-zone turn-back" aria-label="Back a page" @onclick="() => Tapped(-1)"></button>
                    <button type="button" class="turn-zone turn-on" aria-label="On a page" @onclick="() => Tapped(1)"></button>
                }
            </div>
            @* While its music isn't all there, a card over the foot of the paper says what's happening and how far it has got, with
               the key for it: Cancel while there's nothing to read yet, which goes back; Stop once its first lines are there, which
               leaves what's drawn. It fades in after a moment, so a piece that opens at once never shows it. *@
            @if (Card() is { } card)
            {
                <div class="piece-wait" role="status">
                    <b class="piece-wait-what">@card.What</b>
                    <span class="piece-wait-more">@card.More</span>
                    <button type="button" class="mu-btn" data-piano="off" @onclick="card.Press">@card.Key</button>
                    <div class="piece-wait-meter" aria-hidden="true">
                        @for (var i = 0; i < 19; i++)
                        {
                            <span class="@(i < card.Lit ? "on" : null)"></span>
                        }
                    </div>
                </div>
            }
            @if (about)
            {
                <section class="piece-options piece-about-panel" aria-label="About this piece">
                    <h2 class="section-title">About this piece</h2>
                    @aboutPiece(Pdf)
                    <div class="control-row">
                        <button type="button" class="mu-btn" @onclick="ToggleAbout">Back to the music</button>
                    </div>
                </section>
            }
            @if (explain && explained is { } symbol)
            {
                <SymbolCard Entry="symbol.Entry" Note="@symbol.Note" OnClose="() => explained = null" />
            }
            else if (explain)
            {
                <p class="explain-hint">What's this? Tap any symbol on the music. <button type="button" class="mu-btn" data-piano="off" data-action="explain-done" @onclick="ToggleExplain">Done</button></p>
            }
            else if (loopTo == from && !playing && !about && stage == Stage.Practice)
            {
                <p class="explain-hint">Looping bar @from: tap another bar to loop to it, or drag a handle.</p>
            }
        </div>

        @if (readingNotes && pdfBytes is not null)
        {
            <ErrorBoundary @ref="readingBoundary">
                <ChildContent>
                    <ReadNotes Piece="piece" Pdf="pdfBytes" Layout="pdfLayout.Pages" Tempo="tempo" OnClose="CloseReading" OnKept="Kept" />
                </ChildContent>
                <ErrorContent>
                    <div class="pdfread-error pdfread-banner" role="alert">
                        <div>
                            <h3><span class="pdfread-lamp fail"></span>Couldn't open the note reader</h3>
                            <p>The PDF and any saved reading are still in the Library. Try opening the reader again, or return to the piece.</p>
                        </div>
                        <div class="pdfread-actions">
                            <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="() => readingBoundary?.Recover()">Try again</button>
                            <button type="button" class="mu-btn" data-action="back-to-sheet" data-piano="off" @onclick="CloseReading">Back to sheet music</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        }

        @* A run's review, under the music and over the bar: read it, then play again just below. *@
        @if (outcome is not null && stage == Stage.Practice && Settings.AfterRun == "summary")
        {
            <section class="summary" aria-label="How it went">
                <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")" OnBar="StartAt" OnLoop="@(bars => { StartAt(bars.From); SetLoop(bars.To); })"
                             FirstBar="FirstBar" LastBar="LastBar" Tempo="tempo" Previous="previousFigure" OnAgain="SetTempo" />
            </section>
        }
        @if (stage == Stage.Play && played is { InTime: { } result } && !playing)
        {
            @* Play's very quick review, under the music: the headline and a few words. *@
            <section class="mu-screen play-quick" aria-label="How it went">
                <p class="play-quick-line">@(latestRun?.Id == lastRun ? PieceWords.Went(latestRun) : $"{result.Right} of {result.Expected} notes were correct.")</p>
                <div class="play-quick-keys">
                    <button type="button" class="mu-btn mu-primary" @onclick="PlayAgain">Play again</button>
                    <button type="button" class="mu-btn" data-piano="off" @onclick="ReviewPlay">View details</button>
                    <button type="button" class="mu-btn" data-piano="off" @onclick="LeavePlay">Done</button>
                </div>
            </section>
        }
        @if (stage == Stage.Review)
        {
            @* Back to the look back, or the run again; the bar picked, to practice; and the way out. A run's review in a practice
               session, full screen as Practice is, has Finish practice first, as the bar has. *@
            <div class="review-keys">
                @if (reviewFrom == Stage.Practice && clock is not null)
                {
                    <button type="button" class="mu-btn review-finish" data-piano="off" @onclick="FinishFromReview">Finish practice</button>
                }
                @if (reviewFrom == Stage.LookBack)
                {
                    <button type="button" class="mu-btn" data-piano="off" @onclick="BackToLookBack">Back</button>
                }
                else
                {
                    <button type="button" class="mu-btn mu-primary" @onclick="() => Return(reviewFrom, again: true)">Again</button>
                }
                @if (picked is { } bar)
                {
                    <button type="button" class="mu-btn" data-piano="off" @onclick="() => PracticeBar(bar)">Practice @PieceWords.Bar(bar)</button>
                }
                @if (reviewFrom == Stage.LookBack)
                {
                    <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="Done">Done</button>
                }
                else if (reviewFrom == Stage.Play)
                {
                    <button type="button" class="mu-btn" data-piano="off" @onclick="LeavePlay">Done</button>
                }
                else
                {
                    <button type="button" class="mu-btn" data-piano="off" @onclick="() => Return(Stage.Practice, again: false)">Back to practicing</button>
                }
            </div>
        }

        @if (readingNotes)
        {
        }
        else if (Pdf)
        {
            @* A PDF's print has the bar the notation has, its keys in the same places: its page turns, More (the click; its view,
               bars a line and beats a bar; hearing it on the piano), then the tempo, which the scroll goes at. Nothing it plays is
               followed, so it has no hands, mode or Play: its own keys end the bar where Play would be, Scroll and Convert to
               notation, the one to press orange. *@
            <PlayAlong Name="library-pdf" Beats="pdfLayout.BeatsPerBar" Tempo="tempo" TempoChanged="SetTempo" ShowMode="false" ShowStart="false" ShowMarks="false" OnFullScreen="ToggleFullScreen">
                <Tools>
                    @pageTurns
                </Tools>
                <Readouts>
                    @finishInFull
                    @* The first time it's opened: the pages whose systems are still being found, behind the page showing. *@
                    @if (PagesNote() is { } coming)
                    {
                        <p class="bar-note" role="status">@coming</p>
                    }
                </Readouts>
                <MoreMusic>
                    <div class="control-row">
                        <span class="control-label">View</span>
                        <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(view == View.Pages)" @onclick="() => SetView(View.Pages)"><span class="mu-led"></span>Pages</button>
                        <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(view == View.Scroll)" @onclick="() => SetView(View.Scroll)"><span class="mu-led"></span>Scroll at the tempo</button>
                        @if (view == View.Pages)
                        {
                            <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(halfTurns)" @onclick="ToggleHalf"><span class="mu-led"></span>Half-page turns</button>
                        }
                    </div>
                    <div class="control-row">
                        <span class="control-label">Bars</span>
                        <button type="button" class="mu-btn" data-piano="off" aria-label="Fewer beats a bar" @onclick="() => SetBeats(pdfLayout.BeatsPerBar - 1)">−</button>
                        <span class="control-value">@pdfLayout.BeatsPerBar beats a bar</span>
                        <button type="button" class="mu-btn" data-piano="off" aria-label="More beats a bar" @onclick="() => SetBeats(pdfLayout.BeatsPerBar + 1)">+</button>
                        <button type="button" class="mu-btn" data-piano="off" aria-label="Fewer bars a line" @onclick="() => SetBarsPerSystem(-1)">−</button>
                        <span class="control-value">@BarsPerSystemText() a line</span>
                        <button type="button" class="mu-btn" data-piano="off" aria-label="More bars a line" @onclick="() => SetBarsPerSystem(1)">+</button>
                    </div>
                    <p class="section-note">Scrolling moves a line at a time, after a bar of count-in, at the tempo: bars a line × beats a bar × 60 ÷ tempo seconds a line. @(midi is not null ? "The tempo and metre start from the piece's MIDI." : "")</p>
                    @printKey
                </MoreMusic>
                <More>
                    @if (midi is not null && Keyboard.CanSend && Settings.SendToPiano)
                    {
                        <div class="more-group" role="group" aria-label="Hear it">
                            <h3 class="more-head">Hear it</h3>
                            <div class="control-row">
                                <button type="button" class="mu-btn" data-piano="off" @onclick="ToggleHear">@(hearing ? "Stop" : "Hear it on the piano")</button>
                            </div>
                        </div>
                    }
                </More>
                <RunKeys>
                    @if (view == View.Scroll)
                    {
                        @* Scrolling goes a system at a time: it waits for every page's to be found. *@
                        <button type="button" class="mu-btn mu-primary" data-piano="@(scrolling ? "off" : null)" disabled="@(found is not null)" @onclick="ToggleScroll">@(scrolling ? "Stop" : "Scroll")</button>
                    }
                    @if (pdfBytes is not null)
                    {
                        <button type="button" class="mu-btn @(view == View.Scroll ? "" : "mu-primary") piece-key" data-action="convert-pdf" data-piano="off" @onclick="ReadTheNotes">Convert to notation</button>
                    }
                </RunKeys>
            </PlayAlong>
            @if (stage == Stage.Practice && clock is not null)
            {
                @* A practice session while Print shows a PDF's print: its clocks and Finish practice in the foot. *@
                <PlayFoot>
                    <WayOn>
                        <PracticeStrip Clock="clock" OnFinish="FinishPractice" OnTick="Ticked" />
                    </WayOn>
                </PlayFoot>
            }
        }
        else if (stage == Stage.Play)
        {
            @* Play: the piece through, In time, both hands, with nothing on the music while it plays; a slim bar to set the tempo
               and start, then where it is and the time. Once it's played, its quick review over the bar has the keys, Again among
               them, and the bar keeps only the tempo. *@
            var reviewing = !playing && played is { InTime: not null };
            <PlayAlong @ref="play" Name="library-play" Music="playMusic" SheetOf="() => sheet" Tempo="tempo" TempoChanged="SetTempo" BarClass="play-strip" StartLabel="Start" CanStart="playMusic is { Notes.Count: > 0 }"
                       ShowStart="!reviewing" Ask="PlayMode.InTime" ShowMode="false" ShowTime="true" Bare="true" Metronome="false" ShowMore="false" ShowFullScreen="false" OnStarting="Starting" OnFinished="Finished">
                <Readouts>
                    @if (!playing && !reviewing)
                    {
                        <button type="button" class="mu-btn" data-piano="off" @onclick="LeavePlay">Done</button>
                    }
                </Readouts>
            </PlayAlong>
        }
        else if (stage == Stage.Practice)
        {
            @* Practice: the bar every screen with music has, the hands and Loop on it like an exercise's (Loop goes round the bars
               chosen on the music or the strip), More for the rest (the click; the view and lyrics; What's this, the cursor and the
               marks; how a run is summed up and play along). Its foot: the strip of bars, and the session's clocks with Finish
               practice. *@
            <PlayAlong @ref="play" Name="library" Music="music" SheetOf="() => sheet" Tempo="tempo" TempoChanged="SetTempo" ShowPassFigure="Settings.PassFigure"
                       EarlierPasses="@(waitedLoop is { } w && (w.From, w.To, w.Hand) == (from, loopTo, handStaff) ? waited : [])" StartLabel="@StartLabel" CanStart="Playable" OnStarting="Starting" OnFinished="Finished" OnBack="Back" ShowListen="true" OnListened="Listened"
                       OriginalTempo="originalTempo" OnExplain="EventCallback.Factory.Create(this, ToggleExplain)" Explaining="explain" OnFullScreen="ToggleFullScreen"
                       Hands="@(twoHands ? AllHands : null)" Hand="@HandOf(handStaff)" HandChanged="h => SetHands(StaffOf(h))"
                       Loop="@(loopTo is not null)" OnLoop="LoopOnBar" LoopOnLabel="Loop: on. The bars chosen go round until you stop" LoopOffLabel="Loop: off. On, it goes round the bar chosen"
                       OnSlip="SlipStops" OnPass="Passed" Streak="StreakShown">
                <Tools>
                    @if (view == View.Pages && !playing)
                    {
                        @pageTurns
                    }
                </Tools>
                <Readouts>
                    @finishInFull
                </Readouts>
                <MoreMusic>
                    <div class="control-row">
                        <span class="control-label">View</span>
                        <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(view == View.Pages)" @onclick="() => SetView(View.Pages)"><span class="mu-led"></span>Pages</button>
                        <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(view == View.Scroll)" @onclick="() => SetView(View.Scroll)"><span class="mu-led"></span>Scroll</button>
                    </div>
                    @if (lyrics)
                    {
                        <div class="control-row">
                            <span class="control-label">Lyrics</span>
                            <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(Settings.Lyrics)" @onclick="() => ShowLyrics(true)"><span class="mu-led"></span>On</button>
                            <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(!Settings.Lyrics)" @onclick="() => ShowLyrics(false)"><span class="mu-led"></span>Off</button>
                            <span class="control-note">@(Settings.Lyrics ? "The song's words under its notes, on every song." : "The music alone, on every song.")</span>
                        </div>
                    }
                    @printKey
                </MoreMusic>
                <More>
                    @* When I slip: what a wrong or missed note does to a run, kept for the piece (Piece.Slips.cs). *@
                    <SlipChoice Way="slipWay" WayChanged="SetSlipWay" />
                    <div class="more-group" role="group" aria-label="After a run">
                        <h3 class="more-head">After a run</h3>
                        <FeedbackPreset Way="@Settings.Way" Chosen="UseWay" />
                        <p class="section-note">@Settings.FeedbackDescription</p>
                        <SettingSwitch Label="Pause between repeats" Value="Settings.PassWaits" Changed="SetPassWaits" />
                        <p class="section-note">These apply to all library pieces.</p>
                    </div>
                    @if (twoHands)
                    {
                        <div class="more-group" role="group" aria-label="The other hand">
                            <h3 class="more-head">The other hand</h3>
                            <div class="control-row">
                                <span class="control-label">Play along</span>
                                <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(!playAlong)" @onclick="() => SetPlayAlong(false)"><span class="mu-led"></span>Off</button>
                                <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(playAlong)" disabled="@(handStaff is null || !Keyboard.CanSend || !Settings.SendToPiano)" @onclick="() => SetPlayAlong(true)"><span class="mu-led"></span>The other hand</button>
                            </div>
                            <p class="section-note">@(!Keyboard.CanSend || !Settings.SendToPiano ? "Needs the piano to play notes from the tablet (Settings)." : handStaff is null ? "Choose one hand to hear the other part during timed practice." : "The piano plays the other part during timed practice.")</p>
                        </div>
                    }
                    <details class="routine-history more-help"><summary>Playing and looping</summary><p class="section-note">Tap a bar to start there, and Loop to go round it; tap another bar or drag a handle to loop more of them. Timed follows the set tempo. Wait for notes pauses until you play the correct notes or chord.</p></details>
                </More>
            </PlayAlong>
            <PlayFoot>
                <What>
                    @* Every bar, a cell each, drawn and dragged by bars.js: tap one to start there, drag along them to loop them. *@
                    <div class="bar-strip" @ref="strip" role="group" aria-label="The bars: tap one to start there, or drag along them to loop them"></div>
                </What>
                <WayOn>
                    @if (clock is not null)
                    {
                        <PracticeStrip Clock="clock" OnFinish="FinishPractice" OnTick="Ticked" />
                    }
                </WayOn>
            </PlayFoot>
        }

        <section class="settings-section piece-about" aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">About this piece</h2>
            @aboutPiece(true)
        </section>
        @if (stage == Stage.Practice && clock is { Paused: true })
        {
            <PauseCover Clock="clock" OnKeep="KeepPracticing" OnFinish="FinishPractice" />
        }
    </div>
}

@code {
    private enum View { Pages, Scroll }

    // What a notation piece shows: its front (Practice or Play), a practice session, its look back once it's finished, the
    // in-depth review, or Play. A PDF without its notes read shows its pages, as it always has.
    private enum Stage { Front, Practice, LookBack, Review, Play }

    private Stage stage = Stage.Front;
    // The practice session going (or just finished, for its look back), its clock, how much of its playing time the day has,
    // whether the page is covered for its pause, and the seconds since it was last kept.
    private PracticeSession? session;
    private PracticeClock? clock;
    private TimeSpan counted;
    private bool covered;
    private int ticks;
    // The runs in the current review, and the stage to return to when it closes.
    private SessionReview? review;
    private List<PieceRun> reviewed = [];
    private int? picked;
    private Stage reviewFrom;
    private bool startAfterRender;
    // Finish practice pressed while a run plays: the run stops, and the session finishes once it's kept. The marks the runs gone
    // over in the review left, by run.
    private bool finishAfterRun;
    // The run kept last, by its id.
    private long lastRun;
    // Bars to bring into view once the page has drawn, after a run: the loop's, or the bar the run had most to fix in.
    private (int From, int To)? revealBars;
    // A loop that waits after each pass is a run a pass: its passes so far, while it's the same loop, hand and mode, for the bar's
    // pass count and its summary.
    private (int From, int? To, int? Hand, PlayMode Mode)? waitedLoop;
    private List<PiecePass> waited = [];
    private Dictionary<long, string> marksKept = [];
    // Play: its music (the whole piece, both hands) and how its run went.
    private PlayMusic? playMusic;
    private PlayOutcome? played;

    [Parameter] public string Id { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "conversion")] public int? Conversion { get; set; }
    [SupplyParameterFromQuery(Name = "bar")] public int? RequestedBar { get; set; }
    private bool returnToRoutineBar;
    private bool openedFromNotification;

    private PieceRecord? piece;
    // Where RCM's syllabus lists it, when it does: About says so.
    private Listing? listing;
    private bool missing;
    // The piece's music is still being read (loading). Then how its drawing stands, as its sheet tells it as its lines come
    // (nothing said yet: the paper is waiting); and whether its sheet has been drawn whole, or a PDF's first page has.
    private bool loading = true;
    private SheetProgress? drawing;
    private bool painted;
    private string? mei;
    private Score? score;
    // The piece is a song with words to show or hide (SongWords): its Options have the switch.
    private bool lyrics;
    private byte[]? pdfBytes;
    private MidiFile? midi;
    private Sheet? sheet;
    private PdfPages? pdf;
    private ElementReference frame;
    // The strip of bars under the piece's bar, bars.js that draws it and the choice on the music, and the choice it was last shown.
    private ElementReference strip;
    private IJSObjectReference? bars;
    private string? shownChoice;
    // What's been done on the piece, from its runs kept.
    private PieceRun? latestRun;
    // The first bar on the screen, as bars.js tells it: where the piece opens the next time. And whether it's been put back there.
    private int? seen;
    private bool placed;
    // A run going back a bar, or to a tapped one: the same go, so its time carries on.
    private bool restarting;
    private View view = View.Pages;
    private int page = 1;
    private int pages = 1;
    private double tempo = 72;
    private int from = 1;
    private bool removing;
    private IJSObjectReference? turns;
    private IJSObjectReference? keys;
    private DotNetObjectReference<Piece>? self;
    private double pointerX;
    private bool swiped;

    // Playing a notation piece, In time or Wait for me, from a bar to the end: the notes, each bar's first tick, the run's music
    // and how the last run went.
    private IReadOnlyList<ExpectedNote> expected = [];
    private Dictionary<int, long> barStarts = [];
    // The hand played, on a piece for two staves: the upper staff's notes (the right hand), the lower's (the left), or both
    // when null. Kept for each piece.
    private bool twoHands;
    private int? handStaff;
    private PlayMusic? music;
    // The prepared whole loop stays intact when a tap moves its starting point.
    private PlayMusic? wholeLoop;
    private int? cueBar;
    // The play bar; About this piece in place of the music; full screen; a loop from the start bar to its last; the piano playing
    // the other hand.
    private PlayAlong? play;
    private bool about;
    // The piece's own tempo, to go back to (none when its score marks none).
    private double? originalTempo;
    // Full screen as it should be, and as the page shows it: the page can only show it once turns.js is loaded.
    private bool fullScreen;
    private bool shownFull;
    private ErrorBoundary? readingBoundary;
    private int? loopTo;
    private bool playAlong;
    // What's this: on, the symbol tapped last (its entry, and for a note which note it is), and the MEI read for it.
    private bool explain;
    private (GlossaryEntry? Entry, string? Note)? explained;
    private XDocument? meiDocument;
    // A bar tapped to start at (lit even when it's the first); the piece's MEI measure ids, in order.
    private bool chosen;
    private List<string>? measureIds;
    private bool playing;
    private PlayOutcome? outcome;
    // How the last run In time went (correct and on time), and the one before it, shown under a run's figure.
    private double? lastFigure;
    private double? previousFigure;
    private DateTime started;
    private TaskCompletionSource? repainted;
    private Timer? ticker;

    // A PDF's pdfLayout, kept with the piece: each page's systems (in px at 900 wide), its metre and bars a line.
    private sealed record PdfLayoutState(List<List<PageSystem>> Pages, int BeatsPerBar, double Bpm);

    private PdfLayoutState pdfLayout = new([], 4, 72);

    // Converting the PDF in the music's place, and the piece's saved reading. A PDF whose notes are read shows them as notation,
    // and Print shows the PDF again.
    private bool readingNotes;
    private bool redrawPdf;
    private PieceReading? reading;
    private bool print;

    // A PDF shows its pages until its notes are read; then its notation, and Print shows the pages again. While the piece is
    // still being read, one whose notes are read is its notation already: its paper waits, rather than its print flashing by.
    private bool Pdf => piece!.IsPdf && (print || (loading ? !piece.HasNotes : mei is null));

    private IReadOnlyList<double> ratios = [];
    private double drawnWidth;
    private double y;
    private bool halfTurns = true;
    private int? half;
    private bool scrolling;
    private bool hearing;

    protected override async Task OnInitializedAsync()
    {
        piece = await Store.GetPieceAsync(Id);
        if (piece is null)
        {
            missing = true;
            return;
        }
        listing = await Store.GetListingAsync(Id);

        // Its head, its bar and About show at once, the paper waiting with a mark that moves and the way back, while its music is
        // read and drawn.
        StateHasChanged();
        tempo = piece.Tempo ?? 72;
        if (piece.IsPdf)
        {
            pdfBytes = await ReadFile(piece.File);
            // A PDF's pages start opening at once, while the rest about it is read.
            StateHasChanged();
            if (piece.Midi is not null && await ReadFile(piece.Midi) is { } bytes)
            {
                try
                {
                    midi = MidiFile.Read(bytes);
                }
                catch (FormatException)
                {
                }
            }
            if (piece.Layout is { } json) pdfLayout = JsonSerializer.Deserialize<PdfLayoutState>(json, PrimaStore.Json) ?? pdfLayout;
            else if (midi is not null) pdfLayout = pdfLayout with { BeatsPerBar = midi.BeatsPerBar, Bpm = Math.Round(midi.Bpm) };
            // A PDF's own tempo is its MIDI's, whenever its layout was first kept (it may have been opened before it had one).
            tempo = piece.Tempo ?? (midi is not null ? Math.Round(midi.Bpm) : pdfLayout.Bpm);
            // Keep the PDF visible on arrival; the conversion button reopens any saved draft.
            reading = await Store.GetReadingAsync(Id);
        }

        {
            // The music is the piece's only once its view is known (below): the sheet is drawn once, in that view. Set first, it was
            // drawn as pages while the rest was read, then again as the scroll, a long piece's engraving done twice over.
            var text = await Store.GetMeiAsync(Id);
            if (text is not null)
            {
                // Read away from the screen's thread: a long piece takes a moment.
                (score, lyrics) = await Task.Run(() => (MeiReader.Read(text), SongWords.Has(text)));
                expected = score.Expected();
                // The piece's own tempo, as its score marks it (an imported MIDI file's, or a PDF's MIDI's), in its first metre's beats
                // as the tempo is (♩. in 6/8).
                var opening = score.WithSignatures().First().Meter;
                originalTempo = (score.MainTempo() ?? midi?.MarkedTempo) is { } quarters ? Math.Round(quarters * Ticks.Quarter / opening.BeatTicks) : null;
                // It opens at its own tempo until one has been set for this piece (the play bar's, a step's, the metronome's): only a
                // score that marks none starts at 72.
                if (piece.Tempo is null && originalTempo is { } own) tempo = Math.Clamp(own, 20, 240);
                // A bar number met again (a second ending, say) keeps its first place.
                barStarts = score.BarStarts().GroupBy(b => b.Bar.Number).ToDictionary(g => g.Key, g => g.First().Start);
                twoHands = expected.Select(n => n.Staff).Distinct().Order().SequenceEqual([1, 2]);
                // Kept for each piece: the view (the whole piece in one scroll unless it was Pages) and the hand.
                var stored = await Store.GetSettingsAsync();
                view = stored.GetValueOrDefault(ViewKey) == "pages" ? View.Pages : View.Scroll;
                handStaff = twoHands ? stored.GetValueOrDefault(HandsKey) switch { "right" => 1, "left" => 2, _ => null } : null;
                slipWay = SlipWayOf(stored.GetValueOrDefault(SlipKey));
                StartAt(FirstBar);
                latestRun = (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).MaxBy(r => (r.At, r.Id));
                // A session left going is paused, to carry on or finish; one left until another day (played before today, and longer
                // ago than a pause: not one played on past midnight) is finished as of the last thing played in it, and the piece
                // opens on its front.
                if ((await Store.GetSessionsAsync(Id)).LastOrDefault(s => s.Finished is null) is { } open)
                {
                    if (PracticeClock.LeftUntilAnotherDay(open.LastPlayed, DateTimeOffset.Now)) await Store.SaveSessionAsync(open with { Paused = true, Finished = open.LastPlayed });
                    // Practiced full screen, as Practice is: the page goes full screen as soon as it can.
                    else (session, clock, counted, covered, stage, fullScreen) = (open, new PracticeClock(DateTimeOffset.Now, open.Playing, open.Idle, paused: true, lastPlayed: open.LastPlayed), open.Playing, true, Stage.Practice, true);
                }
            }
            mei = text;
        }

        if (piece.Position is { } position && JsonSerializer.Deserialize<Dictionary<string, double>>(position) is { } saved)
        {
            page = (int)saved.GetValueOrDefault("page", 1);
            y = saved.GetValueOrDefault("y", 0);
            // A notation piece opens where it was left: the bar it was to start from, or its loop, and the line that was at the
            // top of the screen (bars.js puts that back once the music is drawn).
            if (saved.TryGetValue("from", out var start) && barStarts.ContainsKey((int)start))
            {
                loopTo = saved.TryGetValue("to", out var last) ? Math.Min((int)last, LastBar) : null;
                StartAt((int)start);
            }
            seen = saved.TryGetValue("bar", out var top) ? (int)top : null;
        }
        if (RequestedBar is { } requested && barStarts.ContainsKey(requested))
        {
            loopTo = null;
            chosen = true;
            seen = requested;
            StartAt(requested);
            returnToRoutineBar = true;
        }
        await Store.SetPieceAsync(Id);
        loading = false;
    }

    // ——— Opening ———

    // The way back, by the name of where it goes: the list the piece was opened from, as that list named itself ("Ludwig van
    // Beethoven", "Uploaded pieces"), and otherwise the Library.
    private string WayBack => Navigation.PreviousName ?? "Library";

    // Back to the list the piece was opened from, as it was left. Opened from anywhere else (or first, as Prima started), the
    // way back says Library and goes there: back to it if it was open on the way here, and otherwise in this screen's place.
    private Task Leave() => Navigation.PreviousName is not null ? Navigation.BackAsync(Place.Last) : Navigation.ReturnToAsync("library");

    // The music the sheet is given: none while it's still being read, nor until the page has the shape it's going to have. A
    // piece left in Practice opens in Practice again, full screen, which the page can only show once its scripts are loaded:
    // given its music before that, the sheet laid the piece out at the narrower width first, then all over again.
    private string SheetMusic => mei is null || shownFull != fullScreen ? "" : mei;

    // The sheet says how its drawing stands: as its paper starts waiting, as its lines come, and when it's over.
    private void Progressed(SheetProgress progress) => drawing = progress;

    // There's music on the paper to play from: all of it, or its first lines with the rest coming (or stopped).
    private bool Playable => !loading && music is { Notes.Count: > 0 } && drawing is { Drawing: SheetDrawing.Done or SheetDrawing.Stopped } or { Lines: > 0 };

    // Nothing of the piece to read yet: its music still being read or laid out, or a PDF's first page not drawn.
    private bool Waiting => !readingNotes && (Pdf ? pdfBytes is not null && !painted : (loading || mei is not null) && drawing is null or { Drawing: SheetDrawing.Coming, Lines: 0 });

    private static string LineOf(SheetProgress lines) => lines.Total > 0 ? $"Line {lines.Lines} of {lines.Total}" : $"Line {lines.Lines}";

    // The bar's note on its front: how its music's drawing stands, while it isn't all there.
    private string? BarNote() => Waiting ? "Getting its music ready" : drawing switch
    {
        { Drawing: SheetDrawing.Coming } coming => LineOf(coming),
        { Drawing: SheetDrawing.Stopped } stopped => $"Stopped at {LineOf(stopped).ToLowerInvariant()}",
        { Drawing: SheetDrawing.Failed } => "Not drawn",
        _ => null,
    };

    // The card over the foot of the paper: what's happening, a line more, its key and what it does, and how much of its meter
    // is lit (of 19).
    private sealed record WaitCard(string What, string More, string Key, Func<Task> Press, int Lit);

    private WaitCard? Card()
    {
        if (readingNotes || about) return null;
        if (Waiting)
        {
            var what = Pdf ? "Opening its pages" : piece!.Bars is { } bars ? $"Engraving {bars} bars" : "Engraving its music";
            return new(what, Pdf ? "Its first page shows as soon as it's drawn." : "The first lines show as soon as they're drawn.", "Cancel", Leave, 0);
        }
        return Pdf ? null : drawing switch
        {
            { Drawing: SheetDrawing.Coming } coming => new("The rest is on its way", $"{LineOf(coming)} · read and scroll what's here{(stage == Stage.Front ? ", or start from bar " + FirstBar : "")}.", "Stop", StopDrawing,
                coming.Total > 0 ? Math.Clamp(19 * coming.Lines / coming.Total, 1, 19) : 1),
            { Drawing: SheetDrawing.Failed } => new("Its music couldn't be drawn", "What went wrong is kept in Settings › Problems.", "Back", Leave, 0),
            _ => null,
        };
    }

    // Stop: what's drawn of the music stays, and no more is. Draw the rest carries on from there.
    private Task StopDrawing() => sheet?.StopDrawing() ?? Task.CompletedTask;

    private Task DrawTheRest() => sheet?.DrawTheRest() ?? Task.CompletedTask;

    protected override void OnParametersSet()
    {
        if (Conversion != 1) openedFromNotification = false;
        else if (!openedFromNotification && piece?.IsPdf == true && pdfBytes is not null)
        {
            openedFromNotification = true;
            ReadTheNotes();
        }
    }

    // A bundled file, or one imported into the Library's folder.
    private async Task<byte[]?> ReadFile(string? file)
    {
        if (file is null) return null;
        if (piece!.Origin != "bundle")
        {
            var path = Path.Combine(Store.FilesPath, file);
            return File.Exists(path) ? await File.ReadAllBytesAsync(path) : null;
        }
        return await Bundle.ReadAsync(file);
    }

    private bool listening;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (piece is null) return;

        // Once: a render while the imports below are awaited mustn't listen to the piano a second time. A tap can land while they're
        // awaited (Practice, as the piece is still opening), and change what's on the page: so nothing more is done in this pass.
        // The page is drawn again, and the next pass does the rest with the page as it is by then.
        if (!listening)
        {
            listening = true;
            turns = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/turns.js");
            bars = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/bars.js");
            self = DotNetObjectReference.Create(this);
            keys = await turns.InvokeAsync<IJSObjectReference>("listenKeys", self);
            Keyboard.Received += Heard;
            StateHasChanged();
            return;
        }

        // Full screen as it should be, if the page couldn't show it when it was asked for (before turns.js was loaded). The sheet
        // waits for it before taking its music (SheetMusic): now it can, and the page is drawn again to give it.
        if (shownFull != fullScreen)
        {
            await ShowFullScreen();
            if (shownFull == fullScreen)
            {
                StateHasChanged();
                return;
            }
        }

        // Closing the reader restores a stage that was display:none. Measure and draw only after that visible DOM is rendered.
        if (returnToRoutineBar)
        {
            returnToRoutineBar = false;
            if (session is null) await StartPractice();
            else { stage = Stage.Practice; covered = false; clock?.Resume(DateTimeOffset.Now); }
            StateHasChanged();
            return;
        }
        if (redrawPdf && !readingNotes && Pdf && pdf is not null && ratios.Count > 0)
        {
            redrawPdf = false;
            await ShowPdf();
        }

        if (startAfterRender && play is not null)
        {
            startAfterRender = false;
            await play.Start();
        }
        if (revealBars is { } shown && bars is not null && frame.Id is not null)
        {
            revealBars = null;
            try { await bars.InvokeVoidAsync("reveal", frame, shown.From, shown.To); }
            catch (JSException e) { Logger.LogWarning(e, "Couldn't bring bars {From} to {To} of {Piece} into view", shown.From, shown.To, piece.Title); }
        }

        // The choice, drawn by bars.js on the music and the strip: the bar a run starts at (the first only once it's tapped), or
        // the loop's first to last, in Practice. bars.js tells Chose, Looped and Loop of a change made there. The strip is a new
        // one each time Practice comes back to the page (from its front, the look back or a review), and drawn again then: not
        // before it's on the page (Practice tapped as the piece opened can get here first).
        if (bars is null || score is null || mei is null || Pdf || readingNotes || frame.Id is null || strip.Id is null || stage != Stage.Practice) return;
        var lit = loopTo is not null || from > FirstBar || chosen;
        var choice = $"{from}|{loopTo}|{lit}|{playing}|{explain}|{mei.Length}|{strip.Id}";
        if (choice == shownChoice) return;

        shownChoice = choice;
        var ids = MeasureIds().Take(score.Bars.Count).ToArray();
        // The first time, with the bar that was at the top of the screen when the piece was left, to be put back there.
        var at = placed ? null : seen;
        placed = true;
        // Drawing the choice going wrong leaves the music to play, without it: it's kept as a problem, not the page's end.
        try { await bars.InvokeVoidAsync("show", frame, strip, self, new { from, to = loopTo, lit, playing, explain, firstBar = FirstBar, ids, at }); }
        catch (JSException e) { Logger.LogWarning(e, "Couldn't draw the bars chosen on {Piece}", piece.Title); }
        await SavePosition();
    }

    // The first bar on the screen, once the music has stayed where it is a moment: kept as where the piece was left.
    [JSInvokable]
    public async Task Seen(int bar)
    {
        seen = bar;
        await SavePosition();
    }

    private string Kicker() => stage == Stage.LookBack && session is not null
        ? $"Practiced · {session.Started.LocalDateTime.ToString("dddd d MMMM", CultureInfo.InvariantCulture)}"
        : string.Join(" · ", new[] { piece!.Composer, piece.Work }.Where(s => !string.IsNullOrEmpty(s)));

    private string LevelText() => piece!.Level is { } level ? (piece.IsPdf && mei is null ? $"~{level}" : $"{level}") : "–";

    private string PlaceText() => Pdf && view == View.Scroll ? $"{CurrentSystem() + 1}" : $"{page} of {pages}";

    private void ReadTheNotes() => (readingNotes, about, explain) = (true, false, false);

    private void CloseReading()
    {
        (readingNotes, about) = (false, false);
        redrawPdf = Pdf;
        if (Conversion == 1) Nav.NavigateTo(Nav.GetUriWithQueryParameter("conversion", (int?)null), replace: true);
    }

    // Kept: the piece now has its notation, so it opens again as one.
    private void Kept() => Nav.NavigateTo(Nav.GetUriWithQueryParameter("conversion", (int?)null), forceLoad: true);

    // A PDF read into notes: the print, as pages to turn, or the notation in the view it had.
    private async Task TogglePrint()
    {
        print = !print;
        StopScroll();
        view = print ? View.Pages : (await Store.GetSettingsAsync()).GetValueOrDefault(ViewKey) == "pages" ? View.Pages : View.Scroll;
        page = 1;
    }

    private static string On(bool on) => on ? "true" : "false";


    // Turning: buttons, the screen's thirds, a swipe, keys, the soft and sostenuto pedals, or the keyboard's top and bottom keys.
    [JSInvokable]
    public async Task Turn(int by)
    {
        if (piece is null) return;
        if (Pdf) await TurnPdf(by);
        else if (view == View.Pages) page = Math.Clamp(page + by, 1, pages);
        await SavePosition();
        StateHasChanged();
    }

    private Task Tapped(int by)
    {
        if (swiped)
        {
            swiped = false;
            return Task.CompletedTask;
        }
        return Turn(by);
    }

    private void Down(PointerEventArgs e) => (pointerX, swiped) = (e.ClientX, false);

    private async Task Up(PointerEventArgs e)
    {
        var dx = e.ClientX - pointerX;
        if (Math.Abs(dx) < 80) return;

        swiped = true;
        await Turn(dx < 0 ? 1 : -1);
    }

    private void Heard(MidiEvent e)
    {
        // A key played in Practice: playing time, and a pause carried on.
        if (e.Kind == MidiKind.NoteOn && stage == Stage.Practice && clock is not null) _ = InvokeAsync(() => clock?.Key(DateTimeOffset.Now));

        var by = e switch
        {
            { Kind: MidiKind.Control, Data1: MidiEvent.Soft, Data2: >= 64 } => 1,
            { Kind: MidiKind.Control, Data1: MidiEvent.Sostenuto, Data2: >= 64 } => -1,
            { Kind: MidiKind.NoteOn, Data1: NoteName.HighestKey } => 1,
            { Kind: MidiKind.NoteOn, Data1: NoteName.LowestKey } => -1,
            _ => 0,
        };
        if (by != 0 && !playing) _ = InvokeAsync(() => Turn(by));
    }

    private Task Pages(int count)
    {
        pages = Math.Max(1, count);
        page = Math.Clamp(page, 1, pages);
        return Task.CompletedTask;
    }

    // A run waits for the sheet to be drawn in its new layout before it starts. The first time, the piece has opened.
    private void Painted(long _)
    {
        painted = true;
        repainted?.TrySetResult();
    }

    private async Task SetView(View to)
