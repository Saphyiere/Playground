    private List<string> MeasureIds()
    {
        meiDocument ??= mei is null ? null : XDocument.Parse(mei);
        return measureIds ??= meiDocument?.Descendants().Where(e => e.Name.LocalName == "measure").Select(m => (string?)m.Attribute(XNamespace.Xml + "id") ?? "").ToList() ?? [];
    }

    private int? BarOf(string measureId)
    {
        var index = MeasureIds().IndexOf(measureId);
        return score is not null && index >= 0 && index < score.Bars.Count ? score.Bars[index].Number : null;
    }

    private string? MeasureOf(int bar)
    {
        var index = bar - FirstBar;
        return index >= 0 && index < MeasureIds().Count ? MeasureIds()[index] : null;
    }

    // The run plays in the scrolling view, a line at a time: for the run, so a piece kept in Pages opens in Pages the next time.
    private async Task Starting()
    {
        (playing, outcome, started, options, explain, explained) = (true, null, restarting ? started : DateTime.Now, false, false, null);
        if (stage == Stage.Practice) clock?.RunStarted(DateTimeOffset.Now);
        if (stage == Stage.Play) played = null;
        if (view == View.Scroll) return;

        repainted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        view = View.Scroll;
        StateHasChanged();
        await Task.WhenAny(repainted.Task, Task.Delay(4000));
    }

    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        if (stage == Stage.Practice) clock?.RunEnded(DateTimeOffset.Now);
        if (stage == Stage.Play) played = how;
        // Stopped before a key that could be judged (in the count-in, or with nothing played): there's no run to keep.
        var kept = how is not { InTime: null, Wait: null or { Notes: 0 } };
        if (kept) await Keep(how);
        if (stage != Stage.Practice) return;

        // A loop waiting after each pass: this pass with those before it, for the bar and the summary (each pass is kept as its own
        // run all the same).
        (int, int?, int?, PlayMode)? loopKey = how.Loop is { } round && Settings.PassWaits ? (round.From, round.To, handStaff, how.Mode) : null;
        if (loopKey is null || loopKey != waitedLoop) (waitedLoop, waited) = (loopKey, []);
        waited.AddRange(how.Passes);
        if (waited.Count > 1) outcome = how with { Passes = [.. waited] };

        // Practice: finishing once the run's kept, if that's what stopped it; then what shows after a run, as Settings say, and
        // whether it goes again by itself.
        if (finishAfterRun)
        {
            finishAfterRun = false;
            await FinishPractice();
        }
        else if (Settings.AfterRun == "review" && kept)
        {
            reviewed = [.. (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).Where(r => r.Id == lastRun)];
            review = SessionReview.Of(reviewed, LastBar);
            await OpenReview(Stage.Practice);
        }
        else if (Settings.AfterRun == "nothing")
        {
            outcome = null;
            if (!Settings.LiveMarks && sheet is not null) await sheet.ClearMarks();
        }
        if (stage == Stage.Practice && Settings.RunAgain && !how.Stopped) startAfterRender = true;
        // The loop, or the bar to look at, in view again, if the summary or the run has left it off the screen.
        else if (stage == Stage.Practice) revealBars = loopTo is { } to ? (from, to) : how.InTime?.WorstBar is { } worst ? (worst, worst) : null;
    }

    // A run kept: how it went, the practice session it was played in (or that it was Play's), what went wrong in each bar (and
    // in each pass round a loop), and the marks it left on the music, for the look back and the in-depth review.
    private async Task Keep(PlayOutcome how)
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var (right, notes, clean) = how.InTime is { } timed ? (timed.Right, timed.Expected, timed.Clean) : (how.Wait!.RightFirstTime, how.Wait.Notes, how.Wait.WrongKeys == 0 && how.Wait.Apart == 0 && how.Wait.Finished);
        // Round a loop, its last bar and each pass, and the run's figures are its last pass's.
        var (to, passes) = (how.Loop?.To, how.Loop is null ? null : how.Passes.Select(p => new { right = p.Right, notes = p.Notes, inTime = p.RightInTime, trouble = Kept(p.Trouble) }));
        var trouble = Kept(how.InTime is { } judged ? Trouble.Of(judged.Notes) : Trouble.Of(how.Marks, expected.ToDictionary(n => n.Id, n => n.Bar)));
        var (practised, fromPlay) = (stage == Stage.Practice ? session?.Id : null, stage == Stage.Play ? true : (bool?)null);
        var marks = new { right = how.Marks.Where(m => m.Kind == "right").Select(m => m.Id), other = how.Marks.Where(m => m.Kind != "right").Select(m => new object?[] { m.Id, m.Kind, m.Played, m.Steps, m.Written }) };
        object measures = how.InTime is { } r
            ? new { inTime = r.InTimeAccuracy, right = r.Right, wrong = r.Wrong, missed = r.Missed, extra = r.Extra, keptGoing = r.KeptGoing, holds = r.HoldsJudged, letGoEarly = r.LetGoEarly, from = RunFrom(), to, passes, stopped = how.Stopped, bar = how.Bar, hands = RunHands(), session = practised, play = fromPlay, trouble, marks }
            : new { rightFirstTime = how.Wait!.RightFirstTime, notes = how.Wait.Notes, wrongKeys = how.Wait.WrongKeys, apart = how.Wait.Apart, seconds = how.Wait.Seconds, from = RunFrom(), to, passes, stopped = how.Stopped, bar = how.Bar, hands = RunHands(), session = practised, play = fromPlay, trouble, marks };
        var firstNs = how.Played.Count == 0 ? 0 : how.Played[0].OnNs;
        var keys = JsonSerializer.Serialize(how.Played.Select(p => new[] { p.Midi, (p.OnNs - firstNs) / 1e6 }));
        lastRun = await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, today, "piece", how.Mode == PlayMode.InTime ? "in time" : "wait", Id, piece!.Level, how.Mode == PlayMode.InTime ? tempo : null, null, null, keys, null, JsonSerializer.Serialize(measures), notes == 0 ? null : right / (double)notes, clean, null));
        // Practice's minutes are its clock's, counted as it goes; Play's are its run's.
        if (stage != Stage.Practice) await Store.AddMinutesAsync(today, (DateTime.Now - started).TotalMinutes);
        history = PieceHistory.Of((await Store.GetPieceRunsAsync(Id)).Select(r => r.Run));
    }

    // Play's run is the whole piece, both hands, whatever bar and hand Practice has chosen.
    private int RunFrom() => stage == Stage.Play ? FirstBar : from;

    private string RunHands() => stage == Stage.Play ? "both" : HandName ?? "both";

    // What went wrong in each bar, as it's kept: [bar, wrong, missed, off the beat, let go early, slips put right, chord notes not together].
    private static IEnumerable<int[]> Kept(IReadOnlyList<BarTrouble> trouble) => trouble.Select(t => new[] { t.Bar, t.Wrong, t.Missed, t.Off, t.Early, t.Slips, t.Apart });

    // ——— A practice session ———

    // Practice: a session starts on the piece, its clock with it, and the page is the piece's with all its tools.
    private async Task StartPractice()
    {
        var now = DateTimeOffset.Now;
        var way = Settings.Way ?? "custom";
        var id = await Store.StartSessionAsync(Id, way, now);
        (session, clock, counted, covered, ticks, stage) = (new PracticeSession(id, Id, now, TimeSpan.Zero, TimeSpan.Zero, false, now, way, null), new PracticeClock(now), TimeSpan.Zero, false, 0, Stage.Practice);
        StartAt(from);
        if (!fullScreen) await ToggleFullScreen();
    }

    // Each second the strip counts: the session kept every half minute, and the page covered as it pauses (or uncovered as a key
    // carries it on).
    private async Task Ticked()
    {
        if (clock is null) return;

        if (clock.Paused != covered)
        {
            covered = clock.Paused;
            await KeepSession();
            StateHasChanged();
        }
        else if (++ticks % 30 == 0) await KeepSession();
    }

    // The session's clock kept as it stands, and the playing time since it was last kept added to the day's minutes. Once it's
    // finished it stays finished, unless it's carried on from its look back.
    private async Task KeepSession(DateTimeOffset? finished = null, bool reopen = false)
    {
        if (session is null || clock is null) return;

        var ended = reopen ? null : finished ?? session.Finished;
        session = session with { Playing = clock.Playing, Idle = clock.Idle, Paused = clock.Paused, LastPlayed = clock.LastPlayed, Finished = ended };
        await Store.SaveSessionAsync(session, reopen);
        var more = clock.Playing - counted;
        counted = clock.Playing;
        if (more > TimeSpan.Zero) await Store.AddMinutesAsync(DateOnly.FromDateTime(DateTime.Now), more.TotalMinutes);
    }

    // Keep practising, on the pause's cover: the clocks count again from now.
    private async Task KeepPractising()
    {
        clock?.Resume(DateTimeOffset.Now);
        covered = false;
        await KeepSession();
    }

    // Finish practice: the session ends now, or from its pause as of the last thing played, and its look back takes the page. A
    // run going stops first, and is kept with the session.
    private async Task FinishPractice()
    {
        if (session is null || clock is null) return;
        if (playing && play is not null)
        {
            finishAfterRun = true;
            await play.Stop();
            return;
        }

        var now = DateTimeOffset.Now;
        var end = clock.Paused ? clock.LastPlayed : now;
        clock.Pause(now);
        await KeepSession(end);
        await ShowLookBack();
    }

    // The look back: the session's runs summed up, and the session before on the piece that had any, to compare with.
    private async Task ShowLookBack()
    {
        if (session is null) return;

        var runs = (await Store.GetPieceRunsAsync(Id)).Select(r => r.Run).ToList();
        reviewed = [.. runs.Where(r => r.Session == session.Id)];
        review = SessionReview.Of(reviewed, LastBar);
        var earlier = (await Store.GetSessionsAsync(Id)).Where(s => s.Id != session.Id && s.Started < session.Started).Select(s => (s.Started, Runs: runs.Where(r => r.Session == s.Id).ToList())).LastOrDefault(s => s.Runs.Count > 0);
        before = earlier.Runs is { Count: > 0 } theirs ? (DateOnly.FromDateTime(earlier.Started.LocalDateTime), SessionReview.Of(theirs, LastBar)) : null;
        (stage, outcome, picked) = (Stage.LookBack, null, null);
        if (fullScreen) await ToggleFullScreen();
    }

    // Keep practising, from the look back: the same session carries on.
    private async Task CarryOn()
    {
        clock?.Resume(DateTimeOffset.Now);
        (stage, covered) = (Stage.Practice, false);
        await KeepSession(reopen: true);
        StartAt(from);
        if (!fullScreen) await ToggleFullScreen();
    }

    // Done: back to the piece's front, the session over.
    private async Task Done()
    {
        (stage, session, clock, review, reviewed, picked, outcome) = (Stage.Front, null, null, null, [], null, null);
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        if (fullScreen) await ToggleFullScreen();
    }

    private async Task BackToLookBack()
    {
        (stage, picked) = (Stage.LookBack, null);
        if (fullScreen) await ToggleFullScreen();
    }

    // The in-depth review of the runs gone over, taking the screen: the bar still hard at the end picked to start with, as the
    // look back names it, or else the bar put right, or else the bar with most to fix.
    private async Task OpenReview(Stage from)
    {
        (reviewFrom, stage, marksKept) = (from, Stage.Review, await Store.GetRunMarksAsync([.. reviewed.Select(r => r.Id)]));
        if (!fullScreen) await ToggleFullScreen();
        StateHasChanged();
        var first = review?.Hard?.Bar ?? review?.Fixed?.Bar ?? review?.Bars.Values.OrderByDescending(b => b.Weight).ThenBy(b => b.Bar).FirstOrDefault()?.Bar;
        if (first is { } bar) await PickBar(bar);
    }

    // A bar picked in the in-depth review (its cell, or the bar tapped on the music): its music as it was last played there, with
    // the marks the latest run that played it left on its notes, outlined and in view.
    private async Task PickBar(int bar)
    {
        picked = bar;
        if (sheet is null) return;

        var inBar = expected.Where(n => n.Bar == bar).Select(n => n.Id).ToHashSet();
        List<SheetMark> marks = [];
        foreach (var run in reviewed.OrderByDescending(r => r.At))
        {
            if (!marksKept.TryGetValue(run.Id, out var json)) continue;

            using var left = JsonDocument.Parse(json);
            var right = left.RootElement.GetProperty("right").EnumerateArray().Select(e => e.GetString() ?? "").Where(inBar.Contains).Select(id => new SheetMark(id, "right"));
            var other = left.RootElement.GetProperty("other").EnumerateArray().Where(e => inBar.Contains(e[0].GetString() ?? ""))
                .Select(e => new SheetMark(e[0].GetString()!, e[1].GetString()!, e[2].ValueKind == JsonValueKind.String ? e[2].GetString() : null, e[3].GetInt32(), Written: e[4].ValueKind == JsonValueKind.String ? e[4].GetString() : null));
            marks = [.. right, .. other];
            if (marks.Count > 0) break;
        }
        await sheet.ShowMarks(marks);
        await sheet.Outline(MeasureOf(bar));
    }

    private string ReviewKicker() => reviewFrom switch
    {
        Stage.LookBack when session is not null => $"Practised · {session.Started.LocalDateTime.ToString("dddd d MMMM", CultureInfo.InvariantCulture)} · {PracticeStrip.Said(session.Playing)} playing",
        Stage.Play => $"Played through · {DateTime.Now.ToString("dddd d MMMM", CultureInfo.InvariantCulture)} · at {tempo:0}",
        _ => reviewed is [var run] ? $"{PieceWords.How(run)} · {DateTime.Now.ToString("dddd d MMMM", CultureInfo.InvariantCulture)}" : "",
    };

    // The review's figures. A session's lead with where it ended, not its average: its last stretch, first to last, and that
    // stretch's tempo, then the time playing. One run's are its own; a pass of a loop that waits after each, with the passes before.
    private List<(string, string)> ReviewFigures()
    {
        if (review is null) return [];

        if (reviewFrom == Stage.LookBack && session is not null && review.Stretches.MaxBy(s => s.Last.At) is { } last)
        {
            var (name, first, end) = (LookBack.Name(last, true), LookBack.Said(last, last.First), LookBack.Said(last, last.Last));
            List<(string, string)> led = last.Points.Count > 1 ? [($"{name}, first → last", $"{first} → {end}")] : [(name, end)];
            if (last is { InTime: true, First.Tempo: { } began, Last.Tempo: { } ended }) led.Add(("Tempo", began == ended ? $"{ended:0}" : $"{began:0} → {ended:0}"));
            led.Add(("Playing", PracticeStrip.Said(session.Playing)));
            return led;
        }

        List<(string, string)> figures = review.RightInTime is { } share ? [("Right in time", $"{share * 100:0}%")] : [];
        figures.Add(("Notes right", $"{review.Right}/{review.Notes}"));
        if (reviewFrom == Stage.Practice && waited is [var once, .., var now])
        {
            figures.Add(("Pass", $"{waited.Count}"));
            figures.Add(("Since pass 1", once.RightInTime is { } then ? $"{then * 100:0}% → {now.RightInTime * 100:0}%" : $"{once.Right}/{once.Notes} → {now.Right}/{now.Notes}"));
        }
        return figures;
    }

    // The piece's bars by number, in order.
    private List<int> BarNumbers() => score is null ? [] : [.. score.Bars.Select(b => b.Number)];

    // Back from the in-depth review to Play or Practice, and the run again if asked; or else back to practising with the run's
    // marks on the music again, all of them, not just the bar the review showed last.
    private async Task Return(Stage to, bool again)
    {
        (stage, picked, startAfterRender) = (to, null, again);
        if (sheet is not null) await sheet.Outline(null);
        if (to == Stage.Practice && !fullScreen) await ToggleFullScreen();
        if (to == Stage.Practice) StartAt(from);
        if (to == Stage.Practice && !again && outcome is not null && sheet is not null) await sheet.ShowMarks(outcome.Marks);
    }

    // Practise a bar, from Play's quick review, the look back or the in-depth review: the bar looped with a bar either side, the
    // session carried on (or, from Play, one started), the music as it was before the review.
    private async Task PractiseBar(int bar)
    {
        if (sheet is not null)
        {
            await sheet.ClearMarks();
            await sheet.Outline(null);
        }
        (from, loopTo, picked, played, outcome) = (Math.Max(FirstBar, bar - 1), Math.Min(LastBar, bar + 1), null, null, null);
        if (session is not null) await CarryOn();
        else await StartPractice();
    }

