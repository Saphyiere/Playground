@page "/library/{Id}"
@implements IAsyncDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject ILibraryBundle Bundle
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISystemBars SystemBars
@using System.Text.Json
@using System.Xml.Linq
@using Prima.UI.Glossary
@using Prima.Core.Library
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>@(piece?.Title ?? "Piece") · Prima</PageTitle>

@if (piece is null)
{
    <PageHead Title="Library" Kicker="@(missing ? "Not in the Library" : "Opening…")" />
}
else
{
    @* It fits the screen, only the music scrolling: between runs with About this piece under the music, and after a run with
       the run's summary there in About's place, so how it went is on the screen with the music (its details scroll in the
       summary's own space). While a PDF's notes are being read the page is as long as that needs, and scrolls. *@
    <div class="piece @(readingNotes ? "" : "piece-fit") @(playing ? "piece-playing" : "") @(outcome is not null ? "piece-summed" : "")">
        <header class="reading-head">
            <div>
                <p class="page-kicker">@Kicker()</p>
                <h1 class="page-title">@piece.Title</h1>
            </div>
            <KeyboardLamp />
        </header>

        @{
            // The piece's own tools at the end of the bar: its options in place of the music, and full screen.
            RenderFragment tools = @<text>
                @if (piece.IsPdf && mei is not null)
                {
                    <button type="button" class="mu-btn piece-tool piece-tool-word" aria-pressed="@On(print)" aria-label="@(print ? "Show the notation" : "Show the print")" disabled="@playing" @onclick="TogglePrint">Print</button>
                }
                @if (!Pdf)
                {
                    <button type="button" class="mu-btn piece-tool" aria-label="What's this?" aria-pressed="@On(explain)" disabled="@playing" @onclick="ToggleExplain"><span class="piece-tool-mark" aria-hidden="true">?</span></button>
                }
                <button type="button" class="mu-btn piece-tool" aria-label="Options" aria-pressed="@On(options)" disabled="@playing" @onclick="ToggleOptions">
                    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="7" cy="5" r="2.3" fill="currentColor" /><circle cx="13" cy="10" r="2.3" fill="currentColor" /><circle cx="9" cy="15" r="2.3" fill="currentColor" /></svg>
                </button>
                <button type="button" class="mu-btn piece-tool" aria-label="@(fullScreen ? "Leave full screen" : "Full screen")" aria-pressed="@On(fullScreen)" @onclick="ToggleFullScreen">
                    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="@(fullScreen ? "M8 3v5H3M17 8h-5V3M12 17v-5h5M3 12h5v5" : "M3 8V3h5M12 3h5v5M17 12v5h-5M8 17H3v-5")" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </text>;
        }
        @if (readingNotes && readingBar)
        {
        }
        else if (Pdf)
        {
            <section class="reading-bar piece-bar" aria-label="The piece">
                <p class="piece-bar-title">@piece.Title</p>
                <div class="mu-readout"><span class="mu-readout-label">Level</span><span class="mu-readout-value">@LevelText()</span></div>
                <div class="mu-readout"><span class="mu-readout-label">@(view != View.Pages ? "System" : "Page")</span><span class="mu-readout-value">@PlaceText()</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Tempo</span><span class="mu-readout-value">@tempo.ToString("0", CultureInfo.InvariantCulture)</span></div>
                <div class="piece-actions">
                    <button type="button" class="mu-btn" aria-label="Back a page" @onclick="() => Turn(-1)">‹</button>
                    <button type="button" class="mu-btn" aria-label="On a page" @onclick="() => Turn(1)">›</button>
                    @if (view == View.Scroll)
                    {
                        <button type="button" class="mu-btn mu-primary" data-piano="@(scrolling ? "off" : null)" @onclick="ToggleScroll">@(scrolling ? "Stop" : "Scroll")</button>
                    }
                    @tools
                </div>
            </section>
        }
        else
        {
            <PlayAlong @ref="play" Name="library" Music="music" SheetOf="() => sheet" Tempo="tempo" TempoChanged="SetTempo" BarClass="piece-bar" ShowResult="true" StartLabel="@StartLabel" CanStart="music is { Notes.Count: > 0 }" OnStarting="Starting" OnFinished="Finished" OnBack="Back" ShowListen="true" OnListened="() => playing = false">
                <Readouts>
                    <p class="piece-bar-title">@piece.Title</p>
                    <div class="mu-readout"><span class="mu-readout-label">Level</span><span class="mu-readout-value">@LevelText()</span></div>
                    @if (view == View.Pages && !playing)
                    {
                        <div class="mu-readout"><span class="mu-readout-label">Page</span><span class="mu-readout-value">@PlaceText()</span></div>
                    }
                    <div class="piece-actions">
                        @if (view == View.Pages && !playing)
                        {
                            <button type="button" class="mu-btn" aria-label="Back a page" @onclick="() => Turn(-1)">‹</button>
                            <button type="button" class="mu-btn" aria-label="On a page" @onclick="() => Turn(1)">›</button>
                        }
                        @tools
                    </div>
                </Readouts>
            </PlayAlong>
            @* Every bar, a cell each, drawn and dragged by bars.js: tap one to start there, drag along them to loop them. *@
            <div class="bar-strip" @ref="strip" role="group" aria-label="The bars: tap one to start there, or drag along them to loop them"></div>
        }

        @* The options cover the music, which stays drawn beneath (hidden, not removed, so it needn't be engraved again). While a
           piece plays it scrolls in its frame, the line being played kept in the frame's upper third (data-follow). *@
        <div class="piece-stage @(readingNotes ? "piece-stage-gone" : "")">
            <div class="piece-frame @(Pdf ? "pdf-frame" : "sheet-frame") @(view == View.Scroll && !Pdf ? "piece-frame-scroll" : "") @(options ? "piece-frame-hidden" : "")" @ref="frame"
                 data-follow="@(view == View.Scroll && !Pdf ? "" : null)" @onpointerdown="Down" @onpointerup="Up">
                @if (Pdf)
                {
                    @if (pdfBytes is not null)
                    {
                        <PdfPages @ref="pdf" Data="pdfBytes" Class="piece-pdf" OnOpened="Opened" />
                    }
                }
                else if (mei is not null)
                {
                    <Sheet @ref="sheet" Mei="@mei" Layout="@(view == View.Pages ? "page" : "scroll")" Page="page" Class="@(HandName is { } hand ? $"piece-sheet hands-{hand}" : "piece-sheet")" OnPages="Pages" OnPainted="Painted" OnBarTapped="@(id => BarOf(id) is { } bar ? Chose(bar) : Task.CompletedTask)" Explain="explain" OnSymbolTapped="SymbolTapped" />
                }
                @* A PDF's pages turn by its outer thirds too. A notation piece's thirds are its bars, to tap, so it turns by a swipe, ‹ ›
                   or the piano. *@
                @if (Pdf && view == View.Pages)
                {
                    <button type="button" class="turn-zone turn-back" aria-label="Back a page" @onclick="() => Tapped(-1)"></button>
                    <button type="button" class="turn-zone turn-on" aria-label="On a page" @onclick="() => Tapped(1)"></button>
                }
            </div>
            @if (options)
            {
                <section class="piece-options" aria-label="Options">
                    <div class="control-row">
                        <span class="control-label">View</span>
                        <button type="button" class="mu-toggle" aria-pressed="@On(view == View.Pages)" @onclick="() => SetView(View.Pages)"><span class="mu-led"></span>Pages</button>
                        <button type="button" class="mu-toggle" aria-pressed="@On(view == View.Scroll)" @onclick="() => SetView(View.Scroll)"><span class="mu-led"></span>@(Pdf ? "Scroll at the tempo" : "Scroll")</button>
                        @if (Pdf && view == View.Pages)
                        {
                            <button type="button" class="mu-toggle" aria-pressed="@On(halfTurns)" @onclick="ToggleHalf"><span class="mu-led"></span>Half-page turns</button>
                        }
                    </div>
                    @if (Pdf)
                    {
                        <div class="control-row">
                            <span class="control-label">Tempo</span>
                            <TempoControl Value="tempo" ValueChanged="SetTempo" />
                            @if (midi is not null && Keyboard.CanSend && Settings.SendToPiano)
                            {
                                <button type="button" class="mu-btn" @onclick="ToggleHear">@(hearing ? "Stop" : "Hear it on the piano")</button>
                            }
                        </div>
                        <div class="control-row">
                            <span class="control-label">Bars</span>
                            <button type="button" class="mu-btn" aria-label="Fewer beats a bar" @onclick="() => SetBeats(pdfLayout.BeatsPerBar - 1)">−</button>
                            <span class="control-value">@pdfLayout.BeatsPerBar beats a bar</span>
                            <button type="button" class="mu-btn" aria-label="More beats a bar" @onclick="() => SetBeats(pdfLayout.BeatsPerBar + 1)">+</button>
                            <button type="button" class="mu-btn" aria-label="Fewer bars a line" @onclick="() => SetBarsPerSystem(-1)">−</button>
                            <span class="control-value">@BarsPerSystemText() a line</span>
                            <button type="button" class="mu-btn" aria-label="More bars a line" @onclick="() => SetBarsPerSystem(1)">+</button>
                        </div>
                        <p class="section-note">Scrolling moves a line at a time, after a bar of count-in, at the tempo: bars a line × beats a bar × 60 ÷ tempo seconds a line. @(midi is not null ? "The tempo and metre start from the piece's MIDI." : "")</p>
                    }
                    else
                    {
                        @if (twoHands)
                        {
                            <div class="control-row">
                                <span class="control-label">Hands</span>
                                <button type="button" class="mu-toggle" aria-pressed="@On(handStaff is null)" @onclick="() => SetHands(null)"><span class="mu-led"></span>Both</button>
                                <button type="button" class="mu-toggle" aria-pressed="@On(handStaff == 1)" @onclick="() => SetHands(1)"><span class="mu-led"></span>Right</button>
                                <button type="button" class="mu-toggle" aria-pressed="@On(handStaff == 2)" @onclick="() => SetHands(2)"><span class="mu-led"></span>Left</button>
                            </div>
                            <div class="control-row">
                                <span class="control-label">Play along</span>
                                <button type="button" class="mu-toggle" aria-pressed="@On(!playAlong)" @onclick="() => SetPlayAlong(false)"><span class="mu-led"></span>Off</button>
                                <button type="button" class="mu-toggle" aria-pressed="@On(playAlong)" disabled="@(handStaff is null || !Keyboard.CanSend || !Settings.SendToPiano)" @onclick="() => SetPlayAlong(true)"><span class="mu-led"></span>The other hand</button>
                                <span class="control-note">@(!Keyboard.CanSend || !Settings.SendToPiano ? "Needs the piano to play notes from the tablet (Settings)." : handStaff is null ? "Choose a hand, and the piano plays the other In time." : "The piano plays the other hand In time.")</span>
                            </div>
                        }
                        <div class="control-row">
                            <span class="control-label">While playing</span>
                            <button type="button" class="mu-toggle" aria-pressed="@On(Settings.Cursor)" @onclick="() => ShowWhilePlaying(!Settings.Cursor, Settings.LiveMarks)"><span class="mu-led"></span>Cursor</button>
                            <button type="button" class="mu-toggle" aria-pressed="@On(Settings.LiveMarks)" @onclick="() => ShowWhilePlaying(Settings.Cursor, !Settings.LiveMarks)"><span class="mu-led"></span>Marks as you play</button>
                            <span class="control-note">@(Settings is { Cursor: true, LiveMarks: true } ? "Turn either off for less on the page as you play." : Settings.LiveMarks ? "The music still scrolls with the run." : "Every note is still judged, and marked when the run ends.")</span>
                        </div>
                        <div class="control-row">
                            <span class="control-label">Start at</span>
                            <span class="control-value">Bar @from</span>
                            @if (from > FirstBar)
                            {
                                <button type="button" class="mu-btn" @onclick="() => StartAt(FirstBar)">From the start</button>
                            }
                        </div>
                        <p class="section-note">Tap a bar, on the music or the strip of bars under the bar, to start from it, and while you play to go back to it (‹ Bar goes back a bar). Loop on its tab loops it: then a tap past either end stretches the loop to that bar and a tap inside trims its nearer end, or drag a handle, or drag along the strip for a loop over those bars; × ends it. @(twoHands ? "Right or Left listens for that hand alone and dims the other's notes. " : "")In time counts in a bar, then the click keeps the tempo and the cursor moves with the beat, each note marked as you play it (While playing turns either off). Wait for me waits at each note or chord until you've played its keys. A run follows the music's repeats. Listen has the piano play it from the same bar, at the tempo, after a bar of count-in: the hand chosen (and the other, with play along), or both; nothing is marked, so play along or just listen.</p>
                    }
                    @if (piece.IsPdf && mei is null && pdfBytes is not null)
                    {
                        <div class="options-rule"></div>
                        <div class="control-row control-row-top">
                            <span class="control-label">Notes</span>
                            <button type="button" class="mu-btn mu-primary" @onclick="ReadTheNotes">Read the notes…</button>
                            <p class="control-note">Claude reads the printed notes into notation. Then this piece works like the rest of the Library: Wait for me, marks on the music, Listen, loops and a real level.</p>
                        </div>
                    }
                    <div class="control-row">
                        <button type="button" class="mu-btn" @onclick="ToggleOptions">Back to the music</button>
                    </div>
                </section>
            }
            @if (explain && explained is { } symbol)
            {
                <SymbolCard Entry="symbol.Entry" Note="@symbol.Note" OnClose="() => explained = null" />
            }
            else if (explain)
            {
                <p class="explain-hint">What's this? Tap any symbol on the music.</p>
            }
            else if (loopTo == from && !playing && !options)
            {
                <p class="explain-hint">Looping bar @from: tap another bar to loop to it, or drag a handle.</p>
            }
        </div>

        @if (readingNotes && pdfBytes is not null)
        {
            <ReadNotes Piece="piece" Pdf="pdfBytes" Layout="pdfLayout.Pages" Tempo="tempo" OnBar="b => readingBar = b" OnClose="CloseReading" OnKept="Kept" />
        }

        @if (outcome is not null)
        {
            <section class="summary" aria-label="How it went">
                <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")" OnBar="StartAt" OnLoop="@(bars => { StartAt(bars.From); SetLoop(bars.To); })" />
            </section>
        }

        <section class="settings-section piece-about" aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">About this piece</h2>
            <ul class="summary-words">
                @* What's been done on it, from the runs kept: the last one, then how often it's been played through and played at all. *@
                @if (history is { } done)
                {
                    var today = DateOnly.FromDateTime(DateTime.Now);
                    <li>Last played @PieceWords.When(done.Last.Day, today): @PieceWords.How(done.Last), @PieceWords.Went(done.Last).</li>
                    @if (done.Runs > 1)
                    {
                        var through = done switch
                        {
                            { LastThrough: { } last, BestThrough: { } best } when last != best => $"Played through {done.Throughs} times In time: {PieceWords.Short(last)} the last time, {PieceWords.Short(best)} at best. ",
                            { LastThrough: { } last, Throughs: > 1 } => $"Played through {done.Throughs} times In time, the last the best: {PieceWords.Short(last)}. ",
                            { LastThrough: { } last } => $"Played through once In time: {PieceWords.Short(last)}. ",
                            _ => "",
                        };
                        <li>@through@done.Runs runs on @done.Days @(done.Days == 1 ? "day" : "days"), the first @PieceWords.When(done.Since, today).</li>
                    }
                }
                @if (piece.Reasons is { Length: > 0 } reasons)
                {
                    <li>Level @piece.Level for @reasons@(piece.TypicalLevel < piece.Level ? $"; most of it reads at {piece.TypicalLevel}" : "").</li>
                }
                else if (piece.IsPdf && mei is null && piece.Level is { } anchor)
                {
                    <li>About level @anchor, where its collection sits. Its notes aren't read yet: Options › Notes.</li>
                }
                @if (mei is not null && reading is { Kept: { } kept } && JsonSerializer.Deserialize<ReadingDraft>(reading.Result, Playground.AI.Assist.AssistSchema.Json) is { } read)
                {
                    <li>Its notes were read from the PDF by Claude on @kept.ToLocalTime().ToString("d MMMM", CultureInfo.InvariantCulture), for @("$" + read.Cost.ToString("0.00", CultureInfo.InvariantCulture))@(read.Doubts.Count == 0 ? "" : $"; bar{(read.Doubts.Select(d => d.Bar).Distinct().Count() == 1 ? "" : "s")} {string.Join(", ", read.Doubts.Select(d => d.Bar).Distinct().Order())} {(read.Doubts.Select(d => d.Bar).Distinct().Count() == 1 ? "was" : "were")} still in doubt when kept").</li>
                }
                @if (piece.Credit is { Length: > 0 } credit)
                {
                    <li>@credit @if (piece.LicenceUrl is { Length: > 0 }) { <a href="@piece.LicenceUrl" target="_blank" rel="noopener">@piece.Licence</a> } @if (piece.SourceUrl is { Length: > 0 }) { <span> · </span><a href="@piece.SourceUrl" target="_blank" rel="noopener">Source</a> }</li>
                }
                else if (piece.Imported)
                {
                    <li>Imported @piece.Added.ToLocalTime().ToString("d MMMM", CultureInfo.InvariantCulture) from @piece.File.</li>
                }
            </ul>
            @if (piece.Origin != "bundle" || piece.IsPdf && mei is not null && pdfBytes is not null)
            {
                <div class="control-row">
                    @if (piece.IsPdf && mei is not null && pdfBytes is not null && !readingNotes)
                    {
                        <button type="button" class="mu-btn" @onclick="ReadTheNotes">Read the notes again…</button>
                    }
                    @if (piece.Origin == "bundle")
                    {
                    }
                    else if (removing)
                    {
                        <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="Remove">Remove it</button>
                        <button type="button" class="mu-btn" @onclick="() => removing = false">Keep it</button>
                    }
                    else
                    {
                        <button type="button" class="mu-btn" @onclick="() => removing = true">Remove from the Library…</button>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private enum View { Pages, Scroll }

    [Parameter] public string Id { get; set; } = "";

    private PieceRecord? piece;
    private bool missing;
    private string? mei;
    private Score? score;
    private byte[]? pdfBytes;
    private MidiFile? midi;
    private Sheet? sheet;
    private PdfPages? pdf;
    private ElementReference frame;
    // The strip of bars under the piece's bar, bars.js that draws it and the choice on the music, and the choice it was last shown.
    private ElementReference strip;
    private IJSObjectReference? bars;
    private string? shownChoice;
    // What's been done on the piece, from its runs kept.
    private PieceHistory? history;
    // The first bar on the screen, as bars.js tells it: where the piece opens the next time. And whether it's been put back there.
    private int? seen;
    private bool placed;
    // A run going back a bar, or to a tapped one: the same go, so its time carries on.
    private bool restarting;
    private View view = View.Pages;
    private int page = 1;
    private int pages = 1;
    private double tempo = 72;
    private int from = 1;
    private bool removing;
    private IJSObjectReference? turns;
    private IJSObjectReference? keys;
    private DotNetObjectReference<Piece>? self;
    private double pointerX;
    private bool swiped;

    // Playing a notation piece, In time or Wait for me, from a bar to the end: the notes, each bar's first tick, the run's music
    // and how the last run went.
    private IReadOnlyList<ExpectedNote> expected = [];
    private Dictionary<int, long> barStarts = [];
    // The hand played, on a piece for two staves: the upper staff's notes (the right hand), the lower's (the left), or both
    // when null. Kept for each piece.
    private bool twoHands;
    private int? handStaff;
    private PlayMusic? music;
    // The play bar; the options in place of the music; full screen; a loop from the start bar to its last; the piano playing the
    // other hand.
    private PlayAlong? play;
    private bool options;
    private bool fullScreen;
    private int? loopTo;
    private bool playAlong;
    // What's this: on, the symbol tapped last (its entry, and for a note which note it is), and the MEI read for it.
    private bool explain;
    private (GlossaryEntry? Entry, string? Note)? explained;
    private XDocument? meiDocument;
    // A bar tapped to start at (lit even when it's the first); the piece's MEI measure ids, in order.
    private bool chosen;
    private List<string>? measureIds;
    private bool playing;
    private PlayOutcome? outcome;
    private DateTime started;
    private TaskCompletionSource? repainted;
    private Timer? ticker;

    // A PDF's pdfLayout, kept with the piece: each page's systems (in px at 900 wide), its metre and bars a line.
    private sealed record PdfLayoutState(List<List<PageSystem>> Pages, int BeatsPerBar, double Bpm);

    private PdfLayoutState pdfLayout = new([], 4, 72);

    // Reading the notes with Claude, in the music's place: whether it has the bar (while it reads and is reviewed), and the piece's
    // reading, waiting to be reviewed or kept. A PDF whose notes are read shows them as notation, and Print shows the PDF again.
    private bool readingNotes;
    private bool readingBar;
    private PieceReading? reading;
    private bool print;

    private bool Pdf => piece!.IsPdf && (mei is null || print);

    private IReadOnlyList<double> ratios = [];
    private double drawnWidth;
    private double y;
    private bool halfTurns = true;
    private int? half;
    private bool scrolling;
    private bool hearing;

    protected override async Task OnInitializedAsync()
    {
        piece = await Store.GetPieceAsync(Id);
        if (piece is null)
        {
            missing = true;
            return;
        }

        tempo = piece.Tempo ?? 72;
        if (piece.IsPdf)
        {
            pdfBytes = await ReadFile(piece.File);
            if (piece.Midi is not null && await ReadFile(piece.Midi) is { } bytes)
            {
                try
                {
                    midi = MidiFile.Read(bytes);
                }
                catch (FormatException)
                {
                }
            }
            if (piece.Layout is { } json) pdfLayout = JsonSerializer.Deserialize<PdfLayoutState>(json, PrimaStore.Json) ?? pdfLayout;
            else if (midi is not null) pdfLayout = pdfLayout with { BeatsPerBar = midi.BeatsPerBar, Bpm = Math.Round(midi.Bpm) };
            tempo = piece.Tempo ?? pdfLayout.Bpm;
            // A reading waiting to be reviewed opens at once.
            reading = await Store.GetReadingAsync(Id);
            readingNotes = reading is { Kept: null };
        }

        {
            mei = await Store.GetMeiAsync(Id);
            if (mei is { } text)
            {
                // Read away from the screen's thread: a long piece takes a moment.
                score = await Task.Run(() => MeiReader.Read(text));
                expected = score.Expected();
                // A bar number met again (a second ending, say) keeps its first place.
                barStarts = score.BarStarts().GroupBy(b => b.Bar.Number).ToDictionary(g => g.Key, g => g.First().Start);
                twoHands = expected.Select(n => n.Staff).Distinct().Order().SequenceEqual([1, 2]);
                // Kept for each piece: the view (the whole piece in one scroll unless it was Pages) and the hand.
                var stored = await Store.GetSettingsAsync();
                view = stored.GetValueOrDefault(ViewKey) == "pages" ? View.Pages : View.Scroll;
                handStaff = twoHands ? stored.GetValueOrDefault(HandsKey) switch { "right" => 1, "left" => 2, _ => null } : null;
                StartAt(FirstBar);
                history = PieceHistory.Of((await Store.GetPieceRunsAsync(Id)).Select(r => r.Run));
            }
        }

        if (piece.Position is { } position && JsonSerializer.Deserialize<Dictionary<string, double>>(position) is { } saved)
        {
            page = (int)saved.GetValueOrDefault("page", 1);
            y = saved.GetValueOrDefault("y", 0);
            // A notation piece opens where it was left: the bar it was to start from, or its loop, and the line that was at the
            // top of the screen (bars.js puts that back once the music is drawn).
            if (saved.TryGetValue("from", out var start) && barStarts.ContainsKey((int)start))
            {
                loopTo = saved.TryGetValue("to", out var last) ? Math.Min((int)last, LastBar) : null;
                StartAt((int)start);
            }
            seen = saved.TryGetValue("bar", out var top) ? (int)top : null;
        }
        await Store.SetPieceAsync(Id);
    }

    // A bundled file, or one imported into the Library's folder.
    private async Task<byte[]?> ReadFile(string? file)
    {
        if (file is null) return null;
        if (piece!.Origin != "bundle")
        {
            var path = Path.Combine(Store.FilesPath, file);
            return File.Exists(path) ? await File.ReadAllBytesAsync(path) : null;
        }
        return await Bundle.ReadAsync(file);
    }

    private bool listening;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (piece is null) return;

        // Once: a render while the imports below are awaited mustn't listen to the piano a second time.
        if (!listening)
        {
            listening = true;
            turns = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/turns.js");
            bars = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/bars.js");
            self = DotNetObjectReference.Create(this);
            keys = await turns.InvokeAsync<IJSObjectReference>("listenKeys", self);
            Keyboard.Received += Heard;
        }

        // The choice, drawn by bars.js on the music and the strip: the bar a run starts at (the first only once it's tapped), or
        // the loop's first to last. bars.js tells Chose, Looped and Loop of a change made there.
        if (bars is null || score is null || mei is null || Pdf || readingNotes || frame.Id is null) return;
        var lit = loopTo is not null || from > FirstBar || chosen;
        var choice = $"{from}|{loopTo}|{lit}|{playing}|{explain}|{mei.Length}";
        if (choice == shownChoice) return;

        shownChoice = choice;
        var ids = MeasureIds().Take(score.Bars.Count).ToArray();
        // The first time, with the bar that was at the top of the screen when the piece was left, to be put back there.
        var at = placed ? null : seen;
        placed = true;
        await bars.InvokeVoidAsync("show", frame, strip, self, new { from, to = loopTo, lit, playing, explain, firstBar = FirstBar, ids, at });
        await SavePosition();
    }

    // The first bar on the screen, once the music has stayed where it is a moment: kept as where the piece was left.
    [JSInvokable]
    public async Task Seen(int bar)
    {
        seen = bar;
        await SavePosition();
    }

    private string Kicker() => string.Join(" · ", new[] { piece!.Composer, piece.Work }.Where(s => !string.IsNullOrEmpty(s)));

    private string LevelText() => piece!.Level is { } level ? (piece.IsPdf && mei is null ? $"~{level}" : $"{level}") : "–";

    private string PlaceText() => Pdf && view == View.Scroll ? $"{CurrentSystem() + 1}" : $"{page} of {pages}";

    private void ReadTheNotes() => (readingNotes, options, explain) = (true, false, false);

    private void CloseReading() => (readingNotes, readingBar, options) = (false, false, piece!.IsPdf && mei is null);

    // Kept: the piece now has its notation, so it opens again as one.
    private void Kept() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    // A PDF read into notes: the print, as pages to turn, or the notation in the view it had.
    private async Task TogglePrint()
    {
        print = !print;
        StopScroll();
        view = print ? View.Pages : (await Store.GetSettingsAsync()).GetValueOrDefault(ViewKey) == "pages" ? View.Pages : View.Scroll;
        page = 1;
    }

    private static string On(bool on) => on ? "true" : "false";


    // Turning: buttons, the screen's thirds, a swipe, keys, the soft and sostenuto pedals, or the keyboard's top and bottom keys.
    [JSInvokable]
    public async Task Turn(int by)
    {
        if (piece is null) return;
        if (Pdf) await TurnPdf(by);
        else if (view == View.Pages) page = Math.Clamp(page + by, 1, pages);
        await SavePosition();
        StateHasChanged();
    }

    private Task Tapped(int by)
    {
        if (swiped)
        {
            swiped = false;
            return Task.CompletedTask;
        }
        return Turn(by);
    }

    private void Down(PointerEventArgs e) => (pointerX, swiped) = (e.ClientX, false);

    private async Task Up(PointerEventArgs e)
    {
        var dx = e.ClientX - pointerX;
        if (Math.Abs(dx) < 80) return;

        swiped = true;
        await Turn(dx < 0 ? 1 : -1);
    }

    private void Heard(MidiEvent e)
    {
        var by = e switch
        {
            { Kind: MidiKind.Control, Data1: MidiEvent.Soft, Data2: >= 64 } => 1,
            { Kind: MidiKind.Control, Data1: MidiEvent.Sostenuto, Data2: >= 64 } => -1,
            { Kind: MidiKind.NoteOn, Data1: NoteName.HighestKey } => 1,
            { Kind: MidiKind.NoteOn, Data1: NoteName.LowestKey } => -1,
            _ => 0,
        };
        if (by != 0 && !playing) _ = InvokeAsync(() => Turn(by));
    }

    private Task Pages(int count)
    {
        pages = Math.Max(1, count);
        page = Math.Clamp(page, 1, pages);
        return Task.CompletedTask;
    }

    // A run waits for the sheet to be drawn in its new layout before it starts.
    private void Painted(long _) => repainted?.TrySetResult();

    private async Task SetView(View to)
    {
        StopScroll();
        view = to;
        if (Pdf) await ShowPdf();
        else await Store.SetSettingAsync(ViewKey, to == View.Pages ? "pages" : null);
    }

    private string ViewKey => $"Library.View.{Id}";

    private void ToggleOptions() => options = !options;

    // What shows on the music while a run plays In time: kept in Settings, for every screen that plays to a tempo.
    private Task ShowWhilePlaying(bool cursor, bool marks)
    {
        (Settings.Cursor, Settings.LiveMarks) = (cursor, marks);
        return Store.SaveAsync(Settings);
    }

    private void ToggleExplain() => (explain, explained, options) = (!explain, null, false);

    // What's this: the symbol from the glossary; a note, or what's drawn on one, says which note it is and where it sits.
    private void SymbolTapped(SheetSymbol symbol)
    {
        meiDocument ??= mei is null ? null : XDocument.Parse(mei);
        var noteId = symbol.Kind == "note" ? symbol.Id : symbol.Kind is "accid" or "artic" or "dots" or "fing" ? symbol.Within : null;
        explained = (GlossaryLookup.Find(meiDocument, symbol), score is not null && noteId is not null ? GlossaryLookup.NoteLine(score, noteId) : null);
    }

    // Full screen: the piece alone, the tablet's own bars hidden too; the same button, or leaving the piece, brings them back.
    // The page changes first, then the tablet's own bars, so the rail goes as the key is pressed.
    private async Task ToggleFullScreen()
    {
        fullScreen = !fullScreen;
        if (turns is not null) await turns.InvokeVoidAsync("fullScreen", fullScreen);
        SystemBars.Show(!fullScreen);
    }

    private async Task SetTempo(double bpm)
    {
        tempo = Math.Clamp(bpm, 20, 240);
        await Store.SetPieceAsync(Id, tempo: tempo);
    }


    // Where the piece is: a PDF's page and how far down it; a notation piece's page, the bar it's to start from, its loop's
    // last bar, and the first bar on the screen.
    private Task SavePosition()
    {
        var place = new Dictionary<string, double> { ["page"] = page, ["y"] = y };
        if (score is not null) place["from"] = from;
        if (loopTo is { } to) place["to"] = to;
        if (seen is { } bar) place["bar"] = bar;
        return Store.SetPieceAsync(Id, position: JsonSerializer.Serialize(place));
    }

    // ——— Playing a notation piece ———

    private int FirstBar => score?.Bars[0].Number ?? 1;

    private int LastBar => score?.Bars[^1].Number ?? 1;

    // From a bar to the end, through the repeats as they're played; or in a loop, its bars again and again (fifty times: until
    // stopped), each time round a pass the play bar scores. The run counts from that bar's downbeat, or from bar 1's for the
    // opening pickup, which comes in the count-in's last beats. Bars are numbered in order, so a bar's index is its number on
    // from the first's. Play along gives the piano the other hand's notes.
    private void StartAt(int bar)
    {
        if (score is null || !barStarts.TryGetValue(bar, out var start)) return;

        from = bar;
        if (loopTo is { } to) loopTo = Math.Max(to, bar);
        var first = bar - FirstBar;
        var loop = loopTo is { } last ? Enumerable.Range(first, last - bar + 1).ToList() : null;
        IReadOnlyList<int> order = loop is null ? score.PlayOrder(first) : [.. Enumerable.Repeat(loop, 50).SelectMany(r => r)];
        var notes = score.Performed(order);
        var beatZero = Math.Max(0, start);
        double Beats(long ticks) => ticks / (double)score.Meter.BeatTicks;
        var otherHand = playAlong && handStaff is { } staff ? notes.Where(n => n.Staff != staff) : null;
        var other = otherHand?.Select(n => (n.Midi, Beats(n.Tick - beatZero), Beats(n.Length))).ToList();
        music = new PlayMusic(score, [.. notes.Where(n => handStaff is null || n.Staff == handStaff)], beatZero) { PianoPart = other, Order = order, LoopBars = loop?.Count };
    }

    private string StartLabel
    {
        get
        {
            var hand = HandName;
            if (loopTo is { } to)
            {
                var bars = to == from ? $"bar {from}" : $"bars {from}–{to}";
                return hand is null ? $"Loop {bars}" : $"Loop {bars}, {hand} hand";
            }
            return $"Play{(hand is null ? "" : $" the {hand} hand")}{(from > FirstBar ? $" from bar {from}" : "")}";
        }
    }

    private void SetLoop(int? last)
    {
        loopTo = last is { } to ? Math.Clamp(to, from, LastBar) : null;
        StartAt(from);
    }

    private void SetPlayAlong(bool on)
    {
        playAlong = on;
        StartAt(from);
    }

    // Back a bar while playing (to the loop's start, in a loop), or to a tapped note's bar: the run stops and starts again there,
    // still listening if it was.
    private Task Back(int bar) => Restart(loopTo is null ? Math.Max(FirstBar, bar - 1) : from);

    private async Task Restart(int bar)
    {
        if (play is null) return;

        StartAt(bar);
        if (music is null) return;

        restarting = true;
        await play.Restart(music);
        restarting = false;
    }

    private string HandsKey => $"Library.Hands.{Id}";

    private string? HandName => handStaff switch { 1 => "right", 2 => "left", _ => null };

    private async Task SetHands(int? staff)
    {
        handStaff = staff;
        StartAt(from);
        await Store.SetSettingAsync(HandsKey, HandName);
    }

    // A bar tapped on the music, anywhere in it, or on the strip: the start goes there, lit. In a loop, the loop's nearer end goes
    // there instead: past either end it stretches the loop, inside it trims it (the end, when the bar is as near both). While
    // playing, the run starts again from it. As pages, the page with the bar shows (one tapped on the strip may be on another).
    [JSInvokable]
    public async Task Chose(int bar)
    {
        if (playing)
        {
            await Restart(bar);
            return;
        }

        if (loopTo is { } last)
        {
            var end = bar > last || bar > from && last - bar <= bar - from;
            if (end) loopTo = bar;
            StartAt(end ? from : bar);
        }
        else
        {
            chosen = true;
            StartAt(bar);
        }

        if (view == View.Pages && sheet is not null && MeasureOf(bar) is { } id && await sheet.PageOf(id) is > 0 and var on && on != page)
        {
            page = on;
            await SavePosition();
        }
        StateHasChanged();
    }

    // A loop dragged out on the strip, or one of its ends dragged there or on the music: its first bar to its last.
    [JSInvokable]
    public void Looped(int first, int last)
    {
        if (playing) return;

        loopTo = last;
        StartAt(first);
        StateHasChanged();
    }

    // The key on the chosen bar's tab: Loop loops that bar, which taps or a handle then stretch or trim; × takes the loop away.
    [JSInvokable]
    public void Loop(bool on)
    {
        SetLoop(on ? from : null);
        StateHasChanged();
    }

    // The piece's bars by their MEI ids, in order (the bars are numbered in order too), for taps on the sheet and for bars.js.
    private List<string> MeasureIds()
    {
        meiDocument ??= mei is null ? null : XDocument.Parse(mei);
        return measureIds ??= meiDocument?.Descendants().Where(e => e.Name.LocalName == "measure").Select(m => (string?)m.Attribute(XNamespace.Xml + "id") ?? "").ToList() ?? [];
    }

    private int? BarOf(string measureId)
    {
        var index = MeasureIds().IndexOf(measureId);
        return score is not null && index >= 0 && index < score.Bars.Count ? score.Bars[index].Number : null;
    }

    private string? MeasureOf(int bar)
    {
        var index = bar - FirstBar;
        return index >= 0 && index < MeasureIds().Count ? MeasureIds()[index] : null;
    }

    // The run plays in the scrolling view, a line at a time: for the run, so a piece kept in Pages opens in Pages the next time.
    private async Task Starting()
    {
        (playing, outcome, started, options, explain, explained) = (true, null, restarting ? started : DateTime.Now, false, false, null);
        if (view == View.Scroll) return;

        repainted = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        view = View.Scroll;
        StateHasChanged();
        await Task.WhenAny(repainted.Task, Task.Delay(4000));
    }

    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        // Stopped before a key that could be judged (in the count-in, or with nothing played): there's no run to keep.
        if (how is { InTime: null, Wait: null or { Notes: 0 } }) return;

        var today = DateOnly.FromDateTime(DateTime.Now);
        var (right, notes, clean) = how.InTime is { } timed ? (timed.Right, timed.Expected, timed.Clean) : (how.Wait!.RightFirstTime, how.Wait.Notes, how.Wait.WrongKeys == 0 && how.Wait.Apart == 0 && how.Wait.Finished);
        // Round a loop, its last bar and each pass, and the run's figures are its last pass's.
        var (to, passes) = (how.Loop?.To, how.Loop is null ? null : how.Passes.Select(p => new { right = p.Right, notes = p.Notes, inTime = p.RightInTime }));
        object measures = how.InTime is { } r
            ? new { inTime = r.InTimeAccuracy, right = r.Right, wrong = r.Wrong, missed = r.Missed, extra = r.Extra, keptGoing = r.KeptGoing, holds = r.HoldsJudged, letGoEarly = r.LetGoEarly, from, to, passes, stopped = how.Stopped, bar = how.Bar, hands = HandName ?? "both" }
            : new { rightFirstTime = how.Wait!.RightFirstTime, notes = how.Wait.Notes, wrongKeys = how.Wait.WrongKeys, apart = how.Wait.Apart, seconds = how.Wait.Seconds, from, to, passes, stopped = how.Stopped, bar = how.Bar, hands = HandName ?? "both" };
        var firstNs = how.Played.Count == 0 ? 0 : how.Played[0].OnNs;
        await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, today, "piece", how.Mode == PlayMode.InTime ? "in time" : "wait", Id, piece!.Level, how.Mode == PlayMode.InTime ? tempo : null, null, null, JsonSerializer.Serialize(how.Played.Select(p => new[] { p.Midi, (p.OnNs - firstNs) / 1e6 })), null, JsonSerializer.Serialize(measures), notes == 0 ? null : right / (double)notes, clean, null));
        await Store.AddMinutesAsync(today, (DateTime.Now - started).TotalMinutes);
        history = PieceHistory.Of((await Store.GetPieceRunsAsync(Id)).Select(r => r.Run));
    }

    // ——— A PDF piece ———

    private async Task Opened(IReadOnlyList<double> shapes)
    {
        ratios = shapes;
        if (pdf is null) return;

        // Each page's systems are found once and kept: staff lines, five to a staff, paired into grand staves.
        if (pdfLayout.Pages.Count != shapes.Count)
        {
            var found = new List<List<PageSystem>>();
            for (var n = 1; n <= shapes.Count; n++) found.Add([.. PdfLayout.FindSystems(await pdf.Profile(n))]);
            var systems = found.Sum(p => p.Count);
            var barsPerSystem = midi is { Bars: > 0 } && systems > 0 ? Math.Max(1, (int)Math.Round(midi.Bars / (double)systems)) : 4;
            pdfLayout = pdfLayout with { Pages = [.. found.Select(p => p.Select(s => s with { Bars = barsPerSystem }).ToList())] };
            await SaveLayout();
        }
        pages = shapes.Count;
        await ShowPdf();
    }

    private Task SaveLayout() => Store.SetPieceAsync(Id, layout: JsonSerializer.Serialize(pdfLayout, PrimaStore.Json));

    // Portrait shows a page at a time, whole; landscape a window down the pages, moved a screen of systems at a time.
    private double frameHeight;
    private double frameWidth;

    private async Task Measure()
    {
        if (turns is null) return;

        var box = await turns.InvokeAsync<double[]>("size", frame);
        (frameWidth, frameHeight) = (box[0], box[1]);
    }

    private async Task ShowPdf()
    {
        if (pdf is null || ratios.Count == 0) return;

        await Measure();
        var fit = view == View.Pages && frameHeight >= frameWidth / ratios.Min();
        var portraitFit = view == View.Pages && frameWidth < frameHeight;
        drawnWidth = await pdf.PageWidth(portraitFit || fit);
        if (portraitFit || fit) y = PageTop(Math.Clamp(page, 1, pages));
        var (cover, shown) = half is { } h ? HalfSplit(h - 1) : (0, 0);
        await pdf.Show(y, 0, portraitFit || fit, half, cover, shown);
        await pdf.Band(null);
    }

    private double PageHeight(int n) => drawnWidth / ratios[n - 1];

    private double PageTop(int n) => Enumerable.Range(1, n - 1).Sum(PageHeight);

    private double Scale => drawnWidth / 900;

    // Every system down the pages, in px at the drawn width, with its bars.
    private List<(int Page, double Top, double Bottom, int Bars)> Systems() => [.. pdfLayout.Pages.SelectMany((systems, i) => systems.Select(s => (i + 1, PageTop(i + 1) + s.Top * Scale, PageTop(i + 1) + s.Bottom * Scale, s.Bars)))];

    // A half-page turn from page current to the next, in px as drawn (the systems were found on pages drawn 900 wide).
    private (double Cover, double Shown) HalfSplit(int current)
    {
        if (current < 1 || current >= pdfLayout.Pages.Count) return (PageHeight(Math.Max(1, current)) / 2, PageHeight(Math.Max(1, current)) / 2);

        var (cover, shown) = PdfLayout.HalfTurn(pdfLayout.Pages[current - 1], 900 / ratios[current - 1], pdfLayout.Pages[current]);
        return (cover * Scale, shown * Scale);
    }

    private async Task TurnPdf(int by)
    {
        if (pdf is null || ratios.Count == 0) return;

        await Measure();
        var whole = view == View.Pages && frameWidth < frameHeight;
        if (whole)
        {
            // Half-page turns: on, the next page's top shows over this one's bottom; on again, the next page whole.
            if (by > 0 && halfTurns && half is null && page < pages) half = page + 1;
            else if (by > 0 && page < pages) (page, half) = (page + 1, null);
            else if (by < 0 && half is not null) half = null;
            else if (by < 0 && page > 1) page--;
            await ShowPdf();
            return;
        }

        // A window down the pages: on to the first system that isn't wholly in sight, or back by a screen.
        var systems = Systems();
        var total = PageTop(pages) + PageHeight(pages);
        if (by > 0) y = systems.FirstOrDefault(s => s.Bottom > y + frameHeight - 4).Top is var top && top > y ? top - 12 : Math.Min(total - frameHeight, y + frameHeight * 0.8);
        else y = systems.LastOrDefault(s => s.Top < y - frameHeight * 0.6).Top is var back && back < y ? Math.Max(0, back - 12) : Math.Max(0, y - frameHeight * 0.8);
        y = Math.Clamp(y, 0, Math.Max(0, total - frameHeight / 2));
        page = systems.LastOrDefault(s => s.Top <= y + frameHeight / 3).Page is > 0 and var p ? p : page;
        await pdf.Show(y, 300);
    }

    private async Task ToggleHalf()
    {
        halfTurns = !halfTurns;
        half = null;
        await ShowPdf();
    }

    private async Task SetBeats(int beats)
    {
        pdfLayout = pdfLayout with { BeatsPerBar = Math.Clamp(beats, 1, 12) };
        await SaveLayout();
    }

    private async Task SetBarsPerSystem(int by)
    {
        pdfLayout = pdfLayout with { Pages = [.. pdfLayout.Pages.Select(p => p.Select(s => s with { Bars = Math.Clamp(s.Bars + by, 1, 12) }).ToList())] };
        await SaveLayout();
    }

    private string BarsPerSystemText()
    {
        var counts = pdfLayout.Pages.SelectMany(p => p.Select(s => s.Bars)).Distinct().ToList();
        return counts.Count == 0 ? "4 bars" : counts.Count == 1 ? $"{counts[0]} {(counts[0] == 1 ? "bar" : "bars")}" : $"{counts.Min()}–{counts.Max()} bars";
    }

    // ——— Scrolling a PDF at the tempo ———

    private int CurrentSystem()
    {
        var systems = Systems();
        return Math.Max(0, systems.FindLastIndex(s => s.Top <= y + frameHeight / 3 + 1));
    }

    private int scrollSystem = -1;

    private async Task ToggleScroll()
    {
        if (scrolling)
        {
            StopScroll();
            await pdf!.Band(null);
            return;
        }

        var systems = Systems();
        if (systems.Count == 0) return;

        await Measure();
        scrolling = true;
        scrollSystem = -1;
        // A bar of count-in on the click, then the music; the click goes quiet after the count-in.
        Click.Start(new ClickPlan(tempo, pdfLayout.BeatsPerBar, 1, ClickStage.CountInOnly));
        ticker = new Timer(_ => InvokeAsync(ScrollOn), null, 0, 100);
    }

    private async Task ScrollOn()
    {
        if (!scrolling || pdf is null || Click.Plan is null) return;

        var systems = Systems();
        var beat = (Clock.NowNs - Click.BeatTime(0)) / (double)Click.Plan.BeatNs - Click.Plan.FirstMusicBeat;
        if (beat < 0) return;

        // Which system the music is in: each lasts its bars × beats a bar.
        var elapsed = 0.0;
        var index = 0;
        while (index < systems.Count && elapsed + systems[index].Bars * pdfLayout.BeatsPerBar <= beat) elapsed += systems[index++].Bars * pdfLayout.BeatsPerBar;
        if (index >= systems.Count)
        {
            StopScroll();
            await pdf.Band(null);
            StateHasChanged();
            return;
        }
        if (index == scrollSystem) return;

        scrollSystem = index;
        var system = systems[index];
        y = Math.Max(0, system.Top - frameHeight / 3);
        page = system.Page;
        await pdf.Show(y, 400);
        await pdf.Band(system.Top, system.Bottom);
        StateHasChanged();
    }

    private void StopScroll()
    {
        if (!scrolling) return;

        scrolling = false;
        ticker?.Dispose();
        ticker = null;
        Click.Stop();
    }

    // ——— Hearing a PDF's MIDI on the piano, on Prima's channel ———

    private void ToggleHear()
    {
        if (hearing)
        {
            Keyboard.Silence();
            hearing = false;
            return;
        }
        if (midi is null) return;

        var start = Clock.NowNs + 300_000_000;
        var speed = tempo / midi.Bpm;
        foreach (var note in midi.Notes)
        {
            Keyboard.Send([0x9F, (byte)note.Midi, (byte)Math.Clamp(note.Velocity, 1, 127)], start + (long)(note.Start / speed * 1e9));
            Keyboard.Send([0x8F, (byte)note.Midi, 0], start + (long)(note.End / speed * 1e9));
        }
        hearing = true;
    }

    private async Task Remove()
    {
        // A PDF that isn't the bundle's keeps its file, and maybe its MIDI, beside the imports.
        if (piece is { IsPdf: true } && piece.Origin != "bundle")
        {
            foreach (var file in new[] { piece.File, piece.Midi }.OfType<string>()) File.Delete(Path.Combine(Store.FilesPath, file));
        }
        await Store.DeletePieceAsync(Id);
        Nav.NavigateTo("library");
    }

    public async ValueTask DisposeAsync()
    {
        Keyboard.Received -= Heard;
        ticker?.Dispose();
        StopScroll();
        if (hearing) Keyboard.Silence();
        if (fullScreen) SystemBars.Show(true);
        try
        {
            if (fullScreen && turns is not null) await turns.InvokeVoidAsync("fullScreen", false);
            if (keys is not null) await keys.InvokeVoidAsync("dispose");
            if (turns is not null) await turns.DisposeAsync();
            if (bars is not null)
            {
                await bars.InvokeVoidAsync("forget", frame);
                await bars.DisposeAsync();
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
        self?.Dispose();
    }
}
