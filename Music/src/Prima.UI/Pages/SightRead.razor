@page "/sight-read"
@implements IDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject IScreen Screen
@inject Click Click
@inject SessionRegistry Registry
@inject NavigationManager Nav
@using Prima.Core.Generation
@using Prima.Core.Practice
@using Prima.Core.Scoring
@using Prima.UI.Practice

<PageTitle>Sight-read · Prima</PageTitle>

<div class="reading @(stage == Stage.Choose ? "" : "reading-on")">
    <header class="reading-head">
        <div>
            <p class="page-kicker">@Kicker()</p>
            <h1 class="page-title">@(passage?.Description ?? (Spot == 1 ? "One spot" : "Sight-read"))</h1>
        </div>
        <KeyboardLamp />
    </header>

    @if (stage == Stage.Choose && PieceId is not null)
    {
        <p class="page-note">That piece isn't in the Library any more.</p>
        <div class="control-row"><a class="mu-btn" href="library">Library</a></div>
    }
    else if (stage == Stage.Choose && Spot == 1)
    {
        <section class="mu-screen reading-start" aria-label="One spot">
            <div class="mu-screen-head"><span>One spot</span><span>@(spotFrom is null ? "" : $"Bar {spotBar}")</span></div>
            <p class="page-panel-line">@(spotFrom is null
                ? "Nothing to fix today: every passage so far was clean. Read one more instead, or pick a piece from the Library."
                : $"Bar {spotBar} of the passage you read at {spotFrom.At.ToLocalTime():HH:mm} had the most to fix. Play it 20% slower, then the bars around it at its tempo.")</p>
        </section>
        <div class="control-row control-row-play">
            @if (spotFrom is null)
            {
                <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="async () => { Spot = null; await NewPassage(); }">Read one more</button>
                <a class="mu-btn" href="library">Library</a>
            }
            else
            {
                <button type="button" class="mu-play" aria-label="Play the bar" data-piano="go" @onclick="() => StartSpot(1)"><svg viewBox="0 0 20 20" width="28" height="28" aria-hidden="true"><path d="M6 3L17 10L6 17Z" fill="currentColor"></path></svg></button>
            }
            <button type="button" class="mu-btn" @onclick="Done">Back</button>
        </div>
    }
    else if (stage == Stage.Choose)
    {
        <section class="mu-screen reading-start" aria-label="Before starting">
            <div class="mu-screen-head"><span>@(reading is null ? "First time" : $"Level {reading.Level}")</span><span>@(reading is null ? "" : $"{reading.Tempo:0} bpm")</span></div>
            <p class="page-panel-line">@(reading is null
                ? "Find your level: two short passages from each level, from the start, until they fall under 80% in time. Or start at level 1."
                : "A new passage at your level: thirty seconds to look, a bar of count-in, then play in time. The click never waits.")</p>
            <div class="mu-readouts">
                <div class="mu-readout"><span class="mu-readout-label">Level</span><span class="mu-readout-value">@(reading?.Level.ToString(CultureInfo.InvariantCulture) ?? "–")</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Reading score</span><span class="mu-readout-value">@(reading?.Score.ToString("0.0", CultureInfo.InvariantCulture) ?? "–")</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Today</span><span class="mu-readout-value">@passagesToday</span></div>
            </div>
        </section>
        <div class="control-row">
            <span class="control-label">Variant</span>
            @foreach (var v in Variants)
            {
                var disabled = v is Variant.Duet or Variant.HearFirst && !PianoPlays;
                <button type="button" class="mu-toggle" disabled="@disabled" aria-pressed="@(variant == v ? "true" : "false")" @onclick="() => chosen = variant = variant == v ? null : v"><span class="mu-led"></span>@VariantName(v)</button>
            }
        </div>
        <div class="control-row control-row-play">
            @if (reading is null)
            {
                <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="FindLevel">Find my level</button>
                <button type="button" class="mu-btn" @onclick="StartAtOne">Start at level 1</button>
            }
            else
            {
                <button type="button" class="mu-play" aria-label="New passage" data-piano="go" @onclick="NewPassage"><svg viewBox="0 0 20 20" width="28" height="28" aria-hidden="true"><path d="M6 3L17 10L6 17Z" fill="currentColor"></path></svg></button>
                <button type="button" class="mu-btn" @onclick="FindLevel">Find my level</button>
            }
            @if (!PianoPlays)
            {
                <p class="control-note">Duet and Hear first need the piano to play notes from the tablet.</p>
            }
        </div>
    }
    else if (passage is not null)
    {
        <section class="reading-bar" aria-label="Where you are">
            @if (stage is Stage.Run or Stage.Hear && session is { Phase: Phase.CountIn })
            {
                <CountIn Session="session" />
            }
            else
            {
                <div class="mu-readout"><span class="mu-readout-label">@PhaseName()</span><span class="mu-readout-value">@PhaseValue()</span></div>
            }
            <div class="mu-readout"><span class="mu-readout-label">Tempo</span><span class="mu-readout-value">@tempo.ToString("0", CultureInfo.InvariantCulture)</span></div>
            <div class="mu-readout"><span class="mu-readout-label">Level</span><span class="mu-readout-value">@passage.Spec.Level</span></div>
            @if (stage == Stage.Look)
            {
                <div class="reading-look"><span style="width: @(LookShare().ToString("0.###", CultureInfo.InvariantCulture))%"></span></div>
                <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="Run">Start</button>
            }
        </section>

        @* One spot's single bar is shown larger, at about its printed width, not stretched across the sheet. *@
        <div class="sheet-frame @(spotPart == 1 ? "spot-frame" : "")">
            <Sheet @ref="sheet" Mei="@mei" Measures="@measures" Onsets="@onsets" Scale="@(spotPart == 1 ? 1.25 : 1)" OnNoteTapped="Tapped" />
        </div>

        @if (stage == Stage.Summary && result is not null)
        {
            <section class="summary" aria-label="How it went">
                <div class="mu-screen summary-figures">
                    <div class="mu-readouts">
                        <div class="mu-readout @(result.InTimeAccuracy < 0.8 ? "miss" : "")"><span class="mu-readout-label">In time</span><span class="mu-readout-value">@($"{(result.InTimeAccuracy) * 100:0}%")</span></div>
                        <div class="mu-readout"><span class="mu-readout-label">Notes a minute</span><span class="mu-readout-value">@result.CorrectPerMinute.ToString("0", CultureInfo.InvariantCulture)</span></div>
                        <div class="mu-readout"><span class="mu-readout-label">Kept going</span><span class="mu-readout-value">@(result.KeptGoing ? "Yes" : "No")</span></div>
                        <div class="mu-readout"><span class="mu-readout-label">Lean</span><span class="mu-readout-value">@Lean()</span></div>
                    </div>
                </div>
                <ul class="summary-words">
                    @foreach (var line in Words())
                    {
                        <li>@line</li>
                    }
                </ul>
                @if (tapped is not null)
                {
                    <p class="control-note">@tapped</p>
                }
                @if (showTimeline)
                {
                    <Timeline Result="result" />
                }
                <div class="control-row">
                    @if (practising is not null)
                    {
                        <button type="button" class="mu-btn mu-primary" data-piano="again" @onclick="() => Practise(0)">Again</button>
                        <button type="button" class="mu-btn" @onclick="() => Practise(0, 0.9)">Slower</button>
                        <button type="button" class="mu-btn" @onclick="() => Practise(0, 1.08)">Faster</button>
                        <button type="button" class="mu-btn" data-piano="go" @onclick="() => Practise(1)">The next bars</button>
                    }
                    else if (spotPart == 1)
                    {
                        <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="() => StartSpot(2)">Now the bars around it</button>
                        <button type="button" class="mu-btn" data-piano="again" @onclick="() => StartSpot(1)">The bar again</button>
                    }
                    else if (spotPart == 2)
                    {
                        <button type="button" class="mu-btn" data-piano="again" @onclick="() => StartSpot(2)">Again</button>
                    }
                    else if (finding)
                    {
                        <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="NewPassage">Next</button>
                    }
                    else
                    {
                        <button type="button" class="mu-play" aria-label="Next passage" data-piano="go" @onclick="NewPassage"><svg viewBox="0 0 20 20" width="28" height="28" aria-hidden="true"><path d="M6 3L17 10L6 17Z" fill="currentColor"></path></svg></button>
                        <button type="button" class="mu-btn" data-piano="again" @onclick="Again">Again</button>
                        <button type="button" class="mu-btn" @onclick="Slower">Slower</button>
                        <button type="button" class="mu-btn" @onclick="FindLevel">Find my level</button>
                    }
                    <button type="button" class="mu-btn" @onclick="() => showTimeline = !showTimeline">@(showTimeline ? "Hide details" : "Details")</button>
                    <button type="button" class="mu-btn" data-piano="@(spotPart == 2 ? "go" : null)" @onclick="Done">Done</button>
                </div>
            </section>
        }
    }
</div>

@code {
    private enum Stage { Choose, Hear, Look, Run, Summary }

    private static readonly Variant[] Variants = [Variant.ReadAhead, Variant.Duet, Variant.HearFirst];

    // Thirty seconds to look at a passage; ten at one spot's single bar.
    private double LookSeconds => spotPart == 1 ? 10 : 30;

    [SupplyParameterFromQuery(Name = "variant")] public string? VariantQuery { get; set; }

    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    /// <summary>1 for Today's one-spot step: the bar with the most to fix today, slower, then the bars around it.</summary>
    [SupplyParameterFromQuery(Name = "spot")] public int? Spot { get; set; }

    /// <summary>A piece from the Library to practise, its bars ("9-16") and the tempo: Again, Slower, Faster and the next bars after.</summary>
    [SupplyParameterFromQuery(Name = "piece")] public string? PieceId { get; set; }

    [SupplyParameterFromQuery(Name = "bars")] public string? BarsQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tempo")] public double? TempoQuery { get; set; }

    private Stage stage = Stage.Choose;
    private ReadingState? reading;
    private Passage? passage;
    private string mei = "";
    private Variant? variant;
    private double tempo;
    private PlaySession? session;
    private PassageResult? result;
    private Sheet? sheet;

    // The run's notes judged as they're played, and each note's written pitch and time on the sheet, in quarters from its start.
    private LiveJudge? judge;
    private Dictionary<string, (Spelled Written, double Quarter)> onSheet = [];
    private DateTime lookStarted;
    private DateTime runStarted;
    private Timer? ticker;
    private bool finding;
    private int findLevel;
    // The same passage again: a second reading is practice, so it doesn't move the level or count as one of today's passages.
    private bool repeat;
    private readonly List<double> findResults = [];
    private int passagesToday;
    private Key? lastKey;
    private Key? avoidKey;
    private string? tapped;
    private bool showTimeline;
    private bool pianoPart;
    private AttemptRecord? spotFrom;
    private int spotBar;
    private int spotPart;
    private Passage? spotPassage;
    private double spotTempo;
    private int spotStep;

    // Real music on the sheet: the piece's own engraving, only the bars being read (by position), the cursor on its notes.
    private string? measures;
    private IReadOnlyList<(string Id, double Quarter)>? onsets;
    private ReadyPassage? ready;
    private Variant? chosen;

    // Practising a piece's bars.
    private PieceRecord? practising;
    private string? practisingMei;
    private Score? practisingScore;
    private (int First, int Last) practiseBars;

    private bool PianoPlays => Keyboard.CanSend && Settings.SendToPiano;

    protected override async Task OnInitializedAsync()
    {
        reading = await Store.GetTrackAsync<ReadingState>("reading");
        var todays = (await Store.GetAttemptsAsync(Today, "passage")).Where(a => a.Day == Today).ToList();
        (passagesToday, lastKey) = (todays.Count, DayPassages.KeyOf(todays.LastOrDefault()));
        chosen = variant = Enum.TryParse<Variant>(VariantQuery, true, out var v) ? v : null;
        if (Spot == 1) await FindSpot(todays);
        if (PieceId is not null && await Store.GetPieceAsync(PieceId) is { IsPdf: false } piece && await Store.GetMeiAsync(PieceId) is { } pieceMei)
        {
            (practising, practisingMei, practisingScore) = (piece, pieceMei, await Task.Run(() => MeiReader.Read(pieceMei)));
            var parts = (BarsQuery ?? "1-4").Split('-');
            var first = parts.Length > 0 && int.TryParse(parts[0], out var f) ? f : 1;
            var last = parts.Length > 1 && int.TryParse(parts[1], out var l) ? l : first + 3;
            practiseBars = (first, last);
            tempo = TempoQuery ?? piece.Tempo ?? 72;
            Practise(0);
        }
    }

    // A piece's bars on the reading screen: the same look, count-in, click, marks and summary; the level doesn't move.
    private void Practise(int on, double speed = 1)
    {
        if (practising is null || practisingScore is null || practisingMei is null) return;

        StopRun();
        var lastBar = practisingScore.Bars[^1].Number;
        var length = practiseBars.Last - practiseBars.First + 1;
        var first = Math.Clamp(practiseBars.First + on * length, practisingScore.Bars[0].Number, lastBar);
        practiseBars = (first, Math.Min(lastBar, first + length - 1));
        tempo = Math.Clamp(Math.Round(tempo * speed), 20, 240);
        variant = null;
        Show(DayPassages.Real(practising, practisingMei, practisingScore, practiseBars.First, practiseBars.Last, practising.TypicalLevel ?? practising.Level ?? 6, description: $"Bars {Math.Max(1, practiseBars.First)} to {practiseBars.Last}"));
        BeginLook();
    }

    private void Show(ReadyPassage next)
    {
        ready = next;
        passage = next.Passage;
        (mei, measures, onsets) = (next.Mei, next.Measures, next.Onsets);
        (result, tapped, showTimeline) = (null, null, false);
    }

    // Today's passage with the most errors in one bar (the latest, on a tie), made again from its seed, level and step, or from the
    // piece it was an excerpt of.
    private ReadyPassage? spotReal;

    private async Task FindSpot(List<AttemptRecord> attempts)
    {
        var worst = attempts.Where(a => a.Day == Today && a.Seed is not null && a.Level is not null && a.Tempo is not null).Select(a =>
        {
            using var measures = System.Text.Json.JsonDocument.Parse(a.Measures);
            var bar = measures.RootElement.TryGetProperty("worstBar", out var b) && b.ValueKind == System.Text.Json.JsonValueKind.Number ? b.GetInt32() : (int?)null;
            var errors = measures.RootElement.TryGetProperty("worstErrors", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.Number ? e.GetInt32() : 1;
            return (Attempt: a, Bar: bar, Errors: errors);
        }).Where(w => w.Bar is not null).OrderByDescending(w => w.Errors).ThenByDescending(w => w.Attempt.At).FirstOrDefault();
        if (worst.Attempt is null) return;

        using var settings = System.Text.Json.JsonDocument.Parse(worst.Attempt.Settings ?? "{}");
        if (settings.RootElement.TryGetProperty("excerpt", out var ex) && ex.ValueKind == System.Text.Json.JsonValueKind.Number)
        {
            if (await Store.GetExcerptAsync(ex.GetInt64()) is not { } excerpt || await Store.GetPieceAsync(excerpt.Piece) is not { } piece || await Store.GetMeiAsync(excerpt.Piece) is not { } pieceMei) return;

            spotReal = DayPassages.Real(piece, pieceMei, await Task.Run(() => MeiReader.Read(pieceMei)), excerpt.FirstBar, excerpt.LastBar, excerpt.Level, excerpt);
            spotPassage = spotReal.Passage;
            (spotFrom, spotBar, spotTempo, spotStep) = (worst.Attempt, worst.Bar!.Value, worst.Attempt.Tempo!.Value, 4);
            return;
        }

        var step = settings.RootElement.TryGetProperty("step", out var s) ? s.GetInt32() : 4;
        Key? avoid = settings.RootElement.TryGetProperty("avoid", out var k) && k.ValueKind == System.Text.Json.JsonValueKind.Object ? new Key(k.GetProperty("fifths").GetInt32(), k.GetProperty("minor").GetBoolean()) : null;
        spotPassage = PassageGenerator.Generate(Ladder.Effective(worst.Attempt.Level!.Value, step), (ulong)worst.Attempt.Seed!.Value, avoid);
        (spotFrom, spotBar, spotTempo, spotStep) = (worst.Attempt, worst.Bar!.Value, worst.Attempt.Tempo!.Value, step);
    }

    // Part 1 is the bar 20% slower (a pickup comes with its first full bar); part 2 the four-bar phrase it's in, at the tempo.
    private async Task StartSpot(int part)
    {
        StopRun();
        var score = spotPassage!.Score;
        var lastBar = score.Bars[^1].Number;
        var firstBar = score.Bars[0].Number;
        var phrase = spotReal is null ? (Math.Max(1, spotBar) - 1) / 4 * 4 + 1 : Math.Max(Math.Max(1, firstBar), spotBar - 1);
        var (from, to) = part == 1 ? (spotBar, spotBar == 0 ? 1 : spotBar) : (phrase == 1 && firstBar == 0 ? 0 : phrase, Math.Min(lastBar, phrase + 3));
        var description = part == 1 ? $"Bar {spotBar}, slower" : $"Bars {Math.Max(1, from)} to {to}";
        (spotPart, variant, finding) = (part, null, false);
        tempo = part == 1 ? Math.Round(spotTempo * 0.8) : spotTempo;
        if (spotReal is { Piece: { } piece } real)
        {
            // A real excerpt's spot: the piece's own engraving again, just the bar or the bars around it.
            Show(DayPassages.Real(piece, real.Mei, await Task.Run(() => MeiReader.Read(real.Mei)), from, to, real.Passage.Spec.Level, real.Excerpt, description));
        }
        else
        {
            passage = spotPassage with { Score = score.Excerpt(from, to), Description = description };
            (mei, measures, onsets, ready) = (MeiWriter.Write(passage.Score, tempo), null, null, null);
            (result, tapped, showTimeline) = (null, null, false);
        }
        BeginLook();
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private static string VariantName(Variant v) => v switch { Variant.ReadAhead => "Read ahead", Variant.Duet => "Duet", _ => "Hear first" };

    private string Kicker() => practising is not null ? $"Practising · {practising.Title}" : Spot == 1 && (stage == Stage.Choose || spotPart > 0) ? "One spot" : stage == Stage.Choose ? "New music, in time" : ready?.Real == true ? "Real music" : finding ? $"Finding your level · level {findLevel}" : repeat ? "Again, for practice" : variant is { } v ? VariantName(v) : "Sight-read";

    private Task FindLevel()
    {
        (finding, findLevel) = (true, 1);
        findResults.Clear();
        return NewPassage();
    }

    private async Task StartAtOne()
    {
        reading = ReadingState.Start;
        await Store.SaveTrackAsync("reading", reading);
        await NewPassage();
    }

    private async Task NewPassage()
    {
        StopRun();
        (spotPart, repeat) = (0, false);
        reading ??= ReadingState.Start;
        var spec = finding ? Ladder.Level(findLevel) : reading.Spec;
        tempo = finding ? spec.Tempo.Min : reading.Tempo;
        avoidKey = lastKey;
        if (finding)
        {
            var found = PassageGenerator.Generate(spec, (ulong)DateTime.Now.Ticks, avoidKey);
            Show(new ReadyPassage(found, MeiWriter.Write(found.Score, tempo), null, null, null, null));
        }
        else Show(await DayPassages.NextAsync(Store, reading, Today, passagesToday, avoidKey, tempo));
        lastKey = passage!.Score.Key;
        // Real music is read plainly; a variant waits for the next generated passage.
        variant = ready!.Real ? null : chosen is Variant.Duet or Variant.HearFirst && !PianoPlays ? null : chosen;
        if (variant == Variant.HearFirst) Hear();
        else BeginLook();
    }

    private double BeatTicks => passage!.Score.Meter.BeatTicks;

    private double MsPerQuarter => 60_000 / tempo * Ticks.Quarter / BeatTicks;

    // Read ahead's view in quarters: its width in bars, never under 1.5 s at the tempo.
    private double ReadAheadQuarters => (reading?.ReadAheadBars ?? 2) * passage!.Score.Meter.BarTicks / (double)Ticks.Quarter;

    private void BeginLook()
    {
        stage = Stage.Look;
        lookStarted = DateTime.Now;
        _ = sheet?.ClearMarks();
        Screen.KeepOn(true);
        StartTicker();
        if (variant == Variant.ReadAhead) _ = ShowOpeningSoon();
    }

    private async Task ShowOpeningSoon()
    {
        await Task.Delay(400);
        if (sheet is not null) await sheet.ShowOpening(ReadAheadQuarters);
    }

    // Hear first: the piano plays the passage once with the click, then the look.
    private void Hear()
    {
        stage = Stage.Hear;
        var all = Beats(passage!.Score.Expected());
        StartSession(all, all, () => InvokeAsync(BeginLook));
    }

    private void Run()
    {
        stage = Stage.Run;
        runStarted = DateTime.Now;
        var expected = passage!.Score.Expected();
        var mine = variant == Variant.Duet && expected.Any(e => e.Staff == 2) && passage.Spec.Hands == Hands.Together ? expected.Where(e => e.Staff == 1).ToList() : expected;
        var others = variant == Variant.Duet ? (mine.Count < expected.Count ? Beats(expected.Where(e => e.Staff == 2).ToList()) : Accompaniment()) : null;
        StartSession(Beats(mine), others, () => InvokeAsync(Score));
        // Each note is judged as it's played and marked on the sheet at once; the summary's marks replace these.
        var pickup = passage.Score.Bars[0].Number == 0 ? passage.Score.Bars[0].Length ?? 0 : 0;
        var pitches = passage.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).ToDictionary(t => t.Id, t => t.Pitch);
        onSheet = expected.ToDictionary(n => n.Id, n => (pitches[n.Id], (n.Tick + pickup) / (double)Ticks.Quarter));
        var run = session!;
        var live = judge = new LiveJudge(mine, run.TimeAt, passage.Score.Meter.BeatTicks, 60e9 / tempo, Settings.TimingOffsetMs);
        run.KeyDown += (key, at) => _ = InvokeAsync(() => MarkLive(live.Play(key, at) is { } mark ? [mark] : []));
        _ = StartCursorSoon();
    }

    private async Task MarkLive(IReadOnlyList<LiveMark> marks)
    {
        if (sheet is null || stage != Stage.Run || marks.Count == 0) return;

        await sheet.MarkLive(marks.Select(m => Mark(m.Id, m.Kind, m.Played, m.ErrorPercent)));
    }

    // A note's mark on the sheet, during the run or after it. A wrong one shows what was played, a grey head that many staff
    // positions from the written one; an early or late one when it was played, a ring on its line.
    private SheetMark Mark(string id, LiveKind kind, int? played, double errorPercent)
    {
        var (written, quarter) = onSheet[id];
        var name = kind.ToString().ToLowerInvariant();
        if (kind == LiveKind.Wrong && played is { } key)
        {
            var spelled = passage!.Score.Key.Spell(key);
            return new SheetMark(id, name, spelled.ToString(), spelled.Diatonic - written.Diatonic);
        }
        return kind is LiveKind.Early or LiveKind.Late ? new SheetMark(id, name, Quarter: quarter + errorPercent / 100 * BeatTicks / Ticks.Quarter) : new SheetMark(id, name);
    }

    private void StartSession(IReadOnlyList<(int Midi, double Beat, double Beats)> expected, IReadOnlyList<(int Midi, double Beat, double Beats)>? piano, Func<Task> whenDone)
    {
        session?.Dispose();
        session = new PlaySession(Click, Keyboard, Clock, Registry);
        pianoPart = piano is not null && stage == Stage.Hear;
        var meter = passage!.Score.Meter;
        var beats = passage.Score.Bars.Where(b => b.Number > 0).Sum(b => b.Length ?? meter.BarTicks) / BeatTicks;
        session.Changed += () =>
        {
            if (session?.Phase == Phase.Done) _ = whenDone();
            else _ = InvokeAsync(StateHasChanged);
        };
        session.Start(new ClickPlan(tempo, meter.Beats, Math.Max(1, Settings.CountInBars)), beats, stage == Stage.Hear ? [] : expected, piano);
    }

    private async Task StartCursorSoon()
    {
        await Task.Delay(50);
        if (sheet is null || session is null || passage is null) return;

        var pickup = passage.Score.Bars[0].Number == 0 ? (passage.Score.Bars[0].Length ?? 0) / BeatTicks : 0;
        await sheet.StartCursor(session.MsUntil(-pickup), MsPerQuarter, 0, 60_000 / tempo, session.MsUntil(0), variant == Variant.ReadAhead ? ReadAheadQuarters : null);
    }

    private IReadOnlyList<(int Midi, double Beat, double Beats)> Beats(IReadOnlyList<ExpectedNote> notes) => [.. notes.Select(n => (n.Midi, n.Tick / BeatTicks, n.Length / BeatTicks))];

    // At one-hand levels the piano plays a bass note a bar: the tonic, or the dominant where the bar leans on it.
    private IReadOnlyList<(int Midi, double Beat, double Beats)> Accompaniment()
    {
        var key = passage!.Score.Key;
        var meter = passage.Score.Meter;
        var tonic = key.Degree(0, 2).Midi + 12;
        var dominant = key.Degree(4, 2).Midi;
        var barBeats = meter.BarTicks / BeatTicks;
        return passage.Score.Bars.Where(b => b.Number > 0).Select((b, i) =>
        {
            var classes = b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones)).Select(t => ((t.Pitch.Midi - key.TonicPitchClass) % 12 + 12) % 12).ToList();
            var leansOnFive = classes.Count(c => c is 7 or 11 or 2) > classes.Count(c => c is 0 or 4);
            return (leansOnFive ? dominant : tonic, i * barBeats, barBeats);
        }).ToList();
    }

    private async Task Score()
    {
        if (session is null || passage is null || stage != Stage.Run) return;

        await (sheet?.StopCursor() ?? Task.CompletedTask);
        var meter = passage.Score.Meter;
        var expected = passage.Score.Expected();
        if (variant == Variant.Duet && passage.Spec.Hands == Hands.Together && expected.Any(e => e.Staff == 2)) expected = [.. expected.Where(e => e.Staff == 1)];
        var beatNs = 60e9 / tempo;
        var ornamented = passage.Score.Marks.Where(m => m.Kind is MarkKind.Trill or MarkKind.Mordent).Select(m => m.StartId).ToHashSet();
        var session1 = session;
        result = PassageScorer.Score(expected, b => session1.TimeAt(b), meter.BeatTicks, beatNs, beatNs * meter.Beats, session.Played, Settings.TimingOffsetMs, ornamented);
        stage = Stage.Summary;
        Screen.KeepOn(false);
        StateHasChanged();
        await ShowMarks();
        await Save(expected);
    }

    private async Task ShowMarks()
    {
        if (sheet is null || result is null || passage is null) return;

        var marks = result.Notes.Select(n => n.Outcome switch
        {
            Outcome.Wrong when n.Played is { } played => Mark(n.Id, LiveKind.Wrong, played, 0),
            Outcome.Missed => Mark(n.Id, LiveKind.Missed, null, 0),
            _ when n.Band == Band.Off => Mark(n.Id, n.ErrorPercent < 0 ? LiveKind.Early : LiveKind.Late, null, n.ErrorPercent ?? 0),
            Outcome.Right => Mark(n.Id, LiveKind.Right, null, 0),
            _ => null,
        }).OfType<SheetMark>().ToList();
        await sheet.ShowMarks(marks);
    }

    private async Task Save(IReadOnlyList<ExpectedNote> expected)
    {
        if (result is null || passage is null || session is null) return;

        var zero = session.TimeAt(0);
        var measures = new
        {
            inTime = result.InTimeAccuracy, right = result.Right, wrong = result.Wrong, missed = result.Missed, extra = result.Extra, audible = result.Audible, off = result.Off,
            leanMs = result.LeanMs, leanPercent = result.LeanPercent, steadiness = result.SteadinessPercent, perMinute = result.CorrectPerMinute, keptGoing = result.KeptGoing,
            drift = result.TempoDriftPercent, rmsMs = result.RmsMs, lost = result.LostOnKeyboard, worstBar = result.WorstBar, worstErrors = result.WorstBar is { } w ? result.ErrorsPerBar[w] : 0,
            bars = passage.Score.Bars.Count(b => b.Number > 0), notes = expected.Count,
        };
        var played = session.Played.Select(p => new[] { p.Midi, (p.OnNs - zero) / 1e6, (p.OffNs - zero) / 1e6, p.Velocity });
        var beats = Enumerable.Range(-Math.Max(1, Settings.CountInBars) * passage.Score.Meter.Beats, (int)(measures.bars * passage.Score.Meter.Beats) + 8).Select(b => (session.TimeAt(b) - zero) / 1e6);
        var kind = practising is not null ? "piece" : spotPart > 0 ? "spot" : finding ? "find" : repeat ? "again" : "passage";
        var avoid = avoidKey is { } k ? new { fifths = k.Fifths, minor = k.Minor } : null;
        await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, Today, kind, spotPart > 0 ? (spotPart == 1 ? "bar" : "phrase") : variant?.ToString(), null, passage.Spec.Level, tempo, (long)passage.Seed,
            System.Text.Json.JsonSerializer.Serialize(new { step = spotPart > 0 ? spotStep : reading?.Step ?? 4, style = passage.Style.ToString(), avoid, key = new { fifths = passage.Score.Key.Fifths, minor = passage.Score.Key.Minor }, spotBar = spotPart > 0 ? spotBar : (int?)null, excerpt = ready?.Excerpt?.Id, piece = ready?.Piece?.Id, bars = ready?.Measures }), System.Text.Json.JsonSerializer.Serialize(played), System.Text.Json.JsonSerializer.Serialize(beats), System.Text.Json.JsonSerializer.Serialize(measures), result.InTimeAccuracy, result.Clean, null));
        await Store.AddMinutesAsync(Today, (DateTime.Now - lookStarted).TotalMinutes);

        if (practising is not null || repeat) return;
        if (spotPart > 0)
        {
            if (spotPart == 2) await Store.MarkStepAsync(Today, StepKind.OneSpot);
            return;
        }

        if (finding)
        {
            findResults.Add(result.InTimeAccuracy);
            if (findResults.Count == 2)
            {
                var (next, found) = Reading.FindLevel(findLevel, findResults);
                findResults.Clear();
                if (found is { } level)
                {
                    finding = false;
                    reading = ReadingState.Start with { Level = level, Step = 4, Tempo = Ladder.Level(level).Tempo.Min };
                    await Store.SaveTrackAsync("reading", reading);
                }
                else findLevel = next!.Value;
            }
            return;
        }

        passagesToday++;
        reading ??= ReadingState.Start;
        // A real excerpt counts as reading done, and rests a few weeks; its grade isn't calibrated enough to move the level.
        if (ready?.Excerpt is { } read) await Store.MarkExcerptReadAsync(read.Id, Today);
        else if (variant == Variant.ReadAhead)
        {
            var verdict = result.InTimeAccuracy > 0.9 && result.KeptGoing ? Verdict.Good : result.InTimeAccuracy < 0.8 || !result.KeptGoing ? Verdict.TooHard : Verdict.Hold;
            reading = reading with { ReadAheadBars = Reading.ReadAheadAfter(reading.ReadAheadBars, verdict, tempo, passage.Score.Meter.Beats) };
        }
        else if (variant is null) reading = Reading.After(reading, result.InTimeAccuracy, result.KeptGoing).State;
        await Store.SaveTrackAsync("reading", reading);
        if (passagesToday >= 4) await Store.MarkStepAsync(Today, StepKind.SightReading);
    }

    private void Again()
    {
        StopRun();
        repeat = true;
        (result, tapped, showTimeline) = (null, null, false);
        BeginLook();
    }

    private async Task Slower()
    {
        if (reading is null) return;

        reading = reading with { Tempo = Math.Max(Ladder.Level(reading.Level).Tempo.Min, Math.Round(reading.Tempo * 0.9)), Recent = [] };
        await Store.SaveTrackAsync("reading", reading);
        await NewPassage();
    }

    private void Done()
    {
        StopRun();
        if (practising is not null) Nav.NavigateTo($"library/{Uri.EscapeDataString(practising.Id)}");
        else if (From == "today") Nav.NavigateTo("");
        else (stage, passage) = (Stage.Choose, null);
    }

    private void Tapped(string id)
    {
        var note = result?.Notes.FirstOrDefault(n => n.Id == id);
        if (note is null) return;

        var name = passage!.Score.Key.Spell(note.Midi).ToString();
        tapped = note.Outcome switch
        {
            Outcome.Right => $"{name}: right, {Math.Abs(note.ErrorMs ?? 0):0} ms {(note.ErrorMs < 0 ? "early" : "late")} ({Math.Abs(note.ErrorPercent ?? 0):0}% of the beat after your lean, {note.Band switch { Band.InTime => "in time", Band.Audible => "audible", _ => "off" }}).",
            Outcome.Wrong => $"{name}: you played {passage.Score.Key.Spell(note.Played ?? 0)}.",
            _ => $"{name}: not played.",
        };
    }

    private string Lean() => result is null ? "–" : Math.Abs(result.LeanMs) < 5 ? "Even" : $"{Math.Abs(result.LeanMs):0} ms {(result.LeanMs < 0 ? "early" : "late")}";

    private IEnumerable<string> Words()
    {
        if (result is null || passage is null) yield break;

        var key = passage.Score.Key;
        if (ready?.Piece is { } from && practising is null) yield return $"From {from.Title}{(from.Composer is { Length: > 0 } c ? $" by {c}" : "")}{(from.Tier == "B" && from.Credit is { } credit ? $". {credit}" : "")}.";
        if (result.Clean && result.Off == 0) yield return "Every note right, and you kept going.";
        foreach (var wrong in result.Notes.Where(n => n.Outcome == Outcome.Wrong).Take(4)) yield return $"Bar {wrong.Bar}: played {key.Spell(wrong.Played ?? 0)} for {key.Spell(wrong.Midi)}{(wrong.Wrong == WrongKind.LostOnKeyboard ? ", a key or two away: lost on the keyboard" : wrong.Wrong == WrongKind.Octave ? ", an octave away" : "")}.";
        if (result.Missed > 0) yield return $"{result.Missed} {(result.Missed == 1 ? "note" : "notes")} not played.";
        if (result.Extra > 0) yield return $"{result.Extra} extra {(result.Extra == 1 ? "note" : "notes")}.";
        if (result.Audible + result.Off > 0) yield return $"{result.Off} off the beat and {result.Audible} just audibly early or late, after your lean.";
        if (!result.KeptGoing) yield return "You stopped for more than a bar. Next time keep the beat going, even past a wrong note.";
        if (Math.Abs(result.LeanPercent) >= 5) yield return $"You leaned {Math.Abs(result.LeanMs):0} ms {(result.LeanMs < 0 ? "early" : "late")}, measured from your timing calibration.";
        if (result.WorstBar is { } bar && !result.Clean && passage.Score.Bars.Count(b => b.Number > 0) > 1) yield return $"Bar {bar} had the most to fix.";
    }

    private string PhaseName() => stage switch
    {
        Stage.Hear => "Listen",
        Stage.Look => "Look",
        Stage.Run => "Bar",
        _ => "Bars",
    };

    private string PhaseValue()
    {
        if (stage == Stage.Look) return $"{Math.Max(0, LookSeconds - (DateTime.Now - lookStarted).TotalSeconds):0}s";
        if (session is null || passage is null || stage is not (Stage.Run or Stage.Hear)) return result is null ? "–" : $"{passage!.Score.Bars.Count(b => b.Number > 0)}";

        var barNs = 60e9 / tempo * passage.Score.Meter.Beats;
        var since = Clock.NowNs - session.TimeAt(0);
        var bars = passage.Score.Bars.Count(b => b.Number > 0);
        return $"{Math.Clamp((int)Math.Floor(since / barNs) + 1, 1, bars)} of {bars}";
    }

    private double LookShare() => Math.Min(100, (DateTime.Now - lookStarted).TotalSeconds / LookSeconds * 100);

    private void StartTicker()
    {
        ticker?.Dispose();
        ticker = new Timer(_ =>
        {
            if (stage == Stage.Look && (DateTime.Now - lookStarted).TotalSeconds >= LookSeconds) _ = InvokeAsync(Run);
            else if (stage is Stage.Look or Stage.Run or Stage.Hear) _ = InvokeAsync(StateHasChanged);
            // Notes whose time has passed with nothing played for them.
            if (stage == Stage.Run && judge is { } live) _ = InvokeAsync(() => MarkLive(live.Due(Clock.NowNs)));
        }, null, 250, 250);
    }

    private void StopRun()
    {
        ticker?.Dispose();
        ticker = null;
        session?.Dispose();
        session = null;
        Screen.KeepOn(false);
    }

    public void Dispose() => StopRun();
}
