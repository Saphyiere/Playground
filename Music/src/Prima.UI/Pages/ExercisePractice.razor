@page "/exercises/{Id}"
@inject PrimaStore Store
@inject Prima.UI.Routines.RoutineService Routines
@inject AppNavigation Navigation
@using System.Text.Json
@using Prima.Core.Generation
@using Prima.Core.Practice
@using Prima.Core.Routines

<PageTitle>@(exercise?.Name ?? "Exercise") · Prima</PageTitle>
<RoutineBar Session="routineSession" BeforeLeaving="StopRoutine" />

@if (exercise is null)
{
    <PageHead Title="Exercises" Kicker="Not one of the exercises" />
    <div class="control-row"><a class="mu-btn" href="exercises">All the exercises</a></div>
}
else
{
    var choosing = keys.Count > 1 || exercise.Hands.Count > 1 || family is not null;
    // What comes after this one in its section. In a routine, the routine's bar has its next.
    var next = routineSession?.IsRoutine == true || Place is not null ? null : exercise.HanonNumber is int n ? Hanon.All.ElementAtOrDefault(n)
        : Exercises.All.SkipWhile(e => e.Id != Id).Skip(1).FirstOrDefault(e => e.Section == exercise.Section && e.HanonNumber is null);
    var history = "Not tried yet.";
    if (was is not null)
    {
        var last = was.Last == Today ? "today" : was.Last.ToString("d MMMM", CultureInfo.InvariantCulture);
        var days = was.Days == 1 ? "1 day" : $"{was.Days} days";
        var times = was.Times == 1 ? "once" : $"{was.Times} times";
        var fastest = was.CleanTempo is { } clean ? $" Fastest clean run: {clean:0} BPM." : "";
        history = exercise.Kind == ExerciseKind.Away ? $"Done on {days}, last {last}." : $"Played {times} on {days}, last {last}.{fastest}";
    }

    <PageHead Title="@exercise.Name" Kicker="@(Place is not null ? Book ? "Complete Hanon" : "Hanon Through the Keys" : Exercises.Sections.First(s => s.Key == exercise.Section).Name)" Class="full-hide" Back="@WayBack" OnBack="Leave"><KeyboardLamp /></PageHead>

    // Its words: how, what to notice (why, for a way to practice), what it trains and the lesson its idea is from, what's been
    // done of it, the key that puts it in one of your routines, and what comes next.
    RenderFragment about = @<text>
        <h2 class="section-title">How to play</h2>
        <ol class="exercise-steps">
            @foreach (var step in exercise.How)
            {
                <li>@step</li>
            }
        </ol>
        <h2 class="section-title">@(exercise.Kind == ExerciseKind.Way ? "Purpose" : "What to notice")</h2>
        <p class="exercise-notice">@exercise.Notice</p>
        @if (ExerciseFocus.Of(exercise.Id) is { Count: > 0 } trains)
        {
            <p class="control-note exercise-trains">Trains @string.Join(", ", trains.Select(f => f.Name.ToLowerInvariant())).</p>
        }
        @if (ExerciseFamilies.LessonOf(exercise.Id) is { } lesson)
        {
            <p class="control-note exercise-lesson">The idea is from a lesson by @lesson.By, <a href="@lesson.Url" target="_blank" rel="noopener">“@lesson.Title”</a> The words and the notes here are Prima's.</p>
        }
        @if (exercise.HanonNumber is int edition)
        {
            <p class="control-note exercise-lesson">C. L. Hanon · Schirmer edition, 1900. Prima re-engraving of
                <a href="@($"https://ranote.zzxxccvv.com/en/s/hanon-{edition:000}")" target="_blank" rel="noopener">RANOTE’s score</a>.
                @if (edition <= 20)
                {
                    <span>From the Mutopia edition by Steve Taylor and Javier Ruiz-Alma. <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>.</span>
                }
                else
                {
                    <span><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.</span>
                    @if (edition <= 38) { <span> Additional fingering from James Brigham’s public-domain edition.</span> }
                }
            </p>
            @if (key != new Key(0) && !Hanon.PrintedKeys(edition) && !Hanon.AsPrintedOnly(edition))
            {
                <p class="control-note">This transposition keeps the original study’s finger numbers.</p>
            }
        }
        @if (exercise.Kind != ExerciseKind.Way)
        {
            <div class="control-row">
                @if (exercise.Kind == ExerciseKind.Away)
                {
                    <button type="button" class="mu-btn mu-primary" data-piano="go" disabled="@(was?.Last == Today)" @onclick="MarkDone">@(was?.Last == Today ? "Done today" : "Done")</button>
                }
                @if (Prima.UI.Routines.OwnRoutines.CanHave(exercise))
                {
                    <button type="button" class="mu-btn" data-action="add-to-routine" @onclick="() => adding = true">Add to a routine</button>
                }
            </div>
            <p class="control-note">@history</p>
        }
        @if (next is not null && !playing)
        {
            <a class="piece-row exercise-next" href="@(next.Route ?? $"exercises/{next.Id}")">
                <span class="piece-title">@next.Name</span>
                <span class="piece-meta">Next in this section</span>
                <span class="piece-level" aria-hidden="true">›</span>
            </a>
        }
    </text>;

    @* One that's played is on the engine, as a piece is: what you do in a line, what to play (its key, or all its keys one after
       another, the hands, and for a family a row for each of its variations), the play bar every screen with music shares (its
       metronome, Options and full screen among its tools, its Loop among the run's keys), and the music in the paper frame a
       piece's is in, taking the rest of the screen and all that scrolls. Its words are its options: the bar's Options shows them
       in place of the music, as a piece's options are. In full screen only the bar and the music are left. One to read, or to do
       away from the keys, is its words. *@
    @if (adding)
    {
        <RoutineMenu Exercise="exercise" OnClose="() => adding = false" OnSaid="said => routineNote = said" />
    }
    @if (routineNote is not null)
    {
        <p class="control-note full-hide" role="status">@routineNote</p>
    }
    @if (exercise.HanonNumber is not null && music is null)
    {
        <Waiting Shape="WaitShape.Row" Count="1" Label="Opening the exercise" />
    }
    else if (exercise.Kind == ExerciseKind.Played)
    {
        <div @key="Id" class="exercise exercise-played practice-page">
            @if (Place is { } bookmark && keys.Count > 0 && music is not null)
            {
                <div class="control-row full-hide" aria-label="Hanon routine">
                    <label class="control-label" for="hanon-study">Study</label>
                    <select class="text-field" id="hanon-study" value="@bookmark.Number" disabled="@playing" @onchange="SelectStudy">
                        @foreach (var study in Hanon.All.Where(e => Book || !Hanon.AsPrintedOnly(e.HanonNumber!.Value)))
                        {
                            <option value="@study.HanonNumber">@study.Name</option>
                        }
                    </select>
                    @if (!Book)
                    {
                        <button type="button" class="mu-toggle" data-piano="off" aria-pressed="@On(bookmark.Cycle)" disabled="@playing" @onclick="() => CycleKeys(bookmark)"><span class="mu-led"></span>Cycle keys</button>
                    }
                    <button type="button" class="mu-btn" data-piano="off" data-action="hanon-next" disabled="@playing" @onclick="Advance">@(Book && (!Hanon.PrintedKeys(bookmark.Number) || key == keys[^1]) ? bookmark.Number == 60 ? "Finish book" : "Next study" : "Next key")</button>
                </div>
            }
            else if (exercise.HanonNumber is null)
            {
                <p class="exercise-does full-hide">@exercise.Does</p>
            }
            @if (routineSession?.Rcm is { } rcm)
            {
                <p class="section-note full-hide rcm-asks">@rcm.Played. @rcm.Activity.Asks@(rcm.Activity.Differs is { } differs ? $" {differs}" : "")</p>
            }
            @if (choosing)
            {
                @* What's chosen, on a card above the play bar: the key on a small keyboard, the hands drawn, a family's own choices
                   a word each; Change opens them all over the music. *@
                <section class="practice-choice exercise-choice full-hide" aria-label="What to play">
                    <ChoiceCard Key="key" KeyName="@exercise.KeyName(key)" Hands="hands" Open="changing" OnChange="ToggleChange" Disabled="playing">
                        @if (family is not null && variant is not null)
                        {
                            @foreach (var variation in family.For(hands))
                            {
                                var option = variation.Options.FirstOrDefault(o => o.Key == variant[variation.Key]) ?? variation.Options[0];
                                <span class="choice-fact">
                                    @if (variation.Key == "interval")
                                    {
                                        <MusicIcon Kind="interval" Steps="@IntervalSteps(option.Key)" />
                                    }
                                    else if (variation.Key == "touch")
                                    {
                                        <MusicIcon Kind="@(option.Key == "detached" ? "staccato" : "legato")" />
                                    }
                                    @FactWords(variation.Key, option)
                                </span>
                            }
                        }
                        @if (through)
                        {
                            <span class="choice-fact"><svg class="cycle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 0 1 12.8-5.3M19.5 12a7.5 7.5 0 0 1-12.8 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M17.5 2.8v4.1h-4.1M6.5 21.2v-4.1h4.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>Through the keys</span>
                        }
                    </ChoiceCard>
                </section>
            }

            <PlayAlong @ref="player" Name="@(Place is null ? "exercises" : Book ? "hanon-book" : "hanon-keys")" Music="music" SheetOf="() => sheet" Tempo="tempo" TempoChanged="SetTempo" StartLabel="Play" Ask="@(routineSession?.Item?.Mode == "wait" ? PlayMode.WaitForMe : routineSession?.Item is not null ? PlayMode.InTime : null)" OnStarting="Starting" OnPracticeStarting="PracticeStarting" OnFinished="Finished" ShowListen="true" OnListened="() => playing = false" Again="@(routineSession?.IsRoutine == true)" ShowLoop="true" LoopChanged="Looped"
                       OriginalTempo="exercise.Tempo" OnOptions="ToggleWords" OptionsOpen="wordsOpen" NextMusic="@(Place is { Cycle: true } && !Book ? () => music : null)" />

            <div class="piece-stage">
                <div class="piece-frame sheet-frame piece-frame-scroll @(wordsOpen ? "piece-frame-hidden" : "")" data-follow="">
                    <Sheet @ref="sheet" Mei="@mei" Layout="scroll" Class="piece-sheet" />
                </div>
                @if (wordsOpen)
                {
                    <section class="piece-options exercise-words" aria-label="How to do it">
                        @about
                        <div class="control-row">
                            <button type="button" class="mu-btn" @onclick="ToggleWords">Back to the music</button>
                        </div>
                    </section>
                }
                @if (changing && choosing)
                {
                    <ChangePanel OnDone="ToggleChange">
                        @if (keys.Count > 1)
                        {
                            <div class="control-row change-key-row">
                                <span class="control-label">Key</span>
                                <KeyPiano Keys="keys" Value="key" ValueChanged="k => Choose(k, hands)" Disabled="playing" />
                                <span class="key-piano-name">@exercise.KeyName(key)</span>
                                @* Through the keys: all of them one after another as one piece of music, from the key showing on
                                   through the list and round to the one before it, each running into the next. *@
                                @if (exercise.HanonNumber is null)
                                {
                                    <button type="button" class="mu-toggle exercise-through" aria-pressed="@On(through)" disabled="@playing" aria-label="@(through ? $"Through the keys: on. All {keys.Count}, from {exercise.KeyName(key)}" : "Through the keys: off. This key alone")" @onclick="() => GoThrough(!through)"><span class="mu-led"></span>Through the keys</button>
                                }
                                else if (Place is null && routineSession?.IsRoutine != true)
                                {
                                    <a class="mu-btn" data-piano="off" href="@($"routines/hanon/keys?study={exercise.HanonNumber}&fifths={key.Fifths}&minor={key.Minor}")">Through the Keys</a>
                                }
                            </div>
                        }
                        @if (family is not null && variant is not null)
                        {
                            @* Each of a family's variations, every option a key: an interval drawn as its two notes, a touch as its
                               slur or its dots, a count on a numbered pad. *@
                            @foreach (var variation in family.For(hands))
                            {
                                <div class="control-row" data-variation="@variation.Key">
                                    <span class="control-label">@variation.Name</span>
                                    <div class="choice-set">
                                        @foreach (var option in variation.Options)
                                        {
                                            var picture = variation.Key is "interval" or "touch";
                                            var pad = Pads(variation.Key);
                                            <button type="button" class="mu-toggle @(picture ? "choice-icon" : pad ? "choice-pad" : null)" aria-pressed="@On(variant[variation.Key] == option.Key)" aria-label="@option.Name" disabled="@playing" @onclick="() => Vary(variation.Key, option.Key)">
                                                <span class="mu-led"></span>
                                                @if (variation.Key == "interval")
                                                {
                                                    <MusicIcon Kind="interval" Steps="@IntervalSteps(option.Key)" />
                                                }
                                                else if (variation.Key == "touch")
                                                {
                                                    <MusicIcon Kind="@(option.Key == "detached" ? "staccato" : "legato")" />
                                                }
                                                <span class="choice-word">@(pad ? option.Key : option.Name)</span>
                                            </button>
                                        }
                                    </div>
                                    @if (variation.Key is "under" or "octaves")
                                    {
                                        <span class="choice-unit">@(variation.Key == "under" ? "fingers" : "octaves")</span>
                                    }
                                </div>
                            }
                        }
                        @if (exercise.Hands.Count > 1)
                        {
                            <div class="control-row">
                                <span class="control-label">Hands</span>
                                <HandsChoice Offered="exercise.Hands" Value="hands" ValueChanged="h => Choose(key, h)" Disabled="playing" />
                            </div>
                        }
                    </ChangePanel>
                }
            </div>

            @if (exercise.HanonNumber is not null && !wordsOpen)
            {
                <p class="control-note full-hide"><strong>Technique</strong> · @exercise.Notice</p>
            }
            @if (outcome is not null)
            {
                <section class="summary" aria-label="How it went">
                    <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")" Review="review" />
                </section>
            }
        </div>
    }
    else
    {
        <div @key="Id" class="exercise">
            <p class="exercise-does">@exercise.Does</p>
            <section class="exercise-words" aria-label="How to do it">
                @about
            </section>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public HanonPlace? Place { get; set; }
    [Parameter] public bool Book { get; set; }
    [Parameter] public EventCallback<HanonPlace> PlaceChanged { get; set; }

    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionId { get; set; }
    private RoutineSession? routineSession;
    private PlayAlong? player;

    private Exercise? exercise;
    private ExerciseFamily? family;
    private FamilyChoice? variant;
    private List<Key> keys = [];
    private Key key;
    private HandUse hands;
    // All its keys one after another, from the key showing, as one piece of music.
    private bool through;
    // The play bar's Loop: the music goes round, and is printed with the repeat's signs.
    private bool loop;
    private double tempo = 60;
    private string mei = "";
    private PlayMusic? music;
    private Sheet? sheet;
    private bool playing;
    // Its words, shown in place of the music by the bar's Options, as a piece's options are.
    private bool wordsOpen;
    private PlayOutcome? outcome;
    // The run in two lines: what you did, and next time.
    private RunReview? review;
    private DoneRecord? was;
    // The menu of your routines, to put it in one, and what was done there.
    private bool adding;
    private string? routineNote;
    private DateTime started;

    private DateOnly Today => routineSession?.Day ?? DateOnly.FromDateTime(DateTime.Now);

    private static string On(bool on) => on ? "true" : "false";

    protected override async Task OnParametersSetAsync()
    {
        if (exercise?.Id == Id && routineSession?.Execution?.Id == ExecutionId)
        {
            if (Place is { } place && key != place.Key)
            {
                key = place.Key;
                Build();
            }
            return;
        }

        (exercise, family, variant, music) = (null, null, null, null);
        routineSession = new(Routines);
        if (!await routineSession.LoadAsync(ExecutionId, "exercise", Id)) return;

        exercise = Exercises.Find(Id);
        if (exercise is null) return;

        (outcome, playing, music, started, adding, routineNote) = (null, false, null, DateTime.Now, false, null);
        await Recount();
        if (exercise.Kind != ExerciseKind.Played) return;

        // A family's variations as last chosen; opened by the id of an exercise that's now one of its variations, as that was. One
        // of Claude's routines asks for a key, hands and a tempo and no variation, so it gets the main exercise; in a routine of
        // yours it's as you last left it.
        var last = await Store.GetTrackAsync<ExerciseChoice>($"exercise:{Id}");
        family = ExerciseFamilies.Of(exercise.Id);
        variant = family?.Read((routineSession.Item is null ? last?.Variation : null) ?? ExerciseFamilies.Formerly(Id)?.Choice);
        // As it was last played, where that's still one of its keys and hands; else its first key and its first hand.
        keys = Keys();
        key = last is not null && keys.Contains(new Key(last.Fifths, last.Minor)) ? new Key(last.Fifths, last.Minor) : keys[0];
        hands = last is not null && exercise.Hands.Contains(last.Hands) ? last.Hands : exercise.Hands[0];
        tempo = last?.Tempo ?? exercise.Tempo;
        through = exercise.HanonNumber is null && last?.Through == true;
        if (Place is not null) key = Place.Key;
        // An activity of one of Claude's routines is the one key it was planned in.
        if (routineSession.Item is { } requested) (key, hands, tempo, through) = (new Key(requested.Fifths, requested.Minor), requested.Hands, requested.Tempo, false);
        // One of RCM's technique: the key and hands its day brings, at RCM's tempo in this music's beat.
        if (routineSession.Rcm is { } rcm) (key, hands, tempo) = (rcm.Key, rcm.Hands, rcm.Activity.Tempo);
        Build();
    }

    private async Task Recount() => was = (await Store.GetDoneAsync("exercise")).FirstOrDefault(d => d.SetId == Id);

    // The keys it's played in: the exercise's, or those of what's chosen of a family's variations where they have their own.
    private List<Key> Keys() => [.. family is not null && variant is not null ? family.KeysOf(exercise!, variant) : Exercises.KeysOf(exercise!)];

    // The music for a key and hands: a family's as its variations are chosen, any other's as it is.
    private Score Written(Key inKey, HandUse with) => family is not null && variant is not null ? family.Music(inKey, with, variant) : exercise!.Music!(inKey, with);

    // The music: the exercise in its key, or through all its keys; looped, with repeat signs round the bars that go round (all
    // but the close). The play bar plays those again and again when its Loop is on, and the music once through when it's off.
    private void Build()
    {
        var score = through ? Exercises.Through(exercise!, key, hands, Written, keys) : Written(key, hands);
        var numbered = exercise!.HanonNumber is not null;
        var round = numbered ? Hanon.PlayOrder(score) : Exercises.Round(exercise, score);
        if (loop && !numbered) score = score.WithRepeat(round[0], round[^1]);
        mei = MeiWriter.Write(score, tempo);
        music = numbered ? new PlayMusic(score, score.Performed(round)) { Order = round, Round = round } : new PlayMusic(score, score.Expected()) { Round = round };
        (outcome, review) = (null, null);
    }

    // What's kept of how it was last played: an activity of one of Claude's routines, played as its recipe says, leaves that as it
    // was; one of a routine of yours is the exercise as you left it, and keeps what's changed.
    private Task Keep() => routineSession?.Fixed == true ? Task.CompletedTask : Store.SaveTrackAsync($"exercise:{Id}", new ExerciseChoice(key.Fifths, key.Minor, hands, tempo) { Variation = variant?.ToString(), Through = through });

    private async Task Choose(Key toKey, HandUse toHands)
    {
        (key, hands) = (toKey, toHands);
        Build();
        await Keep();
        if (Place is { } place && place.Key != key) await PlaceChanged.InvokeAsync(place.At(place.Number, key));
    }

    private Task SelectStudy(ChangeEventArgs args) => Place is { } place && int.TryParse(args.Value?.ToString(), out var number) && number is >= 1 and <= 60
        ? PlaceChanged.InvokeAsync(place.At(number, key)) : Task.CompletedTask;

    private async Task Advance()
    {
        if (Place is not { } place) return;
        var next = place.Next(Book);
        await PlaceChanged.InvokeAsync(next);
        if (next.Number == place.Number && !next.Complete && key != next.Key)
        {
            key = next.Key;
            Build();
        }
    }

    // One of a family's variations set to another of its options. Where what's chosen has keys of its own (the thumb's notes
    // kept white), a key it doesn't have gives way to its first.
    private Task Vary(string variation, string option)
    {
        variant = variant!.With(variation, option);
        keys = Keys();
        return Choose(keys.Contains(key) ? key : keys[0], hands);
    }

    private async Task GoThrough(bool on)
    {
        through = on;
        Build();
        await Keep();
    }

    // The play bar's Loop, as it's read when the bar opens and as it's turned on or off: the repeat's signs go on or come off.
    private async Task Looped(bool on)
    {
        loop = on;
        if (on && !Book && Place is { Cycle: true } place)
            await PlaceChanged.InvokeAsync(place with { Cycle = false });
        if (exercise?.Kind == ExerciseKind.Played && music is not null && !playing) Build();
    }

    private async Task CycleKeys(HanonPlace place)
    {
        if (!place.Cycle && player is { Looping: true }) await player.SetLoop(false);
        await PlaceChanged.InvokeAsync(place with { Cycle = !place.Cycle });
    }

    private async Task SetTempo(double bpm)
    {
        tempo = Math.Clamp(bpm, 20, 240);
        await Keep();
    }

    private void Starting()
    {
        (playing, outcome, review, wordsOpen, changing) = (true, null, null, false, false);
    }

    // The way back: to where it was opened from, by its name.
    private string WayBack => Navigation.PreviousName ?? "Exercises";

    private async Task Leave()
    {
        await StopRoutine();
        await Navigation.BackAsync("exercises");
    }

    // Its words and Change share the music's place: one opening closes the other.
    private void ToggleWords() => (wordsOpen, changing) = (!wordsOpen, false);

    // Change: what to play, over the music.
    private bool changing;

    private void ToggleChange() => (changing, wordsOpen) = (!changing, false);

    // An interval's steps from its lower note to its upper, for its picture.
    private static int IntervalSteps(string option) => option switch { "third" => 2, "fourth" => 3, "fifth" => 4, "sixth" => 5, _ => 7 };

    // A variation that's a count is on numbered pads, its option's number on each.
    private static bool Pads(string variation) => variation is "quick" or "under" or "octaves";

    // What's chosen of a variation, as the card says it.
    private static string FactWords(string variation, VariationOption option) => variation switch
    {
        "quick" => option.Key == "1" ? "1 quick note" : $"{option.Key} quick notes",
        "under" => $"Under {option.Name}",
        "fingers" => $"Fingers {option.Name}",
        "holding" => option.Key == "0" ? "Each holds in turn" : $"{option.Name} holds",
        _ => option.Name,
    };

    private void PracticeStarting() => routineSession?.Start();

    private Task StopRoutine() => player?.StopAndSaveAsync() ?? Task.CompletedTask;

    // A run is kept as an attempt at this exercise: its mode, tempo, key and hands, what was played and how it went.
    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        // Its review: through the keys, no one key's sharps and flats are the ones to name.
        review = how.InTime is { } run ? RunReviews.InTime(run, through ? null : key, how.Passes, how is { Stopped: true, Passes.Count: 0 } ? $"bar {how.Bar}" : null)
            : how.Wait is { } waited ? RunReviews.Waited(waited, Trouble.Of(how.Marks, music?.Notes.GroupBy(n => n.WrittenId).ToDictionary(g => g.Key, g => g.First().Bar) ?? []), how.Passes)
            : null;
        // Stopped before a key that could be judged (in the count-in, or with nothing played): there's no run to keep.
        if (how is { InTime: null, Wait: null or { Notes: 0 } }) return;

        var (right, notes, clean) = how.InTime is { } timed ? (timed.Right, timed.Expected, timed.Clean) : (how.Wait!.RightFirstTime, how.Wait.Notes, how.Wait.WrongKeys == 0 && how.Wait.Apart == 0 && how.Wait.Finished);
        object measures = how.InTime is { } r
            ? new { inTime = r.InTimeAccuracy, right = r.Right, wrong = r.Wrong, missed = r.Missed, extra = r.Extra, holds = r.HoldsJudged, letGoEarly = r.LetGoEarly, stopped = how.Stopped }
            : new { rightFirstTime = how.Wait!.RightFirstTime, notes = how.Wait.Notes, wrongKeys = how.Wait.WrongKeys, apart = how.Wait.Apart, seconds = how.Wait.Seconds, stopped = how.Stopped };
        // The keys kept with it: those played, or round a loop its last pass's, not half an hour's.
        var keysKept = how.Loop is null ? how.Played : how.Judged;
        var firstNs = keysKept.Count == 0 ? 0 : keysKept[0].OnNs;
        var played = JsonSerializer.Serialize(keysKept.Select(p => new[] { p.Midi, (p.OnNs - firstNs) / 1e6 }));
        // How it was played: its key (the one it started from, through the keys), the hands, what was chosen of a family's
        // variations, and round a loop its passes.
        var chosen = new Dictionary<string, object> { ["key"] = key.Name, ["hands"] = hands.ToString() };
        if (variant is not null) chosen["variation"] = variant.ToString();
        if (through) chosen["through"] = true;
        if (how.Loop is not null) chosen["passes"] = how.Passes.Count;
        var inTime = how.Mode == PlayMode.InTime;
        var attempt = new AttemptRecord(0, DateTimeOffset.Now, Today, "exercise", inTime ? "in time" : "wait", Id, null, inTime ? tempo : null, null, JsonSerializer.Serialize(chosen), played, null, JsonSerializer.Serialize(measures), notes == 0 ? null : right / (double)notes, clean && how.TimesThrough > 0, null);
        if (routineSession?.Execution is not null) await routineSession.RecordAsync(attempt, how.TimesThrough);
        else
        {
            await Store.AddAttemptAsync(attempt);
            await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
        }
        started = DateTime.Now;
        await Recount();
        if (Place is not null && !how.Stopped && how.Loop is null && how.TimesThrough > 0 && (Book || Place.Cycle))
            await Advance();
    }

    // One with nothing for Prima to follow is done when you say so; in a routine, as a run of its activity.
    private async Task MarkDone()
    {
        var done = new AttemptRecord(0, DateTimeOffset.Now, Today, "exercise", "done", Id, null, null, null, null, "[]", null, "{}", null, true, null);
        if (routineSession?.Execution is not null) await routineSession.RecordAsync(done, 1);
        else await Store.AddAttemptAsync(done);
        await Recount();
    }
}
