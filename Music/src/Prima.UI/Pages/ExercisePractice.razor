@page "/exercises/{Id}"
@inject PrimaStore Store
@inject Prima.UI.Routines.RoutineService Routines
@using System.Text.Json
@using Prima.Core.Generation

<PageTitle>@(exercise?.Name ?? "Exercise") · Prima</PageTitle>
<RoutineBar Session="routineSession" BeforeLeaving="StopRoutine" />

@if (exercise is null)
{
    <PageHead Title="Exercises" Kicker="Not one of the exercises" />
    <div class="control-row"><a class="mu-btn" href="exercises">All the exercises</a></div>
}
else
{
    var choosing = keys.Count > 1 || exercise.Hands.Count > 1 || family is not null;
    // What comes after this one: the next in My routine when that's the list it was opened from, or else the next in its section.
    var after = Exercises.All.SkipWhile(e => e.Id != Id).Skip(1);
    var next = From == "routine" ? after.FirstOrDefault(e => routine.Contains(e.Id)) : after.FirstOrDefault(e => e.Section == exercise.Section);
    var history = "Not tried yet.";
    if (was is not null)
    {
        var last = was.Last == Today ? "today" : was.Last.ToString("d MMMM", CultureInfo.InvariantCulture);
        var days = was.Days == 1 ? "1 day" : $"{was.Days} days";
        var times = was.Times == 1 ? "once" : $"{was.Times} times";
        var fastest = was.CleanTempo is { } clean ? $" Fastest clean run In time: {clean:0}." : "";
        history = exercise.Kind == ExerciseKind.Away ? $"Done on {days}, last {last}." : $"Played {times} on {days}, last {last}.{fastest}";
    }

    <PageHead Title="@exercise.Name" Kicker="@Exercises.Sections.First(s => s.Key == exercise.Section).Name" Class="full-hide"><KeyboardLamp /></PageHead>

    // Its words: how, what to notice (why, for a way to practice), what it trains and the lesson its idea is from, what's been
    // done of it, the switch that keeps it in My routine, and what comes next.
    RenderFragment about = @<text>
        <h2 class="section-title">How</h2>
        <ol class="exercise-steps">
            @foreach (var step in exercise.How)
            {
                <li>@step</li>
            }
        </ol>
        <h2 class="section-title">@(exercise.Kind == ExerciseKind.Way ? "Why" : "Notice")</h2>
        <p class="exercise-notice">@exercise.Notice</p>
        @if (ExerciseFocus.Of(exercise.Id) is { Count: > 0 } trains)
        {
            <p class="control-note exercise-trains">Trains @string.Join(", ", trains.Select(f => f.Name.ToLowerInvariant())).</p>
        }
        @if (ExerciseFamilies.LessonOf(exercise.Id) is { } lesson)
        {
            <p class="control-note exercise-lesson">The idea is from a lesson by @lesson.By, <a href="@lesson.Url" target="_blank" rel="noopener">“@lesson.Title”</a> The words and the notes here are Prima's.</p>
        }
        @if (exercise.Kind != ExerciseKind.Way)
        {
            <div class="control-row">
                @if (exercise.Kind == ExerciseKind.Away)
                {
                    <button type="button" class="mu-btn mu-primary" data-piano="go" disabled="@(was?.Last == Today)" @onclick="MarkDone">@(was?.Last == Today ? "Done today" : "Done")</button>
                }
                <button type="button" class="mu-toggle" aria-pressed="@On(routine.Contains(Id))" @onclick="ToggleRoutine"><span class="mu-led"></span>In my routine</button>
            </div>
            <p class="control-note">@history</p>
        }
        @if (next is not null && !playing)
        {
            <a class="piece-row exercise-next" href="@(next.Route ?? $"exercises/{next.Id}{(From == "routine" ? "?from=routine" : "")}")">
                <span class="piece-title">@next.Name</span>
                <span class="piece-meta">@(From == "routine" ? "Next in my routine" : "Next in this section")</span>
                <span class="piece-level" aria-hidden="true">›</span>
            </a>
        }
    </text>;

    @* One that's played is on the engine, as a piece is: what you do in a line, what to play (its key, or all its keys one after
       another, the hands, and for a family a row for each of its variations), the play bar every screen with music shares (its
       metronome, Options and full screen among its tools, its Loop among the run's keys), and the music in the paper frame a
       piece's is in, taking the rest of the screen and all that scrolls. Its words are its options: the bar's Options shows them
       in place of the music, as a piece's options are. In full screen only the bar and the music are left. One to read, or to do
       away from the keys, is its words. *@
    @if (exercise.Kind == ExerciseKind.Played)
    {
        <div @key="Id" class="exercise exercise-played practice-page">
            <p class="exercise-does full-hide">@exercise.Does</p>
            @if (choosing)
            {
                <section class="exercise-choice full-hide" aria-label="What to play">
                    @if (keys.Count > 1)
                    {
                        <div class="control-row">
                            <span class="control-label">Key</span>
                            <button type="button" class="mu-btn" aria-label="An easier key" disabled="@(playing || keys.IndexOf(key) == 0)" @onclick="() => Choose(keys[keys.IndexOf(key) - 1], hands)">−</button>
                            <span class="control-value exercise-key">@exercise.KeyName(key)</span>
                            <button type="button" class="mu-btn" aria-label="A harder key" disabled="@(playing || keys.IndexOf(key) == keys.Count - 1)" @onclick="() => Choose(keys[keys.IndexOf(key) + 1], hands)">+</button>
                            @* Through the keys: all of them one after another as one piece of music, from the key showing on
                               through the list and round to the one before it, each running into the next. *@
                            <button type="button" class="mu-toggle exercise-through" aria-pressed="@On(through)" disabled="@playing" aria-label="@(through ? $"Through the keys: on. All {keys.Count}, from {exercise.KeyName(key)}" : "Through the keys: off. This key alone")" @onclick="() => GoThrough(!through)"><span class="mu-led"></span>Through the keys</button>
                        </div>
                    }
                    @if (exercise.Hands.Count > 1)
                    {
                        <div class="control-row">
                            <span class="control-label">Hands</span>
                            @foreach (var h in exercise.Hands)
                            {
                                <button type="button" class="mu-toggle" aria-pressed="@On(hands == h)" disabled="@playing" @onclick="() => Choose(key, h)"><span class="mu-led"></span>@(h switch { HandUse.Right => "Right", HandUse.Left => "Left", _ => "Together" })</button>
                            }
                        </div>
                    }
                    @if (family is not null && variant is not null)
                    {
                        @* Two or three options are keys to press, like the hands; more are stepped through with − and +, like the key. *@
                        @foreach (var variation in family.For(hands))
                        {
                            var at = variation.Options.ToList().FindIndex(o => o.Key == variant[variation.Key]);
                            <div class="control-row" data-variation="@variation.Key">
                                <span class="control-label">@variation.Name</span>
                                @if (variation.Options.Count > 3)
                                {
                                    <button type="button" class="mu-btn" aria-label="@($"{variation.Name}: the one before")" disabled="@(playing || at == 0)" @onclick="() => Vary(variation.Key, variation.Options[at - 1].Key)">−</button>
                                    <span class="control-value exercise-option">@variation.Options[at].Name</span>
                                    <button type="button" class="mu-btn" aria-label="@($"{variation.Name}: the next")" disabled="@(playing || at == variation.Options.Count - 1)" @onclick="() => Vary(variation.Key, variation.Options[at + 1].Key)">+</button>
                                }
                                else
                                {
                                    @foreach (var option in variation.Options)
                                    {
                                        <button type="button" class="mu-toggle" aria-pressed="@On(at >= 0 && variation.Options[at] == option)" disabled="@playing" @onclick="() => Vary(variation.Key, option.Key)"><span class="mu-led"></span>@option.Name</button>
                                    }
                                }
                            </div>
                        }
                    }
                </section>
            }

            <PlayAlong @ref="player" Name="exercises" Music="music" SheetOf="() => sheet" Tempo="tempo" TempoChanged="SetTempo" StartLabel="Play" Ask="@(routineSession?.Item?.Mode == "wait" ? PlayMode.WaitForMe : routineSession?.Item is not null ? PlayMode.InTime : null)" OnStarting="Starting" OnPracticeStarting="PracticeStarting" OnFinished="Finished" ShowListen="true" OnListened="() => playing = false" Again="@(routineSession?.IsRoutine == true)" ShowLoop="true" LoopChanged="Looped"
                       OriginalTempo="exercise.Tempo" OnOptions="ToggleWords" OptionsOpen="wordsOpen" />

            <div class="piece-stage">
                <div class="piece-frame sheet-frame piece-frame-scroll @(wordsOpen ? "piece-frame-hidden" : "")" data-follow="">
                    <Sheet @ref="sheet" Mei="@mei" Layout="scroll" Class="piece-sheet" />
                </div>
                @if (wordsOpen)
                {
                    <section class="piece-options exercise-words" aria-label="How to do it">
                        @about
                        <div class="control-row">
                            <button type="button" class="mu-btn" @onclick="ToggleWords">Back to the music</button>
                        </div>
                    </section>
                }
            </div>

            @if (outcome is not null)
            {
                <section class="summary" aria-label="How it went">
                    <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")" />
                </section>
            }
        </div>
    }
    else
    {
        <div @key="Id" class="exercise">
            <p class="exercise-does">@exercise.Does</p>
            <section class="exercise-words" aria-label="How to do it">
                @about
            </section>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = "";

    /// <summary>"routine" when it was opened from My routine: what comes next is then the routine's next.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionId { get; set; }
    private RoutineSession? routineSession;
    private PlayAlong? player;

    private Exercise? exercise;
    private ExerciseFamily? family;
    private FamilyChoice? variant;
    private List<Key> keys = [];
    private Key key;
    private HandUse hands;
    // All its keys one after another, from the key showing, as one piece of music.
    private bool through;
    // The play bar's Loop: the music goes round, and is printed with the repeat's signs.
    private bool loop;
    private double tempo = 60;
    private string mei = "";
    private PlayMusic? music;
    private Sheet? sheet;
    private bool playing;
    // Its words, shown in place of the music by the bar's Options, as a piece's options are.
    private bool wordsOpen;
    private PlayOutcome? outcome;
    private DoneRecord? was;
    private List<string> routine = [];
    private DateTime started;

    private DateOnly Today => routineSession?.Day ?? DateOnly.FromDateTime(DateTime.Now);

    private static string On(bool on) => on ? "true" : "false";

    protected override async Task OnParametersSetAsync()
    {
        if (exercise?.Id == Id && routineSession?.Execution?.Id == ExecutionId) return;

        (exercise, family, variant, music) = (null, null, null, null);
        routineSession = new(Routines);
        if (!await routineSession.LoadAsync(ExecutionId, "exercise", Id)) return;

        exercise = Exercises.Find(Id);
        if (exercise is null) return;

        (outcome, playing, music, started) = (null, false, null, DateTime.Now);
        routine = await Store.GetTrackAsync<List<string>>("exercise-routine") ?? [];
        await Recount();
        if (exercise.Kind != ExerciseKind.Played) return;

        // A family's variations as last chosen; opened by the id of an exercise that's now one of its variations, as that was. A
        // routine asks for a key, hands and a tempo and no variation, so it gets the main exercise.
        var last = await Store.GetTrackAsync<ExerciseChoice>($"exercise:{Id}");
        family = ExerciseFamilies.Of(exercise.Id);
        variant = family?.Read((routineSession.Item is null ? last?.Variation : null) ?? ExerciseFamilies.Formerly(Id)?.Choice);
        // As it was last played, where that's still one of its keys and hands; else its first key and its first hand.
        keys = Keys();
        key = last is not null && keys.Contains(new Key(last.Fifths, last.Minor)) ? new Key(last.Fifths, last.Minor) : keys[0];
        hands = last is not null && exercise.Hands.Contains(last.Hands) ? last.Hands : exercise.Hands[0];
        tempo = last?.Tempo ?? exercise.Tempo;
        through = last?.Through == true;
        // A routine's activity is the one key it was planned in.
        if (routineSession.Item is { } requested) (key, hands, tempo, through) = (new Key(requested.Fifths, requested.Minor), requested.Hands, requested.Tempo, false);
        Build();
    }

    private async Task Recount() => was = (await Store.GetDoneAsync("exercise")).FirstOrDefault(d => d.SetId == Id);

    // The keys it's played in: the exercise's, or those of what's chosen of a family's variations where they have their own.
    private List<Key> Keys() => [.. family is not null && variant is not null ? family.KeysOf(exercise!, variant) : Exercises.KeysOf(exercise!)];

    // The music for a key and hands: a family's as its variations are chosen, any other's as it is.
    private Score Written(Key inKey, HandUse with) => family is not null && variant is not null ? family.Music(inKey, with, variant) : exercise!.Music!(inKey, with);

    // The music: the exercise in its key, or through all its keys; looped, with repeat signs round the bars that go round (all
    // but the close). The play bar plays those again and again when its Loop is on, and the music once through when it's off.
    private void Build()
    {
        var score = through ? Exercises.Through(exercise!, key, hands, Written, keys) : Written(key, hands);
        var round = Exercises.Round(exercise!, score);
        if (loop) score = score.WithRepeat(round[0], round[^1]);
        mei = MeiWriter.Write(score, tempo);
        music = new PlayMusic(score, score.Expected()) { Round = round };
        outcome = null;
    }

    // What's kept of how it was last played. A routine's activity leaves that as it was.
    private Task Keep() => routineSession?.IsRoutine == true ? Task.CompletedTask : Store.SaveTrackAsync($"exercise:{Id}", new ExerciseChoice(key.Fifths, key.Minor, hands, tempo) { Variation = variant?.ToString(), Through = through });

    private async Task Choose(Key toKey, HandUse toHands)
    {
        (key, hands) = (toKey, toHands);
        Build();
        await Keep();
    }

    // One of a family's variations set to another of its options. Where what's chosen has keys of its own (the thumb's notes
    // kept white), a key it doesn't have gives way to its first.
    private Task Vary(string variation, string option)
    {
        variant = variant!.With(variation, option);
        keys = Keys();
        return Choose(keys.Contains(key) ? key : keys[0], hands);
    }

    private async Task GoThrough(bool on)
    {
        through = on;
        Build();
        await Keep();
    }

    // The play bar's Loop, as it's read when the bar opens and as it's turned on or off: the repeat's signs go on or come off.
    private void Looped(bool on)
    {
        loop = on;
        if (exercise?.Kind == ExerciseKind.Played && music is not null && !playing) Build();
    }

    private async Task SetTempo(double bpm)
    {
        tempo = Math.Clamp(bpm, 20, 240);
        await Keep();
    }

    private void Starting()
    {
        (playing, outcome, wordsOpen) = (true, null, false);
    }

    private void ToggleWords() => wordsOpen = !wordsOpen;

    private void PracticeStarting() => routineSession?.Start();

    private Task StopRoutine() => player?.StopAndSaveAsync() ?? Task.CompletedTask;

    // A run is kept as an attempt at this exercise: its mode, tempo, key and hands, what was played and how it went.
    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        // Stopped before a key that could be judged (in the count-in, or with nothing played): there's no run to keep.
        if (how is { InTime: null, Wait: null or { Notes: 0 } }) return;

        var (right, notes, clean) = how.InTime is { } timed ? (timed.Right, timed.Expected, timed.Clean) : (how.Wait!.RightFirstTime, how.Wait.Notes, how.Wait.WrongKeys == 0 && how.Wait.Apart == 0 && how.Wait.Finished);
        object measures = how.InTime is { } r
            ? new { inTime = r.InTimeAccuracy, right = r.Right, wrong = r.Wrong, missed = r.Missed, extra = r.Extra, holds = r.HoldsJudged, letGoEarly = r.LetGoEarly, stopped = how.Stopped }
            : new { rightFirstTime = how.Wait!.RightFirstTime, notes = how.Wait.Notes, wrongKeys = how.Wait.WrongKeys, apart = how.Wait.Apart, seconds = how.Wait.Seconds, stopped = how.Stopped };
        // The keys kept with it: those played, or round a loop its last pass's, not half an hour's.
        var keysKept = how.Loop is null ? how.Played : how.Judged;
        var firstNs = keysKept.Count == 0 ? 0 : keysKept[0].OnNs;
        var played = JsonSerializer.Serialize(keysKept.Select(p => new[] { p.Midi, (p.OnNs - firstNs) / 1e6 }));
        // How it was played: its key (the one it started from, through the keys), the hands, what was chosen of a family's
        // variations, and round a loop its passes.
        var chosen = new Dictionary<string, object> { ["key"] = key.Name, ["hands"] = hands.ToString() };
        if (variant is not null) chosen["variation"] = variant.ToString();
        if (through) chosen["through"] = true;
        if (how.Loop is not null) chosen["passes"] = how.Passes.Count;
        var inTime = how.Mode == PlayMode.InTime;
        var attempt = new AttemptRecord(0, DateTimeOffset.Now, Today, "exercise", inTime ? "in time" : "wait", Id, null, inTime ? tempo : null, null, JsonSerializer.Serialize(chosen), played, null, JsonSerializer.Serialize(measures), notes == 0 ? null : right / (double)notes, clean && how.TimesThrough > 0, null);
        if (routineSession?.Execution is not null) await routineSession.RecordAsync(attempt, how.TimesThrough);
        else
        {
            await Store.AddAttemptAsync(attempt);
            await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
        }
        started = DateTime.Now;
        await Recount();
    }

    // One with nothing for Prima to follow is done when you say so.
    private async Task MarkDone()
    {
        await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, Today, "exercise", "done", Id, null, null, null, null, "[]", null, "{}", null, true, null));
        await Recount();
    }

    private async Task ToggleRoutine()
    {
        routine = routine.Contains(Id) ? [.. routine.Where(id => id != Id)] : [.. routine, Id];
        await Store.SaveTrackAsync("exercise-routine", routine);
    }
}
