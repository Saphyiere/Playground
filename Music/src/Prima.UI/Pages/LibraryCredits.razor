@page "/library/credits"
@inject PrimaStore Store
@inject ILibraryBundle Bundle
@inject AppNavigation Navigation

<PageTitle>Where the music comes from · Prima</PageTitle>

<PageHead Title="Credits" Kicker="Where the music comes from" Back="@(Navigation.PreviousName ?? "Library")" OnBack="@(() => Navigation.BackAsync("library"))" />

<p class="page-note">The bundled pieces are public domain or openly licensed, and each is credited as its licence asks. Engravings from MuseScore users come through PDMX (Long et al., 2024, CC BY 4.0); the PDFs and their MIDI come from the Mutopia Project, whose pieces under CC BY-SA are share-alike: anything made from one, an arrangement or a new edition, is shared under the same licence. Prima engraves the MusicXML itself with Verovio (LGPL), and draws the PDFs with pdf.js (Apache 2.0).</p>
@if (syllabus is not null)
{
    <p class="page-note">RCM's levels say where <a href="@syllabus.Url" target="_blank" rel="noopener">@syllabus.Name</a> lists Prima's own pieces: @syllabus.Pieces.Count of them, each looked up in the syllabus's free PDF and cited by its page. They're facts about these pieces, not a copy of the syllabus's lists, and Prima isn't affiliated with The Royal Conservatory.</p>
}
@if (pieces.Any(p => p.Origin == "collection"))
{
    <p class="page-note">The local collection, imported from the Library tool's files, is for this tablet only. Craig Sapp's Humdrum editions, the DCML's annotated corpora (EPFL) and ASAP's scores are CC BY-NC-SA 4.0, non-commercial and shared alike; its pieces from PDMX and the Mutopia Project are on the same terms as the bundled ones, and its hymns from the Open Hymnal (edited by Brian J. Dumont) are public domain.</p>
}

@foreach (var source in pieces.Where(p => !p.Imported).GroupBy(p => p.Source ?? "Other").OrderBy(g => g.Key))
{
    <section class="settings-section" aria-labelledby="@($"source-{source.Key}")">
        <h2 id="@($"source-{source.Key}")" class="section-title">@source.Key</h2>
        <table class="you-table credits-table">
            <thead><tr><th>Piece</th><th>Composer</th><th>Credit</th><th>Licence</th></tr></thead>
            <tbody>
                @foreach (var p in source.GroupBy(p => p.File ?? p.Id).Select(Credited).OrderBy(p => p.Composer).ThenBy(p => p.Title, StringComparer.OrdinalIgnoreCase))
                {
                    <tr>
                        <td>@if (p.SourceUrl is { Length: > 0 } url) { <a href="@url" target="_blank" rel="noopener">@p.Title</a> } else { @p.Title }</td>
                        <td>@p.Composer</td>
                        <td>@p.Credit</td>
                        <td>@if (p.LicenceUrl is { Length: > 0 } licence) { <a href="@licence" target="_blank" rel="noopener">@p.Licence</a> } else { @p.Licence }</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private List<PieceRecord> pieces = [];
    private Prima.Core.Library.Syllabus? syllabus;

    protected override async Task OnInitializedAsync()
    {
        pieces = await Store.GetPiecesAsync();
        if (await Bundle.ReadAsync(Prima.Core.Library.Syllabus.RcmFile) is { } bytes)
        {
            try
            {
                syllabus = Prima.Core.Library.Syllabus.Read(System.Text.Encoding.UTF8.GetString(bytes));
            }
            catch (System.Text.Json.JsonException)
            {
            }
        }
    }

    // A collection kept as its separate pieces ("Children's Album, No. 5") came from one file, and is credited once.
    private static PieceRecord Credited(IGrouping<string, PieceRecord> file) => file.Count() == 1 ? file.First() : file.First() with { Title = System.Text.RegularExpressions.Regex.Replace(file.First().Title, @", No\. \d+$", "") };
}
