@page "/drills/{Key}"
@implements IDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject SessionRegistry Registry
@using Prima.Core.Generation
@using DrillMaterial = Prima.Core.Generation.Drills
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>@(info?.Name ?? "Drill") · Prima</PageTitle>

<PageHead Title="@(info?.Name ?? "Drill")" Kicker="@Kicker()"><KeyboardLamp /></PageHead>

@if (info is null)
{
    <p class="page-note">There's no drill here. <a href="drills">Back to the drills</a>.</p>
}
else if (items.Count == 0)
{
    <p class="page-note">@(loading ? "" : "Nothing is due today: every note is resting until its next review. New notes come after a good day.")</p>
}
else if (index < items.Count)
{
    <section class="reading-bar" aria-label="Where you are">
        <div class="mu-readout"><span class="mu-readout-label">Item</span><span class="mu-readout-value">@(index + 1) of @items.Count</span></div>
        <div class="mu-readout"><span class="mu-readout-label">Right</span><span class="mu-readout-value">@results.Count(r => r.Right)</span></div>
        @if (info.Top > 1)
        {
            @* The step by hand: a new set at it, and the ladder moves on from there. *@
            <div class="mu-readout play-tempo"><span class="mu-readout-label">Step of @info.Top</span>
                <span class="tempo-control">
                    <button type="button" class="mu-btn" aria-label="An easier step" disabled="@(track.Step <= 1)" @onclick="() => SetStep(track.Step - 1)">−</button>
                    <span class="tempo-figure">@track.Step</span>
                    <button type="button" class="mu-btn" aria-label="A harder step" disabled="@(track.Step >= info.Top)" @onclick="() => SetStep(track.Step + 1)">+</button>
                </span>
            </div>
        }
        <p class="drill-prompt">@items[index].Item.Prompt</p>
    </section>
    <div class="sheet-frame">
        <Sheet @ref="sheet" Mei="@mei" Scale="@(items[index].Item.Answer.Count > 1 ? 1.25 : 1.7)" OnPainted="Shown" />
    </div>
    <p class="drill-feedback @(feedbackRight ? "right" : "wrong")" aria-live="polite">@feedback</p>
}
else
{
    <section class="mu-screen summary-figures" aria-label="The set">
        <div class="mu-readouts">
            <div class="mu-readout @(Share < 0.8 ? "miss" : "")"><span class="mu-readout-label">Right</span><span class="mu-readout-value">@($"{(Share) * 100:0}%")</span></div>
            <div class="mu-readout"><span class="mu-readout-label">Typical answer</span><span class="mu-readout-value">@($"{Stats.Median(results.Where(r => r.Right).Select(r => r.Ms).ToArray()) / 1000:0.0} s")</span></div>
            <div class="mu-readout"><span class="mu-readout-label">Step</span><span class="mu-readout-value">@track.Step of @info.Top</span></div>
        </div>
    </section>
    <ul class="summary-words">
        @foreach (var line in SummaryWords())
        {
            <li>@line</li>
        }
    </ul>
    @if (Key == "geography" && looked is null)
    {
        <div class="control-row">
            <span class="control-label">Did you look?</span>
            <button type="button" class="mu-btn" @onclick="() => Looked(true)">Yes</button>
            <button type="button" class="mu-btn" @onclick="() => Looked(false)">No</button>
        </div>
    }
    <div class="control-row">
        <button type="button" class="mu-btn mu-primary" data-piano="go" @onclick="NewSet">Another set</button>
        <a class="mu-btn" href="@(From == "today" ? "" : "drills")">Done</a>
    </div>
}

@code {
    private sealed record Entry(DrillItem Item, Clef? Clef, Key ItemKey);

    private sealed record Answer(bool Right, double Ms, string Note);

    [Parameter] public string Key { get; set; } = "";

    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private DrillInfo? info;
    private DrillTrack track = DrillTrack.Start;
    private List<Entry> items = [];
    private Sheet? sheet;
    private bool disposed;
    private readonly List<Answer> results = [];
    private readonly List<PlayedNote> heard = [];
    private int index;
    private string mei = "";
    private long shownNs;
    private bool waiting;
    private bool loading = true;
    private string? feedback;
    private bool feedbackRight;
    private bool? looked;
    private Timer? chordTimer;
    private List<NoteCard> cards = [];
    private List<NoteAnswer> answers = [];
    private double fastMs;
    private int forgotTheKey;
    private DateTime started;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private double Share => results.Count == 0 ? 0 : results.Count(r => r.Right) / (double)results.Count;

    protected override void OnInitialized() => Keyboard.Received += OnReceived;

    protected override async Task OnParametersSetAsync()
    {
        info = DrillCatalog.Find(Key);
        if (info is null) return;

        track = await Store.GetTrackAsync<DrillTrack>($"drill:{Key}") ?? DrillTrack.Start;
        await NewSet();
    }

    private string Kicker() => info is null ? "Drills" : info.Top > 1 ? $"{info.Group} · step {track.Step} of {info.Top}" : info.Group;

    private async Task NewSet()
    {
        loading = true;
        results.Clear();
        (index, looked, forgotTheKey, started) = (0, null, 0, DateTime.Now);
        var rng = new Rng((ulong)DateTime.Now.Ticks);
        var level = (await Store.GetTrackAsync<ReadingState>("reading"))?.Level ?? 1;
        items = Key switch
        {
            "notes" => await NoteItems(rng),
            "ledger" => [.. Enumerable.Range(0, 8).Select(_ => new Entry(DrillMaterial.Ledger(track.Step, ChosenClefs(), rng), null, new Key(0)))],
            "intervals" => [.. Enumerable.Range(0, 8).Select(_ => Figure(rng))],
            "chords" => [.. Enumerable.Range(0, 8).Select(_ => { var key = track.Step <= 2 ? new Key(0) : rng.Pick(Ladder.Level(Math.Max(level, 4)).Keys); return new Entry(DrillMaterial.RandomChord(track.Step, key, rng), null, key); })],
            "keys" => [.. KeyItems(rng)],
            "geography" => [.. Enumerable.Range(0, 10).Select(_ => new Entry(DrillMaterial.Geography(track.Step, rng), null, new Key(0)))],
            _ => [],
        };
        loading = false;
        ShowItem();
    }

    // The clefs Settings has the note drills read.
    private HashSet<Clef> ChosenClefs() => Settings.Clefs switch { "treble" => [Clef.Treble], "bass" => [Clef.Bass], _ => [Clef.Treble, Clef.Bass] };

    // Notes from the note schedule: due cards, then new ones in landmark order.
    private async Task<List<Entry>> NoteItems(Rng rng)
    {
        cards = await Store.GetCardsAsync();
        answers = await Store.GetAnswersAsync(DateTimeOffset.Now.AddDays(-14));
        fastMs = NoteSchedule.FastMs(answers);
        var queue = NoteSchedule.Session(cards, answers, Today, cards.Count < 3 ? 3 : 1 + Math.Min(2, cards.Count / 10), ChosenClefs(), rng);
        // A short set is filled out with the notes it holds, mixed, never one straight after itself.
        var known = queue.Distinct().ToList();
        while (queue.Count < 8 && known.Count > 1)
        {
            var next = rng.Pick(known);
            if (next != queue[^1]) queue.Add(next);
        }
        return [.. queue.Take(14).Select(n => new Entry(DrillMaterial.Note(n.Clef == Clef.Treble ? 1 : 2, new Key(0).Spell(n.Midi)), n.Clef, new Key(0)))];
    }

    // Intervals by step: seconds in one direction, then thirds, fourths and fifths, then sixths to octaves in both directions.
    private Entry Figure(Rng rng)
    {
        var count = 1 + rng.Int(Math.Min(4, track.Step + 1));
        int[] sizes = track.Step switch { 1 => [1], 2 => [1, 2], 3 => [2, 3, 4], _ => [2, 3, 4, 5, 6, 7] };
        var direction = rng.Chance(0.5) ? 1 : -1;
        var steps = Enumerable.Range(0, count).Select(_ => rng.Pick(sizes) * (track.Step >= 4 && rng.Chance(0.4) ? -direction : direction)).ToList();
        var staff = rng.Chance(0.6) ? 1 : 2;
        var start = Spelled.FromDiatonic((staff == 1 ? 32 : 21) + rng.Int(5) - 2);
        return new Entry(DrillMaterial.Figure(staff, start, steps, new Key(0)), null, new Key(0));
    }

    // Key signatures by the boards' ladder: C and A minor, then up to one, two... five sharps or flats; a tonic, then a phrase.
    private IEnumerable<Entry> KeyItems(Rng rng)
    {
        var most = track.Step - 1;
        var keys = Enumerable.Range(-most, 2 * most + 1).SelectMany(f => new[] { new Key(f), new Key(f, true) }).ToList();
        for (var i = 0; i < 4; i++)
        {
            var key = rng.Pick(keys);
            yield return new Entry(DrillMaterial.KeySignature(key), null, key);
            yield return new Entry(DrillMaterial.KeyPhrase(key, Math.Max(3, Math.Min(8, 3 + track.Step)), rng.Next()), null, key);
        }
    }

    private void ShowItem()
    {
        if (index >= items.Count) return;

        var item = items[index].Item;
        mei = MeiWriter.Write(item.Score);
        lock (heard) heard.Clear();
        (waiting, feedback) = (false, null);
        Registry.DrillAnswer = right => right ? item.Answer : [.. item.Answer.Select(step => (IReadOnlyList<int>)[.. step.Select(m => m + 1)])];
    }

    private void Shown(long at) => (shownNs, waiting) = (at, true);

    private void OnReceived(MidiEvent e)
    {
        if (e.Kind != MidiKind.NoteOn || !waiting || index >= items.Count) return;

        lock (heard) heard.Add(new PlayedNote(e.Note, e.TimeNs, e.TimeNs, e.Velocity));
        var item = items[index].Item;
        var needed = item.Answer.Count;
        if (needed == 1 && item.Answer[0].Count > 1)
        {
            // A chord: everything within 150 ms of its first note.
            chordTimer ??= new Timer(_ => InvokeAsync(Judge), null, (int)(DrillScorer.ChordWindowNs / 1_000_000) + 20, Timeout.Infinite);
            return;
        }
        int count;
        lock (heard) count = heard.Count;
        if (count >= needed) _ = InvokeAsync(Judge);
    }

    private async Task Judge()
    {
        if (!waiting || index >= items.Count) return;

        waiting = false;
        chordTimer?.Dispose();
        chordTimer = null;
        var entry = items[index];
        var item = entry.Item;
        List<PlayedNote> notes;
        lock (heard) notes = [.. heard];
        // The answer goes on the staff, note by note: right, wrong (the key played as a grey head that many positions away, named)
        // or missed, and a chord's extra keys beside it; the words name the same notes.
        var expected = item.Score.Expected();
        var written = item.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).GroupBy(t => t.Id).ToDictionary(g => g.Key, g => g.First().Pitch);
        var key = entry.ItemKey;
        var played = notes.Where(p => p.OnNs >= shownNs).OrderBy(p => p.OnNs).ToList();
        List<SheetMark> marks = [];
        SheetMark Wrong(ExpectedNote n, int midi) => new(n.Id, "wrong", key.Spell(midi).ToString(), key.Spell(midi).Diatonic - written[n.Id].Diatonic);
        Answer answer;
        if (item.Answer.Count == 1 && item.Answer[0].Count > 1)
        {
            var chord = DrillScorer.Chord(item.Answer[0], notes, shownNs)!;
            var keys = played.Where(p => p.OnNs - played[0].OnNs <= DrillScorer.ChordWindowNs).Select(p => p.Midi).Distinct().ToList();
            var missing = expected.Where(n => !keys.Contains(n.Midi)).ToList();
            var extra = keys.Where(k => expected.All(n => n.Midi != k)).ToList();
            marks.AddRange(expected.Select(n => new SheetMark(n.Id, keys.Contains(n.Midi) ? "right" : "missed")));
            marks.AddRange(extra.Select(k => Wrong(expected.MinBy(n => Math.Abs(n.Midi - k))!, k) with { Kind = "extra" }));
            answer = new Answer(chord.Right, chord.ResponseMs, string.Join(" ", expected.Select(n => written[n.Id])));
            var slips = new[] { missing.Count > 0 ? $"{string.Join(", ", missing.Select(n => written[n.Id]))} missing" : null, extra.Count > 0 ? $"{string.Join(", ", extra.Select(k => key.Spell(k)))} extra" : null }.OfType<string>();
            feedback = chord.Right ? $"Right, {chord.SpreadMs:0} ms between the first and last notes." : $"Not quite: {string.Join("; ", slips)}.";
        }
        else if (item.Answer.Count == 1)
        {
            var note = DrillScorer.Note(item.Answer[0][0], notes, shownNs)!;
            var heardName = key.Spell(note.Played);
            var writtenName = key.Spell(item.Answer[0][0]);
            answer = new Answer(note.Right, note.ResponseMs, writtenName.ToString());
            feedback = note.Right ? $"Right, in {note.ResponseMs / 1000:0.0} s." : $"That was {heardName}{(Settings.LetterNames ? $"; the note is {writtenName}" : "")}{(note.OctaveOff ? ", an octave away" : note.LostOnKeyboard ? ", a key or two away" : "")}.";
            if (expected.Count == 1) marks.Add(note.Right ? new SheetMark(expected[0].Id, "right") : Wrong(expected[0], note.Played));
            if (entry.Clef is { } clef) await SaveCard(clef, item.Answer[0][0], note);
        }
        else
        {
            var figure = DrillScorer.Figure([.. item.Answer.Select(a => a[0])], notes, shownNs)!;
            answer = new Answer(figure.Right, figure.ResponseMs, "");
            if (Key == "keys") forgotTheKey += notes.Zip(item.Answer).Count(p => p.First.Midi != p.Second[0] && Math.Abs(p.First.Midi - p.Second[0]) == 1 && entry.ItemKey.AlterOf(entry.ItemKey.Spell(p.Second[0]).Step) != 0);
            var slips = new List<string>();
            foreach (var (n, i) in expected.Select((n, i) => (n, i)))
            {
                if (i >= played.Count) marks.Add(new SheetMark(n.Id, "missed"));
                else if (played[i].Midi == n.Midi) marks.Add(new SheetMark(n.Id, "right"));
                else
                {
                    marks.Add(Wrong(n, played[i].Midi));
                    slips.Add($"note {i + 1}, {key.Spell(played[i].Midi)} for {written[n.Id]}");
                }
            }
            feedback = figure.Right ? "Right." : $"{(figure.WrongFirstNote ? "The shape was right, from the wrong first note: " : "Off: ")}{string.Join("; ", slips)}.";
        }

        results.Add(answer);
        feedbackRight = answer.Right;
        StateHasChanged();
        if (sheet is not null && marks.Count > 0) await sheet.ShowMarks(marks);
        await Task.Delay(answer.Right ? 700 : 1600);
        // Left while the answer showed: the set stops there, unsaved.
        if (disposed) return;
        index++;
        if (index >= items.Count) await FinishSet();
        ShowItem();
        StateHasChanged();
    }

    private async Task SaveCard(Clef clef, int midi, DrillScorer.NoteAnswer note)
    {
        var card = cards.FirstOrDefault(c => c.Clef == clef && c.Midi == midi) ?? new NoteCard(clef, midi, 1, Today, Today, null);
        var updated = NoteSchedule.Answer(card, note.Right, note.ResponseMs <= fastMs, Today);
        cards.RemoveAll(c => c.Clef == clef && c.Midi == midi);
        cards.Add(updated);
        await Store.SaveAnswerAsync(updated, new NoteAnswer(DateTimeOffset.Now, clef, midi, note.Right, note.ResponseMs), note.Played, Key);
    }

    private async Task FinishSet()
    {
        Registry.DrillAnswer = null;
        var share = Share;
        if (info!.Top > 1)
        {
            var (step, last) = DrillLadder.After(track.Step, track.LastShare, share, info.Top);
            track = new DrillTrack(step, last, share, Today);
        }
        else track = track with { LastResult = share, LastDay = Today };
        await Store.SaveTrackAsync($"drill:{Key}", track);
        var measures = new { share, items = results.Count, medianMs = Stats.Median(results.Where(r => r.Right).Select(r => r.Ms).ToArray()), forgotTheKey, step = track.Step };
        await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, Today, Key, null, null, track.Step, null, null, null, "[]", null, System.Text.Json.JsonSerializer.Serialize(measures), share, share == 1, null));
        await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
        if (Key == "notes") await Store.MarkStepAsync(Today, StepKind.Notes, shortPlanDone: false);
    }

    // The step by hand: a new set at it, and the ladder moves on from there as before.
    private async Task SetStep(int step)
    {
        track = track with { Step = Math.Clamp(step, 1, info!.Top) };
        await Store.SaveTrackAsync($"drill:{Key}", track);
        await NewSet();
    }

    private async Task Looked(bool yes)
    {
        looked = yes;
        var last = (await Store.GetAttemptsAsync(Today, Key)).LastOrDefault();
        if (last is not null) await Store.AddAttemptAsync(last with { Id = 0, Kind = "geography-look", Looked = yes, Played = "[]" });
    }

    private IEnumerable<string> SummaryWords()
    {
        var slow = results.Where(r => r.Right && r.Ms > fastMs && r.Note != "").Select(r => r.Note).Distinct().ToList();
        var missed = results.Where(r => !r.Right && r.Note != "").Select(r => r.Note).Distinct().ToList();
        if (missed.Count > 0) yield return $"Missed: {string.Join(", ", missed)}.{(Key == "notes" ? " They come back sooner." : "")}";
        if (slow.Count > 0 && Key == "notes") yield return $"Right but slow, so not yet learned: {string.Join(", ", slow)}. They come back tomorrow.";
        if (Key == "keys" && forgotTheKey > 0) yield return $"Played without the key's sharp or flat {forgotTheKey} {(forgotTheKey == 1 ? "time" : "times")}.";
        if (results.All(r => r.Right)) yield return "All right.";
        if (Key == "geography") yield return "Hands covered or eyes on the screen: the only check is your own answer below.";
    }

    public void Dispose()
    {
        disposed = true;
        Keyboard.Received -= OnReceived;
        chordTimer?.Dispose();
        Registry.DrillAnswer = null;
    }
}
