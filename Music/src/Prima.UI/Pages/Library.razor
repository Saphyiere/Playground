@page "/library"
@implements IAsyncDisposable
@inject PrimaStore Store
@inject IFiles Files
@inject Prima.UI.Library.LibraryPrep Prep
@inject Prima.UI.Library.Openings Openings
@inject Prima.UI.Library.LibraryPlace Place
@inject Prima.UI.Library.RepertoireBook Book
@inject NavigationManager Nav
@inject AppNavigation Navigation
@inject IJSRuntime JS
@using Prima.Core.Library
@using Prima.Core.Practice

<PageTitle>@(Heading is null ? "Library" : $"{Heading} · Library") · Prima</PageTitle>

@* The Library is a catalogue: its lists stay down the left (the pieces uploaded, the ones near your level, then every composer,
   kind or level), and what's chosen there is beside them: a composer's works by kind, a work's movements in order with the
   other versions of it, or a list of pieces. Each column scrolls by itself. *@
<div class="lib">
    <header class="page-head">
        <div>
            <p class="page-kicker">@Counted()</p>
            <h1 class="page-title">Library</h1>
        </div>
        <div class="head-tools">
            <input class="text-field head-search" type="search" placeholder="Find a piece or a composer" aria-label="Find a piece" value="@search" @oninput="Typed" />
            <button type="button" class="mu-btn" @onclick="Import">Import files</button>
        </div>
    </header>

    @if (Prep.Running)
    {
        <section class="mu-screen library-prep" aria-live="polite">
            <div class="mu-screen-head"><span>@(Prep.Adding is { } adding ? $"Adding {adding}" : "Preparing the collection")</span><span>@Prep.Progress.Done of @Prep.Progress.Total</span></div>
            <div class="mu-meter" role="img" aria-label="@($"{Prep.Progress.Done} of {Prep.Progress.Total} pieces ready")">
                @for (var i = 0; i < 20; i++)
                {
                    <span class="@(i < 20 * Prep.Progress.Done / Math.Max(1, Prep.Progress.Total) ? "on" : "")"></span>
                }
            </div>
            <p class="page-panel-line">Once only: each piece is stored with its excerpts. The ones done are in the lists already.</p>
        </section>
    }
    @if (Openings.Playing is { } hearing && byId.GetValueOrDefault(hearing) is { } heard)
    {
        <p class="control-note" role="status">The opening of @heard.Title, @Openings.Where. ■ stops it.</p>
    }
    else if (note is not null)
    {
        <p class="control-note" role="status">@note</p>
    }

    @{
        var today = DateOnly.FromDateTime(DateTime.Now);
        var view = View;
        var of = ShownOf;
        var listed = ListMode;

        // A piece's row: the key that plays its opening, its number where it has one, its name over a line about it, its level
        // and its star.
        RenderFragment<(PieceRecord Piece, string No, string Name, string? About)> row = item =>
        {
            var piece = item.Piece;
            var playing = Openings.Playing == piece.Id;
            var starred = Book.Current.Has(piece.Id);
            return @<li class="mov piece-item">
                @if (Hearable(piece))
                {
                    <button type="button" class="mu-btn piece-hear" aria-pressed="@(playing ? "true" : "false")" aria-label="@(playing ? $"Stop {piece.Title}" : $"Hear the opening of {piece.Title}")" @onclick="() => Hear(piece)">@(playing ? "■" : "▶")</button>
                }
                else
                {
                    <span class="piece-hear-none" title="A PDF without MIDI: nothing to play until its notes are read"></span>
                }
                <span class="mov-no">@item.No</span>
                <a class="mov-name" href="@($"library/{Uri.EscapeDataString(piece.Id)}")">
                    <span class="piece-title">@item.Name</span>
                    @if (!string.IsNullOrEmpty(item.About))
                    {
                        <small>@item.About</small>
                    }
                </a>
                <span class="piece-level">@LevelShown(piece)</span>
                <button type="button" class="lb-star" aria-pressed="@(starred ? "true" : "false")" aria-label="@(starred ? $"{piece.Title} is in your repertoire: choose its collections" : $"Add {piece.Title} to your repertoire")" @onclick="e => Star(piece, e)">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 17l-5.3 2.9 1.1-6L3.4 9.7l6-.8z" /></svg>
                </button>
            </li>;
        };

        // A work's own pieces in order, then the other versions of it the Library has, each by its own title.
        RenderFragment<ListedWork> movements = work =>
            @<text>
                <ol class="mov-list">
                    @foreach (var part in work.Parts)
                    {
                        @if (byId.GetValueOrDefault(part.Id) is { } piece)
                        {
                            var (no, name) = Numbered(work, part);
                            @row((piece, no, name, About(piece)))
                        }
                    }
                </ol>
                @if (work.Others.Count > 0)
                {
                    <p class="col-title others-title">@(work.Others.Count == 1 ? "Another version of it" : $"Other versions of it · {work.Others.Count}")</p>
                    <ol class="mov-list">
                        @foreach (var other in work.Others)
                        {
                            @if (byId.GetValueOrDefault(other.Id) is { } piece)
                            {
                                @row((piece, "", piece.Title, AboutVersion(piece)))
                            }
                        }
                    </ol>
                }
            </text>;
    }

    <div class="lib-cols">
        <nav class="lib-col lib-list" aria-label="The Library's lists" data-keep="list" data-at="@listed">
            @if (pieces.Any(p => p.Imported))
            {
                <a class="col-item shelf-own" href="@Address("mine", null)" aria-current="@(view == "mine" ? "true" : null)"><span>Uploaded pieces</span><span class="n">@pieces.Count(p => p.Imported)</span></a>
            }
            @if (composers.Count > 0 || pieces.Count > 0)
            {
                <p class="col-title">Catalogue · @pieces.Count(p => !p.Imported).ToString("N0")</p>
                @if (Near().Count() is > 0 and var near)
                {
                    <a class="col-item" href="@Address("near", null)" aria-current="@(view == "near" ? "true" : null)"><span>Near your level</span><span class="n">@near</span></a>
                }
                <p class="col-by">
                    @foreach (var (key, label) in Lists)
                    {
                        <a href="@Nav.GetUriWithQueryParameter("list", key)" aria-current="@(listed == key ? "true" : null)" @onclick="@(() => Keep("list", key))" @onclick:preventDefault>@label</a>
                    }
                </p>
                @if (listed == "composers")
                {
                    <input class="text-field col-find" type="search" placeholder="Find a composer" aria-label="Find a composer" value="@find" @oninput="Finding" />
                    @foreach (var composer in composers.Where(c => string.IsNullOrWhiteSpace(find) || Shelves.Finds(c.Name, find)))
                    {
                        <a class="col-item" href="@Address("composer", composer.Name)" aria-current="@(view == "composer" && of == composer.Name ? "true" : null)"><span>@composer.Listed</span><span class="n">@composer.Count</span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(find) && !composers.Any(c => Shelves.Finds(c.Name, find)))
                    {
                        <p class="section-note">No composer for “@find”.</p>
                    }
                }
                else if (listed == "kinds")
                {
                    @foreach (var kind in Shelves.Kinds)
                    {
                        @if (pieces.Count(p => kindOf[p.Id] == kind) is > 0 and var count)
                        {
                            <a class="col-item" href="@Address("kind", kind)" aria-current="@(view == "kind" && of == kind ? "true" : null)"><span>@kind</span><span class="n">@count</span></a>
                        }
                    }
                }
                else
                {
                    <p class="section-note">Where most of a piece reads.</p>
                    @foreach (var level in pieces.GroupBy(LevelOf).OrderBy(g => g.Key))
                    {
                        <a class="col-item" href="@Address("level", level.Key.ToString())" aria-current="@(view == "level" && of == level.Key.ToString() ? "true" : null)"><span>@(level.Key == 0 ? "Not graded" : $"Level {level.Key}")</span><span class="n">@level.Count()</span></a>
                    }
                }
            }
            @* Prima's own pieces taken out (Settings' Remove library, or one by one) stay out until they're put back here, and the
               collection's pieces removed by hand stay out when it's imported again, until they're let back in. *@
            @if (pieces.Count > 0 && puttingBack is null && OwnOut() is { } said)
            {
                <div class="library-put-back">
                    <p class="section-note">@said</p>
                    <button type="button" class="mu-btn" @onclick="PutBack">@(ownOut is { All: false, Removed.Count: 1 } ? "Put it back" : "Put them back")</button>
                </div>
            }
            @if (collectionOut.Count > 0)
            {
                <div class="library-put-back">
                    <p class="section-note">@(collectionOut.Count == 1 ? "1 of your collection's pieces is out of the Library: you removed it, and importing its collection again leaves it out." : $"{collectionOut.Count} of your collection's pieces are out of the Library: you removed them, and importing their collection again leaves them out.")</p>
                    <button type="button" class="mu-btn" @onclick="LetBackIn">@(collectionOut.Count == 1 ? "Let it back in" : "Let them back in")</button>
                </div>
            }
            <p class="section-note library-credits">The pieces are public domain or openly licensed; the level shown is a piece's hardest excerpt (most of a piece reads lower). <a href="library/credits">Where the music comes from</a></p>
        </nav>

        <div class="lib-main">
            @if (pieces.Count == 0)
            {
                @if (!Prep.Running && puttingBack is null)
                {
                    @if (ownOut.All)
                    {
                        <p class="page-note">Prima's own pieces are out of the Library: Remove library took them out, and Prima won't put them back by itself. Import MusicXML, MEI, ABC, MIDI or PDF files, or put Prima's own back.</p>
                        <div class="control-row library-put-back">
                            <button type="button" class="mu-btn mu-primary" @onclick="PutBack">Put Prima's pieces back</button>
                        </div>
                    }
                    else
                    {
                        <p class="page-note">The collection wasn't built into this copy of the app (Music/README.md says how). Import MusicXML, MEI, ABC, MIDI or PDF files meanwhile.</p>
                    }
                }
            }
            else if (view == "found")
            {
                // Every piece whose words have what's typed, under its composer, and the composers whose names do.
                var all = Found().ToList();
                var names = composers.Where(c => Shelves.Finds(c.Name, search!)).ToList();
                <div class="lib-main-head">
                    <div>
                        <h2 class="col-head">Found for “@search”</h2>
                        <p class="col-sub">@(all.Count == 0 ? "Nothing" : all.Count == 1 ? "1 piece" : $"{all.Count:N0} pieces")@(all.Count > Most ? $", the first {Most} here: another word narrows them" : ""). Each word is looked for by itself; a number finds a work's number or a movement's.</p>
                    </div>
                </div>
                <div class="lib-col" data-keep="pieces">
                    @if (names.Count > 0)
                    {
                        <p class="col-title">@(names.Count == 1 ? "Composer" : "Composers")</p>
                        @foreach (var composer in names.Take(8))
                        {
                            <a class="col-item" href="@Address("composer", composer.Name)"><span>@composer.Listed</span><span class="n">@composer.Count</span></a>
                        }
                    }
                    @foreach (var group in all.Take(Most).GroupBy(p => string.IsNullOrWhiteSpace(p.Composer) ? NotGiven : p.Composer))
                    {
                        <p class="col-title found-title">@group.Key</p>
                        <ol class="mov-list">
                            @foreach (var piece in group)
                            {
                                @row((piece, "", piece.Title, AboutFound(piece)))
                            }
                        </ol>
                    }
                    @if (all.Count == 0 && names.Count == 0)
                    {
                        <p class="page-note">Nothing here for “@search”.</p>
                    }
                </div>
            }
            else if (view == "composer" && of is not null)
            {
                var works = worksOf.GetValueOrDefault(of);
                var count = pieces.Count(p => p.Composer == of);
                <div class="lib-main-head">
                    <div>
                        <h2 class="col-head">@of</h2>
                        <p class="col-sub">@(count == 1 ? "1 piece" : $"{count:N0} pieces")@(works is { Count: > 1 } ? $" · {works.Count} works" : "")</p>
                    </div>
                    @if (works is not null && Tabs(works) is { Count: > 1 } tabs)
                    {
                        <div class="settings-tabs" role="tablist" aria-label="Kinds">
                            @foreach (var each in tabs)
                            {
                                <button type="button" role="tab" class="settings-tab" aria-selected="@(each == TabOf(works) ? "true" : "false")" @onclick="() => Turn(each.Name)">@each.Name<span class="tab-n">@each.Held</span></button>
                            }
                        </div>
                    }
                </div>
                @if (works is null)
                {
                    <p class="section-note" role="status">Reading its works…</p>
                }
                else
                {
                    var tab = TabOf(works);
                    var shown = works.Where(w => tab is not null && tab.Kinds.Contains(w.Kind)).ToList();
                    @if (shown.All(w => w.Parts.Count == 1 && w.Others.Count == 0))
                    {
                        // Pieces that each stand by themselves need no second column.
                        <div class="lib-col" data-keep="pieces" data-at="@($"{of} {tab?.Name}")">
                            <ol class="mov-list">
                                @foreach (var work in shown)
                                {
                                    @if (byId.GetValueOrDefault(work.Parts[0].Id) is { } piece)
                                    {
                                        @row((piece, work.Number?.ToString() ?? "", work.Title, AboutAlone(work, piece)))
                                    }
                                }
                            </ol>
                        </div>
                    }
                    else
                    {
                        var chosen = ChosenOf(shown);
                        // Across: the works, and the one chosen beside them.
                        <div class="lib-pair only-wide">
                            <div class="lib-col works" data-keep="works" data-at="@($"{of} {tab?.Name}")">
                                @foreach (var work in shown)
                                {
                                    <a class="col-item col-work" href="@Nav.GetUriWithQueryParameter("work", work.Key)" aria-current="@(work == chosen ? "true" : null)" @onclick="@(() => Keep("work", work.Key))" @onclick:preventDefault>
                                        <span class="work-no">@work.Number</span>
                                        <span>@work.Title<small>@WorkLine(work)</small></span>
                                        <span class="n">@Levels(work)</span>
                                    </a>
                                }
                            </div>
                            <div class="lib-col" data-keep="work" data-at="@($"{of} {chosen?.Key}")">
                                @if (chosen is not null)
                                {
                                    <h3 class="col-head small">@chosen.Title</h3>
                                    <p class="col-sub">@WorkLine(chosen, levels: true)</p>
                                    @movements(chosen)
                                }
                            </div>
                        </div>
                        // Upright: each work opens where it is.
                        <div class="work-list only-upright" data-keep="works-upright" data-at="@($"{of} {tab?.Name}")">
                            @foreach (var work in shown)
                            {
                                var open = work == chosen && Chosen != Closed;
                                <section class="work" data-open="@(open ? "true" : null)">
                                    <a class="work-head" href="@Nav.GetUriWithQueryParameter("work", open ? Closed : work.Key)" aria-expanded="@(open ? "true" : "false")" @onclick="@(() => Keep("work", open ? Closed : work.Key))" @onclick:preventDefault>
                                        <span class="work-no">@work.Number</span>
                                        <div class="work-name"><h3>@work.Title</h3><p>@WorkLine(work)</p></div>
                                        <span class="work-levels">@Levels(work)</span>
                                        <span class="work-chev"></span>
                                    </a>
                                    @if (open)
                                    {
                                        @movements(work)
                                    }
                                </section>
                            }
                        </div>
                    }
                }
            }
            else if (view == "kind" && of is not null)
            {
                // A kind is an index of every composer's works of it: a work goes to its composer, opened at it.
                var index = worksRead ? composers.Select(c => (Composer: c, Works: worksOf[c.Name].Where(w => w.Kind == of).ToList())).Where(c => c.Works.Count > 0).ToList() : null;
                <div class="lib-main-head">
                    <div>
                        <h2 class="col-head">@of</h2>
                        <p class="col-sub">@(index is null ? "" : $"{Counted(index.Sum(c => c.Works.Count), "work")} by {Counted(index.Count, "composer")} · ")@Counted(pieces.Count(p => kindOf[p.Id] == of), "piece")</p>
                    </div>
                </div>
                @if (index is null)
                {
                    <p class="section-note" role="status">Reading the works…</p>
                }
                else
                {
                    <div class="lib-col" data-keep="pieces">
                        @foreach (var (composer, works) in index)
                        {
                            <p class="col-title found-title">@composer.Listed</p>
                            @foreach (var work in works)
                            {
                                <a class="col-item col-work" href="@($"library?by=composer&of={Uri.EscapeDataString(composer.Name)}&kind={Uri.EscapeDataString(of)}&work={Uri.EscapeDataString(work.Key)}")">
                                    <span class="work-no">@work.Number</span>
                                    <span>@work.Title<small>@WorkLine(work)</small></span>
                                    <span class="n">@Levels(work)</span>
                                </a>
                            }
                        }
                    </div>
                }
            }
            else if (view == "mine")
            {
                var mine = Uploaded().ToList();
                <div class="lib-main-head">
                    <div class="band-head">
                        <div>
                            <h2 class="col-head">Uploaded pieces</h2>
                            <p class="col-sub">@(mine.Count == 1 ? "1 piece" : $"{mine.Count} pieces") · @(Sorted switch { "az" => "by title", "artist" => "by artist", _ => "the latest first" })</p>
                        </div>
                        <div class="band-tools">
                            @foreach (var (key, label) in Sorts)
                            {
                                <button type="button" class="mu-toggle lb-small" aria-pressed="@(Sorted == key ? "true" : "false")" @onclick="@(() => Keep("sort", key == "latest" ? null : key))"><span class="mu-led"></span>@label</button>
                            }
                            <button type="button" class="mu-btn mu-primary lb-small" @onclick="Import">Import files</button>
                        </div>
                    </div>
                </div>
                <div class="lib-col" data-keep="pieces">
                    <ul class="up-list">
                        @foreach (var piece in mine)
                        {
                            var playing = Openings.Playing == piece.Id;
                            var starred = Book.Current.Has(piece.Id);
                            <li class="up-row piece-item">
                                @if (Hearable(piece))
                                {
                                    <button type="button" class="mu-btn piece-hear" aria-pressed="@(playing ? "true" : "false")" aria-label="@(playing ? $"Stop {piece.Title}" : $"Hear the opening of {piece.Title}")" @onclick="() => Hear(piece)">@(playing ? "■" : "▶")</button>
                                }
                                else
                                {
                                    <span class="piece-hear-none" title="A PDF without MIDI: nothing to play until its notes are read"></span>
                                }
                                <a class="up-main" href="@($"library/{Uri.EscapeDataString(piece.Id)}")">
                                    <span class="up-title piece-title">@piece.Title</span>
                                    @if (!string.IsNullOrWhiteSpace(piece.Composer))
                                    {
                                        <span class="up-artist">@piece.Composer</span>
                                    }
                                </a>
                                <span class="up-last">
                                    @if (played.GetValueOrDefault(piece.Id) is { } done)
                                    {
                                        <b>@Capital(PieceWords.When(done.Last.Day, today))</b>@($" · {PieceWords.Short(done.Last)}")
                                    }
                                    else
                                    {
                                        @($"Added {Capital(PieceWords.When(DateOnly.FromDateTime(piece.Added.LocalDateTime), today)).ToLowerInvariant()}, not played yet")
                                    }
                                </span>
                                <span class="up-parts">
                                    @if (piece.IsPdf) { <span class="piece-tag">Pages</span> }
                                    @if (piece.PlaysAlong) { <span class="piece-tag">Notes</span> }
                                    <span class="piece-level">@LevelShown(piece)</span>
                                </span>
                                <button type="button" class="lb-star" aria-pressed="@(starred ? "true" : "false")" aria-label="@(starred ? $"{piece.Title} is in your repertoire: choose its collections" : $"Add {piece.Title} to your repertoire")" @onclick="e => Star(piece, e)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 17l-5.3 2.9 1.1-6L3.4 9.7l6-.8z" /></svg>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (mine.Count == 0)
                    {
                        <p class="page-note">Nothing uploaded yet. Import files brings in MusicXML, MEI, ABC, MIDI and PDF files, and zips of them.</p>
                    }
                </div>
            }
            else
            {
                // A list of pieces (the ones near your level, a level's, a period's, everything, the PDFs), under their composers
                // by surname, the pieces without one last.
                var shown = Shown().ToList();
                var groups = shown.GroupBy(p => string.IsNullOrWhiteSpace(p.Composer) ? NotGiven : p.Composer).OrderBy(g => g.Key == NotGiven).ThenBy(g => Initial(g.Key), StringComparer.Ordinal)
                    .ThenBy(g => Shelves.Surname(g.Key), StringComparer.OrdinalIgnoreCase).ThenBy(g => g.Key).ToList();
                var by = ComposersIn(groups);
                <div class="lib-main-head">
                    <div class="band-head">
                        <div>
                            <h2 class="col-head">@Heading</h2>
                            <p class="col-sub">@(shown.Count == 1 ? "1 piece" : $"{shown.Count:N0} pieces")@(by > 1 ? $" by {by} composers" : "").@(view == "near" ? $" {NearNote()}" : "")</p>
                        </div>
                        @if (view != "pdf")
                        {
                            <div class="band-tools">
                                @foreach (var (key, label) in Formats)
                                {
                                    <button type="button" class="mu-toggle lb-small" aria-pressed="@(format == key ? "true" : "false")" @onclick="() => Choose(key)"><span class="mu-led"></span>@label</button>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="lib-col" data-keep="pieces">
                    @if (groups.Count > 2)
                    {
                        // Straight to a composer, in a long list.
                        <nav class="shelf shelf-jump" aria-label="@(by > MostKeys ? "Composers by surname" : "Composers")">
                            @foreach (var (label, count, at) in Keys(groups))
                            {
                                <a class="mu-btn shelf-chip" href="@($"{Here()}#group-{at}")">@label <span class="shelf-count">@count</span></a>
                            }
                        </nav>
                    }
                    @foreach (var (group, i) in groups.Select((g, i) => (g, i)))
                    {
                        <p id="@($"group-{i}")" class="col-title found-title">@group.Key</p>
                        <ol class="mov-list">
                            @foreach (var piece in group.OrderBy(p => p.Work ?? "").ThenBy(p => Works.Natural(p.Title), StringComparer.Ordinal))
                            {
                                @row((piece, "", piece.Title, AboutListed(piece)))
                            }
                        </ol>
                    }
                    @if (shown.Count == 0)
                    {
                        <p class="page-note">Nothing here.</p>
                    }
                </div>
            }
        </div>
    </div>

    @* The piece just taken out, from its own Remove: what went, and Undo, at the foot of the screen until the Library is left. *@
    @if (Place.Removed is { } removed)
    {
        <div class="control-row library-removed" role="status">
            <p class="control-note">Removed “@removed.Piece.Title” from the Library.</p>
            <button type="button" class="mu-btn" @onclick="Undo">Undo</button>
        </div>
    }

    @* A star's second tap: which of the repertoire's collections the piece is in, where it was tapped. *@
    @if (starring is { } kept)
    {
        var holding = Book.Current.Holding(kept.Piece.Id).Select(c => c.Id).ToHashSet();
        <div class="lb-away" @onclick="CloseStar"></div>
        <div class="lb-menu add-to" role="menu" aria-label="@($"Where {kept.Piece.Title} is kept")" style="@($"--at-x: {kept.X.ToString("0", CultureInfo.InvariantCulture)}px; --at-y: {kept.Y.ToString("0", CultureInfo.InvariantCulture)}px")">
            <p class="menu-title">Keep “@kept.Piece.Title” in</p>
            <button type="button" role="menuitemcheckbox" aria-checked="true" @onclick="Unstar"><span class="mu-led"></span>Repertoire</button>
            @foreach (var collection in Book.Current.Collections)
            {
                var there = holding.Contains(collection.Id);
                <button type="button" role="menuitemcheckbox" aria-checked="@(there ? "true" : "false")" @onclick="() => Book.PutAsync(collection.Id, kept.Piece.Id, !there)"><span class="mu-led"></span>@collection.Name</button>
            }
            <hr />
            @if (naming)
            {
                <div class="lb-menu-new">
                    <input class="text-field" type="text" placeholder="Its name" aria-label="The new collection's name" maxlength="60" value="@newName" @oninput="e => newName = e.Value?.ToString()" @onkeydown="NameKey" />
                    <button type="button" class="mu-btn mu-primary lb-small" @onclick="AddCollection">Add</button>
                </div>
                @if (nameNote is not null)
                {
                    <p class="menu-note" role="status">@nameNote</p>
                }
            }
            else
            {
                <button type="button" role="menuitem" @onclick="() => naming = true">New collection…</button>
            }
        </div>
    }
</div>
