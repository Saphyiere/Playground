@page "/drills/scales"
@page "/drills/arpeggios"
@page "/drills/independence"
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject NavigationManager Nav
@using Prima.Core.Generation
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>@Title · Prima</PageTitle>

<PageHead Title="@Title" Kicker="@(item?.Name ?? "Technique")"><KeyboardLamp /></PageHead>

@* What to play is yours to choose, whatever your reading level: the key (easier to harder, in the exams' order), the form, the
   octaves, the hands. Today's is the day's plan. *@
<section class="control-rows technique-choice" aria-label="What to play">
    <div class="control-row">
        @if (Key == "independence")
        {
            <span class="control-label">Pattern</span>
            @foreach (var (pattern, name) in Patterns)
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(choice.Pattern == pattern)" disabled="@playing" @onclick="() => Choose(choice with { Pattern = pattern })"><span class="mu-led"></span>@name</button>
            }
        }
        <span class="control-label @(Key == "independence" ? "control-label-gap" : "")">Key</span>
        <button type="button" class="mu-btn" aria-label="An easier key" disabled="@(playing || KeyAt(-1) is null)" @onclick="() => Choose(choice with { Key = KeyAt(-1)!.Value })">−</button>
        <span class="control-value">@choice.Key.Name</span>
        <button type="button" class="mu-btn" aria-label="A harder key" disabled="@(playing || KeyAt(1) is null)" @onclick="() => Choose(choice with { Key = KeyAt(1)!.Value })">+</button>
        @if (Key == "scales" && choice.Key.Minor)
        {
            <button type="button" class="mu-toggle" aria-pressed="@On(choice.Form != ScaleKind.MelodicMinor)" disabled="@playing" @onclick="() => Choose(choice with { Form = ScaleKind.HarmonicMinor })"><span class="mu-led"></span>Harmonic</button>
            <button type="button" class="mu-toggle" aria-pressed="@On(choice.Form == ScaleKind.MelodicMinor)" disabled="@playing" @onclick="() => Choose(choice with { Form = ScaleKind.MelodicMinor })"><span class="mu-led"></span>Melodic</button>
        }
        @if (choice != today with { Hands = choice.Hands })
        {
            <button type="button" class="mu-btn" disabled="@playing" @onclick="() => Choose(today with { Hands = choice.Hands })">Today's</button>
        }
    </div>
    <div class="control-row">
        @if (Key != "independence")
        {
            <span class="control-label">Octaves</span>
            @if (Key == "arpeggios")
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(choice.Octaves == 0)" disabled="@playing" @onclick="() => Choose(choice with { Octaves = 0 })"><span class="mu-led"></span>Triad</button>
            }
            @for (var n = 1; n <= 4; n++)
            {
                var octaves = n;
                <button type="button" class="mu-toggle mu-toggle-number" aria-pressed="@On(choice.Octaves == octaves)" disabled="@playing" @onclick="() => Choose(choice with { Octaves = octaves })"><span class="mu-led"></span>@octaves</button>
            }
        }
        <span class="control-group">
            <span class="control-label @(Key != "independence" ? "control-label-gap" : "")">Hands</span>
            @foreach (var h in new[] { HandUse.Right, HandUse.Left, HandUse.Together })
            {
                <button type="button" class="mu-toggle" aria-pressed="@On(choice.Hands == h)" disabled="@playing" @onclick="() => Choose(choice with { Hands = h })"><span class="mu-led"></span>@HandName(h)</button>
            }
        </span>
    </div>
    <p class="control-note">Runs @runs of @TechniqueState.RunsPerSet. Stop if anything hurts.</p>
</section>

<PlayAlong Name="@Key" Music="music" SheetOf="() => sheet" Tempo="Tempo" TempoChanged="SetTempo" StartLabel="Run" CanStart="@(runs < TechniqueState.RunsPerSet)" OnStarting="Starting" OnFinished="Finished">
    <Readouts>
        <div class="mu-readout"><span class="mu-readout-label">Target</span><span class="mu-readout-value">@(state.Target is { } t ? $"±{t:0}%" : "First week")</span></div>
    </Readouts>
</PlayAlong>

@if (state.Tempo is null && result is null && outcome is null)
{
    <p class="page-note">First, play it once in Wait for me, at your own speed and without the click. The In time runs then start a little slower than that, which is how speed is built.</p>
}

<div class="sheet-frame">
    <Sheet @ref="sheet" Mei="@mei" Scale="0.9" />
</div>

@if (result is not null)
{
    <section class="mu-screen summary-figures" aria-label="The run">
        <div class="mu-readouts">
            @foreach (var (hand, run) in new[] { ("Right", result.Right), ("Left", result.Left) }.Where(r => r.Item2 is not null))
            {
                <div class="mu-readout @(run!.Valid ? "" : "miss")"><span class="mu-readout-label">@hand evenness</span><span class="mu-readout-value">@(run.Valid ? $"±{run.IoiSdPercent:0.0}%" : Slips(run))</span></div>
            }
            @if (result.SyncMeanMs is { } sync)
            {
                <div class="mu-readout"><span class="mu-readout-label">Hands apart</span><span class="mu-readout-value">@($"{Math.Abs(sync):0} ms")</span></div>
            }
        </div>
    </section>
    <ul class="summary-words">
        @foreach (var line in Words())
        {
            <li>@line</li>
        }
    </ul>
}
else if (outcome?.Wait is not null)
{
    <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")">
        <li>@(comfortable is { } bpm ? $"Your own speed came to about {bpm:0} beats a minute, so In time starts at {state.Tempo:0}." : "Wait for me is practice for the notes: it doesn't count for evenness or move the tempo.")</li>
    </PlaySummary>
}

@code {
    private static readonly (int Pattern, string Name)[] Patterns = [(1, "Five fingers"), (2, "Trill 3–4"), (3, "Trill 4–5")];

    private string Key => new Uri(Nav.Uri).Segments[^1].Trim('/');

    private string Title => Key switch { "arpeggios" => "Arpeggios", "independence" => "Finger independence", _ => "Scales" };

    private TechniqueChoice choice = new(new Key(0), ScaleKind.Major, 1, HandUse.Right, 1);
    private TechniqueChoice today = new(new Key(0), ScaleKind.Major, 1, HandUse.Right, 1);
    private TechniqueItem? item;
    private string mei = "";
    private PlayMusic? music;
    private TechniqueState state = TechniqueState.New;
    private TechniqueResult? result;
    private PlayOutcome? outcome;
    private double? comfortable;
    private Sheet? sheet;
    private bool playing;
    private int runs;
    private int level = 1;
    private DateTime started;
    private double? noiseFloor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private static string On(bool on) => on ? "true" : "false";

    // An item's own progress, kept by its name (and octaves past one) and hands.
    private string StateKey => $"technique:{Key}:{item?.Id}:{choice.Hands}";

    private double Tempo => state.Tempo ?? 60;

    private static string HandName(HandUse h) => h switch { HandUse.Right => "Right", HandUse.Left => "Left", _ => "Together" };

    // The next key easier or harder in the exams' order (major keys only for the finger patterns), or null at the end.
    private Key? KeyAt(int step)
    {
        var keys = Technique.Order.Where(k => Key != "independence" || !k.Minor).ToList();
        var i = keys.IndexOf(choice.Key) + step;
        return i >= 0 && i < keys.Count ? keys[i] : null;
    }

    protected override async Task OnInitializedAsync()
    {
        level = (await Store.GetTrackAsync<ReadingState>("reading"))?.Level ?? 1;
        noiseFloor = Keyboard.Sensing.JitterMs;
        started = DateTime.Now;
        var plan = DailyPlan.Build(Today, Settings.DailyMinutes, level, false);
        var pattern = (await Store.GetTrackAsync<DrillTrack>("drill:independence") ?? DrillTrack.Start).Step;
        today = TechniqueChoice.Today(Key, plan.ScaleKey, plan.ArpeggioKey, level, pattern, Today);
        choice = await Store.GetTrackAsync<TechniqueChoice>($"technique-choice:{Key}") ?? today;
        await Build();
    }

    private async Task Choose(TechniqueChoice to)
    {
        choice = to;
        await Store.SaveTrackAsync($"technique-choice:{Key}", to);
        await Build();
    }

    private async Task Build()
    {
        item = choice.Item(Key);
        mei = MeiWriter.Write(item.Score, 72);
        music = new PlayMusic(item.Score, item.Score.Expected());
        state = await Store.GetTrackAsync<TechniqueState>(StateKey) ?? TechniqueState.New;
        (result, outcome, comfortable) = (null, null, null);
    }

    private async Task SetTempo(double bpm)
    {
        state = state with { Tempo = bpm, Started = state.Started ?? Today };
        await Store.SaveTrackAsync(StateKey, state);
    }

    private Task Starting()
    {
        (playing, result, outcome, comfortable) = (true, null, null, null);
        return Task.CompletedTask;
    }

    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        if (item is null) return;

        runs++;
        if (how.Mode == PlayMode.WaitForMe)
        {
            // The first time, your own pace in Wait for me is the comfortable speed: the gap between notes, as beats a minute.
            var onsets = how.Played.Select(p => p.OnNs).ToArray();
            if (state.Tempo is null && onsets.Length >= 4)
            {
                var gapMs = Stats.Median(onsets.Zip(onsets.Skip(1), (a, b) => (b - a) / 1e6).ToArray());
                comfortable = 60_000 / (gapMs * item.NotesPerBeat);
                state = state.Comfortable(comfortable.Value, Today);
                await Store.SaveTrackAsync(StateKey, state);
            }
        }
        else
        {
            await Scored(item, how.Played);
        }
        await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
        started = DateTime.Now;
        if (runs >= 3) await Store.MarkStepAsync(Today, StepKind.Technique);
    }

    // In time: evenness from the keys played, each note marked as the scorer lined it up (replacing the play bar's marks), and
    // the tempo moved on as the run went.
    private async Task Scored(TechniqueItem run, IReadOnlyList<PlayedNote> played)
    {
        result = TechniqueScorer.Score(run, played);
        // Every note marked as Sight-read marks them: green right; wrong, the note grey and the key played beside it in red, each
        // named; outlined grey missed; and an extra key as a red head beside the note before it.
        var pitches = run.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).ToDictionary(t => t.Id, t => t.Pitch);
        SheetMark KeyMark(string id, string kind, int key)
        {
            var spelled = run.Key.Spell(key);
            return new SheetMark(id, kind, spelled.ToString(), spelled.Diatonic - pitches[id].Diatonic, Written: pitches[id].ToString());
        }
        var handRuns = new[] { result.Right, result.Left }.OfType<HandRun>().ToList();
        var marks = handRuns.SelectMany(h => h.Notes).Select(n => n.Outcome switch
        {
            Outcome.Wrong => KeyMark(n.Id, "wrong", n.Played!.Value),
            Outcome.Missed => new SheetMark(n.Id, "missed"),
            _ => new SheetMark(n.Id, "right"),
        }).Concat(handRuns.SelectMany(h => h.Extras).Select(e => KeyMark(e.AfterId, "extra", e.Played)));
        await (sheet?.ShowMarks(marks) ?? Task.CompletedTask);
        var sd = handRuns.Where(r => r.Valid).Select(r => r.IoiSdPercent).DefaultIfEmpty(0).Max();
        var tempo = Tempo;
        state = state.After(result.Valid, result.Valid ? sd : null, Today);
        await Store.SaveTrackAsync(StateKey, state);
        var measures = new
        {
            valid = result.Valid,
            right = result.Right is { Valid: true } r ? new { r.IoiSdMs, r.IoiSdPercent, r.PlainIoiSdMs, r.Bpm, r.CrossingMs, r.SeamMs, r.VelocitySd, r.LegatoMs } : null,
            left = result.Left is { Valid: true } l ? new { l.IoiSdMs, l.IoiSdPercent, l.PlainIoiSdMs, l.Bpm, l.CrossingMs, l.SeamMs, l.VelocitySd, l.LegatoMs } : null,
            sync = result.SyncMeanMs,
            item = run.Id,
            hands = choice.Hands.ToString(),
        };
        await Store.AddAttemptAsync(new AttemptRecord(0, DateTimeOffset.Now, Today, Key == "independence" ? "independence" : Key == "arpeggios" ? "arpeggio" : "scale", choice.Hands.ToString(), run.Id, level, tempo, null, null, "[]", null, System.Text.Json.JsonSerializer.Serialize(measures), result.Valid ? sd : null, result.Valid, null));
    }

    private IEnumerable<string> Words()
    {
        if (result is null) yield break;

        foreach (var (hand, run) in new[] { ("Right hand", result.Right), ("Left hand", result.Left) })
        {
            if (run is null) continue;
            if (!run.Valid)
            {
                yield return $"{hand}: {Slips(run)}, marked on the music. This run doesn't count for evenness.";
                continue;
            }

            yield return $"{hand}: the gaps between notes varied by {TechniqueScorer.Describe(run.IoiSdMs, noiseFloor)} (±{run.IoiSdPercent:0.0}% of the gap) at {run.Bpm:0} beats a minute{(Math.Abs(run.SlopeMsPerNote) > 0.5 ? $", {(run.SlopeMsPerNote < 0 ? "speeding up" : "slowing down")} steadily" : "")}.";
            if (run.CrossingMs is { } crossing) yield return $"{hand}, thumb crossings: {(Math.Abs(crossing) < TechniqueScorer.HearingMs ? TechniqueScorer.Describe(crossing, noiseFloor) : $"{Math.Abs(crossing):0} ms {(crossing > 0 ? "late" : "early")}")}.";
            if (run.SeamMs is { } seam) yield return $"{hand}, across the octaves: {TechniqueScorer.Describe(seam, noiseFloor)}.";
            var legato = run.LegatoMs >= 0 ? $"the keys overlapped {run.LegatoMs:0} ms on average" : $"a gap of {-run.LegatoMs:0} ms between keys on average";
            yield return run.VelocitySd > 0 ? $"{hand}, touch: velocity varied by ±{run.VelocitySd:0}. Legato: {legato}." : $"{hand}, legato: {legato}.";
        }
        if (result.SyncSdMs is { } syncSd) yield return $"The hands landed {Math.Abs(result.SyncMeanMs ?? 0):0} ms apart on average, give or take {TechniqueScorer.Describe(syncSd, noiseFloor)}.";
        if (state.InvalidInRow == 0 && !result.Valid && state.Tempo is { } t) yield return $"Next run a little slower: {t:0}.";
    }

    // A run's slips, briefly: "1 wrong", "2 missed", "1 wrong, 1 extra".
    private static string Slips(HandRun run) => string.Join(", ", new[] { (run.Wrong, "wrong"), (run.Missed, "missed"), (run.Extras.Count, "extra") }.Where(s => s.Item1 > 0).Select(s => $"{s.Item1} {s.Item2}"));
}
