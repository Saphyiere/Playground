@page "/drills/scales"
@page "/drills/arpeggios"
@page "/drills/independence"
@inject PrimaStore Store
@inject Prima.UI.Routines.RoutineService Routines
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject NavigationManager Nav
@inject AppNavigation Navigation
@using Prima.Core.Generation
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>@Title · Prima</PageTitle>

<PageHead Title="@Title" Kicker="@(item?.Name ?? "Technique")" Class="full-hide" Back="@WayBack" OnBack="Leave"><KeyboardLamp /></PageHead>

@* What to play is yours to choose, whatever your reading level: the key (any of them in one tap, on the piano) or all the keys
   one after another, the form, the octaves, the hands. What's chosen shows on a card above the play bar, Change opening it all
   over the music; Today's goes back to the day's plan. Then the play bar every screen with music shares, and the music in a
   piece's paper frame, taking the rest of the screen, as an exercise's page does; in full screen only the two. *@
<div class="practice-page">
<section class="practice-choice technique-choice full-hide" aria-label="What to play">
    <ChoiceCard Key="choice.Key" KeyNote="@FormName()" Hands="choice.Hands" Open="changing" OnChange="ToggleChange" Disabled="playing">
        @if (Key == "independence")
        {
            <span class="choice-fact">@Patterns.First(p => p.Pattern == choice.Pattern).Name</span>
        }
        else
        {
            <span class="choice-fact"><MusicIcon Kind="octave" />@OctavesName(choice.Octaves)</span>
        }
        @if (through)
        {
            <span class="choice-fact"><svg class="cycle-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 0 1 12.8-5.3M19.5 12a7.5 7.5 0 0 1-12.8 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M17.5 2.8v4.1h-4.1M6.5 21.2v-4.1h4.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>Through the keys</span>
        }
    </ChoiceCard>
    <p class="control-note">@(runs <= TechniqueState.RunsPerSet ? $"Runs {runs} of {TechniqueState.RunsPerSet}." : $"{runs} runs: a set is {TechniqueState.RunsPerSet}.") Stop if anything hurts.</p>
</section>

<RoutineBar Session="routineSession" BeforeLeaving="StopRoutine" />
<PlayAlong @ref="player" @key="Key" Name="@Key" Music="music" SheetOf="() => sheet" Tempo="Tempo" TempoChanged="SetTempo" StartLabel="Run" CanStart="@(routineSession?.IsRoutine == true || loop || through || runs < TechniqueState.RunsPerSet)" ShowLoop="true" LoopChanged="Looped" Ask="@Asked" OnStarting="Starting" OnPracticeStarting="PracticeStarting" OnFinished="Finished" Again="@(routineSession?.IsRoutine == true)">
    <Readouts>
        <div class="mu-readout"><span class="mu-readout-label">Target</span><span class="mu-readout-value">@(state.Target is { } t ? $"±{t:0}%" : "First week")</span></div>
        @if (routineSession?.Rcm is { } rcm)
        {
            <div class="mu-readout"><span class="mu-readout-label">RCM @rcm.Activity.LevelName</span><span class="mu-readout-value">♩ @rcm.Activity.Rcm.ToString("0", System.Globalization.CultureInfo.InvariantCulture)</span></div>
        }
    </Readouts>
</PlayAlong>

@if (through)
{
    <p class="page-note full-hide">Every key one after another, from @choice.Key.Name, at the tempo showing. It's practice for the notes: it isn't measured for evenness, and no key's tempo moves.</p>
}
else if (FirstRun)
{
    <p class="page-note full-hide">First, play it once in Wait for me, at your own speed and without the click. The In time runs then start a little slower than that, which is how speed is built.</p>
}
@if (!playing && (runs >= 3 || (From == "today" && Key == "scales")))
{
    @* The way on. From Today the scale leads to the arpeggio, at any time (so coming back to the step doesn't mean the scale
       again), and the arpeggio back to the day once it's had its three runs; from anywhere else, three runs lead back to the
       drills. With all five played the way on is the orange key, and another set is offered beside it. *@
    var set = runs >= TechniqueState.RunsPerSet;
    <div class="control-row full-hide">
        @if (From == "today" && Key == "scales")
        {
            <a class="mu-btn @(set ? "mu-primary" : "")" data-piano="@(set ? "go" : null)" href="drills/arpeggios?from=today">Next: the arpeggio</a>
        }
        else
        {
            <a class="mu-btn @(set ? "mu-primary" : "")" data-piano="@(set ? "go" : null)" href="@(From == "today" ? "" : "exercises?type=drills")">Done</a>
        }
        @if (set)
        {
            <button type="button" class="mu-btn" @onclick="() => runs = 0">Another set</button>
        }
    </div>
}

<div class="piece-stage">
    <div class="piece-frame sheet-frame piece-frame-scroll" data-follow="">
        <Sheet @ref="sheet" Mei="@mei" Layout="scroll" Class="piece-sheet" />
    </div>
    @if (changing)
    {
        <ChangePanel OnDone="ToggleChange">
            <ChildContent>
                @if (Key == "independence")
                {
                    <div class="control-row">
                        <span class="control-label">Pattern</span>
                        <div class="choice-set">
                            @foreach (var (pattern, name) in Patterns)
                            {
                                <button type="button" class="mu-toggle" aria-pressed="@On(choice.Pattern == pattern)" disabled="@playing" @onclick="() => Choose(choice with { Pattern = pattern })"><span class="mu-led"></span>@name</button>
                            }
                        </div>
                    </div>
                }
                <div class="control-row change-key-row">
                    <span class="control-label">Key</span>
                    <KeyPiano Keys="KeysOffered" Value="choice.Key" ValueChanged="k => Choose(choice with { Key = k })" Disabled="playing" />
                    <span class="key-piano-name">@choice.Key.Name</span>
                    @* Through the keys: every key one after another as one piece of music, from the key showing on and round to the one
                       before it. Practice for the notes: it isn't measured for evenness and doesn't move a tempo. *@
                    <button type="button" class="mu-toggle exercise-through" aria-pressed="@On(through)" disabled="@playing" aria-label="@(through ? $"Through the keys: on. All of them, from {choice.Key.Name}" : "Through the keys: off. This key alone")" @onclick="() => GoThrough(!through)"><span class="mu-led"></span>Through the keys</button>
                </div>
                @if (Key == "scales" && choice.Key.Minor)
                {
                    <div class="control-row">
                        <span class="control-label">Form</span>
                        <div class="choice-set">
                            <button type="button" class="mu-toggle" aria-pressed="@On(choice.Form == ScaleKind.NaturalMinor)" disabled="@playing" @onclick="() => Choose(choice with { Form = ScaleKind.NaturalMinor })"><span class="mu-led"></span>Natural</button>
                            <button type="button" class="mu-toggle" aria-pressed="@On(choice.Form is not (ScaleKind.MelodicMinor or ScaleKind.NaturalMinor))" disabled="@playing" @onclick="() => Choose(choice with { Form = ScaleKind.HarmonicMinor })"><span class="mu-led"></span>Harmonic</button>
                            <button type="button" class="mu-toggle" aria-pressed="@On(choice.Form == ScaleKind.MelodicMinor)" disabled="@playing" @onclick="() => Choose(choice with { Form = ScaleKind.MelodicMinor })"><span class="mu-led"></span>Melodic</button>
                        </div>
                    </div>
                }
                @if (Key != "independence")
                {
                    <div class="control-row">
                        <span class="control-label">Octaves</span>
                        <div class="choice-set">
                            @if (Key == "arpeggios")
                            {
                                <button type="button" class="mu-toggle" aria-pressed="@On(choice.Octaves == 0)" disabled="@playing" @onclick="() => Choose(choice with { Octaves = 0 })"><span class="mu-led"></span>Triad</button>
                            }
                            @for (var n = 1; n <= 4; n++)
                            {
                                var octaves = n;
                                <button type="button" class="mu-toggle choice-pad" aria-pressed="@On(choice.Octaves == octaves)" aria-label="@OctavesName(octaves)" disabled="@playing" @onclick="() => Choose(choice with { Octaves = octaves })"><span class="mu-led"></span>@octaves</button>
                            }
                        </div>
                    </div>
                }
                <div class="control-row">
                    <span class="control-label">Hands</span>
                    <HandsChoice Offered="AllHands" Value="choice.Hands" ValueChanged="h => Choose(choice with { Hands = h })" Disabled="playing" />
                </div>
            </ChildContent>
            <Extra>
                @if (choice != today with { Hands = choice.Hands })
                {
                    <button type="button" class="mu-btn" disabled="@playing" @onclick="() => Choose(today with { Hands = choice.Hands })">Today's</button>
                }
            </Extra>
        </ChangePanel>
    }
</div>

@if (result is not null && review is not null)
{
    @* The run in two lines, what you did and next time; the figures, and a line on each, under Show details. A hand is named
       there only when both played. *@
    var named = result.Right is not null && result.Left is not null;
    <section class="summary" aria-label="The run">
        <div class="sum">
            <section class="mu-screen sum-quick" aria-label="In short">
                <ReviewLines Review="review" />
                <div class="sum-quick-keys">
                    <button type="button" class="mu-btn sum-more" aria-expanded="@On(Settings.SummaryDetails)" aria-controls="run-details" @onclick="ToggleDetails">@(Settings.SummaryDetails ? "Hide details" : "Show details")<svg class="sum-chevron" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true"><path d="M3 5L7 9L11 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
                </div>
            </section>
            @if (Settings.SummaryDetails)
            {
                <section id="run-details" class="mu-screen summary-figures" aria-label="The figures">
                    <div class="mu-readouts">
                        @foreach (var (hand, run) in new[] { ("Right", result.Right), ("Left", result.Left) }.Where(r => r.Item2 is not null))
                        {
                            <div class="mu-readout @(run!.Valid ? "" : "miss")"><span class="mu-readout-label">@(named ? $"{hand} evenness" : "Evenness")</span><span class="mu-readout-value">@(run.Valid ? $"±{run.IoiSdPercent:0.0}%" : Slips(run))</span></div>
                        }
                        @if (result.SyncMeanMs is { } sync)
                        {
                            <div class="mu-readout"><span class="mu-readout-label">Hands apart</span><span class="mu-readout-value">@($"{Math.Abs(sync):0} ms")</span></div>
                        }
                    </div>
                </section>
                <ul class="summary-words">
                    @foreach (var line in Words())
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
    </section>
}
else if (review is not null && outcome is { Wait: not null } or { InTime: not null })
{
    <PlaySummary Outcome="outcome" StoppedAt="@($"bar {outcome.Bar}")" Review="review">
        <li>@(through ? "A run through the keys is practice for the notes: it isn't measured for evenness, and no key's tempo moves." : comfortable is { } bpm ? $"Your own speed came to about {bpm:0} beats a minute, so In time starts at {state.Tempo:0}." : "Wait for me is practice for the notes: it doesn't count for evenness or move the tempo.")</li>
    </PlaySummary>
}
</div>

@code {
    private static readonly (int Pattern, string Name)[] Patterns = [(1, "Five fingers"), (2, "Trill 3–4"), (3, "Trill 4–5")];

    private string Key => new Uri(Nav.Uri).Segments[^1].Trim('/');

    private string Title => Key switch { "arpeggios" => "Arpeggios", "independence" => "Finger independence", _ => "Scales" };

    /// <summary>Where the screen was opened from: "today" for the day's Technique step, which is the scale and then the arpeggio.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionId { get; set; }
    private RoutineSession? routineSession;
    private PlayAlong? player;

    // What it has no tempo for yet and hasn't been run: its first run is in Wait for me, which the bar is set to.
    private bool FirstRun => state.Tempo is null && result is null && outcome is null;

    // The mode the bar is set to: one of Claude's activities as its recipe says; one of RCM's, In time once its own speed is
    // known (Wait for me the first time, as anywhere); otherwise Wait for me the first time, and else as the bar was left.
    private PlayMode? Asked => routineSession?.Rcm is not null ? (FirstRun ? PlayMode.WaitForMe : PlayMode.InTime)
        : routineSession?.Item is { } recipe ? recipe.Mode == "wait" ? PlayMode.WaitForMe : PlayMode.InTime
        : FirstRun && !through ? PlayMode.WaitForMe : null;

    // Whether its tempo and target are kept: anywhere but in one of Claude's routines. One of RCM's keeps them, by its item (in
    // eighths, as RCM writes it), so it builds speed towards RCM's as a drill does anywhere.
    private bool Keeps => routineSession?.Fixed != true || routineSession.Rcm is not null;

    // The tempo the last run In time went at, for what's said of it against RCM's.
    private double ranAt;

    private TechniqueChoice choice = new(new Key(0), ScaleKind.Major, 1, HandUse.Right, 1);
    private TechniqueChoice today = new(new Key(0), ScaleKind.Major, 1, HandUse.Right, 1);
    private TechniqueItem? item;
    // All the keys one after another, from the one chosen, as one piece of music; and the play bar's Loop.
    private bool through;
    private bool loop;
    private string mei = "";
    private PlayMusic? music;
    private TechniqueState state = TechniqueState.New;
    private TechniqueResult? result;
    private PlayOutcome? outcome;
    // The run in two lines: what you did, and next time.
    private RunReview? review;
    private double? comfortable;
    private Sheet? sheet;
    private bool playing;
    private int runs;
    // The scale, arpeggio or pattern showing, by the address's last part.
    private string? opened;
    private int level = 1;
    private DateTime started;
    private double? noiseFloor;

    private DateOnly Today => routineSession?.Day ?? DateOnly.FromDateTime(DateTime.Now);

    private static string On(bool on) => on ? "true" : "false";

    // An item's own progress, kept by its name (and octaves past one) and hands.
    private string StateKey => $"technique:{Key}:{item?.Id}:{choice.Hands}";

    private double Tempo => state.Tempo ?? 60;

    private static readonly HandUse[] AllHands = [HandUse.Right, HandUse.Left, HandUse.Together];

    // The keys to choose from, in the exams' order: major keys only for the finger patterns.
    private IReadOnlyList<Key> KeysOffered => [.. Technique.Order.Where(k => Key != "independence" || !k.Minor)];

    // A minor scale's form, under its key's name on the card.
    private string? FormName() => Key == "scales" && choice.Key.Minor
        ? choice.Form switch { ScaleKind.NaturalMinor => "Natural minor", ScaleKind.MelodicMinor => "Melodic minor", _ => "Harmonic minor" }
        : null;

    private static string OctavesName(int octaves) => octaves switch { 0 => "Triad", 1 => "1 octave", _ => $"{octaves} octaves" };

    // Change: what to play, over the music. A run starting closes it.
    private bool changing;

    private void ToggleChange() => changing = !changing;

    // The way back: to where it was opened from, by its name.
    private string WayBack => Navigation.PreviousName ?? (From == "today" ? "Today" : "Exercises");

    private async Task Leave()
    {
        await StopRoutine();
        await Navigation.BackAsync(From == "today" ? "" : "exercises?type=drills");
    }

    protected override async Task OnInitializedAsync()
    {
        level = (await Store.GetTrackAsync<ReadingState>("reading"))?.Level ?? 1;
        noiseFloor = Keyboard.Sensing.JitterMs;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Key == opened && routineSession?.Execution?.Id == ExecutionId) return;
        await StopRoutine();
        await Open();
    }

    // What the address names, as last chosen or else today's, with its runs to play.
    private async Task Open()
    {
        (music, item, mei) = (null, null, "");
        routineSession = new(Routines);
        if (!await routineSession.LoadAsync(ExecutionId, "drill", Key)) return;
        (opened, runs, started) = (Key, 0, DateTime.Now);
        var plan = DailyPlan.Build(Today, Settings.DailyMinutes, level, false);
        var pattern = (await Store.GetTrackAsync<DrillTrack>("drill:independence") ?? DrillTrack.Start).Step;
        today = TechniqueChoice.Today(Key, plan.ScaleKey, plan.ArpeggioKey, level, pattern, Today);
        choice = await Store.GetTrackAsync<TechniqueChoice>($"technique-choice:{Key}") ?? today;
        through = routineSession.Item is null && (await Store.GetSettingsAsync()).GetValueOrDefault(ThroughKey) == "on";
        // One of RCM's: the key, form and hands its day brings, at its octaves, written as RCM writes it.
        if (routineSession.Rcm is { } rcm) choice = new TechniqueChoice(rcm.Key, Key == "arpeggios" ? ScaleKind.Arpeggio : rcm.Form, rcm.Activity.Octaves, rcm.Hands, 1) { PerBeat = rcm.Activity.PerBeat };
        else if (routineSession.Item is { } requested) choice = new(new Key(requested.Fifths, requested.Minor), Key == "arpeggios" ? ScaleKind.Arpeggio : requested.Minor ? ScaleKind.HarmonicMinor : ScaleKind.Major, 1, requested.Hands, requested.Step);
        await Build();
    }

    // Whether the drill goes through the keys, kept for each drill.
    private string ThroughKey => $"Technique.Through.{Key}";

    private async Task GoThrough(bool on)
    {
        through = on;
        if (routineSession?.Fixed != true) await Store.SetSettingAsync(ThroughKey, on ? "on" : "off");
        await Build();
    }

    // The play bar's Loop, as it's read when the bar opens and as it's turned on or off: the repeat's signs go on or come off.
    private async Task Looped(bool on)
    {
        loop = on;
        if (item is not null && !playing) await Build();
    }

    // The keys from the one chosen on, through the drill's keys and round to the one before it.
    private List<Key> KeysFromHere()
    {
        var keys = Technique.Order.Where(k => Key != "independence" || !k.Minor).ToList();
        var at = Math.Max(0, keys.IndexOf(Key == "independence" ? choice.Key with { Minor = false } : choice.Key));
        return [.. keys.Skip(at), .. keys.Take(at)];
    }

    private async Task Choose(TechniqueChoice to)
    {
        choice = to;
        if (routineSession?.Fixed != true) await Store.SaveTrackAsync($"technique-choice:{Key}", to);
        await Build();
    }

    // The music: the scale, arpeggio or pattern chosen, or the same in every key one after another, each named over its first
    // note; looped, all of it goes round, and is printed with the repeat's signs.
    private async Task Build()
    {
        item = choice.Item(Key);
        var score = item.Score;
        if (through)
        {
            score = Score.Join([.. KeysFromHere().Select(k =>
            {
                var part = (choice with { Key = k }).Item(Key).Score;
                var first = part.Bars[0].Voices.OrderBy(v => v.Staff).SelectMany(v => v.Events.OfType<Notes>()).MinBy(n => n.Start)!;
                return part with { Marks = [.. part.Marks, new Mark(MarkKind.Text, first.Tones[0].Id, Text: k.Name)] };
            })]);
        }
        if (loop) score = score.WithRepeat(0, score.Bars.Count - 1);
        mei = MeiWriter.Write(score, 72);
        music = new PlayMusic(score, score.Expected());
        state = await Store.GetTrackAsync<TechniqueState>(StateKey) ?? TechniqueState.New;
        if (routineSession?.Item is { } requested && routineSession.Rcm is null) state = state with { Tempo = requested.Tempo };
        (result, outcome, review, comfortable) = (null, null, null, null);
    }

    private async Task ToggleDetails()
    {
        Settings.SummaryDetails = !Settings.SummaryDetails;
        await Store.SaveAsync(Settings);
    }

    private async Task SetTempo(double bpm)
    {
        state = state with { Tempo = bpm, Started = state.Started ?? Today };
        if (Keeps) await Store.SaveTrackAsync(StateKey, state);
    }

    private Task Starting()
    {
        (playing, result, outcome, review, comfortable, changing) = (true, null, null, null, null, false);
        return Task.CompletedTask;
    }

    private void PracticeStarting() => routineSession?.Start();

    private Task StopRoutine() => player?.StopAndSaveAsync() ?? Task.CompletedTask;

    private async Task Finished(PlayOutcome how)
    {
        (playing, outcome) = (false, how);
        if (item is null) return;
        if (how.InTime is null && how.Wait is not { Notes: > 0 }) return;

        // Round a loop, each time round played to its end is a run of the set; anything else is one.
        runs += Math.Max(1, how.Passes.Count);
        // Its review, but In time on one key, which its evenness gives once it's scored. Through the keys, no one key's sharps and
        // flats are the ones to name.
        review = how.InTime is { } played ? through ? RunReviews.InTime(played, null, how.Passes, StoppedAt(how)) : null
            : RunReviews.Waited(how.Wait!, [], how.Passes);
        if (through)
        {
            // Through the keys is practice for the notes: kept as a run of the drill, with nothing for evenness and no tempo moved.
            var (right, notes) = how.InTime is { } timed ? (timed.Right, timed.Expected) : (how.Wait!.RightFirstTime, how.Wait.Notes);
            var kept = new AttemptRecord(0, DateTimeOffset.Now, Today, Key == "independence" ? "independence" : Key == "arpeggios" ? "arpeggio" : "scale", choice.Hands.ToString(), $"{item.Id}, through the keys", level,
                how.Mode == PlayMode.InTime ? Tempo : null, null, System.Text.Json.JsonSerializer.Serialize(new { key = choice.Key.Name, hands = choice.Hands.ToString(), through = true }), "[]", null,
                System.Text.Json.JsonSerializer.Serialize(new { valid = false, through = true, right, notes, inTime = how.InTime?.InTimeAccuracy, passes = how.Passes.Count, stopped = how.Stopped, hands = choice.Hands.ToString() }), null, false, null);
            if (routineSession?.Execution is not null) await routineSession.RecordAsync(kept, how.TimesThrough);
            else await Store.AddAttemptAsync(kept);
        }
        else if (how.Mode == PlayMode.WaitForMe)
        {
            // The first time, your own pace in Wait for me is the comfortable speed: the gap from one moment of the music to the
            // next, as beats a minute. Hands together a moment is two keys, and the gap between those isn't the pace.
            var steps = how.Wait!.StepNs;
            var gapMs = steps.Count < 4 ? 0 : Stats.Median(steps.Zip(steps.Skip(1), (a, b) => (b - a) / 1e6).ToArray());
            if (state.Tempo is null && gapMs > 0)
            {
                comfortable = 60_000 / (gapMs * item.NotesPerBeat);
                state = state.Comfortable(comfortable.Value, Today);
                // Its next is In time, started from that speed: said before anything's drawn.
                if (review is { Focus: ReviewFocus.None }) review = review with { Next = "In time, a little under your own speed." };
                if (Keeps) await Store.SaveTrackAsync(StateKey, state);
            }
            if (routineSession?.Execution is not null)
            {
                var waited = how.Wait!;
                var attempt = new AttemptRecord(0, DateTimeOffset.Now, Today, Key == "arpeggios" ? "arpeggio" : Key == "scales" ? "scale" : "independence", "wait", item.Id, null, null, null,
                    System.Text.Json.JsonSerializer.Serialize(new { key = choice.Key.Name, hands = choice.Hands.ToString() }), "[]", null,
                    System.Text.Json.JsonSerializer.Serialize(new { rightFirstTime = waited.RightFirstTime, notes = waited.Notes, wrongKeys = waited.WrongKeys, apart = waited.Apart, stopped = how.Stopped }),
                    waited.Notes == 0 ? null : waited.RightFirstTime / (double)waited.Notes, waited.Finished && waited.WrongKeys == 0 && waited.Apart == 0, null);
                await routineSession.RecordAsync(attempt, how.TimesThrough);
            }
        }
        else
        {
            // Round a loop, the evenness is the last pass's, from its own keys.
            await Scored(item, how.Judged);
        }
        if (routineSession?.IsRoutine != true) await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
        started = DateTime.Now;
        // From Today the step is the scale and then the arpeggio: it's done with the arpeggio's runs, not the scale's.
        if (routineSession?.IsRoutine != true && runs >= 3 && !(From == "today" && Key == "scales")) await Store.MarkStepAsync(Today, StepKind.Technique);
    }

    // In time: evenness from the keys played, each note marked as the scorer lined it up (replacing the play bar's marks), and
    // the tempo moved on as the run went.
    private async Task Scored(TechniqueItem run, IReadOnlyList<PlayedNote> played)
    {
        result = TechniqueScorer.Score(run, played);
        // Every note marked as Sight-read marks them: green right; wrong, the note grey and the key played beside it in red, each
        // named; outlined grey missed; and an extra key as a red head beside the note before it.
        var pitches = run.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).ToDictionary(t => t.Id, t => t.Pitch);
        SheetMark KeyMark(string id, string kind, int key)
        {
            var spelled = run.Key.Spell(key);
            return new SheetMark(id, kind, spelled.ToString(), spelled.Diatonic - pitches[id].Diatonic, Written: pitches[id].ToString());
        }
        var handRuns = new[] { result.Right, result.Left }.OfType<HandRun>().ToList();
        var marks = handRuns.SelectMany(h => h.Notes).Select(n => n.Outcome switch
        {
            Outcome.Wrong => KeyMark(n.Id, "wrong", n.Played!.Value),
            Outcome.Missed => new SheetMark(n.Id, "missed"),
            _ => new SheetMark(n.Id, "right"),
        }).Concat(handRuns.SelectMany(h => h.Extras).Select(e => KeyMark(e.AfterId, "extra", e.Played)));
        await (sheet?.ShowMarks(marks) ?? Task.CompletedTask);
        var sd = handRuns.Where(r => r.Valid).Select(r => r.IoiSdPercent).DefaultIfEmpty(0).Max();
        var tempo = ranAt = Tempo;
        var before = state;
        if (Keeps)
        {
            state = state.After(result.Valid, result.Valid ? sd : null, Today);
            await Store.SaveTrackAsync(StateKey, state);
        }
        // Its review, held to the evenness the run was; the next a step on, or where the tempo's moved, that. A run stopped before
        // its end is reviewed as far as it went, as the play bar scored it: the notes not reached weren't left out.
        var rcm = routineSession?.Rcm?.Activity;
        var step = state.Tempo > before.Tempo ? "A little faster: the tempo's gone up." : RunReviews.StepOn(tempo, result.Valid ? rcm?.Rcm : null, rcm?.LevelName);
        review = outcome is { InTime: { } far, Stopped: true, Passes.Count: 0 } ? RunReviews.InTime(far, null, null, StoppedAt(outcome), step)
            : RunReviews.Technique(result, run, tempo, before.Target, outcome?.Passes, step);
        if (state.Tempo < before.Tempo) review = review with { Next = "A little slower, for every note: the tempo's come down." };
        var measures = new
        {
            valid = result.Valid,
            right = result.Right is { Valid: true } r ? new { r.IoiSdMs, r.IoiSdPercent, r.PlainIoiSdMs, r.Bpm, r.CrossingMs, r.SeamMs, r.VelocitySd, r.LegatoMs } : null,
            left = result.Left is { Valid: true } l ? new { l.IoiSdMs, l.IoiSdPercent, l.PlainIoiSdMs, l.Bpm, l.CrossingMs, l.SeamMs, l.VelocitySd, l.LegatoMs } : null,
            sync = result.SyncMeanMs,
            item = run.Id,
            hands = choice.Hands.ToString(),
        };
        var attempt = new AttemptRecord(0, DateTimeOffset.Now, Today, Key == "independence" ? "independence" : Key == "arpeggios" ? "arpeggio" : "scale", choice.Hands.ToString(), run.Id, level, tempo, null,
            System.Text.Json.JsonSerializer.Serialize(new { key = choice.Key.Name, hands = choice.Hands.ToString() }), "[]", null, System.Text.Json.JsonSerializer.Serialize(measures), result.Valid ? sd : null, result.Valid, null);
        if (routineSession?.Execution is not null) await routineSession.RecordAsync(attempt, outcome?.TimesThrough ?? 1);
        else await Store.AddAttemptAsync(attempt);
    }

    private IEnumerable<string> Words()
    {
        if (result is null) yield break;

        // Round a loop, how many times it went round, as every screen's summary says it; the evenness is the last pass's.
        if (outcome is { Loop: { } round, Passes: { Count: > 0 } passes }) yield return PlaySummary.PassesSaid(round, passes);
        // A hand is named only when both played.
        var named = result.Right is not null && result.Left is not null;
        foreach (var (hand, run) in new[] { ("Right hand", result.Right), ("Left hand", result.Left) })
        {
            if (run is null) continue;
            string Of(string what) => named ? $"{hand}, {what}" : char.ToUpperInvariant(what[0]) + what[1..];
            if (!run.Valid)
            {
                yield return $"{(named ? $"{hand}: " : "")}{Slips(run)}, marked on the music. This run doesn't count for evenness.";
                continue;
            }

            yield return $"{Of("evenness")}: the gaps between notes varied by {TechniqueScorer.Describe(run.IoiSdMs, noiseFloor)} (±{run.IoiSdPercent:0.0}% of the gap) at {run.Bpm:0} beats a minute{(Math.Abs(run.SlopeMsPerNote) > 0.5 ? $", {(run.SlopeMsPerNote < 0 ? "speeding up" : "slowing down")} steadily" : "")}.";
            if (run.CrossingMs is { } crossing) yield return $"{Of("thumb crossings")}: {(Math.Abs(crossing) < TechniqueScorer.HearingMs ? TechniqueScorer.Describe(crossing, noiseFloor) : $"{Math.Abs(crossing):0} ms {(crossing > 0 ? "late" : "early")}")}.";
            if (run.SeamMs is { } seam) yield return $"{Of("across the octaves")}: {TechniqueScorer.Describe(seam, noiseFloor)}.";
            var legato = run.LegatoMs >= 0 ? $"the keys overlapped {run.LegatoMs:0} ms on average" : $"a gap of {-run.LegatoMs:0} ms between keys on average";
            yield return run.VelocitySd > 0 ? $"{Of("touch")}: velocity varied by ±{run.VelocitySd:0}. Legato: {legato}." : $"{Of("legato")}: {legato}.";
        }
        if (result.SyncSdMs is { } syncSd) yield return $"The hands landed {Math.Abs(result.SyncMeanMs ?? 0):0} ms apart on average, give or take {TechniqueScorer.Describe(syncSd, noiseFloor)}.";
        if (state.InvalidInRow == 0 && !result.Valid && state.Tempo is { } t) yield return $"Next run a little slower: {t:0}.";
        // One of RCM's: this run against the least RCM asks.
        if (routineSession?.Rcm is { Activity: var rcm } && result.Valid)
        {
            yield return ranAt >= rcm.Rcm
                ? $"At RCM {rcm.LevelName}'s tempo: it asks at least ♩ {rcm.Rcm:0}, and this run went at ♩ {ranAt:0}."
                : $"RCM {rcm.LevelName} asks at least ♩ {rcm.Rcm:0}; this run went at ♩ {ranAt:0}.";
        }
    }

    // Where a run stopped before its end was stopped, for its review: none for one played to its end, or round a loop.
    private static string? StoppedAt(PlayOutcome how) => how is { Stopped: true, Passes.Count: 0 } ? $"bar {how.Bar}" : null;

    // A run's slips, briefly: "1 wrong", "2 missed", "1 wrong, 1 extra".
    private static string Slips(HandRun run) => string.Join(", ", new[] { (run.Wrong, "wrong"), (run.Missed, "missed"), (run.Extras.Count, "extra") }.Where(s => s.Item1 > 0).Select(s => $"{s.Item1} {s.Item2}"));
}
