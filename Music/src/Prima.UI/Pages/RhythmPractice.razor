@page "/drills/rhythm"
@implements IDisposable
@inject PrimaStore Store
@inject Prima.UI.Routines.RoutineService Routines
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject SessionRegistry Registry
@using Prima.Core.Generation
@using Prima.Core.Practice
@using Prima.Core.Scoring

<PageTitle>Rhythm · Prima</PageTitle>

<PageHead Title="Rhythm" Kicker="@($"Level {state.Level} · try {Math.Min(tryIndex + 1, Tries)} of {Tries}")"><KeyboardLamp /></PageHead>
<RoutineBar Session="routineSession" BeforeLeaving="StopRoutine" />

<p class="page-note">Tap the first bar's beat, then the rhythm, on any key. @StageWords(state.StageForTry(tryIndex))</p>

<section class="reading-bar" aria-label="Where you are">
    @if (session is { Phase: Phase.CountIn })
    {
        <CountIn Session="session" />
    }
    <div class="mu-readout"><span class="mu-readout-label">Click</span><span class="mu-readout-value">@StageName(state.StageForTry(tryIndex))</span></div>
    <div class="mu-readout"><span class="mu-readout-label">Tempo</span><span class="mu-readout-value">@Tempo</span></div>
    @if (result is not null)
    {
        <div class="mu-readout"><span class="mu-readout-label">In time</span><span class="mu-readout-value">@($"{(result.Accuracy) * 100:0}%")</span></div>
        <div class="mu-readout"><span class="mu-readout-label">Lean</span><span class="mu-readout-value">@($"{result.LeanPercent:+0;−0;0}%")</span></div>
        <div class="mu-readout"><span class="mu-readout-label">Steadiness</span><span class="mu-readout-value">@($"±{result.SteadinessPercent:0}%")</span></div>
    }
    @if (session?.Phase is not (Phase.CountIn or Phase.Playing))
    {
        <button type="button" class="mu-btn mu-primary" data-piano="go" disabled="@(score is null)" @onclick="Next">@(tryIndex >= Tries ? "Another set" : result is null ? "Start" : "Next try")</button>
    }
</section>

<div class="sheet-frame">
    <Sheet @ref="sheet" Mei="@mei" />
</div>

@if (result is not null)
{
    <ul class="summary-words">
        @if (result.DriftPercent is { } drift && state.StageForTry(tryIndex - 1) != ClickStage.Throughout)
        {
            <li>Without the click you drifted @($"{Math.Abs(drift):0}%") @(drift > 0 ? "faster" : "slower").</li>
        }
        <li>The bar of beat: lean @($"{result.PulseLeanPercent:+0;−0;0}%") of the beat, steady to ±@($"{result.PulseSteadinessPercent:0}")%.</li>
        @if (result.Missed > 0)
        {
            <li>@result.Missed missed, @result.Extra extra.</li>
        }
        @foreach (var line in BarWords())
        {
            <li>@line</li>
        }
        @if (tryIndex >= Tries)
        {
            <li>@SetWords()</li>
        }
    </ul>
}

@code {
    private const int Tries = 3;
    private double Tempo => routineSession?.Item?.Tempo ?? 72;
    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionId { get; set; }
    private RoutineSession? routineSession;
    private TaskCompletionSource? saved;
    private bool interrupted;
    private bool loaded;
    private string? openedExecution;

    private RhythmState state = RhythmState.Start;
    private int tryIndex;
    private Score? score;
    private string mei = "";
    private PlaySession? session;
    private RhythmResult? result;
    private IReadOnlyList<BarTiming> bars = [];
    private Sheet? sheet;
    private readonly List<double> accuracies = [];
    private RhythmState? before;
    private DateTime started;

    private DateOnly Today => routineSession?.Day ?? DateOnly.FromDateTime(DateTime.Now);

    private static string StageName(ClickStage s) => s switch { ClickStage.Throughout => "On", ClickStage.CountInOnly => "Count-in", _ => "Silent" };

    private static string StageWords(ClickStage s) => s switch
    {
        ClickStage.Throughout => "The click plays throughout.",
        ClickStage.CountInOnly => "The click plays the count-in only: keep the pulse yourself.",
        _ => "No click: the count-in shows on the screen, and the pulse is yours.",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (loaded && openedExecution == ExecutionId) return;
        await StopRoutine();
        (loaded, openedExecution, tryIndex, result) = (true, ExecutionId, 0, null);
        accuracies.Clear();
        (score, mei) = (null, "");
        routineSession = new(Routines);
        if (!await routineSession.LoadAsync(ExecutionId, "drill", "rhythm")) return;
        state = await Store.GetTrackAsync<RhythmState>("rhythm") ?? RhythmState.Start;
        if (routineSession.Item is { } requested) state = state with { Level = requested.Step };
        started = DateTime.Now;
        NewRhythm();
    }

    private void NewRhythm()
    {
        score = RhythmDrill.Generate(state.Level, (ulong)DateTime.Now.Ticks);
        mei = MeiWriter.Write(score, Tempo);
    }

    private async Task Next()
    {
        if (tryIndex >= Tries)
        {
            (tryIndex, result) = (0, null);
            accuracies.Clear();
            NewRhythm();
            return;
        }

        if (result is not null) NewRhythm();
        result = null;
        await (sheet?.ClearMarks() ?? Task.CompletedTask);
        StateHasChanged();
        await Task.Delay(300);
        Start();
    }

    private void Start()
    {
        routineSession?.Start();
        interrupted = false;
        saved = new(TaskCreationOptions.RunContinuationsAsynchronously);
        session?.Dispose();
        session = new PlaySession(Click, Keyboard, Clock, Registry);
        var meter = score!.Meter;
        var expected = score.Expected().Select(e => (e.Midi, e.Tick / (double)meter.BeatTicks, e.Length / (double)meter.BeatTicks)).ToList();
        var beats = score.Bars.Count * meter.BarTicks / (double)meter.BeatTicks;
        session.Changed += () => _ = InvokeAsync(async () =>
        {
            if (session?.Phase != Phase.Done) { StateHasChanged(); return; }
            try { await Scored(); saved.TrySetResult(); }
            catch (Exception error) { saved.TrySetException(error); throw; }
        });
        // No line moves across the music: keeping the pulse is the point. The count-in shows in the bar.
        session.Start(new ClickPlan(Tempo, meter.Beats, 1, state.StageForTry(tryIndex)), beats, expected);
    }

    private async Task Scored()
    {
        if (session is null || score is null || session.Phase != Phase.Done) return;

        var meter = score.Meter;
        var expected = score.Expected();
        var beatNs = 60e9 / Tempo;
        var onsets = expected.Select(e => session.TimeAt(e.Tick / (double)meter.BeatTicks)).ToList();
        var taps = session.Played.Select(p => p.OnNs).ToList();
        result = RhythmScorer.Score(onsets, [.. expected.Select(e => e.Id)], meter.Beats, taps, beatNs, beatNs * meter.Beats, Settings.TimingOffsetMs);
        // Every note marked by where its tap landed against the click: green within a tenth of a beat, amber with an arrow further
        // out, a ring where the tap landed whenever it was a twentieth of a beat or more off, outlined red when missed.
        await (sheet?.ShowMarks(result.Notes.Zip(expected).Select(p =>
        {
            if (p.First.Outcome != Outcome.Right || p.First.ErrorMs is not { } ms) return new SheetMark(p.First.Id, "missed");
            var percent = ms / (beatNs / 1e6) * 100;
            var kind = Math.Abs(percent) <= Grading.AudiblePercent ? "right" : percent < 0 ? "early" : "late";
            var landed = p.Second.Tick / (double)Ticks.Quarter + percent / 100 * meter.BeatTicks / Ticks.Quarter;
            return new SheetMark(p.First.Id, kind, Quarter: Math.Abs(percent) >= Grading.InTimePercent ? landed : null);
        })) ?? Task.CompletedTask);
        bars = RhythmScorer.ByBar(result.Notes, [.. expected.Select(e => e.Bar)], beatNs);
        accuracies.Add(result.Accuracy);
        var measures = new { accuracy = result.Accuracy, lean = result.LeanPercent, steadiness = result.SteadinessPercent, drift = result.DriftPercent, missed = result.Missed, extra = result.Extra, stage = state.StageForTry(tryIndex).ToString(), stopped = interrupted };
        var attempt = new AttemptRecord(0, DateTimeOffset.Now, Today, "rhythm", state.StageForTry(tryIndex).ToString(), null, state.Level, Tempo, null, null, "[]", null, System.Text.Json.JsonSerializer.Serialize(measures), result.Accuracy, !interrupted && result.Missed == 0 && result.Extra == 0, null);
        if (routineSession?.Execution is not null) await routineSession.RecordAsync(attempt, interrupted ? 0 : 1);
        else await Store.AddAttemptAsync(attempt);
        tryIndex++;
        if (tryIndex >= Tries && routineSession?.IsRoutine != true)
        {
            before = state;
            state = state.After(accuracies.Average());
            await Store.SaveTrackAsync("rhythm", state);
            await Store.MarkStepAsync(Today, StepKind.Rhythm);
            await Store.AddMinutesAsync(Today, (DateTime.Now - started).TotalMinutes);
            started = DateTime.Now;
        }
        StateHasChanged();
    }

    private async Task StopRoutine()
    {
        if (session?.Phase is Phase.CountIn or Phase.Playing)
        {
            interrupted = true;
            session.Finish();
        }
        if (saved is not null) await saved.Task;
    }

    // Bar by bar, against the click: one that ran early or late as a whole, by how much; the notes in it well off either way; where
    // you came back on the beat; the missed notes.
    private IEnumerable<string> BarWords()
    {
        var wasOff = false;
        foreach (var bar in bars)
        {
            var parts = new List<string>();
            if (bar.Percent is > Grading.AudiblePercent or < -Grading.AudiblePercent) parts.Add($"ran {(bar.Percent > 0 ? "late" : "early")}, about {Math.Abs(bar.Percent.Value):0}% of a beat {(bar.Percent > 0 ? "behind" : "ahead of")} the click");
            else if (bar.Early + bar.Late > 0) parts.Add(string.Join(" and ", new[] { bar.Late > 0 ? $"{bar.Late} late" : null, bar.Early > 0 ? $"{bar.Early} early" : null }.OfType<string>()));
            else if (wasOff && bar.Percent is not null) parts.Add("back on the beat");
            if (bar.Missed > 0) parts.Add($"{bar.Missed} missed");
            if (parts.Count > 0) yield return $"Bar {bar.Bar}: {string.Join("; ", parts)}.";
            wasOff = bar.Off;
        }
        if (bars.Count > 0 && !bars.Any(b => b.Off || b.Missed > 0)) yield return "Every note landed on the beat.";
    }

    private string SetWords() => before is null ? "" : state.Level > before.Level ? $"On to rhythm level {state.Level}." : state.Level < before.Level ? $"Back to level {state.Level} for now." : state.Stage != before.Stage ? $"Next set starts with the click {StageName(state.Stage).ToLowerInvariant()}." : "Same again next time.";

    public void Dispose()
    {
        session?.Dispose();
    }
}
