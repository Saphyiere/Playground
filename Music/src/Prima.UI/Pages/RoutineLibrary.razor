@page "/routines"
@implements IDisposable
@inject RoutineService Routines
@inject NavigationManager Nav
@inject AppNavigation Navigation
@inject ILogger<RoutineLibrary> Logger
@using Microsoft.Extensions.Logging
@using Prima.Core.Routines
@using Prima.UI.Routines

<PageTitle>Routines · Prima</PageTitle>

@* Your routines and Claude's, as the Repertoire has its pieces: three starred on top as cards, each with how it's going (a lamp
   for each day of the last four weeks it was played, when it last was, how many of its activities went clean that day, and
   what's next), the rest listed under them, and what's been asked of Claude that isn't a routine yet after them. A routine opens
   on its own page; Start goes straight to its next activity. Yours are made here and filled from the exercises, with the + on
   any of them; Claude's are asked for. *@
<PageHead Title="Routines" Kicker="Yours and Claude's">
    <button type="button" class="mu-btn" data-piano="off" data-action="new-routine" @onclick="Name">New routine</button>
    <button type="button" class="mu-btn" data-piano="off" data-action="rcm-routine" aria-expanded="@(choosingRcm ? "true" : "false")" @onclick="ChooseRcm">RCM technique</button>
    <a class="mu-btn" data-piano="off" href="exercises?show=hanon">Hanon routines</a>
    <a class="mu-btn" data-piano="off" data-action="ask-routine" href="routine/ask">Ask Claude for a routine</a>
</PageHead>

@* RCM's technique for a level, Preparatory A to Level 4, made a routine of yours when it's asked for: its scales, chords and
   arpeggios, a key a day, with RCM's minimum tempo as the target. One already made for the level opens again. *@
@if (choosingRcm)
{
    <div class="control-row rep-name rcm-levels" role="group" aria-label="RCM's technique for a level">
        <span class="control-label">RCM's technique for</span>
        @foreach (var level in Prima.Core.Routines.RcmTechnique.Levels)
        {
            <button type="button" class="mu-btn" data-piano="off" data-action="@($"rcm-{level.Key}")" disabled="@busy" @onclick="() => MakeRcm(level)">@level.Name</button>
        }
        <button type="button" class="mu-btn" data-piano="off" @onclick="() => choosingRcm = false">Cancel</button>
    </div>
}

@if (naming)
{
    <div class="control-row rep-name">
        <input class="text-field" type="text" placeholder="The routine's name" aria-label="The new routine's name" maxlength="60" value="@typed" @oninput="e => typed = e.Value?.ToString()" @onkeydown="NameKey" />
        <button type="button" class="mu-btn mu-primary" data-piano="off" data-action="make-routine" disabled="@busy" @onclick="Make">Make</button>
        <button type="button" class="mu-btn" data-piano="off" @onclick="() => naming = false">Cancel</button>
    </div>
}
@if (note is not null)
{
    <p class="control-note" role="status">@note</p>
}

@if (loading)
{
    <div class="wait-tabs wait-item"><span class="wait-line tall" style="width: 120px"></span><span class="wait-line tall" style="width: 78px"></span><span class="wait-line tall" style="width: 118px"></span></div>
    <div class="rep-grid rt-grid"><Waiting Shape="WaitShape.Card" Count="3" Label="Opening your routines" /></div>
    <section class="settings-section"><ul class="up-list rep-lately rt-rest"><Waiting Shape="WaitShape.Row" Count="3" From="3" /></ul></section>
}
else
{
    var shown = Shown().ToList();
    var starred = stars.Select(s => shown.FirstOrDefault(r => r.Routine.Revision == s)).OfType<RoutineStanding>().ToList();
    var rest = shown.Where(r => !stars.Contains(r.Routine.Revision)).OrderByDescending(r => r.Last ?? DateOnly.MinValue).ThenByDescending(r => r.Routine.Accepted).ToList();
    @if (standings.Count == 0)
    {
        <p class="page-note">None yet. Make one with New routine and fill it with the + on any exercise, or ask Claude for one.</p>
    }
    else
    {
        <div class="settings-tabs" role="tablist" aria-label="Whose routines">
            @foreach (var (key, label) in Tabs)
            {
                <button type="button" role="tab" class="settings-tab" aria-selected="@((Whose ?? "") == key ? "true" : "false")" @onclick="() => Show(key)">@label<span class="tab-dot">·</span><span class="tab-n">@Of(key).Count()</span></button>
            }
        </div>
        @if (starred.Count > 0)
        {
            <div class="rep-grid rt-grid" @key="@($"cards {Whose}")">
                @foreach (var standing in starred)
                {
                    var routine = standing.Routine;
                    var go = standing.Next;
                    <article class="rep-card rt-card" data-routine="@routine.Revision" data-state="@(routine.Revision == active?.Revision ? "now" : null)">
                        <div class="rep-top">
                            <div>
                                <p class="rep-kicker">@About(routine, true)@if (routine.Revision == active?.Revision) { <span class="rt-today">Daily routine</span> }</p>
                                <h3 class="rep-title"><a href="@($"routines/{routine.Revision}")">@Called(routine)</a></h3>
                            </div>
                            <button type="button" class="lb-star" aria-pressed="true" aria-label="@($"{Called(routine)} is starred: take its star off")" @onclick="() => Star(routine, false)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 17l-5.3 2.9 1.1-6L3.4 9.7l6-.8z" /></svg>
                            </button>
                        </div>
                        <RoutineStrip Routine="routine" />
                        <div class="rep-meter rt-days" role="img" aria-label="@Days(standing)">
                            @foreach (var lit in standing.Lamps)
                            {
                                <span class="@(lit ? "s2" : "")"></span>
                            }
                        </div>
                        <p class="rep-line">@Went(standing)</p>
                        <div class="rep-foot">
                            @if (routine.Items.Count == 0)
                            {
                                <p class="rep-line"><b>Empty</b> · the + on an exercise puts it in</p>
                                <a class="mu-btn lb-small" data-piano="off" href="exercises">Exercises</a>
                            }
                            else if (go is not null)
                            {
                                <p class="rep-line"><b>Next</b> · @RoutineWords.American(go.Title)</p>
                                <button type="button" class="mu-btn mu-primary lb-small" data-piano="off" data-action="routine-start" disabled="@busy" @onclick="() => Start(routine, go.Id)">@(standing.DoneToday.Count > 0 ? "Go on" : "Start")</button>
                            }
                            else
                            {
                                <p class="rep-line"><b>Done today</b> · again tomorrow</p>
                                <button type="button" class="mu-btn lb-small" data-piano="off" data-action="routine-start" disabled="@busy" @onclick="() => Start(routine, routine.Items[0].Recipe.Id)">Again</button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else if (rest.Count > 0)
        {
            <p class="section-note">A star keeps a routine here on top, as a card: three of them at most.</p>
        }
        @if (rest.Count > 0)
        {
            <section class="settings-section" aria-labelledby="rest-heading" @key="@($"rest {Whose}")">
                <h2 id="rest-heading" class="section-title">@(starred.Count > 0 ? "Your other routines" : "Your routines")</h2>
                <ul class="up-list rep-lately rt-rest">
                    @foreach (var standing in rest)
                    {
                        var routine = standing.Routine;
                        var go = standing.Next ?? routine.Items.FirstOrDefault()?.Recipe;
                        <li class="up-row piece-item" data-routine="@routine.Revision" data-state="@(routine.Revision == active?.Revision ? "now" : null)">
                            @if (go is not null)
                            {
                                <button type="button" class="mu-btn piece-hear" data-piano="off" aria-label="@($"Start {Called(routine)}")" disabled="@busy" @onclick="() => Start(routine, go.Id)">▶</button>
                            }
                            else
                            {
                                <span class="piece-hear-none"></span>
                            }
                            <div class="up-main">
                                <a class="up-title piece-title" href="@($"routines/{routine.Revision}")">@Called(routine)</a>
                                <span class="up-artist">@About(routine)@(routine.Revision == active?.Revision ? " · on Today" : "")</span>
                            </div>
                            <span class="up-last">@if (standing.Last is { } last) { <b>@RoutineStanding.When(last, today)</b>@(standing.CleanOnLast is { } clean ? $" · {clean} of {routine.Items.Count} clean" : "") } else { <b>Not practiced yet</b> }</span>
                            <button type="button" class="lb-star" aria-pressed="false" aria-label="@($"Star {Called(routine)}")" @onclick="() => Star(routine, true)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.4l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 17l-5.3 2.9 1.1-6L3.4 9.7l6-.8z" /></svg>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
    }

    @if (asked.Count > 0)
    {
        <section class="settings-section" aria-labelledby="asked-heading">
            <h2 id="asked-heading" class="section-title">Asked of Claude</h2>
            <p class="section-note">Not routines yet: open one to look over what came back, ask again, or see why it didn't finish. Dismiss one you don't want, once it isn't being asked.</p>
            <ul class="piece-list routine-requests">
                @foreach (var job in asked)
                {
                    <li class="routine-request">
                        <a class="piece-row" data-piano="off" data-routine-job="@job.Id" data-state="@job.State.ToString().ToLowerInvariant()" href="@($"routine/jobs/{job.Id}")">
                            <span class="piece-title">@JobTitle(job)</span>
                            <span class="piece-meta">
                                @if (job.State is RoutineGenerationState.Queued or RoutineGenerationState.Running)
                                {
                                    <span class="busy-line"><Busy />@JobState(job)</span>
                                }
                                else
                                {
                                    @JobState(job)
                                }
                                @($" · {job.Request.Minutes} min{(job.Source is { } source ? $" · {source.Title}" : "")} · {job.Updated.ToLocalTime().ToString("d MMM HH:mm", CultureInfo.InvariantCulture)}")
                            </span>
                        </a>
                        @* One being asked just now stays: what Claude sends back would have nowhere to go. Taking one off asks first. *@
                        @if (job.State is not (RoutineGenerationState.Queued or RoutineGenerationState.Running))
                        {
                            @if (dismissing == job.Id)
                            {
                                <span class="routine-request-actions">
                                    <button type="button" class="mu-btn mu-primary" data-piano="off" data-action="routine-dismiss-confirm" disabled="@busy" @onclick="() => Dismiss(job.Id)">Dismiss it</button>
                                    <button type="button" class="mu-btn" data-piano="off" @onclick="() => dismissing = null">Keep it</button>
                                </span>
                            }
                            else
                            {
                                <span class="routine-request-actions">
                                    <button type="button" class="mu-btn" data-piano="off" data-action="routine-dismiss" @onclick="() => dismissing = job.Id">Dismiss…</button>
                                </span>
                            }
                        }
                    </li>
                }
            </ul>
        </section>
    }
}
@if (problem is not null)
{
    <p class="section-note" role="alert">@problem</p>
}

@code {
    private static readonly (string Key, string Label)[] Tabs = [("", "Everything"), ("yours", "Yours"), ("claude", "From Claude")];

    /// <summary>Whose routines are shown: "yours" or "claude"; all of them when none.</summary>
    [SupplyParameterFromQuery(Name = "whose")] public string? Whose { get; set; }

    /// <summary>"1" to open with a new routine being named.</summary>
    [SupplyParameterFromQuery(Name = "new")] public string? New { get; set; }

    private RoutineDefinition? active;
    private List<RoutineStanding> standings = [];
    private IReadOnlyList<string> stars = [];
    private IReadOnlyList<RoutineGenerationJob> asked = [];
    private bool loading = true;
    private bool busy;
    private bool naming;
    private string? typed;
    private string? note;
    private string? problem;
    // The request whose Dismiss… was tapped, asking whether to take it off for good.
    private string? dismissing;
    private DateOnly today = DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnInitializedAsync()
    {
        Navigation.Name("Routines");
        Routines.Changed += Changed;
        naming = New == "1";
        await Load();
        loading = false;
    }

    private async Task Load()
    {
        try
        {
            today = DateOnly.FromDateTime(DateTime.Now);
            active = await Routines.ActiveAsync();
            var (times, runs) = (await Routines.TimesAsync(), await Routines.RunsAsync());
            standings = [.. (await Routines.RoutinesAsync()).Select(r => RoutineStanding.Of(r, times, runs, today))];
            var saved = standings.Select(s => s.Routine.Revision).ToHashSet();
            stars = [.. (await Routines.StarredAsync()).Where(saved.Contains)];
            asked = await Routines.RecentAsync();
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Couldn't open the routines: {Message}", error.Message);
            problem = $"Couldn't open your routines: {error.Message}";
        }
    }

    // A request asked for finished, failed or was accepted elsewhere (its notification, the review): the lists follow.
    private void Changed(RoutineGenerationJob job) => _ = InvokeAsync(async () =>
    {
        await Load();
        StateHasChanged();
    });

    private IEnumerable<RoutineStanding> Of(string whose) => whose switch
    {
        "yours" => standings.Where(s => s.Routine.Own),
        "claude" => standings.Where(s => !s.Routine.Own),
        _ => standings,
    };

    private IEnumerable<RoutineStanding> Shown() => Of(Whose ?? "");

    private void Show(string whose) => Navigation.Replace(Nav.GetUriWithQueryParameter("whose", whose.Length == 0 ? null : whose));

    private static string Called(RoutineDefinition routine) => routine.Own ? routine.Title : RoutineWords.American(routine.Title);

    // Whose it is, how many exercises and how long: "Yours · 6 exercises · 18 min", or on a card, under which its exercises'
    // shapes show, "Yours · 6 · 18 min".
    private static string About(RoutineDefinition routine, bool card = false)
    {
        var count = card ? $"{routine.Items.Count}" : routine.Items.Count == 1 ? "1 exercise" : $"{routine.Items.Count} exercises";
        return $"{(routine.Own ? "Yours" : "From Claude")} · {count} · {routine.Items.Sum(i => i.Recipe.Minutes)} min";
    }

    // When it was last played, how many of its activities went clean that day, and on how many of the last four weeks' days.
    private string Went(RoutineStanding standing) => standing.Last is { } last
        ? string.Join(" · ", new[] { RoutineStanding.When(last, today), standing.CleanOnLast is { } clean ? $"{clean} of {standing.Routine.Items.Count} clean" : null, $"{RoutineStanding.DaysSaid(standing.DaysPlayed)} of {RoutineStanding.Days}" }.OfType<string>())
        : $"Not practiced yet · made {RoutineStanding.When(DateOnly.FromDateTime(standing.Routine.Accepted.LocalDateTime), today).ToLowerInvariant()}";

    private string Days(RoutineStanding standing) => standing.Last is { } last
        ? $"Played on {standing.DaysPlayed} of the last {RoutineStanding.Days} days, last {RoutineStanding.When(last, today).ToLowerInvariant()}"
        : "Not practiced yet";

    private void Name() => (naming, choosingRcm, typed, note) = (true, false, null, null);

    // Choosing a level of RCM's technique, Preparatory A to Level 4, to make a routine of.
    private bool choosingRcm;

    private void ChooseRcm() => (choosingRcm, naming, note) = (!choosingRcm, false, null);

    // A level of RCM's technique as a routine of yours, opened at once; the one made before for the level, where there is one.
    private async Task MakeRcm(Prima.Core.Routines.RcmLevel level)
    {
        busy = true;
        try
        {
            var made = standings.Select(s => s.Routine).FirstOrDefault(r => r.Own && r.Items.Any(i => Prima.Core.Routines.RcmTechnique.Find(i.Recipe.Id)?.Level == level.Key))
                ?? await Routines.MakeAsync(level.Title, level.Items, level.Summary);
            Nav.NavigateTo($"routines/{made.Revision}");
        }
        finally
        {
            busy = false;
        }
    }

    // A new routine of yours under the name typed, opened at once to fill it.
    private async Task Make()
    {
        var name = typed?.Trim() ?? "";
        if (name.Length == 0)
        {
            note = "Give it a name.";
            return;
        }
        if (standings.Any(s => s.Routine.Own && string.Equals(s.Routine.Title, name, StringComparison.OrdinalIgnoreCase)))
        {
            note = "You have a routine by that name.";
            return;
        }
        busy = true;
        try
        {
            var made = await Routines.MakeAsync(name);
            Nav.NavigateTo($"routines/{made.Revision}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task NameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Make();
    }

    private async Task Star(RoutineDefinition routine, bool on)
    {
        note = await Routines.StarAsync(routine.Revision, on) ? null : $"Three are starred: take a star off one of them to star {Called(routine)}.";
        await Load();
    }

    // Straight to an activity of a routine, on its day's progress, whether Today follows it or not.
    private async Task Start(RoutineDefinition routine, string itemId)
    {
        busy = true;
        try
        {
            var day = await Routines.DayAsync(routine.Revision) ?? throw new InvalidOperationException("That routine isn't saved any more.");
            Nav.NavigateTo(await Routines.OpenAsync(day.Id, itemId));
        }
        catch (InvalidOperationException error) { problem = error.Message; }
        finally { busy = false; }
    }

    // A request taken off for good. One asked again since it was tapped stays, being asked.
    private async Task Dismiss(string id)
    {
        busy = true;
        try
        {
            if (!await Routines.DismissAsync(id)) problem = "That request is being asked just now: it can be dismissed once it's back.";
            dismissing = null;
            await Load();
        }
        finally { busy = false; }
    }

    // What a request is called: what came back, or else what was asked for, or the piece it's for. Only Claude's words are
    // respelled: the goal typed and the piece's title stay as they were written.
    private static string JobTitle(RoutineGenerationJob job) =>
        job.Draft?.Title is { } title ? RoutineWords.American(title) : job.Request.Goal is { Length: > 0 } goal ? goal : job.Source?.Title ?? "Practice routine";

    private static string JobState(RoutineGenerationJob job) => job.State switch
    {
        RoutineGenerationState.Queued => "Waiting to be asked",
        RoutineGenerationState.Running => "Asking Claude",
        RoutineGenerationState.Ready => "Ready to look over",
        RoutineGenerationState.Failed => "Didn't finish",
        RoutineGenerationState.Interrupted => "Interrupted",
        RoutineGenerationState.Cancelled => "Cancelled",
        _ => job.State.ToString(),
    };

    public void Dispose() => Routines.Changed -= Changed;
}
