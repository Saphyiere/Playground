@using Prima.Core.Practice

@* The in-depth review: a practice session, or one run, gone over at length. Its figures, led by where it ended; its lines over
   every run and pass (the notes, the timing, the notes held, the bar still hard at the end and the bar put right, by the same
   rule as the look back); and its bars shaded by what went wrong, the worst darkest, to tap for the bar's music, which the
   screen shows under it as it was last played there. Up to 24 bars every bar has a cell. A longer piece shows the bars that had
   something wrong, the most to fix first, up to 16, over a strip of the whole piece with each marked on it; more than that,
   the rest on asking. *@
<div class="deep-review">
    <section class="mu-screen review-head">
        <div class="review-title"><span class="mu-readout-label">@Kicker</span><span class="review-name">@Title</span></div>
        <div class="review-figures">
            @foreach (var (label, value) in Figures)
            {
                <div class="mu-readout"><span class="mu-readout-label">@label</span><span class="mu-readout-value">@value</span></div>
            }
        </div>
    </section>

    <div class="sum review-lines-box">
        <section class="mu-screen sum-quick review-lines" aria-label="How it went">
            @foreach (var (bad, key, line) in Lines())
            {
                <p class="sum-point"><span class="sum-key @(bad ? "bad" : "good")" aria-hidden="true"></span><span class="mu-readout-label">@key</span><span>@line</span></p>
            }
        </section>
    </div>

    @{
        var whole = Bars.Count <= 24;
        var troubled = Review.Bars.Values.Where(b => b.Weight > 0).OrderByDescending(b => b.Weight).ThenByDescending(b => b.Wrong + b.Missed).ThenBy(b => b.Bar).Select(b => b.Bar).ToList();
        var cells = whole ? Bars.ToList() : all ? troubled : [.. troubled.Take(16)];
        var worst = Review.Bars.Values.Select(b => b.Weight).DefaultIfEmpty(0).Max();
    }
    <section class="mu-screen review-bars" style="--n: @Math.Max(cells.Count, whole ? 1 : 8)" aria-label="Bar by bar">
        <span class="mu-readout-label">@(whole ? "Bar by bar: shaded by what went wrong · tap one for its music" : troubled.Count == 0 ? "No bar had anything wrong" : "The bars with most to fix first · tap one for its music")</span>
        @if (!whole)
        {
            @* Where they are in the whole piece: a thin strip, each bar shown below marked on it. *@
            <div class="review-whole" aria-hidden="true">
                @foreach (var bar in cells)
                {
                    <span class="review-tick @(bar == Picked ? "picked" : "")" style="left: @(Math.Max(0, Bars.IndexOf(bar)) * 100.0 / Bars.Count)%; width: @(100.0 / Bars.Count)%"></span>
                }
            </div>
        }
        <div class="review-cells">
            @foreach (var bar in cells)
            {
                var trouble = Review.Bars.GetValueOrDefault(bar);
                <button type="button" class="review-cell @(bar == Picked ? "picked" : "")" style="background: @Fill(trouble?.Weight ?? 0, worst)" aria-pressed="@(bar == Picked ? "true" : "false")"
                        aria-label="@($"{LookBack.Capital(PieceWords.Bar(bar))}: {(trouble is null ? "nothing to fix" : PieceWords.Trouble(trouble))}")" @onclick="() => OnPick.InvokeAsync(bar)"></button>
            }
        </div>
        <div class="review-nums" aria-hidden="true">
            @foreach (var bar in cells)
            {
                @* The upbeat has no number, as on the strip of bars. *@
                <span class="@(bar == Picked ? "picked" : "")">@(bar == 0 ? "" : bar)</span>
            }
        </div>
        @if (!whole && !all && troubled.Count > 16)
        {
            <button type="button" class="mu-btn review-more" @onclick="() => all = true">and @(troubled.Count - 16) more</button>
        }
    </section>
</div>

@code {
    [Parameter] public string Kicker { get; set; } = "";

    [Parameter] public string Title { get; set; } = "";

    [Parameter] public IReadOnlyList<(string Label, string Value)> Figures { get; set; } = [];

    [Parameter, EditorRequired] public SessionReview Review { get; set; } = null!;

    /// <summary>The piece's bars by number, in order.</summary>
    [Parameter] public List<int> Bars { get; set; } = [];

    [Parameter] public int? Picked { get; set; }

    [Parameter] public EventCallback<int> OnPick { get; set; }

    // A long piece's bars with something wrong, all of them, once asked for.
    private bool all;

    // Shaded by how much there is to fix against the bar with the most, so the worst bar is darkest whatever the session.
    private static string Fill(int weight, int worst) => weight == 0 ? "var(--chart-off)" : (weight * 3.0 / Math.Max(1, worst)) switch
    {
        <= 1 => "color-mix(in srgb, var(--chart-bad) 38%, var(--chart-off))",
        <= 2 => "color-mix(in srgb, var(--chart-bad) 68%, var(--chart-off))",
        _ => "var(--chart-bad)",
    };

    // The session's lines, over every run and pass: the notes, the timing (In time), the notes let go early, and the bar still hard
    // at the end and the bar put right, by the look back's rule.
    private IEnumerable<(bool Bad, string Key, string Line)> Lines()
    {
        var bars = Review.Bars.Values.ToList();
        var total = bars.Aggregate(new BarTrouble(0, 0, 0, 0, 0), (a, b) => a + b) with { Off = 0, Early = 0 };
        var notRight = bars.Where(b => b.Wrong + b.Missed + b.Slips + b.Apart > 0).OrderByDescending(b => b.Wrong + b.Missed + b.Slips + b.Apart);
        int[] most = [.. notRight.ThenBy(b => b.Bar).Take(3).Select(b => b.Bar).Order()];
        var notes = Review.Right == Review.Notes ? ": every one." : most.Length > 0 ? $": {PieceWords.Trouble(total)}, most in {Listed(most)}." : ".";
        yield return (Review.Right < Review.Notes, "Notes", $"{Review.Right} of {Review.Notes} right{notes}");
        if (Review.RightInTime is not null)
        {
            int[] off = [.. bars.Where(b => b.Off > 0).OrderByDescending(b => b.Off).ThenBy(b => b.Bar).Take(3).Select(b => b.Bar).Order()];
            var sum = bars.Sum(b => b.Off);
            yield return (sum > 0, "Timing", sum == 0 ? "Every right note in time: nothing more than a tenth of a beat out." : $"{sum} {(sum == 1 ? "note" : "notes")} more than a tenth of a beat early or late, most in {Listed(off)}.");
        }
        if (Review.Early > 0) yield return (true, "Held", $"{Review.Early} {(Review.Early == 1 ? "note" : "notes")} let go early, in {Listed([.. bars.Where(b => b.Early > 0).Select(b => b.Bar)])}.");
        if (Review.Hard is { } hard) yield return (true, "Look at", $"{LookBack.Capital(PieceWords.Bar(hard.Bar))} still had something to fix at the end: {PieceWords.Trouble(hard.Last)}.");
        else if (bars.Count > 0) yield return (false, "Look at", "Every bar was clean by the end.");
        if (Review.Fixed is { } put) yield return (false, "Fixed", $"{LookBack.Capital(PieceWords.Bar(put.Bar))}: {PieceWords.Trouble(put.First)} at first, nothing in its last {(put.Clean == 1 ? "time" : $"{put.Clean} times")}.");
    }

    // Bars listed: "bar 15", "bars 1 and 4", "bars 1, 4 and 15", and the pickup first as "the upbeat": "the upbeat and bar 4".
    private static string Listed(int[] bars) => bars switch
    {
        [var one] => PieceWords.Bar(one),
        [0, .. var rest] => $"the upbeat and {Listed(rest)}",
        _ => $"bars {string.Join(", ", bars[..^1])} and {bars[^1]}",
    };
}
