@implements IDisposable
@inject Prima.UI.Practice.FullScreen Full

@*
    The start of every play bar, the same keys in the same places on every screen that plays music, the engine's bar and a drill's
    alike: a screen's own keys first (a piece's page turns), then More (PlayMore), where the bar has anything in it, and full
    screen's key while full screen is on: it's in the screen's head otherwise, and full screen takes the head away. A screen says
    which it has; the keys, their order and what they look like are here.
*@
@Extra
@if (ShowMore && (Metronome || Marks || Music is not null || ChildContent is not null || OnExplain.HasDelegate))
{
    <PlayMore Running="Running" Metronome="Metronome" Ticking="Ticking" OnClickAlone="OnClickAlone" OnClickChanged="OnClickChanged" Marks="Marks"
              OnExplain="OnExplain" Explaining="Explaining" Music="Music">@ChildContent</PlayMore>
}
@if (ShowFullScreen && Full.On)
{
    <FullScreenKey OnFullScreen="OnFullScreen" />
}

@code {
    /// <summary>The screen's own keys, first on the bar: a piece's page turns.</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>More, unless the bar is a slim strip (a piece's Play).</summary>
    [Parameter] public bool ShowMore { get; set; } = true;

    /// <summary>A run playing: More is off meanwhile.</summary>
    [Parameter] public bool Running { get; set; }

    /// <summary>The click's settings in More, where the bar has a click.</summary>
    [Parameter] public bool Metronome { get; set; }

    /// <summary>The click going by itself (the engine's metronome), and the key that starts and stops it; none on a drill's bar.</summary>
    [Parameter] public bool Ticking { get; set; }

    [Parameter] public EventCallback OnClickAlone { get; set; }

    /// <summary>When the click's settings change, for a click going to start again with them.</summary>
    [Parameter] public EventCallback OnClickChanged { get; set; }

    /// <summary>The cursor and the marks while you play, on a bar whose runs are followed on the music.</summary>
    [Parameter] public bool Marks { get; set; }

    /// <summary>What's this, for a screen whose music explains its symbols when tapped, and whether it's on.</summary>
    [Parameter] public EventCallback OnExplain { get; set; }

    [Parameter] public bool Explaining { get; set; }

    /// <summary>The screen's own rows in More's group for the music.</summary>
    [Parameter] public RenderFragment? Music { get; set; }

    /// <summary>The screen's own groups in More.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Full screen's key on the bar while full screen is on, the head and its key gone.</summary>
    [Parameter] public bool ShowFullScreen { get; set; } = true;

    /// <summary>For a screen that does more as it goes in and out of full screen (a piece's Practice), asked by the key.</summary>
    [Parameter] public EventCallback OnFullScreen { get; set; }

    protected override void OnInitialized() => Full.Changed += Redraw;

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Full.Changed -= Redraw;
}
