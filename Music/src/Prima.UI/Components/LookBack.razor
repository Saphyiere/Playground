@using Prima.Core.Practice
@using Prima.UI.Storage

<div class="look-back sum">
    <section class="mu-screen look-story" aria-label="Practice summary">
        <div class="look-head">
            <span class="mu-readout-label">@(Session is null ? "Saved run" : "Practice summary")</span>
            @if (Session is not null)
            {
                <span class="look-total">@PieceWords.Duration(Session.Playing) playing · @(quick is { } counted ? $"{BarWords.Count(counted.Runs, "run")}{(counted.Loops > 0 ? $" · {BarWords.Count(counted.Loops, "loop")}" : "")}" : BarWords.Count(Runs.Count, "run"))</span>
            }
        </div>
        @if (quick is { } take)
        {
            @* The session in short, every number in it on the chart under it: where it went wrong, run by run, or how it went over time. *@
            <p class="look-headline"><QuickWords Sentence="take.Said" /></p>
            @if (take.Sub is { } sub)
            {
                <p class="qs-sub">@sub</p>
            }
            @if (take.Locks.Count > 0)
            {
                @* Each spot Lock in went round, and each loop counted to its clean times round in a row, in the order played. *@
                <ul class="qs-locks" aria-label="Locked in">
                    @foreach (var line in take.Locks)
                    {
                        <li><QuickWords Sentence="line" /></li>
                    }
                </ul>
            }
            <div class="qs-switches">
                <div class="play-mode" role="radiogroup" aria-label="Show">
                    <button type="button" role="radio" class="play-mode-option" data-piano="off" aria-checked="@On(!overTime)" @onclick="() => overTime = false">Where it went wrong</button>
                    <button type="button" role="radio" class="play-mode-option" data-piano="off" aria-checked="@On(overTime)" @onclick="() => overTime = true">Over time</button>
                </div>
                @if (!overTime && take.Rows.Count > 0)
                {
                    <div class="play-mode qs-lens" role="radiogroup" aria-label="Mistakes of">
                        <button type="button" role="radio" class="play-mode-option qs-notes" data-piano="off" aria-checked="@On(!timing)" @onclick="() => timing = false">Notes</button>
                        <button type="button" role="radio" class="play-mode-option qs-beat" data-piano="off" aria-checked="@On(timing)" @onclick="() => timing = true">Timing</button>
                    </div>
                }
            </div>
            @if (overTime)
            {
                <SessionTimeline Groups="take.Groups" UntimedLeftOut="take.UntimedLeftOut" />
            }
            else if (take.Rows.Count > 0)
            {
                <SessionHeat Rows="take.Rows" FirstBar="take.FirstBar" Timing="timing" Named="take.Named" />
            }
            else
            {
                <p class="section-note">No run through the piece in this session: its loops are under Over time.</p>
            }
        }
        else
        {
            <p class="look-headline">No run recorded.</p>
        }
    </section>

    @if (quick is { } next && next.Next.Parts.Count > 0)
    {
        <section class="mu-screen qs-next" aria-label="Next">
            <span class="mu-readout-label">Next</span>
            <p class="qr-said"><QuickWords Sentence="next.Next" /></p>
            @if (OnPractice.HasDelegate)
            {
                <button type="button" class="mu-btn mu-primary" data-action="practice-it" data-piano="off" @onclick="() => OnPractice.InvokeAsync((next.NextLoop, next.NextTempo, NeedsTiming(next)))">Practice it</button>
            }
        </section>
    }

    @if (Review.Stretches.Count > 0)
    {
        <details class="mu-screen look-stretches">
            <summary class="mu-readout-label">Passages and results</summary>
            @{
                var missingTiming = Runs.Where(r => r.InTime && (r.Passes.Count > 0 ? r.Passes.Any(p => p.RightInTime is null) : r.RightInTime is null))
                    .Select(r => (r.From, r.To, r.Hands)).ToHashSet();
            }
            @foreach (var stretch in Review.Stretches)
            {
                if (stretch.InTime && missingTiming.Contains((stretch.From, stretch.To, stretch.Hands)))
                {
                    <div class="look-row">
                        <div class="look-name"><span class="look-bars">@Name(stretch, true)</span><span class="mu-readout-label">@PieceWords.Hands(stretch.Hands) · @Count(stretch)</span></div>
                        <span class="look-total">Timing results are incomplete for this passage.</span>
                    </div>
                    continue;
                }
                var values = stretch.Points.Select(p => p.Figure).ToList();
                var comparable = values.Count > 1 && stretch.Points.All(p => p.Tempo == stretch.First.Tempo && p.Notes == stretch.First.Notes && p.Partial == stretch.First.Partial);
                var low = Math.Max(0, values.Min() - 0.08);
                var best = values.IndexOf(values.Max());
                var xs = values.Select((_, i) => values.Count == 1 ? Width / 2 : 6 + i * (Width - 12) / (values.Count - 1)).ToList();
                var ys = values.Select(v => 18 + (1 - (v - low) / Math.Max(0.01, 1 - low)) * (Height - 34)).ToList();
                // Where the tempo changed along it, the new tempo under that point.
                var steps = stretch.InTime && stretch.Points.Select(p => p.Tempo).Distinct().Count() > 1 ? stretch.Points.Select((p, i) => (i, p.Tempo)).Where(s => s.i == 0 || stretch.Points[s.i - 1].Tempo != s.Tempo).ToList() : [];
                var tempos = TempoLabels(steps, xs);
                <div class="look-row">
                    <div class="look-name">
                        <span class="look-bars">@Name(stretch, true)</span>
                        <span class="mu-readout-label">@PieceWords.Hands(stretch.Hands) · @(stretch.InTime ? "Timed" : "Wait for notes")</span>
                        <span class="mu-readout-label">@Count(stretch)</span>
                    </div>
                    <div class="look-spark">
                        <svg class="look-line" viewBox="0 0 @Width @Height" role="img" aria-label="@($"{BarWords.Count(values.Count, stretch.To is null ? "run" : "pass", stretch.To is null ? "runs" : "passes")}. Latest result: {Said(stretch, stretch.Last)}.")">
                            @foreach (var (i, _) in steps)
                            {
                                <line x1="@Place(xs[i])" x2="@Place(xs[i])" y1="12" y2="@Place(Height - 12)" class="look-step" />
                                @if (tempos.TryGetValue(i, out var tempo))
                                {
                                    @Label(tempo.X, Height - 2, tempo.Anchor, null, tempo.Words)
                                }
                            }
                            <path d="@string.Join(" ", xs.Select((x, i) => $"{(i == 0 ? "M" : "L")}{Place(x)} {Place(ys[i])}"))" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            @foreach (var i in new[] { 0, best, values.Count - 1 }.Distinct())
                            {
                                <circle cx="@Place(xs[i])" cy="@Place(ys[i])" r="@(i == best ? 5 : 4)" class="@(i == best ? "look-best" : "look-end")" />
                            }
                            @if (comparable)
                            {
                                @Label(xs[best], ys[best] - 9, xs[best] > Width - 60 ? "end" : xs[best] < 60 ? "start" : "middle", "look-said", $"{Said(stretch, stretch.Best)} best")
                            }
                        </svg>
                    </div>
                    <div class="look-figs">
                        <span class="mu-readout-label">@(stretch.InTime ? "Correct and on time" : "Correct on the first try")@(comparable ? ", first → last" : values.Count > 1 ? ", last attempt" : "")</span>
                        <span class="look-fig">@if (comparable) { @Said(stretch, stretch.First)<span class="look-arrow"> → </span> }<b>@Said(stretch, stretch.Last)</b></span>
                    </div>
                    <div class="look-figs look-tempo">
                        @if (stretch.InTime)
                        {
                            var temposPlayed = stretch.Points.Select(p => p.Tempo).OfType<double>().ToList();
                            <span class="mu-readout-label">Tempo</span>
                            <span class="look-fig">@(temposPlayed.Count == 0 ? "—" : temposPlayed.Min() == temposPlayed.Max() ? $"{temposPlayed[0]:0} BPM" : $"{temposPlayed.Min():0}–{temposPlayed.Max():0} BPM")</span>
                        }
                        else if (comparable)
                        {
                            <span class="mu-readout-label">Best</span>
                            <span class="look-fig">@Said(stretch, stretch.Best)</span>
                        }
                    </div>
                </div>
            }
        </details>
    }

    <div class="look-keys">
        @if (OnKeep.HasDelegate)
        {
            <button type="button" class="mu-btn" data-action="continue-practice" data-piano="off" @onclick="OnKeep">Keep practicing</button>
        }
        @if (Runs.Count > 0)
        {
            <button type="button" class="mu-btn" data-action="review-details" data-piano="off" @onclick="OnReview">Details</button>
        }
        <button type="button" class="mu-btn mu-primary" data-action="close-review" data-piano="off" @onclick="OnDone">Done</button>
    </div>
</div>

@code {
    [Parameter] public PracticeSession? Session { get; set; }
    [Parameter, EditorRequired] public SessionReview Review { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<PieceRun> Runs { get; set; } = [];
    [Parameter] public EventCallback OnKeep { get; set; }
    [Parameter] public EventCallback<int> OnViewBar { get; set; }
    [Parameter] public EventCallback OnReview { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }

    /// <summary>The piece's first and last bars, for the heat map's columns; without them, the bars its runs reached.</summary>
    [Parameter] public int? FirstBar { get; set; }

    [Parameter] public int? LastBar { get; set; }

    /// <summary>
    /// Next's Practice it: its bars looped (or none) at its tempo, the session carried on, and whether the place needs its timing
    /// (so a note off the beat spoils a time round as it's counted to two clean in a row).
    /// </summary>
    [Parameter] public EventCallback<((int From, int To)? Bars, double? Tempo, bool Timing)> OnPractice { get; set; }

    // The session's quick review, which view is shown (the heat map or the timeline) and which kind the heat map counts.
    private QuickSession? quick;
    private (IReadOnlyList<PieceRun>? Runs, int? First, int? Last) reviewedFor;
    private bool overTime;
    private bool timing;

    protected override void OnParametersSet()
    {
        // Worked out again for other runs, or once the piece's bars are known (the history reads its music after its runs).
        if (ReferenceEquals(Runs, reviewedFor.Runs) && (FirstBar, LastBar) == (reviewedFor.First, reviewedFor.Last)) return;
        reviewedFor = (Runs, FirstBar, LastBar);
        if (Runs.Count == 0)
        {
            quick = null;
            return;
        }
        var first = Math.Min(FirstBar ?? 1, Runs.Min(r => r.From));
        var reached = Runs.SelectMany(r => r.Passes.SelectMany(p => p.Trouble).Concat(r.Trouble)).Select(t => t.Bar).DefaultIfEmpty(first).Max();
        var last = Math.Max(LastBar ?? first, Math.Max(reached, Runs.Max(r => r.To ?? r.Bar ?? r.From)));
        quick = QuickReview.Session(Runs, new PieceShape(first, last, null));
        // It opens on where it went wrong, on the kind the first place needs; with no run through the piece, on the timeline.
        (overTime, timing) = (quick.Rows.Count == 0, quick.OpensOnTiming);
    }

    private static string On(bool on) => on ? "true" : "false";

    // Whether Next's place needs its timing (timing alone, or wrong notes and timing): Practice it counts a note off the beat then.
    private static bool NeedsTiming(QuickSession next) => next.Places.FirstOrDefault()?.Needs.Contains("timing") == true;

    // The lines' drawing size, which scales to its box.
    private const double Width = 360;
    private const double Height = 60;

    // Words on a line's drawing (Razor takes a text element for its own, so it's written out).
    // The words under a line's tempo changes: "at 120" where the changes leave room for them, only "120" where they come closer (a
    // new tempo every run or two ran "at 120at 115" together), and none under a change too close even for that to the one named
    // before it, whose dashed line still shows it. A change at the line's far end is named to its left, to stay in the drawing.
    // A letter is taken as 6.8 of the drawing's 360 across: the widest at its 11.
    private static Dictionary<int, (double X, string Anchor, string Words)> TempoLabels(List<(int i, double? Tempo)> steps, List<double> xs)
    {
        Dictionary<int, (double X, string Anchor, string Words)> Fit(Func<double?, string> words)
        {
            var named = new Dictionary<int, (double X, string Anchor, string Words)>();
            var clear = double.NegativeInfinity;
            foreach (var (i, tempo) in steps)
            {
                var said = words(tempo);
                var far = xs[i] > Width - 46;
                var (from, to) = far ? (xs[i] - 4 - said.Length * 6.8, xs[i] - 4) : (xs[i] + 4, xs[i] + 4 + said.Length * 6.8);
                if (from < clear) continue;
                named[i] = (far ? xs[i] - 4 : xs[i] + 4, far ? "end" : "start", said);
                clear = to + 6;
            }
            return named;
        }
        var full = Fit(tempo => $"at {tempo:0}");
        return full.Count == steps.Count ? full : Fit(tempo => $"{tempo:0}");
    }

    private static MarkupString Label(double x, double y, string anchor, string? kind, string words) =>
        new($"<text x=\"{Place(x)}\" y=\"{Place(y)}\" text-anchor=\"{anchor}\"{(kind is null ? "" : $" class=\"{kind}\"")}>{System.Net.WebUtility.HtmlEncode(words)}</text>");

    // A place on a line's drawing as SVG reads it, whatever the tablet's own number format: "180.5", never "180,5", which SVG
    // takes for two numbers.
    private static string Place(double at) => at.ToString("0.0", CultureInfo.InvariantCulture);

    /// <summary>
    /// A stretch's bars: "Bars 13–16", "Bar 7", "From bar 9" or "The whole piece", and runs that were all stopped on the way by
    /// the bars they reached, "Bars 1–8", as the look back's words name them (lower case in a sentence).
    /// </summary>
    public static string Name(Stretch stretch, bool capital)
    {
        var name = stretch.To is { } to ? PieceWords.Bars(stretch.From, to)
            : stretch.Reached is { } reached ? PieceWords.Bars(stretch.From, reached)
            : stretch.From <= 1 ? "the whole piece" : $"from bar {stretch.From}";
        return capital ? Capital(name) : name;
    }

    /// <summary>Words starting a sentence: "the upbeat" as "The upbeat".</summary>
    public static string Capital(string words) => BarWords.Capital(words);

    // Its passes or runs, and the time they took, where every one of them kept it.
    private static string Count(Stretch stretch)
    {
        var time = stretch.Time is { } took ? $" · {Math.Max(1, Math.Round(took.TotalMinutes)):0} min" : "";
        if (stretch.To is not null) return (stretch.Points.Count == 1 ? "1 pass" : $"{stretch.Points.Count} passes") + time;

        var stopped = stretch.Runs - stretch.Throughs;
        if (stretch.Throughs == 0) return (stretch.Runs == 1 ? "1 run" : $"{stretch.Runs} runs") + time;
        return (stretch.Throughs == 1 ? "1 run through" : $"{stretch.Throughs} runs through") + (stopped > 0 ? $", {stopped} stopped" : "") + time;
    }

    /// <summary>How a run or pass went: "91%" right in time, or "15/17" right first time.</summary>
    public static string Said(Stretch stretch, StretchPoint point) => stretch.InTime ? $"{point.Figure * 100:0}%" : $"{point.Right}/{point.Notes}";
}
