@using Prima.Core.Practice
@using Prima.UI.Storage

@* A practice session looked back on, taking the page once it's finished. First what it came to, in words: a sentence, then a
   few lines on what moved, what's still hard and how it compares with the time before, which depend on the kind of work it was
   (finding the notes, getting them right In time, the timing and the touch, or playing it through at tempo). Then where the
   piece stands now, bar by bar, and what to do next, each step a tap away. Under those, as before, each stretch practiced (its
   bars, the hand and the mode) with its runs, or round a loop its passes, as a line, the first to the last and the best named,
   and its tempo. Keep practicing carries the session on, a step's Practice it carries it on set up for that step, the in-depth
   review goes over it, and Done goes back to the piece's front: only taps press them. Those three keys stay at the foot of the
   screen. *@
<div class="look-back sum">
    <section class="mu-screen look-story" aria-label="This session">
        <div class="look-head">
            <span class="mu-readout-label">This session</span>
            <span class="look-total"><b>@PracticeStrip.Said(Session.Playing)</b> playing · @PracticeStrip.Said(Session.Idle) idle@(Totals())</span>
        </div>
        <p class="look-headline">@Story.Headline</p>
        @foreach (var line in Story.Lines)
        {
            <p class="sum-point"><span class="sum-key @(line.Tint switch { Tint.Good => "good", Tint.Bad => "bad", _ => "plain" })" aria-hidden="true"></span><span class="mu-readout-label">@line.About</span><span>@line.Words</span></p>
        }
    </section>

    <div class="look-now @(Story.Steps.Count == 0 ? "look-now-one" : "")">
        <section class="mu-screen look-standing" aria-label="Where the piece stands">
            <div class="look-head">
                <span class="mu-readout-label">Where the piece stands</span>
                <span class="look-total">@(Story.Standing.Own is { } own ? $"the piece goes at {own:0}" : "")</span>
            </div>
            @* Every bar, lighter the further along it is, and marked under it if it was played today. *@
            <div class="look-map" style="--n: @Columns" role="img" aria-label="@MapSaid()">
                @foreach (var bar in Story.Standing.Bars)
                {
                    <span class="look-bar @(Story.Today.Contains(bar.Bar) ? "today" : "")">
                        <i class="state-@((int)bar.State)"></i>
                        <b>@(Numbered(bar.Bar) ? bar.Bar : "")</b>
                    </span>
                }
            </div>
            <div class="look-legend" aria-hidden="true">
                @foreach (var (state, name) in States)
                {
                    <span><i class="state-@((int)state)"></i>@name <b>@Story.Standing.Count(state)</b></span>
                }
                <span class="look-legend-today"><i></i>played today</span>
            </div>
            <p class="look-held">@Held()</p>
        </section>

        @if (Story.Steps.Count > 0)
        {
            <section class="mu-screen look-next" aria-label="What to do next">
                <div class="look-head">
                    <span class="mu-readout-label">Next</span>
                    <span class="look-total">@(Story.Tired ? "for next time: that's enough for today" : "now, or next time")</span>
                </div>
                <ol class="look-steps">
                    @foreach (var step in Story.Steps)
                    {
                        <li>
                            <div class="look-step-words"><span class="look-step-what">@step.What</span><span class="look-step-why">@step.Why</span></div>
                            <button type="button" class="mu-btn" data-piano="off" aria-label="@($"Practice it: {step.What}")" @onclick="() => OnStep.InvokeAsync(step)">Practice it</button>
                        </li>
                    }
                </ol>
            </section>
        }
    </div>

    @if (Review.Stretches.Count > 0)
    {
        <section class="mu-screen look-stretches" aria-label="What was played">
            <div class="look-head">
                <span class="mu-readout-label">What was played</span>
                <span class="look-total">each run or pass a point, the first to the last</span>
            </div>
            @foreach (var stretch in Review.Stretches)
            {
                var values = stretch.Points.Select(p => p.Figure).ToList();
                var low = Math.Max(0, values.Min() - 0.08);
                var best = values.IndexOf(values.Max());
                var xs = values.Select((_, i) => values.Count == 1 ? Width / 2 : 6 + i * (Width - 12) / (values.Count - 1)).ToList();
                var ys = values.Select(v => 18 + (1 - (v - low) / Math.Max(0.01, 1 - low)) * (Height - 34)).ToList();
                // Where the tempo changed along it, the new tempo under that point.
                var steps = stretch.InTime && stretch.Points.Select(p => p.Tempo).Distinct().Count() > 1 ? stretch.Points.Select((p, i) => (i, p.Tempo)).Where(s => s.i == 0 || stretch.Points[s.i - 1].Tempo != s.Tempo).ToList() : [];
                var tempos = TempoLabels(steps, xs);
                <div class="look-row">
                    <div class="look-name">
                        <span class="look-bars">@Name(stretch, true)</span>
                        <span class="mu-readout-label">@Hands(stretch) · @(stretch.InTime ? "In time" : "Wait for me")</span>
                        <span class="mu-readout-label">@Count(stretch)</span>
                    </div>
                    <div class="look-spark">
                        <svg class="look-line" viewBox="0 0 @Width @Height" role="img" aria-label="@($"{values.Count} {(stretch.To is null ? "runs" : "passes")}: {Said(stretch, stretch.First)} the first, {Said(stretch, stretch.Best)} at best, {Said(stretch, stretch.Last)} the last")">
                            @foreach (var (i, _) in steps)
                            {
                                <line x1="@Place(xs[i])" x2="@Place(xs[i])" y1="12" y2="@Place(Height - 12)" class="look-step" />
                                @if (tempos.TryGetValue(i, out var tempo))
                                {
                                    @Label(tempo.X, Height - 2, tempo.Anchor, null, tempo.Words)
                                }
                            }
                            <path d="@string.Join(" ", xs.Select((x, i) => $"{(i == 0 ? "M" : "L")}{Place(x)} {Place(ys[i])}"))" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                            @foreach (var i in new[] { 0, best, values.Count - 1 }.Distinct())
                            {
                                <circle cx="@Place(xs[i])" cy="@Place(ys[i])" r="@(i == best ? 5 : 4)" class="@(i == best ? "look-best" : "look-end")" />
                            }
                            @if (values.Count > 1)
                            {
                                @Label(xs[best], ys[best] - 9, xs[best] > Width - 60 ? "end" : xs[best] < 60 ? "start" : "middle", "look-said", $"{Said(stretch, stretch.Best)} best")
                            }
                        </svg>
                    </div>
                    <div class="look-figs">
                        <span class="mu-readout-label">@(stretch.InTime ? "Right in time" : "Right first time")@(values.Count > 1 ? ", first → last" : "")</span>
                        <span class="look-fig">@if (values.Count > 1) { @Said(stretch, stretch.First)<span class="look-arrow"> → </span> }<b>@Said(stretch, stretch.Last)</b></span>
                    </div>
                    <div class="look-figs look-tempo">
                        @if (stretch.InTime)
                        {
                            var (first, last) = (stretch.First.Tempo ?? 0, stretch.Last.Tempo ?? 0);
                            <span class="mu-readout-label">Tempo</span>
                            <span class="look-fig">@(first == last ? $"{last:0}" : $"{first:0} → {last:0}")</span>
                        }
                        else
                        {
                            <span class="mu-readout-label">Best</span>
                            <span class="look-fig">@Said(stretch, stretch.Best)</span>
                        }
                    </div>
                </div>
            }
        </section>
    }

    @* The keys stay at the foot of the screen, however long the page is. *@
    <div class="look-keys">
        <button type="button" class="mu-btn" data-piano="off" @onclick="OnKeep">Keep practicing</button>
        <button type="button" class="mu-btn" data-piano="off" @onclick="OnReview">In-depth review</button>
        <button type="button" class="mu-btn mu-primary" data-piano="off" @onclick="OnDone">Done</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PracticeSession Session { get; set; } = null!;

    [Parameter, EditorRequired] public SessionReview Review { get; set; } = null!;

    /// <summary>The session in words, where the piece stands, and what to do next.</summary>
    [Parameter, EditorRequired] public SessionStory Story { get; set; } = null!;

    [Parameter] public EventCallback OnKeep { get; set; }

    [Parameter] public EventCallback OnReview { get; set; }

    /// <summary>Practice a step: the session carried on, set up for it.</summary>
    [Parameter] public EventCallback<NextStep> OnStep { get; set; }

    [Parameter] public EventCallback OnDone { get; set; }

    // The lines' drawing size, which scales to its box.
    private const double Width = 360;
    private const double Height = 60;

    // The bars' standings, the furthest along first. At tempo is only for a piece whose music marks one.
    private (BarState State, string Name)[] States => [.. Story.Standing.Own is null ? [] : new[] { (BarState.AtTempo, "at tempo") }, (BarState.InTime, "notes there, in time"), (BarState.Reading, "notes not there yet"), (BarState.NotPlayed, "not played")];

    // The map's bars a row: all of them up to 48, and a longer piece in rows as even as they come.
    private int Columns
    {
        get
        {
            var bars = Story.Standing.Bars.Count;
            return bars <= 48 ? Math.Max(1, bars) : (int)Math.Ceiling(bars / Math.Ceiling(bars / 48.0));
        }
    }

    // The bars numbered under the map: the first, and every fourth (every eighth of a longer piece, where a number wouldn't fit).
    private bool Numbered(int bar) => bar == Story.Standing.Bars[0].Bar || (bar > 0 && bar % (Columns > 32 ? 8 : 4) == 0);

    // The fastest it has held together, played through In time with both hands: 85% right in time, the app's aim everywhere.
    private string Held() => Story.Standing switch
    {
        { Held: { } held } => $"Played through, the fastest it has held together is {held:0}: 85% right in time, or more.",
        { Through: true } => "Played through, it hasn't held together yet: under 85% right in time.",
        _ => "Not played through In time yet.",
    };

    private string MapSaid()
    {
        var standing = Story.Standing;
        return $"Of {standing.Bars.Count} bars: {string.Join(", ", States.Select(s => $"{standing.Count(s.State)} {s.Name}"))}. Played today: {BarWords.Runs(Story.Today)}.";
    }

    // Words on a line's drawing (Razor takes a text element for its own, so it's written out).
    // The words under a line's tempo changes: "at 120" where the changes leave room for them, only "120" where they come closer (a
    // new tempo every run or two ran "at 120at 115" together), and none under a change too close even for that to the one named
    // before it, whose dashed line still shows it. A change at the line's far end is named to its left, to stay in the drawing.
    // A letter is taken as 6.8 of the drawing's 360 across: the widest at its 11.
    private static Dictionary<int, (double X, string Anchor, string Words)> TempoLabels(List<(int i, double? Tempo)> steps, List<double> xs)
    {
        Dictionary<int, (double X, string Anchor, string Words)> Fit(Func<double?, string> words)
        {
            var named = new Dictionary<int, (double X, string Anchor, string Words)>();
            var clear = double.NegativeInfinity;
            foreach (var (i, tempo) in steps)
            {
                var said = words(tempo);
                var far = xs[i] > Width - 46;
                var (from, to) = far ? (xs[i] - 4 - said.Length * 6.8, xs[i] - 4) : (xs[i] + 4, xs[i] + 4 + said.Length * 6.8);
                if (from < clear) continue;
                named[i] = (far ? xs[i] - 4 : xs[i] + 4, far ? "end" : "start", said);
                clear = to + 6;
            }
            return named;
        }
        var full = Fit(tempo => $"at {tempo:0}");
        return full.Count == steps.Count ? full : Fit(tempo => $"{tempo:0}");
    }

    private static MarkupString Label(double x, double y, string anchor, string? kind, string words) =>
        new($"<text x=\"{Place(x)}\" y=\"{Place(y)}\" text-anchor=\"{anchor}\"{(kind is null ? "" : $" class=\"{kind}\"")}>{System.Net.WebUtility.HtmlEncode(words)}</text>");

    // A place on a line's drawing as SVG reads it, whatever the tablet's own number format: "180.5", never "180,5", which SVG
    // takes for two numbers.
    private static string Place(double at) => at.ToString("0.0", CultureInfo.InvariantCulture);

    // The session in a few figures, after its minutes: its stretches, the passes round its loops and its runs through.
    private string Totals()
    {
        var passes = Review.Stretches.Where(s => s.To is not null).Sum(s => s.Points.Count);
        var throughs = Review.Stretches.Sum(s => s.Throughs);
        var parts = new List<string> { Review.Stretches.Count == 1 ? "1 stretch" : $"{Review.Stretches.Count} stretches" };
        if (passes > 0) parts.Add(passes == 1 ? "1 pass" : $"{passes} passes");
        if (throughs > 0) parts.Add(throughs == 1 ? "1 run through" : $"{throughs} runs through");
        return " · " + string.Join(" · ", parts);
    }

    /// <summary>
    /// A stretch's bars: "Bars 13–16", "Bar 7", "From bar 9" or "The whole piece", and runs that were all stopped on the way by
    /// the bars they reached, "Bars 1–8", as the look back's words name them (lower case in a sentence).
    /// </summary>
    public static string Name(Stretch stretch, bool capital)
    {
        var name = stretch.To is { } to ? PieceWords.Bars(stretch.From, to)
            : stretch.Reached is { } reached ? PieceWords.Bars(stretch.From, reached)
            : stretch.From <= 1 ? "the whole piece" : $"from bar {stretch.From}";
        return capital ? Capital(name) : name;
    }

    /// <summary>Words starting a sentence: "the upbeat" as "The upbeat".</summary>
    public static string Capital(string words) => BarWords.Capital(words);

    private static string Hands(Stretch stretch) => stretch.Hands switch { "right" => "Right hand", "left" => "Left hand", _ => "Both hands" };

    // Its passes or runs, and the time they took, where every one of them kept it.
    private static string Count(Stretch stretch)
    {
        var time = stretch.Time is { } took ? $" · {Math.Max(1, Math.Round(took.TotalMinutes)):0} min" : "";
        if (stretch.To is not null) return (stretch.Points.Count == 1 ? "1 pass" : $"{stretch.Points.Count} passes") + time;

        var stopped = stretch.Runs - stretch.Throughs;
        if (stretch.Throughs == 0) return (stretch.Runs == 1 ? "1 run" : $"{stretch.Runs} runs") + time;
        return (stretch.Throughs == 1 ? "1 run through" : $"{stretch.Throughs} runs through") + (stopped > 0 ? $", {stopped} stopped" : "") + time;
    }

    /// <summary>How a run or pass went: "91%" right in time, or "15/17" right first time.</summary>
    public static string Said(Stretch stretch, StretchPoint point) => stretch.InTime ? $"{point.Figure * 100:0}%" : $"{point.Right}/{point.Notes}";
}
