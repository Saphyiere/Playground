@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IClock Clock
@inject PrimaSettings Settings

@* Sheet music, engraved by Verovio from MEI: black on paper in both looks. The marks are drawn over it, and the cursor is a
   line of its own over both, so it can move without the music under it being painted again. *@
<div class="sheet @Class" @ref="element">
    <div class="sheet-music"></div>
    <svg class="sheet-overlay" aria-hidden="true"></svg>
    <div class="sheet-cursor" aria-hidden="true" hidden></div>
</div>

@code {
    /// <summary>The printed staff's height, in mm, at the normal sheet size.</summary>
    public const double StaffMm = 7;

    private ElementReference element;
    private IJSObjectReference? module;
    private DotNetObjectReference<Sheet>? self;
    private string? drawn;
    private bool disposed;
    private readonly string ownerId = Guid.NewGuid().ToString("N");

    [Parameter, EditorRequired] public string Mei { get; set; } = "";

    /// <summary>
    /// "line": a passage, its systems as wide as the sheet and as tall as the music, its bars shared evenly between them;
    /// "scroll": a whole piece down one sheet, each line broken where its bars fit; "page": one page the sheet's size.
    /// </summary>
    [Parameter] public string Layout { get; set; } = "line";

    /// <summary>Larger or smaller than the normal staff, for drill items and the small sheet on Today.</summary>
    [Parameter] public double Scale { get; set; } = 1;

    [Parameter] public int Page { get; set; } = 1;

    [Parameter] public bool Header { get; set; }

    /// <summary>Only these bars, by position from 1 ("6-9"): a stretch of a real piece, with its key, clefs and metre drawn at its start.</summary>
    [Parameter] public string? Measures { get; set; }

    /// <summary>Where the cursor goes, as each note's id and its time in quarter notes, when Verovio's time map isn't the music's (a stretch).</summary>
    [Parameter] public IReadOnlyList<(string Id, double Quarter)>? Onsets { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>When the music has painted, on the system clock (ns), for timing answers from when an item was shown.</summary>
    [Parameter] public EventCallback<long> OnPainted { get; set; }

    [Parameter] public EventCallback<int> OnPages { get; set; }

    [Parameter] public EventCallback<string> OnNoteTapped { get; set; }

    /// <summary>A bar tapped, on a note or anywhere in its space: its MEI id.</summary>
    [Parameter] public EventCallback<string> OnBarTapped { get; set; }

    /// <summary>What's this: a tap names the symbol under it (<see cref="OnSymbolTapped"/>) instead of a note.</summary>
    [Parameter] public bool Explain { get; set; }

    [Parameter] public EventCallback<SheetSymbol> OnSymbolTapped { get; set; }

    private bool explained;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        var size = Settings.SheetSize switch { < 0 => 0.85, > 0 => 1.2, _ => 1.0 };
        var key = $"{Mei.Length}|{Mei.GetHashCode()}|{Layout}|{Scale}|{Page}|{Header}|{Measures}|{Settings.MusicFont}|{size}";
        if (key == drawn)
        {
            if (module is null || explained == Explain) return;

            explained = Explain;
            try
            {
                await module.InvokeVoidAsync("explain", element, Explain);
            }
            catch (JSDisconnectedException)
            {
            }
            return;
        }

        (drawn, explained) = (key, Explain);
        try
        {
            if (module is null)
            {
                var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Components/Sheet.razor.js");
                if (disposed || drawn != key) { await imported.DisposeAsync(); return; }
                module = imported;
            }
            if (disposed || drawn != key) return;
            self ??= DotNetObjectReference.Create(this);
            var onsets = Onsets?.Select(o => new object[] { o.Id, o.Quarter }).ToArray();
            await module.InvokeVoidAsync("render", element, Mei, new { layout = Layout, staffMm = StaffMm * size * Scale, font = Settings.MusicFont, page = Page, header = Header, measures = Measures, onsets, explain = Explain }, self, ownerId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception e) when (disposed && e is JSException or ObjectDisposedException)
        {
        }
    }

    [JSInvokable]
    public async Task Painted(int pages)
    {
        if (disposed) return;
        var at = Clock.NowNs;
        await OnPages.InvokeAsync(pages);
        if (!disposed) await OnPainted.InvokeAsync(at);
    }

    [JSInvokable]
    public Task NoteTapped(string id) => disposed ? Task.CompletedTask : OnNoteTapped.InvokeAsync(id);

    [JSInvokable]
    public Task BarTapped(string id) => disposed ? Task.CompletedTask : OnBarTapped.InvokeAsync(id);

    [JSInvokable]
    public Task SymbolTapped(string id, string kind, string? within) => disposed ? Task.CompletedTask : OnSymbolTapped.InvokeAsync(new SheetSymbol(id, kind, within));

    /// <summary>
    /// Starts the cursor: bar 1 is <paramref name="msUntilStart"/> from now, at <paramref name="msPerQuarter"/>, from quarter
    /// <paramref name="startQuarter"/> of the music. Until the music starts it waits there, pulsing with the click's beats: one
    /// every <paramref name="beatMs"/>, one of them <paramref name="msUntilBeat"/> from now. It keeps to the run's
    /// <paramref name="path"/> when it's given one. Not <paramref name="shown"/>, it isn't drawn, but the line being played is
    /// still kept in view. Given the run's beats' <paramref name="times"/> (each one's quarter, and when it's due in ms after the
    /// beat <paramref name="msUntilBeat"/> from now), for music whose tempo changes, it keeps to those instead.
    /// </summary>
    public async Task StartCursor(double msUntilStart, double msPerQuarter, double startQuarter, double beatMs, double msUntilBeat, double? readAheadQuarters = null, CursorPath? path = null, bool shown = true,
        IReadOnlyList<(double Quarter, double Ms)>? times = null)
    {
        if (module is null) return;

        var way = path is null ? null : new { bars = path.Bars.Select(b => new object[] { b.Index, b.Quarter, b.Quarters }), events = path.Printed.Select(e => new object[] { e.Index, e.Id, e.Quarter }) };
        var beats = times?.Select(t => new[] { t.Quarter, t.Ms });
        await module.InvokeVoidAsync("cursorStart", element, msUntilStart, msPerQuarter, startQuarter, readAheadQuarters, beatMs, msUntilBeat, way, shown, beats);
    }

    /// <summary>Read ahead's look: only the opening view of <paramref name="quarters"/> shows.</summary>
    public async Task ShowOpening(double quarters)
    {
        if (module is not null) await module.InvokeVoidAsync("showOpening", element, quarters);
    }

    /// <summary>Wait for me's cursor: still, at a note, its line kept in view.</summary>
    public async Task CursorAt(string id)
    {
        if (module is not null) await module.InvokeVoidAsync("cursorAt", element, id);
    }

    /// <summary>A bar outlined, by its MEI id, and brought into view; null takes the outline away.</summary>
    public async Task Outline(string? measureId)
    {
        if (module is not null) await module.InvokeVoidAsync("outline", element, measureId);
    }

    public async Task StopCursor()
    {
        if (module is not null) await module.InvokeVoidAsync("cursorStop", element);
    }

    /// <summary>The marks after a run, in place of any before.</summary>
    public async Task ShowMarks(IEnumerable<SheetMark> marks)
    {
        if (module is not null) await module.InvokeVoidAsync("showMarks", element, marks.Select(m => new { id = m.Id, kind = m.Kind, played = m.Played, steps = m.Steps, q = m.Quarter, written = m.Written }));
    }

    /// <summary>Marks during a run, as notes are judged, added to those already shown (a note marked again takes its new mark).</summary>
    public async Task MarkLive(IEnumerable<SheetMark> marks)
    {
        if (module is not null) await module.InvokeVoidAsync("markLive", element, marks.Select(m => new { id = m.Id, kind = m.Kind, played = m.Played, steps = m.Steps, q = m.Quarter, written = m.Written }));
    }

    public async Task ClearMarks()
    {
        if (module is not null) await module.InvokeVoidAsync("clearMarks", element);
    }

    /// <summary>The page a note is on (1 for the first), or 0 when it isn't in the music.</summary>
    public async Task<int> PageOf(string id) => module is null ? 0 : await module.InvokeAsync<int>("pageOf", element, id);

    /// <summary>Which of these notes are on the page showing.</summary>
    public async Task<string[]> OnPage(IEnumerable<string> ids) => module is null ? [] : await module.InvokeAsync<string[]>("onPage", element, ids.ToArray());

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        var owned = module;
        module = null;
        try
        {
            if (owned is not null)
            {
                try { await owned.InvokeVoidAsync("dispose", element, ownerId); }
                finally { await owned.DisposeAsync(); }
            }
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
        self?.Dispose();
    }
}
