@*
    A small drawing on a choice whose words are musical, in the music's own shapes (the noteheads and clefs Verovio engraves
    with): two notes slurred, or with staccato dots; an interval as its two notes on a staff; the clefs; a sharp; an octave. It's
    drawn in the ink of the key it's on.
*@
<svg class="music-icon" viewBox="@ViewBox" aria-hidden="true">@((MarkupString)Drawing())</svg>

@code {
    /// <summary>legato, staccato, interval, octave, treble, bass, both (the two clefs) or sharp.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    /// <summary>For an interval, the steps from its lower note to its upper: 2 a third, 5 a sixth, 7 an octave.</summary>
    [Parameter] public int Steps { get; set; }

    // The glyphs' outlines, as Verovio's font draws them, their y upward.
    private static readonly Dictionary<string, string> Glyphs = new()
    {
        ["E0A4"] = "M0 -39c0 68 73 172 200 172c66 0 114 -37 114 -95c0 -84 -106 -171 -218 -171c-64 0 -96 30 -96 94z",
