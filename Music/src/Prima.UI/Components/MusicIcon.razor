    };

    private string ViewBox => Kind switch
    {
        "treble" => "-80 -1150 800 1880",
        "bass" => "-60 -420 820 1180",
        "both" => "0 0 1300 1300",
        "sharp" => "-200 -420 600 840",
        _ => "0 0 1200 1200",
    };

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Glyph(string id, double x, double y, double scale = 1) =>
        $"<path transform=\"translate({F(x)} {F(y)}) scale({F(scale)} {F(-scale)})\" d=\"{Glyphs[id]}\" fill=\"currentColor\"/>";

    // A staff's five lines, faint, behind an interval's notes.
    private static string Staff() => string.Concat(Enumerable.Range(0, 5).Select(i =>
        $"<path d=\"M120 {250 + i * 200}H1080\" stroke=\"currentColor\" stroke-width=\"22\" opacity=\"0.55\"/>"));

    private string Drawing() => Kind switch
    {
        "legato" => Glyph("E0A4", 170, 860, 1.05) + Glyph("E0A4", 680, 600, 1.05) + "<path d=\"M250 640Q560 250 900 420\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"56\" stroke-linecap=\"round\"/>",
        "staccato" => Glyph("E0A4", 170, 860, 1.05) + Glyph("E0A4", 680, 600, 1.05) + "<circle cx=\"335\" cy=\"650\" r=\"62\" fill=\"currentColor\"/><circle cx=\"845\" cy=\"390\" r=\"62\" fill=\"currentColor\"/>",
        "interval" => Staff() + Glyph("E0A4", 450, 850, 0.82) + Glyph("E0A4", 450, 850 - 100 * Steps, 0.82),
        "octave" => Staff() + Glyph("E0A4", 450, 850, 0.82) + Glyph("E0A4", 450, 150, 0.82),
        "treble" => Glyph("E050", 0, 0),
        "bass" => Glyph("E062", 0, 0),
        "both" => Glyph("E050", 60, 760, 0.62) + Glyph("E062", 640, 620, 0.66),
        "sharp" => Glyph("E262", 0, 0),
        _ => "",
    };
}
