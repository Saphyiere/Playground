@using Prima.Core.Generation

@*
    The hands as hands: the left and the right, each a key with its lamp, both lit for together. A tap lights or puts out that
    hand; one is always lit. Where together isn't offered, a tap is that hand alone.
*@
<div class="choice-set hands-choice" role="group" aria-label="Hands">
    @foreach (var (side, name) in Sides)
    {
        <button type="button" class="mu-toggle choice-icon" aria-pressed="@On(Lit(side))" aria-label="@($"{name} hand")" disabled="@Disabled" @onclick="() => Tap(side)">
            <span class="mu-led"></span><HandIcon Right="@(side == HandUse.Right)" /><span class="choice-word">@name</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HandUse> Offered { get; set; } = [];

    [Parameter] public HandUse Value { get; set; }

    [Parameter] public EventCallback<HandUse> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private static readonly (HandUse Side, string Name)[] Sides = [(HandUse.Left, "Left"), (HandUse.Right, "Right")];

    private static string On(bool on) => on ? "true" : "false";

    private bool Lit(HandUse side) => Value == side || Value == HandUse.Together;

    private Task Tap(HandUse side)
    {
        var to = side;
        if (Offered.Contains(HandUse.Together))
        {
            var left = Lit(HandUse.Left) != (side == HandUse.Left);
            var right = Lit(HandUse.Right) != (side == HandUse.Right);
            if (!left && !right) return Task.CompletedTask;
            to = left && right ? HandUse.Together : left ? HandUse.Left : HandUse.Right;
        }
        return to != Value && Offered.Contains(to) ? ValueChanged.InvokeAsync(to) : Task.CompletedTask;
    }
}
