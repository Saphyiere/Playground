@using Prima.Core.Generation

@*
    The hands: Left, Right or Both, one tap for the one wanted, each key with its hand drawn and the chosen one lit, as the mode's
    two are. Both only where together is offered. The owner, 28 November 2026: "we need a left, right, and both, so that you can
    just click the one you want instead of like having to do this ballet of like which one is on".
*@
<div class="play-mode hands-choice" role="radiogroup" aria-label="Hands">
    @foreach (var (side, name) in Sides)
    {
        if (!Offered.Contains(side)) continue;
        <button type="button" role="radio" class="play-mode-option" data-hand="@name.ToLowerInvariant()" aria-checked="@On(Value == side)" disabled="@Disabled" @onclick="() => Pick(side)">
            <span class="hands-choice-icons" aria-hidden="true">
                @if (side != HandUse.Right)
                {
                    <HandIcon />
                }
                @if (side != HandUse.Left)
                {
                    <HandIcon Right="true" />
                }
            </span>
            <span class="hands-choice-word">@name</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HandUse> Offered { get; set; } = [];

    [Parameter] public HandUse Value { get; set; }

    [Parameter] public EventCallback<HandUse> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private static readonly (HandUse Side, string Name)[] Sides = [(HandUse.Left, "Left"), (HandUse.Right, "Right"), (HandUse.Together, "Both")];

    private static string On(bool on) => on ? "true" : "false";

    private Task Pick(HandUse side) => side != Value ? ValueChanged.InvokeAsync(side) : Task.CompletedTask;
}
