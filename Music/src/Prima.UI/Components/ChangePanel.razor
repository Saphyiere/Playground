@*
    A panel of choices over the music, which stays drawn underneath: Change (what to play: a row each, the key on the piano and
    the screen's own choices) and the play bar's More (the rest). Done closes it, and so does a run starting.
*@
<section class="change-panel @Class" aria-label="@Label">
    @ChildContent
    <div class="change-panel-end">
        @Extra
        <button type="button" class="mu-btn mu-primary change-done" @onclick="() => OnDone.InvokeAsync()">Done</button>
    </div>
</section>

@code {
    /// <summary>Its rows: a <c>control-row</c> each, a <c>control-label</c> first.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Keys beside Done (Today's, to go back to the day's).</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    [Parameter] public EventCallback OnDone { get; set; }

    /// <summary>What it's called to a screen reader: what to play, or More.</summary>
    [Parameter] public string Label { get; set; } = "What to play";

    /// <summary>A class of its own: play-more, for the bar's.</summary>
    [Parameter] public string? Class { get; set; }
}
