@*
    A hand seen from above, as it lies on the keys: four fingers and the thumb, the right hand's thumb on its left, the left
    hand's on its right. Drawn in the ink of what it's on.
*@
<svg class="hand-icon" viewBox="0 0 24 24" aria-hidden="true">
    <g fill="currentColor" transform="@(Right ? null : "matrix(-1 0 0 1 24 0)")">
        <rect x="7" y="10.5" width="12" height="11.5" rx="4" />
        <rect x="7.3" y="4" width="2.4" height="10" rx="1.2" />
        <rect x="10.3" y="2.5" width="2.4" height="11" rx="1.2" />
        <rect x="13.3" y="3.5" width="2.4" height="10" rx="1.2" />
        <rect x="16.3" y="6" width="2.4" height="8" rx="1.2" />
        <rect x="6.3" y="9.5" width="2.4" height="9" rx="1.2" transform="rotate(-38 7.5 18)" />
    </g>
</svg>

@code {
    /// <summary>The right hand; otherwise the left.</summary>
    [Parameter] public bool Right { get; set; }
}
