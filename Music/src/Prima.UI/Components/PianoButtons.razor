@implements IAsyncDisposable
@inject IKeyboard Keyboard
@inject PrimaSettings Settings
@inject SessionRegistry Registry
@inject NavigationManager Nav
@inject IJSRuntime JS

@*
    The piano's two buttons, so the hands needn't leave the keys between runs: the C♯ above middle C presses the screen's button
    marked data-piano="go", or else its primary button (the orange one, or Play), and the D♯ beside it the one marked
    data-piano="again". They're in the middle, a short reach from where the hands are, so only a deliberate press counts: the key
    on its own, with no other key in the moment before it, not a C♯ played in a passage. While a run counts in or plays every
    key is music, and a button that mustn't be pressed by accident (clearing your progress, removing a piece, stopping the music
    you're playing along with) is marked data-piano="off". While the piano is plugged in, the buttons say which key presses them.
*@

@code {
    /// <summary>The C♯ and D♯ above middle C.</summary>
    public const int Go = 61, Again = 63;

    private IJSObjectReference? module;
    private long otherKeyNs;

    protected override void OnInitialized()
    {
        Keyboard.Received += OnReceived;
        Keyboard.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Prima.UI/Components/PianoButtons.razor.js");
            await ShowKeys();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }

    private void OnReceived(MidiEvent e)
    {
        if (e.Kind != MidiKind.NoteOn) return;
        if (e.Note is not (Go or Again))
        {
            otherKeyNs = e.TimeNs;
            return;
        }
        if (e.TimeNs - otherKeyNs < 400_000_000 || !Settings.PianoButtons || Registry.Current?.Phase is Phase.CountIn or Phase.Playing) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (module is not null) await module.InvokeVoidAsync("press", e.Note == Go ? "go" : "again");
            }
            catch (Exception e) when (e is JSDisconnectedException or JSException)
            {
            }
        });
    }

    // The keys' names on the buttons: while the piano is plugged in and the setting is on (looked at again on each new screen).
    private async Task ShowKeys()
    {
        try
        {
            if (module is not null) await module.InvokeVoidAsync("showKeys", Keyboard.Name is not null && Settings.PianoButtons);
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }

    private void OnChanged() => _ = InvokeAsync(ShowKeys);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(ShowKeys);

    public async ValueTask DisposeAsync()
    {
        Keyboard.Received -= OnReceived;
        Keyboard.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            if (module is not null) await module.DisposeAsync();
        }
        catch (Exception e) when (e is JSDisconnectedException or JSException)
        {
        }
    }
}
