@* Settings › Your data: the copies of everything Prima keeps but Claude's key, through the Kit's sync (Storage/PrimaSync). When the
   last copy was made, its size and what it holds; how many copies are kept and what they take; Back up now; Restore from a
   backup… (this tablet's copies, or a folder or a file chosen with the tablet's picker, then which copy, and what it replaces,
   what's here being kept first); and Export everything, to send on. The copies held stand first, newest first, each saying what
   it was kept from before (an update that didn't check out, a restore, Start over, Remove library, Reset settings) and when, with
   actions to restore it or remove its protection. Work goes on in the background, its progress on the meter. *@
@implements IDisposable
@inject Syncer Sync
@inject ISyncPicker Picker
@inject IFiles Files
@inject PrimaStore Store
@inject PrimaSettings Options
@inject LookSetting LookSetting
@inject NavigationManager Nav
@using Playground.Sync

@foreach (var kept in status.Holding)
{
    <div class="copies-held" data-held="@(kept.Held!.Copy)" role="@(kept.Held!.From == SyncHeldFrom.Update ? "alert" : "group")" aria-label="@Head(kept)">
        <p class="copies-held-head"><span class="mu-led"></span>@Head(kept)</p>
        <p class="section-note">@Said(kept)</p>
        <div class="control-row">
            <button type="button" class="mu-btn mu-primary" data-action="restore-held" data-piano="off" disabled="@status.Busy" @onclick="() => ChooseHeld(kept)">Restore this backup…</button>
            <button type="button" class="mu-btn" data-action="release-held" disabled="@status.Busy" @onclick="() => LetGo(kept)">Remove backup protection</button>
        </div>
    </div>
}

<div class="control-row">
    <span class="control-label">Last backup</span>
    @if (status.Last is { } last)
    {
        <span class="key-figure">@SyncText.When(last.Made)</span>
        <span class="control-note">@SyncText.Size(last.Size) · @last.Summary</span>
    }
    else
    {
        <span class="key-figure none">@(status.Known ? "None yet" : "…")</span>
    }
</div>
@if (status.Copies > 0)
{
    <div class="control-row" data-backup-storage>
        <span class="control-label">Backups</span>
        <span class="control-note">@status.Copies @(status.Copies == 1 ? "copy" : "copies"), @SyncText.Size(status.Stored) total</span>
    </div>
    <p class="section-note copies-kept">@Shared()</p>
}
<div class="control-row">
    <button type="button" class="mu-btn" data-action="backup" disabled="@status.Busy" @onclick="BackUpNow">@if (status.Step == SyncStep.Copying) { <Busy /><span>Copying</span> } else { <span>Back up now</span> }</button>
    <button type="button" class="mu-btn" data-action="choose-backup" disabled="@status.Busy" aria-expanded="@(restoring ? "true" : "false")" @onclick="OpenRestore">Restore from a backup…</button>
    <button type="button" class="mu-btn" disabled="@status.Busy" @onclick="Export">@if (status.Step == SyncStep.Exporting) { <Busy /><span>Exporting</span> } else { <span>Export everything</span> }</button>
</div>
@if (status.Progress is { } progress)
{
    var percent = (int)Math.Round(progress.Fraction * 100);
    <div class="copies-progress" aria-live="polite">
        <p class="mu-meter-head"><span>@progress.Doing</span><span>@percent%</span></p>
        <div class="mu-meter meter-going" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent" aria-label="@progress.Doing">
            @for (var i = 0; i < 20; i++)
            {
                <span class="@(i < (int)Math.Round(progress.Fraction * 20) ? "on" : "")"></span>
            }
        </div>
    </div>
}
@if (restoring)
{
    <div class="copies-restore">
        @if (found.Count == 0)
        {
            @if (looking)
            {
                <p class="section-note busy-line" role="status"><Busy />Looking for copies</p>
            }
            else
            {
                <p class="section-note">No backups found on this tablet. Choose a backup folder or an exported file.</p>
            }
        }
        else
        {
            <ul class="copies-list" aria-label="Copies to restore">
                @foreach (var copy in found)
                {
                    <li>
                        <button type="button" class="copy-choice" data-held="@copy.Held?.Copy" aria-pressed="@(chosen == copy ? "true" : "false")" @onclick="() => chosen = copy">
                            <span class="mu-led"></span>
                            <span class="copy-when">@SyncText.When(copy.Made)</span>
                            <span class="copy-what">@SyncText.Size(copy.Size) · @copy.Summary</span>
                            <span class="copy-where">@Where(copy)</span>
                        </button>
                    </li>
                }
            </ul>
        }
        <div class="control-row">
            <button type="button" class="mu-btn" disabled="@status.Busy" @onclick="PickFolder">Choose a folder…</button>
            <button type="button" class="mu-btn" data-action="choose-file" disabled="@status.Busy" @onclick="PickFile">Choose a file…</button>
            <button type="button" class="mu-btn" @onclick="CloseRestore">Cancel</button>
        </div>
        @if (chosen is { } choice)
        {
            <p class="section-note">@Replaced(choice) @(unkept == choice ? "Prima couldn’t back up your current data. You can cancel or restore without that backup." : "Prima backs up your current data first so you can undo the restore.")</p>
            <div class="control-row">
                <button type="button" class="mu-btn mu-primary" data-action="restore" data-piano="off" disabled="@status.Busy" @onclick="() => Restore(choice, true)">Restore this copy</button>
                @if (unkept == choice)
                {
                    @* What's here couldn't be kept first (the status says why): restoring without it is a choice of its own. *@
                    <button type="button" class="mu-btn" data-action="restore-without-backup" data-piano="off" disabled="@status.Busy" @onclick="() => Restore(choice, false)">Restore without a backup</button>
                }
                <button type="button" class="mu-btn" @onclick="() => chosen = null">Cancel restore</button>
            </div>
        }
    </div>
}
<p class="section-note" role="status">@Note</p>

@code {
    private SyncStatus status = null!;
    private bool restoring;
    private bool looking;
    private List<SyncCopy> found = [];
    private SyncCopy? chosen;
    // The copy whose restore stopped because what's here couldn't be kept first.
    private SyncCopy? unkept;
    private string? note;

    protected override async Task OnInitializedAsync()
    {
        status = Sync.Status;
        Sync.Changed += Changed;
        // The copies in this tablet's folder are read once, as Settings first opens.
        if (!status.Known) await Sync.RefreshAsync();
        status = Sync.Status;
    }

    // What's said under the buttons: what was just picked, or how the last piece of work went, or what the copies are.
    private string Note => note ?? (status.Message.Length > 0 ? status.Message : Sync.Store.SurvivesUninstall
        ? $"Prima backs up daily when you open the app or finish practicing, and before updates, restores and resets. Backups in {Sync.Store.Name} survive an uninstall."
        : $"Android removes backups in {Sync.Store.Name} when you uninstall Prima. Use Export everything to save a copy elsewhere.");

    // Why the copies take so little together: the music imported is kept once for them all, so each copy costs about a copy of the
    // data file.
    private string Shared() => status.Last?.Manifest.Files.FirstOrDefault(f => f.Path == "prima.db") is { } data
        ? $"Backups share imported music. Each backup adds about {SyncText.Size(data.Size)}."
        : "Backups share imported music.";

    private void Changed(SyncStatus now) => _ = InvokeAsync(() =>
    {
        status = now;
        StateHasChanged();
    });

    private async Task BackUpNow()
    {
        note = null;
        try
        {
            await Sync.CopyAsync();
        }
        catch (Exception)
        {
            // The status says why, and the problem log has it.
        }
    }

    private async Task OpenRestore()
    {
        (restoring, chosen, unkept, note, looking) = (true, null, null, null, true);
        try
        {
            found = [.. await Sync.FindCopiesAsync(Sync.Store)];
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            note = $"This tablet's copies couldn't be read: {e.Message}";
        }
        looking = false;
    }

    private void CloseRestore()
    {
        (restoring, chosen, unkept, note) = (false, null, null, null);
        ForgetPicked();
    }

    // A file picked to restore from is copied in to be read (a database can be 180 MB): it goes once the restore it was for closes.
    private static void ForgetPicked()
    {
        try
        {
            if (Directory.Exists(PrimaSync.PickedFolder)) Directory.Delete(PrimaSync.PickedFolder, recursive: true);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
        }
    }

    // A copy held, chosen, ready to restore.
    private async Task ChooseHeld(SyncCopy kept)
    {
        await OpenRestore();
        chosen = found.FirstOrDefault(c => c.Held == kept.Held);
    }

    private async Task PickFolder()
    {
        note = null;
        try
        {
            var stores = await Picker.PickFolderAsync(CancellationToken.None);
            if (stores.Count == 0)
            {
                note = "No folder of copies chosen.";
                return;
            }
            var copies = new List<SyncCopy>();
            foreach (var store in stores) copies.AddRange(await Sync.FindCopiesAsync(store));
            if (copies.Count == 0) note = "No Prima backups found in that folder.";
            Add(copies);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException or NotSupportedException)
        {
            note = $"That folder couldn't be read: {e.Message}";
        }
    }

    private async Task PickFile()
    {
        note = null;
        try
        {
            if (await Picker.PickFileAsync(PrimaSync.PickedFolder, CancellationToken.None) is not { } path)
            {
                note = "No file chosen.";
                return;
            }
            if (await Sync.OpenFileAsync(path) is not { } copy)
            {
                note = "Choose a Prima export (.zip) or database (.db).";
                return;
            }
            Add([copy]);
            chosen = found.FirstOrDefault(c => c.Made == copy.Made && c.Size == copy.Size);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            note = $"That file couldn't be read: {e.Message}";
        }
    }

    // Copies found, newest first, each once (a folder chosen may hold this tablet's own).
    private void Add(IEnumerable<SyncCopy> copies) =>
        found = [.. found.Concat(copies.Where(c => !found.Any(f => f.Made == c.Made && f.Size == c.Size))).OrderByDescending(c => c.Made)];

    // Restores the copy chosen, keeping what's here first unless asked not to (once keeping it has failed).
    private async Task Restore(SyncCopy copy, bool keep)
    {
        try
        {
            await Sync.RestoreAsync(copy, keep);
        }
        catch (SyncKeepException)
        {
            // Nothing was restored: what's here couldn't be kept first, the status says why, and restoring without it is offered.
            unkept = copy;
            return;
        }
        catch (Exception)
        {
            // Nothing was restored, and the status says why: once a copy is in place the restore doesn't throw, whatever comes after.
            return;
        }
        // Everything is the copy's now: its settings and look, and every screen drawn afresh, opening where it says it's restored.
        await Store.LoadAsync(Options);
        await LookSetting.ReloadAsync();
        Nav.NavigateTo("settings?tab=app&section=data", forceLoad: true);
    }

    private async Task Export()
    {
        note = null;
        try
        {
            // The export before, if it's still in the cache, makes way.
            if (Directory.Exists(PrimaSync.ExportFolder)) Directory.Delete(PrimaSync.ExportFolder, recursive: true);
            var path = await Sync.ExportAsync(PrimaSync.ExportFolder);
            if (!await Files.OfferAsync(path, "Everything in Prima")) note = $"{Sync.Status.Message} On the tablet the share sheet opens to send it on; here it's in {path}.";
        }
        catch (Exception)
        {
            // The status says why.
        }
    }

    private async Task LetGo(SyncCopy kept)
    {
        note = null;
        try
        {
            await Sync.ReleaseHeldAsync(kept);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            note = $"Couldn’t remove backup protection. {e.Message}";
        }
    }

    // What a held copy was kept from before: an update, a restore, or something done to the data (Start over, Remove library, Reset
    // settings).
    private static string From(SyncHeld held) => held.From switch
    {
        SyncHeldFrom.Update => $"before the update to {held.Update}",
        SyncHeldFrom.Restore => "before a restore",
        _ => $"before {held.Why}",
    };

    // A held copy's head: what it was kept from before, and when it was taken.
    private static string Head(SyncCopy kept) => $"Backup {From(kept.Held!)} · {SyncText.When(kept.Made)}";

    // Why a held copy is kept, and until when.
    private static string Said(SyncCopy kept) => kept.Held!.From switch
    {
        SyncHeldFrom.Update => $"Prima found missing data after the update. {kept.Held.Why}.",
        _ => kept.Summary + ".",
    } + " This backup is protected until you restore it or remove protection.";

    // Where a copy is, and what it was kept from before when it's held.
    private static string Where(SyncCopy copy) => copy.Held is { } held ? $"{copy.Where} · {From(held)}" : copy.Where;

    // What a restore replaces: everything for a whole copy, the data file alone for a database on its own.
    private static string Replaced(SyncCopy copy) => copy.Manifest.Items.Count == 1 && copy.Manifest.Items[0].Kind == SyncItemKind.Database
        ? "This database backup replaces your settings, levels, practice history and routines."
        : "This backup replaces your settings, levels, practice history, routines and imported music.";

    public void Dispose()
    {
        Sync.Changed -= Changed;
        ForgetPicked();
    }
}
