@implements IDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject SessionRegistry Registry
@using Prima.Core.Practice
@using Prima.Core.Scoring

@*
    The play bar, the same on every screen that plays music to a tempo, so they all work and feel alike. In time: a count-in, the
    click that never waits, the cursor moving with the beat, each note marked as it's played, and the timing summed up after.
    Wait for me: no click; the cursor waits at each note or chord until its keys are played, a chord's together (played a key at
    a time, it's marked so and says "together"), a wrong key is marked where it was, and the pace is your own. Settings can take
    the moving cursor away, and the marks until the run ends. The mode is kept for
    each screen. The screen gives the music and its sheet, puts its own readouts in the bar, and gets the outcome. A screen can
    offer Listen too: the piano plays the music at the tempo, the click only counting in and the cursor moving with it, and
    nothing is judged, so you can hear how it goes or play along.
*@

<section class="reading-bar play-bar @BarClass" aria-label="Playing">
    @if (session is { Phase: Phase.CountIn })
    {
        <CountIn Session="session" />
    }
    @Readouts
    @* In portrait a piece's bar puts its run's controls on a row of their own, under its figures and keys. *@
    <span class="play-bar-break" aria-hidden="true"></span>
    @if (Running)
    {
        @if (Mode == PlayMode.InTime || listening)
        {
            <div class="mu-readout"><span class="mu-readout-label">@(listening ? "Listening" : "Tempo")</span><span class="mu-readout-value">@Tempo.ToString("0", CultureInfo.InvariantCulture)</span></div>
        }
        <div class="mu-readout"><span class="mu-readout-label">Bar</span><span class="mu-readout-value">@bar</span></div>
        @* Round a loop, the time round being played, and as each begins how the one before went, up or down on the one before
           that: In time the share right in time, Wait for me the notes right first time. Nothing stops for it, and nothing
           moves: it's in the bar. *@
        @if (loop is not null && !listening)
        {
            <div class="mu-readout"><span class="mu-readout-label">Pass</span><span class="mu-readout-value">@(passes.Count + 1)</span></div>
            @if (passes.Count > 0)
            {
                var (done, before) = (passes[^1], passes.Count > 1 ? passes[^2] : null);
                var (now, then) = done.RightInTime is { } share ? (share, before?.RightInTime) : (done.Right, before?.Right);
                var way = then is null || then == now ? "" : now > then ? " ↑" : " ↓";
                var low = done.RightInTime is { } inTime ? inTime < 0.8 : done.Right < done.Notes * 0.9;
                <div class="mu-readout @(low ? "miss" : "")"><span class="mu-readout-label">Last pass</span><span class="mu-readout-value">@(done.RightInTime is null ? $"{done.Right}/{done.Notes}" : $"{now * 100:0}%")@way</span></div>
            }
        }
        @if (OnBack.HasDelegate)
        {
            <button type="button" class="mu-btn" aria-label="Back a bar" @onclick="() => OnBack.InvokeAsync(bar)">‹ Bar</button>
        }
        @* Not the piano's go key: while a run plays, every key is music. *@
        <button type="button" class="mu-btn" @onclick="Stop">Stop</button>
    }
    else
    {
        @if (ShowResult && last?.InTime is { } timed)
        {
            <div class="mu-readout play-result @(timed.InTimeAccuracy < 0.8 ? "miss" : "")"><span class="mu-readout-label">Right in time</span><span class="mu-readout-value">@($"{timed.InTimeAccuracy * 100:0}%")</span></div>
        }
        else if (ShowResult && last?.Wait is { Notes: > 0 } waited)
        {
            <div class="mu-readout play-result @(waited.RightFirstTime < waited.Notes * 0.9 ? "miss" : "")"><span class="mu-readout-label">Right first time</span><span class="mu-readout-value">@waited.RightFirstTime/@waited.Notes</span></div>
        }
        <div class="play-mode" role="radiogroup" aria-label="How it follows you">
            <button type="button" role="radio" class="play-mode-option" aria-checked="@On(Mode == PlayMode.InTime)" @onclick="() => SetMode(PlayMode.InTime)">In time</button>
            <button type="button" role="radio" class="play-mode-option" aria-checked="@On(Mode == PlayMode.WaitForMe)" @onclick="() => SetMode(PlayMode.WaitForMe)">Wait for me</button>
        </div>
        @if (Mode == PlayMode.InTime)
        {
            @* The tempo as its figure; tapped, its − and + and a field to type it, under it. *@
            <div class="play-tempo-pick">
                <button type="button" class="mu-readout play-tempo-figure" aria-expanded="@On(tempoOpen)" aria-label="@($"Tempo {Tempo:0}: change it")" @onclick="() => tempoOpen = !tempoOpen">
                    <span class="mu-readout-label">Tempo</span><span class="mu-readout-value">@Tempo.ToString("0", CultureInfo.InvariantCulture)</span>
                </button>
                @if (tempoOpen)
                {
                    <div class="tempo-pop" role="dialog" aria-label="Tempo">
                        <input class="text-field tempo-entry" type="number" min="20" max="240" step="1" inputmode="numeric" aria-label="Tempo, to type" value="@Tempo.ToString("0", CultureInfo.InvariantCulture)" @onchange="TypedTempo" />
                        <TempoControl Value="Tempo" ValueChanged="TempoChanged" Figure="false" />
                        <button type="button" class="mu-btn" @onclick="() => tempoOpen = false">Done</button>
                    </div>
                }
            </div>
        }
        @if (ShowStart)
        {
            @* The key looks off when there's nothing it can start (no music yet, a set all played), and with no piano plugged in,
               when a tap says so under the bar: a run is played on the piano. *@
            <button type="button" class="mu-btn mu-primary @(CanStart && Keyboard.Name is not null ? "" : "mu-btn-off")" data-piano="go" disabled="@(!CanStart)" @onclick="StartPressed">@StartLabel</button>
        }
        @if (ShowListen)
        {
            @* The piano plays it, so it needs one that takes notes from the tablet: without one the key looks off, and a tap says
               why for a few seconds. *@
            var piano = Keyboard.CanSend && Settings.SendToPiano;
            <div class="play-listen">
                <button type="button" class="mu-btn @(piano ? "" : "mu-btn-off")" disabled="@(!CanStart)" aria-label="@(piano ? "Listen: the piano plays it" : "Listen: it needs the piano")"
                        @onclick="() => piano ? Listen() : ListenNeeds()">Listen</button>
                @if (listenNeeds is not null)
                {
                    <p class="tempo-pop play-why" role="status">@listenNeeds</p>
                }
            </div>
        }
        @if (startNeeds is not null)
        {
            <p class="tempo-pop play-why" role="status">@startNeeds</p>
        }
    }
</section>
@code {
    /// <summary>The screen, for keeping its mode: "library", "sight-read", "scales"…</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public PlayMusic? Music { get; set; }

    /// <summary>The sheet the music is on (asked for when a run starts, so it's there by then).</summary>
    [Parameter] public Func<Sheet?> SheetOf { get; set; } = () => null;

    [Parameter] public double Tempo { get; set; } = 72;

    [Parameter] public EventCallback<double> TempoChanged { get; set; }

    [Parameter] public string StartLabel { get; set; } = "Start";

    /// <summary>A class for the bar, for a screen that lays it out its own way.</summary>
    [Parameter] public string? BarClass { get; set; }

    /// <summary>The last run's headline figure in the bar, for a screen whose summary is out of sight below the music.</summary>
    [Parameter] public bool ShowResult { get; set; }

    [Parameter] public bool CanStart { get; set; } = true;

    /// <summary>Whether the bar has Start: a screen that starts its runs itself (Sight-read, after its look) can leave it off.</summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>What Start does on a screen that starts its runs itself with the music it's showing; otherwise Start runs Music.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    /// <summary>The screen's own figures, in the bar before the run's.</summary>
    [Parameter] public RenderFragment? Readouts { get; set; }

    /// <summary>Just before a run starts, for the screen to clear what the last one left.</summary>
    [Parameter] public EventCallback OnStarting { get; set; }

    [Parameter] public EventCallback<PlayOutcome> OnFinished { get; set; }

    [Parameter] public EventCallback<PlayMode> ModeChanged { get; set; }

    /// <summary>Back while a run plays, given the bar it's at: a screen that can start again from an earlier bar offers it.</summary>
    [Parameter] public EventCallback<int> OnBack { get; set; }

    /// <summary>Listen beside Start: the piano plays the music, its notes and its piano part (Duet's), with nothing judged.</summary>
    [Parameter] public bool ShowListen { get; set; }

    /// <summary>When Listen ends, played through or stopped; it has no outcome.</summary>
    [Parameter] public EventCallback OnListened { get; set; }

    /// <summary>
    /// A mode the screen asks for now (a scale's first run is in Wait for me): the bar is set to it while it's asked, and goes
    /// back to the screen's own when it no longer is. The mode can still be changed on the bar.
    /// </summary>
    [Parameter] public PlayMode? Ask { get; set; }

    public PlayMode Mode { get; private set; }

    public bool Running => session?.Phase is Phase.CountIn or Phase.Playing || wait is not null;

    /// <summary>Whether the run going is Listen's.</summary>
    public bool Listening => listening && Running;

    private PlaySession? session;
    private PlayOutcome? last;
    private WaitJudge? wait;
    private PlayMusic? playing;
    private Timer? ticker;
    private long? stoppedNs;
    private int bar;
    private bool listening;
    private Dictionary<string, Spelled> pitches = [];
    private Dictionary<string, ExpectedNote> notes = [];
    private readonly Dictionary<string, SheetMark> drawn = [];
    private readonly List<PlayedNote> heard = [];
    // The note with "together" over it: the top of a chord played a key at a time, in Wait for me.
    private string? hinted;
    // Round a loop: its first and last bars by number, the tick its first time round starts at and how many ticks each lasts, and
    // the passes played to their end so far.
    private (int From, int To)? loop;
    private long passFrom;
    private long passTicks;
    private readonly List<PiecePass> passes = [];
    // Wait for me's marks as the last pass played to its end left them, for the summary.
    private List<SheetMark> passMarks = [];
    // In time: whether the run goes anywhere at a tempo other than the one set (where its score marks another).
    private bool otherTempo;

    private string ModeKey => $"Play.Mode.{Name}";

    // The screen's own mode, as kept, and what was last asked for in its place.
    private PlayMode? kept;
    private PlayMode? asked;

    private bool tempoOpen;
    // What Listen needs, said under it when it's tapped without a piano that takes notes.
    private string? listenNeeds;
    // What a run needs, said under the bar when one is asked for with no piano plugged in.
    private string? startNeeds;

    private async Task TypedTempo(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var bpm)) await TempoChanged.InvokeAsync(Math.Clamp(Math.Round(bpm), 20, 240));
    }

    private static string On(bool on) => on ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        Keyboard.Received += Heard;
        Keyboard.Changed += Plugged;
        kept = (await Store.GetSettingsAsync()).GetValueOrDefault(ModeKey) == "wait" ? PlayMode.WaitForMe : PlayMode.InTime;
        (asked, Mode) = (Ask, Ask ?? kept.Value);
        await ModeChanged.InvokeAsync(Mode);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (kept is not { } own || Ask == asked) return;

        (asked, Mode) = (Ask, Ask ?? own);
        await ModeChanged.InvokeAsync(Mode);
    }

    private Task StartPressed() => Keyboard.Name is null ? StartNeeds() : OnStart.HasDelegate ? OnStart.InvokeAsync() : Start();

    // The piano plugged in or out: Start and Listen look as they can be used.
    private void Plugged() => _ = InvokeAsync(StateHasChanged);

    // A run is played on the piano. With none plugged in nothing starts, and the bar says so for a few seconds.
    private async Task StartNeeds()
    {
        startNeeds = "Plug in your keyboard first.";
        StateHasChanged();
        await Task.Delay(4000);
        startNeeds = null;
        StateHasChanged();
    }

    private async Task SetMode(PlayMode mode)
    {
        (Mode, kept) = (mode, mode);
        await Store.SetSettingAsync(ModeKey, mode == PlayMode.WaitForMe ? "wait" : "time");
        await ModeChanged.InvokeAsync(mode);
    }

    /// <summary>
    /// Starts a run in the chosen mode: the screen's Start, the piano's go key, or the screen itself with the music it's about to
    /// show (a parameter set in the same step wouldn't have reached here yet).
    /// </summary>
    public Task Start(PlayMusic? with = null) => Run(with, listen: false);

    /// <summary>
    /// Listen: the piano plays the music at the tempo, its notes and any piano part, after the count-in (the click only counts in),
    /// the cursor moving with it. Nothing is judged, so you can play along or only listen.
    /// </summary>
    public Task Listen(PlayMusic? with = null) => Run(with, listen: true);

    /// <summary>
    /// Starts again with other music (the piece from another bar) in place of the run going, which ends there with nothing of
    /// it judged, marked or kept: it's the same go at the piece, moved. Listen stays Listen.
    /// </summary>
    public async Task Restart(PlayMusic with)
    {
        var listen = Listening;
        session?.Stop();
        if (wait is not null) Registry.DrillAnswer = null;
        wait = null;
        await Run(with, listen);
    }

    private async Task ListenNeeds()
    {
        listenNeeds = Keyboard.Name is null ? "Listen plays it on your piano: plug in your keyboard."
            : !Keyboard.CanSend ? "Listen plays it on the piano, and this one doesn't take notes from the tablet."
            : "Listen plays it on your piano: turn Sound from the piano on in Settings.";
        StateHasChanged();
        await Task.Delay(4000);
        listenNeeds = null;
    }

    private async Task Run(PlayMusic? with, bool listen)
    {
        if (Running || (with ?? Music) is not { Notes.Count: > 0 }) return;
        if (!listen && Keyboard.Name is null)
        {
            _ = InvokeAsync(StartNeeds);
            return;
        }

        tempoOpen = false;
        await OnStarting.InvokeAsync();
        if ((with ?? Music) is not { Notes.Count: > 0 } music || SheetOf() is not { } sheet) return;

        // A run stopped to start again (back a bar) leaves nothing ticking.
        session?.Dispose();
        ticker?.Dispose();
        (session, wait, playing, stoppedNs, last, ticker, listening) = (null, null, music, null, null, null, listen);
        pitches = music.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).GroupBy(t => t.Id).ToDictionary(g => g.Key, g => g.First().Pitch);
        notes = music.Notes.ToDictionary(n => n.Id);
        drawn.Clear();
        heard.Clear();
        hinted = null;
        await sheet.ClearMarks();
        var first = music.Notes.MinBy(n => n.Tick)!;
        bar = first.Bar;
        // Every bar the run plays and when, a bar with nothing to play too: the bar the readout names, and the cursor's path.
        var bars = music.Score.BarTimes(music.Order ?? [.. Enumerable.Range(0, music.Score.Bars.Count)]);
        passes.Clear();
        (loop, passMarks) = (null, []);
        if (music.LoopBars is { } count && !listen)
        {
            loop = (music.Score.Bars[bars[0].Index].Number, music.Score.Bars[bars[count - 1].Index].Number);
            (passFrom, passTicks) = (bars[0].Start, bars.Take(count).Sum(b => b.Length));
        }

        if (Mode == PlayMode.WaitForMe && !listen)
        {
            var judge = wait = new WaitJudge(music.Notes, music.Ornamented, music.Rolled);
            // The preview's simulated player answers the step waited for: its keys, or a key beside its first.
            Registry.DrillAnswer = right => judge.Done ? [] : right ? [[.. judge.Current.Select(n => n.Midi)]] : [[judge.Current[0].Midi + 1]];
            StateHasChanged();
            // Read ahead's covers go: the cursor waits, so there's no time to keep ahead of.
            await sheet.StopCursor();
            await sheet.CursorAt(PlayMusic.SheetId(wait.Current[0].Id));
            return;
        }

        // In time: beats from the run's beat 0, the click's, with a pickup's before it. Listen gives the piano the notes as well as
        // any piano part, expects nothing, and hears the click only in the count-in.
        var from = music.FromTick / (double)music.BeatTicks;
        double Beat(ExpectedNote n) => n.Tick / (double)music.BeatTicks - from;
        bar = music.Score.Bars[bars[0].Index].Number;
        var timed = music.Notes.Select(n => (n.Midi, Beat(n), n.Length / (double)music.BeatTicks)).ToList();
        IReadOnlyList<(int Midi, double Beat, double Beats)>? piano = listen ? [.. timed, .. music.PianoPart ?? []] : music.PianoPart;
        var run = session = new PlaySession(Click, Keyboard, Clock, Registry);
        run.Changed += () => _ = InvokeAsync(async () =>
        {
            if (run.Phase == Phase.Done) await Ended(run);
            else StateHasChanged();
        });
        // The click's beats are the music's own: each bar's by its metre, each as long as the score's tempo there says, the tempo
        // set being the one it mostly goes at. The count-in has the first bar's metre and tempo.
        var beats = music.Score.RunBeats(music.Order ?? [.. Enumerable.Range(0, music.Score.Bars.Count)], music.FromTick, Tempo);
        var opening = music.Score.WithSignatures().ElementAt(bars.First(b => b.Start >= music.FromTick).Index).Meter;
        var countInNs = beats[0].Ns / (beats[0].Beats * music.BeatTicks) * opening.BeatTicks;
        var stage = listen ? ClickStage.CountInOnly : ClickStage.Throughout;
        var plan = new ClickPlan(60e9 / countInNs, opening.Beats, Math.Max(1, Settings.CountInBars), stage) { Music = beats };
        otherTempo = beats.Any(b => Math.Abs(b.Ns / b.Beats - 60e9 / Tempo) > 1e3);
        run.Start(plan, timed.Max(e => e.Item2 + e.Item3), listen ? [] : timed, piano, Settings.TimingOffsetMs);
        // Each note judged as it's played and marked at once; the summary's marks replace these.
        var (timeAt, heardAt) = Judged(run, music);
        var live = listen ? null : new LiveJudge(music.Notes, timeAt, music.BeatTicks, 60e9 / Tempo, Settings.TimingOffsetMs, music.Ornamented, music.Rolled);
        if (live is not null) run.KeyDown += (key, at) => _ = InvokeAsync(() => Draw(live.Play(key, heardAt(at)) is { } mark ? [mark] : []));
        ticker = new Timer(_ => _ = InvokeAsync(async () =>
        {
            var now = Clock.NowNs;
            var at = music.Score.Bars[bars.LastOrDefault(b => run.TimeAt(b.Start / (double)music.BeatTicks - from) <= now, bars[0]).Index].Number;
            if (at != bar)
            {
                bar = at;
                StateHasChanged();
            }
            if (live is not null) await Draw(live.Due(heardAt(now)));
            // Round a loop, a time round is scored once the next has begun and a late key for its last note has had its chance.
            var next = passFrom + (passes.Count + 1) * passTicks;
            if (loop is null || live is null || now - Settings.TimingOffsetMs * 1e6 < run.TimeAt(next / (double)music.BeatTicks - from) + Grading.WindowNs(60e9 / Tempo)) return;

            var pass = Pass(music, run, passes.Count, expression: false);
            passes.Add(new PiecePass(pass.Right, pass.Expected, pass.InTimeAccuracy));
            StateHasChanged();
        }), null, 100, 100);
        StateHasChanged();
        // The cursor once the click's beat times are set: waiting where the music starts through the count-in, then with the beat
        // along the run's own path, so it goes back at a repeat as the notes do. The path is each of the run's bars, with the
        // quarter it starts at and how many it lasts, and what's printed in them: each note and rest, both hands', with its
        // quarters from its bar's start. So the cursor keeps the beat through rests and through bars the hand played has nothing in.
        await Task.Delay(50);
        var printed = bars.Select(b => b.Index).Distinct().SelectMany(index => music.Score.Bars[index].Voices.SelectMany(v => v.Events).SelectMany(e => e switch
        {
            Notes { Grace: false } n => [(index, n.Tones[0].Id, n.Start / (double)Ticks.Quarter)],
            Rest { Hidden: false } r => [(index, r.Id, r.Start / (double)Ticks.Quarter)],
            _ => Array.Empty<(int, string, double)>(),
        }));
        var path = new CursorPath([.. bars.Select(b => (b.Index, music.QuarterOf(b.Start), b.Length / (double)Ticks.Quarter))], [.. printed]);
        // Where the tempo isn't the one set, the cursor keeps to the beats: each one's quarter, and when it's due after the run's
        // beat 0, and the last one's end.
        List<(double Quarter, double Ms)>? times = null;
        if (otherTempo)
        {
            times = [];
            var ms = 0.0;
            foreach (var b in beats)
            {
                times.Add((music.QuarterOf(music.FromTick + (long)Math.Round(b.At * music.BeatTicks)), ms));
                ms += b.Ns / 1e6;
            }
            times.Add((music.QuarterOf(music.FromTick + (long)Math.Round((beats[^1].At + beats[^1].Beats) * music.BeatTicks)), ms));
        }
        var msPerQuarter = 60_000 / Tempo * Ticks.Quarter / music.BeatTicks;
        await sheet.StartCursor(run.MsUntil(Beat(first)), msPerQuarter, music.QuarterOf(first.Tick), plan.BeatNs / 1e6, run.MsUntil(0), music.ReadAheadQuarters, path, Settings.Cursor, times);
    }

    /// <summary>Ends the run where it is: In time scores what was due by now, Wait for me what was reached.</summary>
    public async Task Stop()
    {
        if (wait is not null)
        {
            await EndWait(true);
            return;
        }
        if (session is not { Phase: Phase.CountIn or Phase.Playing } run) return;

        stoppedNs = Clock.NowNs;
        run.Finish();
    }

    private async Task Ended(PlaySession run)
    {
        if (run != session || playing is not { } music) return;

        ticker?.Dispose();
        ticker = null;
        var sheet = SheetOf();
        if (sheet is not null) await sheet.StopCursor();
        if (listening)
        {
            listening = false;
            StateHasChanged();
            await OnListened.InvokeAsync();
            return;
        }

        var from = music.FromTick / (double)music.BeatTicks;
        var beatNs = 60e9 / Tempo;
        // Stopped early, only the notes due by the last key played count, and none after the stop. What was due between that key
        // and Stop wasn't played wrong: the hands had left the keys to press it. With no key played, nothing counts. A loop left
        // to run its course is the same: its times round after the last key weren't played.
        var lastKey = run.Played.Count == 0 ? long.MinValue : (long)(run.Played.Max(p => p.OnNs) - Settings.TimingOffsetMs * 1e6 + Grading.WindowNs(beatNs));
        var until = stoppedNs is { } at ? Math.Min(at, lastKey) : loop is not null ? lastKey : long.MaxValue;
        var due = until == long.MaxValue ? music.Notes : music.Notes.Where(n => run.TimeAt(n.Tick / (double)music.BeatTicks - from) <= until).ToList();
        // Expression too, where the music marks it: loudness on your own soft-to-loud range when it's been measured.
        (int, int)? range = Settings is { SoftVelocity: { } soft, LoudVelocity: { } loud } ? (soft, loud) : null;
        var (timeAt, heardAt) = Judged(run, music);
        var played = run.Played.Select(p => p with { OnNs = heardAt(p.OnNs), OffNs = heardAt(p.OffNs) }).ToList();
        var damper = run.Damper.Select(d => (heardAt(d.DownNs), heardAt(d.UpNs))).ToList();
        var result = due.Count == 0 ? null : PassageScorer.Score(due, timeAt, music.BeatTicks, beatNs, beatNs * music.Score.Meter.Beats, played, Settings.TimingOffsetMs, music.Ornamented, damper,
            Markings.Of(music.Score, due), range, music.Rolled);
        // Round a loop, each time round played to its end is a pass, scored by itself: one whose last note is among those that
        // count. Any the run hadn't scored yet are now, any it scored after the last key was played go, and the run's result is
        // the last pass's, which is how the loop stood when it was left. Stopped in its first time round, the result is what was
        // played of that.
        if (loop is not null && due.Count > 0)
        {
            var (reached, lastOfFirst) = (due.Max(n => n.Tick), music.Notes.Where(n => n.Tick < passFrom + passTicks).Max(n => n.Tick));
            var whole = reached < lastOfFirst ? 0 : (int)((reached - lastOfFirst) / passTicks) + 1;
            passes.RemoveRange(Math.Min(whole, passes.Count), Math.Max(0, passes.Count - whole));
            while (passes.Count < whole)
            {
                var pass = Pass(music, run, passes.Count, expression: false);
                passes.Add(new PiecePass(pass.Right, pass.Expected, pass.InTimeAccuracy));
            }
            if (whole > 0) result = Pass(music, run, whole - 1, expression: true);
        }
        if (result is not null && sheet is not null)
        {
            await sheet.ShowMarks(result.Notes.Select(n => n.Outcome switch
            {
                Outcome.Wrong when n.Played is { } key => MarkOf(music, n.Id, LiveKind.Wrong, key, 0),
                Outcome.Missed => MarkOf(music, n.Id, LiveKind.Missed, null, 0),
                _ when n.Band == Band.Off => MarkOf(music, n.Id, n.ErrorPercent < 0 ? LiveKind.Early : LiveKind.Late, null, n.ErrorPercent ?? 0),
                _ => MarkOf(music, n.Id, LiveKind.Right, null, 0),
            }));
        }
        last = new PlayOutcome(PlayMode.InTime, result, null, run.Played, stoppedNs is not null, bar) { TimeAt = b => run.TimeAt(b - from), Loop = loop, Passes = [.. passes] };
        StateHasChanged();
        await OnFinished.InvokeAsync(last);
    }

    // One time round a loop scored by itself: its notes against the keys played for them, those still down too. Its keys start
    // half a window before its first note, as any passage's do, and end half a window before the next time round's first, so
    // the next one's first keys aren't extra here. With its expression, for the summary; without, for the bar while the loop
    // goes on.
    private PassageResult Pass(PlayMusic music, PlaySession run, int index, bool expression)
    {
        var (from, beatNs, start) = (music.FromTick / (double)music.BeatTicks, 60e9 / Tempo, passFrom + index * passTicks);
        var notes = music.Notes.Where(n => n.Tick >= start && n.Tick < start + passTicks).ToList();
        var nextFirst = run.TimeAt((notes.Min(n => n.Tick) + passTicks) / (double)music.BeatTicks - from);
        var until = nextFirst - Grading.WindowNs(beatNs) / 2 + Settings.TimingOffsetMs * 1e6;
        var (timeAt, heardAt) = Judged(run, music);
        var played = run.PlayedSoFar(Clock.NowNs).Where(p => p.OnNs < until);
        var keys = played.Select(p => p with { OnNs = heardAt(p.OnNs), OffNs = heardAt(p.OffNs) }).ToList();
        var damper = run.Damper.Select(d => (heardAt(d.DownNs), heardAt(d.UpNs))).ToList();
        (int, int)? range = expression && Settings is { SoftVelocity: { } soft, LoudVelocity: { } loud } ? (soft, loud) : null;
        return PassageScorer.Score(notes, timeAt, music.BeatTicks, beatNs, beatNs * music.Score.Meter.Beats, keys, Settings.TimingOffsetMs, music.Ornamented, damper,
            expression ? Markings.Of(music.Score, notes) : null, range, music.Rolled);
    }

    // When the music's moments were due and when a key came, as a run is judged: the click's, or where the score marks a tempo
    // other than the one set, as though the run went at that one throughout, each moment, the music's and the keys', moved to where
    // it'd be at that tempo. So a note's timing is a share of the beat it was played in, and a beat's window one of it, whatever
    // the tempo there.
    private (Func<double, long> TimeAt, Func<long, long> HeardAt) Judged(PlaySession run, PlayMusic music)
    {
        var from = music.FromTick / (double)music.BeatTicks;
        if (!otherTempo) return (b => run.TimeAt(b - from), t => t);

        var (beatNs, offsetNs) = (60e9 / Tempo, (long)(Settings.TimingOffsetMs * 1e6));
        Func<double, long> timeAt = b => run.TimeAt(0) + (long)((b - from) * beatNs);
        Func<long, long> heardAt = t => run.TimeAt(0) + (long)(run.MusicBeatAt(t - offsetNs) * beatNs) + offsetNs;
        return (timeAt, heardAt);
    }

    // Wait for me: each key judged, marked, and the cursor moved on once a step's keys are all down together.
    private void Heard(MidiEvent e)
    {
        if (wait is null || e.Kind != MidiKind.NoteOn) return;

        _ = InvokeAsync(async () =>
        {
            if (wait is not { } judge) return;

            heard.Add(new PlayedNote(e.Note, e.TimeNs, e.TimeNs, e.Velocity));
            var (marks, moved) = judge.Play(e.Note, e.TimeNs);
            await Draw(marks);
            // A chord played a key at a time has "together" over its top note until it's played so (a chord marked to be rolled,
            // "in one roll"). That's what to do next, not how a note went, so it shows whatever Settings says of the marks.
            var word = judge.Apart ? PlayMusic.SheetId(judge.Current.MaxBy(n => n.Midi)!.Id) : null;
            if ((word ?? hinted) is not null && SheetOf() is { } paper)
            {
                List<SheetMark> hints = hinted is not null && hinted != word ? [new SheetMark(hinted, "hint")] : [];
                if (word is not null) hints.Add(new SheetMark(word, "hint", judge.Rolling ? "in one roll" : "together"));
                await paper.MarkLive(hints);
                hinted = word;
            }
            if (!moved) return;
            // Round a loop, a step in the next time round means the one before it was played to its end: a pass, its marks as they
            // stand all its own.
            while (loop is not null && (judge.Done || judge.Current[0].Tick >= passFrom + (passes.Count + 1) * passTicks))
            {
                var pass = judge.Stretch(passFrom + passes.Count * passTicks, passFrom + (passes.Count + 1) * passTicks);
                passes.Add(new PiecePass(pass.RightFirstTime, pass.Notes, null));
                passMarks = [.. drawn.Values];
                if (judge.Done) break;
            }
            if (judge.Done)
            {
                await EndWait(false);
                return;
            }

            bar = judge.Current[0].Bar;
            StateHasChanged();
            if (SheetOf() is { } sheet) await sheet.CursorAt(PlayMusic.SheetId(judge.Current[0].Id));
        });
    }

    private async Task EndWait(bool stopped)
    {
        if (wait is not { } judge) return;

        wait = null;
        Registry.DrillAnswer = null;
        // Round a loop, the run is its last time round played to its end, with that pass's marks, as In time's is. Stopped in its
        // first time round, it's what was played of that.
        long? lastPass = loop is not null && passes.Count > 0 ? passFrom + (passes.Count - 1) * passTicks : null;
        if (SheetOf() is { } sheet)
        {
            await sheet.StopCursor();
            // Kept as the summary's, so they stay through a redraw.
            await sheet.ShowMarks(lastPass is null ? [.. drawn.Values] : passMarks);
        }
        var result = lastPass is { } start ? judge.Stretch(start, start + passTicks) : judge.Result();
        last = new PlayOutcome(PlayMode.WaitForMe, null, result, [.. heard], stopped, bar) { Loop = loop, Passes = [.. passes] };
        StateHasChanged();
        await OnFinished.InvokeAsync(last);
    }

    private async Task Draw(IReadOnlyList<LiveMark> marks)
    {
        if (marks.Count == 0 || playing is not { } music || SheetOf() is not { } sheet) return;

        var shown = marks.Select(m => MarkOf(music, m.Id, m.Kind, m.Played, m.ErrorPercent)).ToList();
        foreach (var mark in shown) drawn[mark.Id] = mark;
        // With the marks as you play off, they're kept all the same and shown when the run ends.
        if (Settings.LiveMarks) await sheet.MarkLive(shown);
    }

    // A note's mark on the sheet. A wrong one shows the key played, a red head that many staff positions from the written one,
    // which turns grey, each named; an early or late one when it was played, a ring on its line. A note played again (a repeat)
    // marks the same note on the sheet, the latest time through.
    private SheetMark MarkOf(PlayMusic music, string id, LiveKind kind, int? key, double errorPercent)
    {
        var name = kind.ToString().ToLowerInvariant();
        var sheetId = PlayMusic.SheetId(id);
        if (kind == LiveKind.Wrong && key is { } played && pitches.TryGetValue(sheetId, out var written))
        {
            var spelled = music.Score.Key.Spell(played);
            return new SheetMark(sheetId, name, spelled.ToString(), spelled.Diatonic - written.Diatonic, Written: written.ToString());
        }
        return kind is LiveKind.Early or LiveKind.Late && notes.TryGetValue(id, out var note)
            ? new SheetMark(sheetId, name, Quarter: music.QuarterOf(note.Tick) + errorPercent / 100 * music.BeatTicks / Ticks.Quarter)
            : new SheetMark(sheetId, name);
    }

    public void Dispose()
    {
        Keyboard.Received -= Heard;
        Keyboard.Changed -= Plugged;
        if (wait is not null) Registry.DrillAnswer = null;
        ticker?.Dispose();
        session?.Dispose();
    }
}
