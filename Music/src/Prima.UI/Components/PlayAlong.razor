@implements IDisposable
@inject PrimaStore Store
@inject PrimaSettings Settings
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject SessionRegistry Registry
@inject PracticeLifecycle Lifecycle
@using Prima.Core.Practice
@using Prima.Core.Scoring

@*
    The play bar, the same on every screen that plays music, so they all work and feel alike: the one engine they all use, under
    the music, near the hands, with the screen's foot under it. Its keys are in the same places on every screen: first the
    screen's own (a piece's page turns), then More, which opens the rest (PlayMore: the click, the music's view and marks, the
    screen's own), and full screen's key while the head is gone; then what every run needs: the hands (Left, Right or Both), the
    mode, the tempo, Loop, Listen and Play. A screen says which it has; it doesn't draw them. In time: a count-in, the click that
    never waits, the cursor moving with the beat, each note marked as it's played, and the timing summed up after. Wait for me:
    no click; the cursor waits at each note or chord until its keys are played, a chord's together (played a key at a time, it's
    marked so and says "together"), a wrong key is marked where it was, and the pace is your own. Settings can take the moving
    cursor away, and the marks until the run ends. The mode is kept for each screen. The screen gives the music and its sheet
    and gets the outcome; how the run went is the screen's review, between the music and the bar. Listen: the piano plays the
    music at the tempo, the click only counting in and the cursor moving with it, and nothing is judged, so you can hear how it
    goes or play along.
*@

@* While a run plays (its count-in too) the bar says so, and nothing new moves on the screen (prima.css, Motion); and from a slip
   until the run counts in again, that it's been cut there. *@
<section class="reading-bar play-bar piece-bar @BarClass" aria-label="Playing" data-running="@(Running || moving)" data-cut="@(cut is not null ? "" : null)">
    @if (session is { Phase: Phase.CountIn })
    {
        <CountIn Session="session" />
    }
    @Readouts
    @* The screen's own keys, More, and full screen's key while the head is gone: every bar's start, PlayTools. *@
    <PlayTools Extra="Tools" ShowMore="ShowMore" Running="Running" Metronome="HasMetronome" Ticking="@(ticking is not null)" OnClickAlone="ToggleMetronome" OnClickChanged="ClickChanged"
               Marks="@(ShowMarks && !Bare)" Music="MoreMusic" ShowFullScreen="ShowFullScreen" OnFullScreen="OnFullScreen">@More</PlayTools>
    <span class="play-bar-gap" aria-hidden="true"></span>
    @if (Running || moving)
    {
        @if (Mode == PlayMode.InTime || listening || HasMetronome)
        {
            <div class="mu-readout"><span class="mu-readout-label">@(listening ? "Listening" : "Tempo")</span><span class="mu-readout-value">@Tempo.ToString("0", CultureInfo.InvariantCulture)</span></div>
        }
        <div class="mu-readout" data-explain="bar-now"><span class="mu-readout-label">Bar</span><span class="mu-readout-value">@bar</span></div>
        @if (ShowTime)
        {
            <div class="mu-readout"><span class="mu-readout-label">Time</span><span class="mu-readout-value">@($"{seconds / 60}:{seconds % 60:00}")</span></div>
        }
        @* Round a loop, the time round being played, and (unless it's not wanted) as each begins how the one before went, up or
           down on the one before that: In time the share right in time, Wait for me the notes right first time. Nothing stops for
           it, and nothing moves: it's in the bar. A loop that waits after each pass counts on from its passes before this run,
           those played in this mode. Runs going again by themselves (Again) are counted the same, once one has been played. *@
        var earlier = EarlierPasses.Where(p => (p.RightInTime is null) == (Mode == PlayMode.WaitForMe));
        List<PiecePass>? all = listening ? null : loop is not null ? [.. earlier, .. passes] : runs.Count > 0 ? runs : null;
        @if (all is not null)
        {
            <div class="mu-readout" data-explain="pass"><span class="mu-readout-label">@(loop is not null ? "Pass" : "Run")</span><span class="mu-readout-value">@(all.Count + 1)</span></div>
            @if (all.Count > 0 && ShowPassFigure)
            {
                var (done, before) = (all[^1], all.Count > 1 ? all[^2] : null);
                var (now, then) = done.RightInTime is { } share ? (share, before?.RightInTime) : (done.Right, before?.Right);
                var way = then is null || then == now ? "" : now > then ? " ↑" : " ↓";
                var low = done.RightInTime is { } inTime ? inTime < 0.8 : done.Right < done.Notes * 0.9;
                <div class="mu-readout @(low ? "miss" : "")" data-explain="last-pass"><span class="mu-readout-label">@(loop is not null ? "Last pass" : "Last run")</span><span class="mu-readout-value">@(done.RightInTime is null ? $"{done.Right}/{done.Notes}" : $"{now * 100:0}%")@way</span></div>
            }
        }
        @if (Streak is { Of: > 0 } streak)
        {
            @* Clean times round in a row (Lock in's, Practice it's): a dot each, lit as they come, all put out by a slip. *@
            <div class="mu-readout play-streak" role="img" data-explain="streak" aria-label="@($"{streak.Clean} of {streak.Of} clean in a row")">
                <span class="mu-readout-label">In a row</span>
                <span class="mu-readout-value play-streak-dots">
                    @for (var i = 0; i < streak.Of; i++)
                    {
                        <span class="play-streak-dot @(i < streak.Clean ? "on" : null)"></span>
                    }
                </span>
            </div>
        }
        <span class="play-bar-gap play-bar-gap-portrait" aria-hidden="true"></span>
        @if (OnBack.HasDelegate)
        {
            <button type="button" class="mu-btn" aria-label="Back a bar" data-explain="bar-back" @onclick="() => OnBack.InvokeAsync(bar)">‹ Bar</button>
        }
        @* Not the piano's go key: while a run plays, every key is music. *@
        <button type="button" class="mu-btn" data-explain="stop" @onclick="Stop">Stop</button>
        @if (Saying is { } said)
        {
            <p class="tempo-pop play-why play-saying" role="status">@said</p>
        }
    }
    else
    {
        @* The tempo as its figure; tapped, its − and +, a field to type it, and the music's own tempo once it's been changed, to
           go back to. With a metronome it's shown whatever the mode, since the metronome goes at it. *@
        RenderFragment tempoPick = @<div class="play-tempo-pick">
            <button type="button" class="mu-readout play-tempo-figure" data-piano="off" data-explain="tempo" aria-expanded="@On(tempoOpen)" aria-label="@($"Tempo {Tempo:0}: change it")" @onclick="() => tempoOpen = !tempoOpen">
                <span class="mu-readout-label">Tempo</span><span class="mu-readout-value">@Tempo.ToString("0", CultureInfo.InvariantCulture)</span>
            </button>
            @if (tempoOpen)
            {
                <div class="tempo-pop" role="dialog" aria-label="Tempo">
                    <input class="text-field tempo-entry" type="number" min="20" max="240" step="1" inputmode="numeric" aria-label="Tempo, to type" value="@Tempo.ToString("0", CultureInfo.InvariantCulture)" @onchange="TypedTempo" />
                    <TempoControl Value="Tempo" ValueChanged="TempoChanged" Figure="false" />
                    @if (OriginalTempo is { } original && Math.Round(original) != Math.Round(Tempo))
                    {
                        <button type="button" class="mu-btn play-tempo-original" data-piano="off" aria-label="@($"Back to the music's own tempo, {original:0}")" @onclick="() => TempoChanged.InvokeAsync(Math.Round(original))">Original @original.ToString("0", CultureInfo.InvariantCulture)</button>
                    }
                    <button type="button" class="mu-btn" @onclick="() => tempoOpen = false">Done</button>
                </div>
            }
        </div>;
        @if (Hands is { Count: > 1 } offered)
        {
            <HandsChoice Offered="offered" Value="Hand" ValueChanged="HandChanged" />
            @* In portrait the run's other controls go on a row of their own, under More and the hands. *@
            <span class="play-bar-break" aria-hidden="true"></span>
        }
        @if (ShowMode)
        {
            <div class="play-mode" role="radiogroup" aria-label="Practice mode" data-explain="mode">
                <button type="button" role="radio" class="play-mode-option" data-mode="time" aria-checked="@On(Mode == PlayMode.InTime)" @onclick="() => SetMode(PlayMode.InTime)">Timed</button>
                <button type="button" role="radio" class="play-mode-option" data-mode="wait" aria-checked="@On(Mode == PlayMode.WaitForMe)" @onclick="() => SetMode(PlayMode.WaitForMe)">Wait for notes</button>
            </div>
        }
        @if (HasMetronome || Mode == PlayMode.InTime)
        {
            @tempoPick
        }
        @if (Loop is { } kept)
        {
            @* The screen's own loop (a piece's bars): lit as it says, and a tap asks it. *@
            <LoopKey On="kept" Changed="OnLoop" OnLabel="@LoopOnLabel" OffLabel="@LoopOffLabel" />
        }
        else if (ShowLoop)
        {
            @* Loop: lit, a run goes round and round until Stop, the music's bars that go round (an exercise's without its close)
               again and again, each time round a pass. Kept for the screen, as the mode is. *@
            <LoopKey On="Looping" Changed="SetLoop" OnLabel="Loop: on. It goes round until you stop it" OffLabel="Loop: off. It plays once through" />
        }
        <span class="play-bar-gap play-bar-gap-portrait" aria-hidden="true"></span>
        @if (ShowListen)
        {
            @* The piano plays it, so it needs one that takes notes from the tablet: without one the key looks off, and a tap says
               why for a few seconds. *@
            var piano = Keyboard.CanSend && Settings.SendToPiano;
            <div class="play-listen">
                <button type="button" class="mu-btn @(piano ? "" : "mu-btn-off")" data-piano="off" data-explain="listen" disabled="@(!CanStart)" aria-label="@(piano ? "Listen: the piano plays it" : "Listen: it needs the piano")"
                        @onclick="() => piano ? Listen() : ListenNeeds()">Listen</button>
                @if (listenNeeds is not null)
                {
                    <p class="tempo-pop play-why" role="status">@listenNeeds</p>
                }
            </div>
        }
        @if (ShowStart)
        {
            @* The key looks off when there's nothing it can start (no music yet, a set all played), and with no piano plugged in,
               when a tap says so over the bar: a run is played on the piano. *@
            <button type="button" class="mu-btn mu-primary play-start @(CanStart && Keyboard.Name is not null ? "" : "mu-btn-off")" data-piano="go" data-explain="play" disabled="@(!CanStart)" @onclick="StartPressed">@StartLabel</button>
        }
        @RunKeys
        @if (startNeeds is not null)
        {
            <p class="tempo-pop play-why" role="status">@startNeeds</p>
        }
    }
</section>
@code {
    /// <summary>The screen, for keeping its mode: "library", "sight-read", "scales"…</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public PlayMusic? Music { get; set; }

    /// <summary>The sheet the music is on (asked for when a run starts, so it's there by then).</summary>
    [Parameter] public Func<Sheet?> SheetOf { get; set; } = () => null;

    [Parameter] public double Tempo { get; set; } = 72;

    [Parameter] public EventCallback<double> TempoChanged { get; set; }

    [Parameter] public string StartLabel { get; set; } = "Start";

    /// <summary>A class for the bar, for a screen that lays it out its own way.</summary>
    [Parameter] public string? BarClass { get; set; }

    [Parameter] public bool CanStart { get; set; } = true;

    /// <summary>Whether the bar has Start: a screen that starts its runs itself (Sight-read, after its look) can leave it off.</summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>What Start does on a screen that starts its runs itself with the music it's showing; otherwise Start runs Music.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    /// <summary>
    /// The screen's own, first in the bar: what goes with its runs and has nowhere else in full screen (a piece's Finish practice
    /// there, Sight-read's look).
    /// </summary>
    [Parameter] public RenderFragment? Readouts { get; set; }

    /// <summary>The hands to choose from on the bar, Left, Right and Both, where there are two or more; none, the music's own.</summary>
    [Parameter] public IReadOnlyList<Prima.Core.Generation.HandUse>? Hands { get; set; }

    /// <summary>The hand or hands chosen.</summary>
    [Parameter] public Prima.Core.Generation.HandUse Hand { get; set; }

    [Parameter] public EventCallback<Prima.Core.Generation.HandUse> HandChanged { get; set; }

    /// <summary>Just before a run starts, for the screen to clear what the last one left.</summary>
    [Parameter] public EventCallback OnStarting { get; set; }

    [Parameter] public EventCallback<PlayOutcome> OnFinished { get; set; }
    [Parameter] public EventCallback OnPracticeStarting { get; set; }

    /// <summary>For an explicitly generated rhythm exercise, grade taps independently of the key played.</summary>
    [Parameter] public bool RhythmOnly { get; set; }

    [Parameter] public EventCallback<PlayMode> ModeChanged { get; set; }

    /// <summary>Back while a run plays, given the bar it's at: a screen that can start again from an earlier bar offers it.</summary>
    [Parameter] public EventCallback<int> OnBack { get; set; }

    /// <summary>
    /// A slip stops the run (Back a bar, Lock in). In time, the first note heard wrong or missed as it's played stops it there: the
    /// click at once (a moment after a wrong key, for the rest of its chord), its mark staying on the music whatever Settings say.
    /// The screen is given what was played up to the slip, as a run stopped there, and gives back the music to count in again with
    /// a moment later, the same go at the piece; or none, and the run ends at the slip. The screen's own <see cref="Cut"/> asks it
    /// the same. Null: a slip is played through, as it always was.
    /// </summary>
    [Parameter] public Func<PlayOutcome, Task<PlayMusic?>>? OnSlip { get; set; }

    /// <summary>Round a loop In time, each time round as it's scored while the run goes on, for a screen counting clean ones.</summary>
    [Parameter] public EventCallback<PiecePass> OnPass { get; set; }

    /// <summary>Clean times round in a row so far and how many are wanted: dots among the run's readouts while it plays.</summary>
    [Parameter] public (int Clean, int Of)? Streak { get; set; }

    /// <summary>A line over the bar's end while a run plays, from the screen: what Lock in is doing ("Bars 13–15 until 7 clean in a row").</summary>
    [Parameter] public string? Saying { get; set; }

    /// <summary>How long a run cut at a slip waits, the click stopped, before it counts in again: a moment to see the slip.</summary>
    [Parameter] public TimeSpan CutPause { get; set; } = TimeSpan.FromSeconds(1);

    /// <summary>Whether the run starting is the same go counted in again after a cut (a slip), not one started anew.</summary>
    public bool Continuing { get; private set; }

    /// <summary>Listen beside Start: the piano plays the music, its notes and its piano part (Duet's), with nothing judged.</summary>
    [Parameter] public bool ShowListen { get; set; }

    /// <summary>In time and Wait for me on the bar, to choose between; off, the mode is the one asked for (<see cref="Ask"/>).</summary>
    [Parameter] public bool ShowMode { get; set; } = true;

    /// <summary>Round a loop, the last pass's figure in the bar beside the pass being played.</summary>
    [Parameter] public bool ShowPassFigure { get; set; } = true;

    /// <summary>
    /// Round and round, as a routine's activity is: a run played to its end is kept and starts again by itself (In time after its
    /// count-in) until Stop, and the bar counts the runs and says how the last went, up or down on the one before.
    /// </summary>
    [Parameter] public bool Again { get; set; }

    /// <summary>When a key-rotation routine continues, take the next key's score after saving the finished run.</summary>
    [Parameter] public Func<PlayMusic?>? NextMusic { get; set; }

    /// <summary>
    /// Loop on the bar. Lit, a run doesn't end: the music's bars that go round (<see cref="PlayMusic.Round"/>: an exercise's
    /// without its close, or all of them) are played again and again until Stop, In time without a break and with no count-in
    /// after the first, each time round a pass the bar counts and scores. Listen still plays the music once. Kept for each
    /// screen, like the mode. A screen with a loop of its own (a piece's, on its bars) gives that instead (<see cref="Loop"/>).
    /// </summary>
    [Parameter] public bool ShowLoop { get; set; }

    /// <summary>
    /// A loop the screen keeps itself, on its music (a piece's chosen bars): Loop on the bar lit as it says, a tap asking
    /// <see cref="OnLoop"/> with what it's to be. The bar's own Loop is off then: the screen's music goes round already.
    /// </summary>
    [Parameter] public bool? Loop { get; set; }

    [Parameter] public EventCallback<bool> OnLoop { get; set; }

    /// <summary>What the screen's own Loop says to a screen reader, lit and not.</summary>
    [Parameter] public string LoopOnLabel { get; set; } = "Loop: on";

    [Parameter] public string LoopOffLabel { get; set; } = "Loop: off";

    /// <summary>Loop as it's read when the bar opens, and each time it's turned on or off: for a screen that prints the repeat's signs.</summary>
    [Parameter] public EventCallback<bool> LoopChanged { get; set; }

    /// <summary>Whether Loop is on.</summary>
    public bool Looping { get; private set; }

    /// <summary>
    /// The metronome, on every bar unless a screen has no use for one (a piece's Play): its key, before the tempo, starts and stops
    /// a click at the tempo, accented on each bar's first beat by the music's metre where it starts, with nothing judged, to play
    /// to as you like, from More, with its settings. The tempo shows then in either mode. A run, leaving, or Prima put away stops it.
    /// </summary>
    [Parameter] public bool Metronome { get; set; } = true;

    /// <summary>
    /// The beats in a bar, for the metronome on a bar with no music to go by: a PDF's print, which scrolls at the tempo by the
    /// beats it's given.
    /// </summary>
    [Parameter] public int? Beats { get; set; }

    /// <summary>A screen's own keys at the end of the run's, where Start would be: a PDF's Scroll and Convert to notation.</summary>
    [Parameter] public RenderFragment? RunKeys { get; set; }

    // The metronome where there's music, or beats, for it to go by (a screen that starts its runs with music of its own has none).
    private bool HasMetronome => Metronome && BarBeats() is not null;

    // The beats a bar the metronome counts: the music's metre where it starts, or the beats given.
    private int? BarBeats() => Music is { } music ? OpeningMeter(music).Beats : Beats;

    /// <summary>More, at the bar's start (<see cref="PlayMore"/>): off only for a bar that's a slim strip (a piece's Play).</summary>
    [Parameter] public bool ShowMore { get; set; } = true;

    /// <summary>The cursor and the marks in More, on a bar whose runs are followed on the music (not a PDF's print).</summary>
    [Parameter] public bool ShowMarks { get; set; } = true;

    /// <summary>The screen's own rows in More's group for the music: a piece's view and lyrics.</summary>
    [Parameter] public RenderFragment? MoreMusic { get; set; }

    /// <summary>The screen's own groups in More, after the click's and the music's: a piece's feedback and its play along.</summary>
    [Parameter] public RenderFragment? More { get; set; }

    /// <summary>A screen's own keys, before More (a piece's page turns).</summary>
    [Parameter] public RenderFragment? Tools { get; set; }

    /// <summary>Full screen's key on the bar while full screen is on, the head and its key gone; on every bar unless a screen has none.</summary>
    [Parameter] public bool ShowFullScreen { get; set; } = true;

    /// <summary>For a screen that does more as it goes in and out of full screen (a piece's Practice), asked by the key.</summary>
    [Parameter] public EventCallback OnFullScreen { get; set; }

    /// <summary>The music's own tempo, in the tempo's beats a minute: with the tempo's − and + once it's been changed, a tap going back to it.</summary>
    [Parameter] public double? OriginalTempo { get; set; }

    /// <summary>Round a loop that waits after each pass (a run a pass), the passes before this run's, for the pass count and the last figure.</summary>
    [Parameter] public IReadOnlyList<PiecePass> EarlierPasses { get; set; } = [];

    /// <summary>The time since the music started, in the bar while a run plays.</summary>
    [Parameter] public bool ShowTime { get; set; }

    /// <summary>Nothing on the music while a run plays, whatever Settings say: no cursor and no marks (Play).</summary>
    [Parameter] public bool Bare { get; set; }

    /// <summary>When Listen ends, played through or stopped; it has no outcome.</summary>
    [Parameter] public EventCallback OnListened { get; set; }

    /// <summary>
    /// A mode the screen asks for now (a scale's first run is in Wait for me): the bar is set to it while it's asked, and goes
    /// back to the screen's own when it no longer is. The mode can still be changed on the bar.
    /// </summary>
    [Parameter] public PlayMode? Ask { get; set; }

    public PlayMode Mode { get; private set; }

    public bool Running => session?.Phase is Phase.CountIn or Phase.Playing || wait is not null;

    /// <summary>Whether the run going is Listen's.</summary>
    public bool Listening => listening && Running;

    private PlaySession? session;
    // A run moving to another bar (Restart): the bar stays as it plays, not showing Start and the mode for the moment in between.
    private bool moving;
    private PlayMusic? requestedMove;
    private Task? moveTask;
    private bool stopping;
    private long generation;
    // The metronome going, and what it was started with (the tempo, beats a bar, and where and how the click's heard), so a change
    // to any of them starts it again with the change.
    private (double Tempo, int Beats, bool OnPiano, ClickSoundKind Sound, int Volume)? ticking;
    private PlayOutcome? last;
    private WaitJudge? wait;
    private PlayMusic? playing;
    private Timer? ticker;
    private long? stoppedNs;
    private int bar;
    private bool listening;
    private Dictionary<string, Spelled> pitches = [];
    private Score? indexedScore;
    private IReadOnlyList<ExpectedNote>? indexedNotes;
    private Dictionary<string, ExpectedNote> notes = [];
    private TaskCompletionSource? savedCompletion;
    private readonly Dictionary<string, SheetMark> drawn = [];
    private readonly List<PlayedNote> heard = [];
    // The note with "together" over it: the top of a chord played a key at a time, in Wait for me.
    private string? hinted;
    // Round a loop: its first and last bars by number, the tick its first time round starts at and how many ticks each lasts, and
    // the passes played to their end so far.
    private (int From, int To)? loop;
    private long passFrom;
    private long passTicks;
    private int fullPassesAvailable;
    private readonly List<PiecePass> passes = [];
    // Going again by itself (Again): each run played to its end since Start, as a pass, for the run count and the last figure.
    private readonly List<PiecePass> runs = [];
    private bool disposed;
    // Wait for me's marks as the last pass played to its end left them, for the summary.
    private List<SheetMark> passMarks = [];
    // In time: whether the run goes anywhere at a tempo other than the one set (where its score marks another).
    private bool otherTempo;
    // Each note's bar on the sheet, by its id, for what went wrong in each bar of a pass; and the seconds since the music started.
    private Dictionary<string, int> barOf = [];
    private int seconds;
    // Where a run is being cut, to go on from elsewhere: at a slip, the note slipped on (the last that counts, by its tick) and its
    // bar; or where the screen moved it on, with no tick. The moment's pause after it, which Stop cuts short; whether the run
    // counting in after it keeps the marks so far; and how many of the run's times round the screen has been told of.
    private sealed record RunCut(PlaySession Run, long? Tick, int Bar);
    private RunCut? cut;
    private CancellationTokenSource? pausing;
    private bool keepMarks;
    private int passesTold;

    private string ModeKey => ModeKeyOf(Name);

    /// <summary>Where a screen's mode is kept, by the screen's name: a screen that sets the mode before the bar is made keeps it there.</summary>
    public static string ModeKeyOf(string name) => $"Play.Mode.{name}";

    /// <summary>Where a screen's Loop is kept, by the screen's name ("on" when it's lit).</summary>
    public static string LoopKeyOf(string name) => $"Play.Loop.{name}";

    // The screen's own mode, as kept, and what was last asked for in its place.
    private PlayMode? kept;
    private PlayMode? asked;

    private bool tempoOpen;
    // What Listen needs, said under it when it's tapped without a piano that takes notes.
    private string? listenNeeds;
    // What a run needs, said under the bar when one is asked for with no piano plugged in.
    private string? startNeeds;

    private async Task TypedTempo(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var bpm)) await TempoChanged.InvokeAsync(Math.Clamp(Math.Round(bpm), 20, 240));
    }

    private static string On(bool on) => on ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        Keyboard.Received += Heard;
        Keyboard.Changed += Plugged;
        Lifecycle.Pausing += Hush;
        var stored = await Store.GetSettingsAsync();
        kept = stored.GetValueOrDefault(ModeKey) == "wait" ? PlayMode.WaitForMe : PlayMode.InTime;
        (asked, Mode) = (Ask, Ask ?? kept.Value);
        await ModeChanged.InvokeAsync(Mode);
        Looping = ShowLoop && NextMusic is null && stored.GetValueOrDefault(LoopKeyOf(Name)) == "on";
        if (Looping) await LoopChanged.InvokeAsync(true);
    }

    public async Task SetLoop(bool on)
    {
        if (Running) return;

        Looping = on;
        await Store.SetSettingAsync(LoopKeyOf(Name), on ? "on" : "off");
        await LoopChanged.InvokeAsync(on);
    }

    protected override async Task OnParametersSetAsync()
    {
        // The metronome going at what's asked of it: a new tempo, start bar's metre, or click starts it again with it.
        if (ticking is { } going && BarBeats() is { } beats && going != (Tempo, beats, Settings.ClickOnPiano, Settings.ClickSound, Settings.ClickVolume)) Tick();
        if (kept is not { } own || Ask == asked) return;

        (asked, Mode) = (Ask, Ask ?? own);
        await ModeChanged.InvokeAsync(Mode);
    }

    private Task StartPressed() => Keyboard.Name is null ? StartNeeds() : OnStart.HasDelegate ? OnStart.InvokeAsync() : Start();

    // The click's settings changed in More: a metronome going starts again with them.
    private void ClickChanged()
    {
        if (ticking is not null) Tick();
    }

    private void ToggleMetronome()
    {
        if (ticking is null) Tick();
        else StopMetronome();
    }

    // The metronome clicking at the tempo, by the metre where the music starts: from a downbeat, with nothing counted in.
    private void Tick()
    {
        if (BarBeats() is not { } beats) return;

        Click.Start(new ClickPlan(Tempo, beats, 0, ClickStage.Throughout));
        ticking = (Tempo, beats, Settings.ClickOnPiano, Settings.ClickSound, Settings.ClickVolume);
    }

    private void StopMetronome()
    {
        if (ticking is null) return;

        Click.Stop();
        ticking = null;
    }

    // Prima put away: the metronome stops, as a run does.
    private Task Hush() => InvokeAsync(() =>
    {
        StopMetronome();
        StateHasChanged();
    });

    // The metre in force where the music starts (its start bar's): what a run's count-in counts, and the metronome's bar.
    private static Meter OpeningMeter(PlayMusic music)
    {
        var bars = music.Score.BarTimes(music.Order ?? [.. Enumerable.Range(0, music.Score.Bars.Count)]);
        return music.Score.WithSignatures().ElementAt(bars.First(b => b.Start >= music.FromTick).Index).Meter;
    }

    // The piano plugged in or out: Start and Listen look as they can be used.
    private void Plugged() => _ = InvokeAsync(StateHasChanged);

    // A run is played on the piano. With none plugged in nothing starts, and the bar says so for a few seconds.
    private async Task StartNeeds()
    {
        startNeeds = "Plug in your keyboard first.";
        StateHasChanged();
        await Task.Delay(4000);
        startNeeds = null;
        StateHasChanged();
    }

    private async Task SetMode(PlayMode mode)
    {
        (Mode, kept) = (mode, mode);
        await Store.SetSettingAsync(ModeKey, mode == PlayMode.WaitForMe ? "wait" : "time");
        await ModeChanged.InvokeAsync(mode);
    }

    /// <summary>
    /// Starts a run in the chosen mode: the screen's Start, the piano's go key, or the screen itself with the music it's about to
    /// show (a parameter set in the same step wouldn't have reached here yet). Whether one started: with no piano plugged in,
    /// say, none does and the bar says why, so a screen that has a stage of its own for the run moves to it only once it has.
    /// </summary>
    public Task<bool> Start(PlayMusic? with = null) => Run(with, listen: false);

    /// <summary>
    /// Listen: the piano plays the music at the tempo, its notes and any piano part, after the count-in (the click only counts in),
    /// the cursor moving with it. Nothing is judged, so you can play along or only listen.
    /// </summary>
    public Task Listen(PlayMusic? with = null) => Run(with, listen: true);

    /// <summary>
    /// Starts again with other music (the piece from another bar) in place of the run going, which ends there with nothing of
    /// it judged, marked or kept: it's the same go at the piece, moved. Listen stays Listen.
    /// </summary>
    public Task Restart(PlayMusic with)
    {
        if (disposed || stopping || (!Running && moveTask is null)) return Task.CompletedTask;
        requestedMove = with;
        return moveTask ??= MoveToLatest(Listening);
    }

    private async Task MoveToLatest(bool listen)
    {
        moving = true;
        try
        {
            await Task.Yield();
            while (!disposed && !stopping && requestedMove is { } next)
            {
                requestedMove = null;
                ticker?.Dispose();
                session?.Stop();
                savedCompletion?.TrySetResult();
                if (wait is not null) Registry.DrillAnswer = null;
                wait = null;
                await Run(next, listen);
            }
        }
        finally { moving = false; moveTask = null; }
    }

    private async Task ListenNeeds()
    {
        listenNeeds = Keyboard.Name is null ? "Listen plays it on your piano: plug in your keyboard."
            : !Keyboard.CanSend ? "Listen plays it on the piano, and this one doesn't take notes from the tablet."
            : "Listen plays it on your piano: turn Sound from the piano on in Settings.";
        StateHasChanged();
        await Task.Delay(4000);
        listenNeeds = null;
    }

    // Whether a run started.
    private async Task<bool> Run(PlayMusic? with, bool listen, bool again = false)
    {
        if (disposed || stopping || Running || savedCompletion is { Task.IsCompleted: false } || (with ?? Music) is not { Notes.Count: > 0 }) return false;
        if (!listen && Keyboard.Name is null)
        {
            _ = InvokeAsync(StartNeeds);
            return false;
        }

        // Runs going round count from the one started by hand. A run has the click to itself (In time's, or none).
        if (!again) runs.Clear();
        StopMetronome();
        tempoOpen = false;
        var version = ++generation;
        await OnStarting.InvokeAsync();
        if (disposed || version != generation || (with ?? Music) is not { Notes.Count: > 0 } music || SheetOf() is not { } sheet) return false;
        if (!listen) await OnPracticeStarting.InvokeAsync();
        if (disposed || version != generation) return false;
        // Loop on the bar: the music's round, as many times as fill half an hour (until stopped, for anyone's purposes). A
        // screen with a loop of its own has made it already, Listen plays the music as it's written, and a rhythm tapped on
        // any key isn't scored a pass at a time, so it isn't looped.
        if (Looping && !listen && !RhythmOnly && music.LoopBars is null) music = music.Looped(music.TimesRound(Tempo));

        // A run stopped to start again (back a bar) leaves nothing ticking.
        session?.Dispose();
        ticker?.Dispose();
        (session, wait, playing, stoppedNs, last, ticker, listening, cut) = (null, null, music, null, null, null, listen, null);
        savedCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        if (!ReferenceEquals(indexedScore, music.Score))
        {
            indexedScore = music.Score;
            pitches = music.Score.Bars.SelectMany(b => b.Voices.SelectMany(v => v.Events.OfType<Notes>().SelectMany(n => n.Tones))).GroupBy(t => t.Id).ToDictionary(g => g.Key, g => g.First().Pitch);
        }
        var sourceNotes = music.Notes is ArraySegment<ExpectedNote> { Array: { } source } ? source : music.Notes;
        if (!ReferenceEquals(indexedNotes, sourceNotes))
        {
            indexedNotes = sourceNotes;
            notes = sourceNotes.ToDictionary(n => n.Id);
            barOf = sourceNotes.GroupBy(n => n.WrittenId).ToDictionary(g => g.Key, g => g.First().Bar);
        }
        // Counted in again after a cut, the marks so far stay (the slip's among them), each note taking its new mark as it's
        // played again.
        var keep = keepMarks;
        keepMarks = false;
        if (!keep) drawn.Clear();
        heard.Clear();
        hinted = null;
        if (!keep) await sheet.ClearMarks();
        if (disposed || version != generation)
        {
            savedCompletion?.TrySetResult();
            return false;
        }
        var first = music.Notes.MinBy(n => n.Tick)!;
        bar = first.Bar;
        // Every bar the run plays and when, a bar with nothing to play too: the bar the readout names, and the cursor's path.
        var bars = music.Score.BarTimes(music.Order ?? [.. Enumerable.Range(0, music.Score.Bars.Count)]);
        passes.Clear();
        (loop, passMarks, passesTold) = (null, [], 0);
        if (music.LoopBars is { } count && !listen)
        {
            loop = (music.Score.Bars[bars[0].Index].Number, music.Score.Bars[bars[count - 1].Index].Number);
            (passFrom, passTicks) = (bars[0].Start, bars.Take(count).Sum(b => b.Length));
            fullPassesAvailable = bars.Count / count;
            if (music.EntryIndex > 0)
            {
                passFrom += passTicks;
                fullPassesAvailable--;
            }
        }

        if (Mode == PlayMode.WaitForMe && !listen && !RhythmOnly)
        {
            var judge = wait = new WaitJudge(music.Notes, music.Ornamented, music.Rolled);
            // The preview's simulated player answers the step waited for: its keys, or a key beside its first.
            Registry.DrillAnswer = right => judge.Done ? [] : right ? [[.. judge.Current.Select(n => n.Midi)]] : [[judge.Current[0].Midi + 1]];
            StateHasChanged();
            // Read ahead's covers go: the cursor waits, so there's no time to keep ahead of.
            await sheet.StopCursor();
            await sheet.CursorAt(PlayMusic.SheetId(wait.Current[0].Id));
            return true;
        }

        // In time: beats from the run's beat 0, the click's, with a pickup's before it. Listen gives the piano the notes as well as
        // any piano part, expects nothing, and hears the click only in the count-in.
        var from = music.FromTick / (double)music.BeatTicks;
        double Beat(ExpectedNote n) => n.Tick / (double)music.BeatTicks - from;
        var barIndex = music.EntryIndex;
        bar = music.Score.Bars[bars[barIndex].Index].Number;
        var timed = music.Notes.Select(n => (n.Midi, Beat(n), n.Length / (double)music.BeatTicks)).ToList();
        // The piano holds a staccato note half its length.
        IReadOnlyList<(int Midi, double Beat, double Beats)>? piano = listen ? [.. music.Notes.Select(n => (n.Midi, Beat(n), n.Sounds / (double)music.BeatTicks)), .. music.PianoPart ?? []] : music.PianoPart;
        var run = session = new PlaySession(Click, Keyboard, Clock, Registry);
        var completion = savedCompletion;
        // Its end is handled once: the change its count-in ending told can come to be handled after it has ended (a busy screen,
        // a run cut short), and then found it ended too.
        var ended = false;
        run.Changed += () => _ = InvokeAsync(async () =>
        {
            if (run.Phase == Phase.Done)
            {
                if (ended) return;
                ended = true;
                if (cut is { } at && at.Run == run)
                {
                    await Cutting(run, music, at, completion, version);
                    return;
                }
                try { await Ended(run); completion.TrySetResult(); }
                catch (Exception error) { completion.TrySetException(error); throw; }
                if (!disposed && run == session && version == generation) await Round(music);
            }
            else StateHasChanged();
        });
        // The click's beats are the music's own: each bar's by its metre, each as long as the score's tempo there says, the tempo
        // set being the one it mostly goes at. The count-in has the first bar's metre and tempo.
        var beats = music.Score.RunBeats(music.Order ?? [.. Enumerable.Range(0, music.Score.Bars.Count)], music.FromTick, Tempo);
        var opening = music.Score.WithSignatures().ElementAt(bars.First(b => b.Start >= music.FromTick).Index).Meter;
        var countInNs = beats[0].Ns / (beats[0].Beats * music.BeatTicks) * opening.BeatTicks;
        var stage = listen ? ClickStage.CountInOnly : ClickStage.Throughout;
        var plan = new ClickPlan(60e9 / countInNs, opening.Beats, Math.Max(1, Settings.CountInBars), stage) { Music = beats };
        otherTempo = beats.Any(b => Math.Abs(b.Ns / b.Beats - 60e9 / Tempo) > 1e3);
        seconds = 0;
        run.Start(plan, timed.Max(e => e.Item2 + e.Item3), listen ? [] : timed, piano, Settings.TimingOffsetMs);
        // Each note judged as it's played and marked at once; the summary's marks replace these.
        var (timeAt, heardAt) = Judged(run, music);
        var live = listen || RhythmOnly ? null : new LiveJudge(music.Notes, timeAt, music.BeatTicks, 60e9 / Tempo, Settings.TimingOffsetMs, music.Ornamented, music.Rolled);
        if (live is not null) run.KeyDown += (key, at) => _ = InvokeAsync(() => version == generation && run == session
            ? Judge(run, live.Play(key, heardAt(at)) is { } mark ? [mark] : []) : Task.CompletedTask);
        var tickQueued = 0;
        ticker = new Timer(_ =>
        {
            if (Interlocked.Exchange(ref tickQueued, 1) != 0) return;
            _ = InvokeAsync(async () =>
            {
                try
                {
                    if (disposed || version != generation || run != session || !Running) return;
                    var now = Clock.NowNs;
                    while (barIndex + 1 < bars.Count && run.TimeAt(bars[barIndex + 1].Start / (double)music.BeatTicks - from) <= now) barIndex++;
                    var at = music.Score.Bars[bars[barIndex].Index].Number;
                    var elapsed = ShowTime ? (int)Math.Max(0, (now - run.TimeAt(0)) / 1e9) : 0;
                    if (at != bar || elapsed != seconds)
                    {
                        (bar, seconds) = (at, elapsed);
                        StateHasChanged();
                    }
                    if (live is not null) await Judge(run, live.Due(heardAt(now)));
                    // Round a loop, a time round is scored once the next has begun and a late key for its last note has had its chance.
                    var next = passFrom + (passes.Count + 1) * passTicks;
                    if (version != generation || run != session || cut is not null || loop is null || live is null || passes.Count >= fullPassesAvailable || now - Settings.TimingOffsetMs * 1e6 < run.TimeAt(next / (double)music.BeatTicks - from) + Grading.WindowNs(60e9 / Tempo)) return;

                    passes.Add(PassOf(Pass(music, run, passes.Count, expression: false)));
                    StateHasChanged();
                    // The screen told, as each comes: Lock in's dots, Practice it's.
                    passesTold = passes.Count;
                    await OnPass.InvokeAsync(passes[^1]);
                }
                finally { Volatile.Write(ref tickQueued, 0); }
            });
        }, null, 100, 100);
        StateHasChanged();
        // The cursor once the click's beat times are set: waiting where the music starts through the count-in, then with the beat
        // along the run's own path, so it goes back at a repeat as the notes do. The path is each of the run's bars, with the
        // quarter it starts at and how many it lasts, and what's printed in them: each note and rest, both hands', with its
        // quarters from its bar's start. So the cursor keeps the beat through rests and through bars the hand played has nothing in.
        await Task.Delay(50);
        if (disposed || stopping || requestedMove is not null || version != generation || run != session || !Running) return true;
        var introBars = 0;
        var iterations = 1;
        var visibleBars = bars.Count - music.EntryIndex;
        if (music.LoopBars is { } cycle && bars.Count > cycle)
        {
            introBars = music.EntryIndex == 0 ? 0 : cycle - music.EntryIndex;
            iterations = (visibleBars - introBars) / cycle;
            visibleBars = introBars + cycle;
        }
        var cursorBars = bars.Skip(music.EntryIndex).Take(visibleBars).ToList();
        var printed = cursorBars.Select(b => b.Index).Distinct().SelectMany(index => music.Score.Bars[index].Voices.SelectMany(v => v.Events).SelectMany(e => e switch
        {
            Notes { Grace: false } n => [(index, n.Tones[0].Id, n.Start / (double)Ticks.Quarter)],
            Rest { Hidden: false } r => [(index, r.Id, r.Start / (double)Ticks.Quarter)],
            _ => Array.Empty<(int, string, double)>(),
        }));
        var path = new CursorPath([.. cursorBars.Select(b => (b.Index, music.QuarterOf(b.Start), b.Length / (double)Ticks.Quarter))], [.. printed]) { IntroBars = introBars, Iterations = iterations };
        // Where the tempo isn't the one set, the cursor keeps to the beats: each one's quarter, and when it's due after the run's
        // beat 0, and the last one's end.
        List<(double Quarter, double Ms)>? times = null;
        if (otherTempo)
        {
            times = [];
            var ms = 0.0;
            foreach (var b in beats)
            {
                times.Add((music.QuarterOf(music.FromTick + (long)Math.Round(b.At * music.BeatTicks)), ms));
                ms += b.Ns / 1e6;
            }
            times.Add((music.QuarterOf(music.FromTick + (long)Math.Round((beats[^1].At + beats[^1].Beats) * music.BeatTicks)), ms));
        }
        var msPerQuarter = 60_000 / Tempo * Ticks.Quarter / music.BeatTicks;
        await sheet.StartCursor(run.MsUntil(Beat(first)), msPerQuarter, music.QuarterOf(first.Tick), plan.BeatNs / 1e6, run.MsUntil(0), music.ReadAheadQuarters, path, Settings.Cursor && !Bare, times);
        return true;
    }

    /// <summary>Ends the run where it is: In time scores what was due by now, Wait for me what was reached.</summary>
    public async Task Stop()
    {
        stopping = true;
        requestedMove = null;
        // Stopped in the moment after a cut: the run ends where it was cut.
        pausing?.Cancel();
        try
        {
            if (moveTask is { } move) await move;
            generation++;
            if (wait is not null)
            {
                await EndWait(true);
                return;
            }
            if (session is not { Phase: Phase.CountIn or Phase.Playing } run) return;
            stoppedNs = Clock.NowNs;
            run.Finish();
        }
        finally { stopping = false; }
    }

    /// <summary>Stop and await the owner's persisted outcome before navigation or host suspension.</summary>
    public async Task StopAndSaveAsync()
    {
        await Stop();
        if (savedCompletion is { } completion) await completion.Task;
    }

    private async Task Ended(PlaySession run)
    {
        if (run != session || playing is not { } music) return;

        ticker?.Dispose();
        ticker = null;
        var sheet = SheetOf();
        if (sheet is not null) await sheet.StopCursor();
        if (listening)
        {
            listening = false;
            StateHasChanged();
            await OnListened.InvokeAsync();
            return;
        }

        var from = music.FromTick / (double)music.BeatTicks;
        var beatNs = 60e9 / Tempo;
        // Stopped early, only the notes due by the last key played count, and none after the stop. What was due between that key
        // and Stop wasn't played wrong: the hands had left the keys to press it. With no key played, nothing counts. A loop left
        // to run its course is the same: its times round after the last key weren't played.
        var lastKey = run.Played.Count == 0 ? long.MinValue : (long)(run.Played.Max(p => p.OnNs) - Settings.TimingOffsetMs * 1e6 + Grading.WindowNs(beatNs));
        var until = stoppedNs is { } at ? Math.Min(at, lastKey) : loop is not null ? lastKey : long.MaxValue;
        var due = until == long.MaxValue ? music.Notes : music.Notes.TakeWhile(n => run.TimeAt(n.Tick / (double)music.BeatTicks - from) <= until).ToList();
        // Expression too, where the music marks it: loudness on your own soft-to-loud range when it's been measured.
        (int, int)? range = Settings is { SoftVelocity: { } soft, LoudVelocity: { } loud } ? (soft, loud) : null;
        var (timeAt, heardAt) = Judged(run, music);
        var played = run.Played.Select(p => p with { OnNs = heardAt(p.OnNs), OffNs = heardAt(p.OffNs) }).ToList();
        var damper = run.Damper.Select(d => (heardAt(d.DownNs), heardAt(d.UpNs))).ToList();
        // Round a loop, how many times round were played to their end: when one was, the run's result is the last one's (below),
        // and the whole run, which can be a great many notes, isn't scored for nothing.
        var whole = 0;
        if (loop is not null && fullPassesAvailable > 0 && due.Count > 0)
        {
            var (reached, lastOfFirst) = (due.Max(n => n.Tick), music.Notes.Where(n => n.Tick < passFrom + passTicks).Max(n => n.Tick));
            whole = reached < lastOfFirst ? 0 : (int)((reached - lastOfFirst) / passTicks) + 1;
        }
        var result = due.Count == 0 || whole > 0 ? null : PassageScorer.Score(due, timeAt, music.BeatTicks, beatNs, beatNs * music.Score.Meter.Beats, played, Settings.TimingOffsetMs, music.Ornamented, damper,
            Markings.Of(music.Score, due), range, music.Rolled);
        if (RhythmOnly && due.Count > 0)
        {
            var rhythmNotes = due.GroupBy(n => n.Tick).Select(g => g.First()).ToList();
            var rhythm = RhythmScorer.Score([.. rhythmNotes.Select(n => timeAt(n.Tick / (double)music.BeatTicks))], [.. rhythmNotes.Select(n => n.Id)], 0,
                [.. played.Select(n => n.OnNs)], beatNs, beatNs * music.Score.Meter.Beats, Settings.TimingOffsetMs);
            var judged = rhythm.Notes.Zip(rhythmNotes).Select(p => p.First with { Midi = p.Second.Midi, Bar = p.Second.Bar }).ToList();
            result = new PassageResult(judged, rhythm.Extra, rhythm.LeanPercent * beatNs / 1e8, rhythm.LeanPercent, rhythm.SteadinessPercent, 0,
                rhythm.KeptGoing, rhythm.DriftPercent, 0, judged.Where(n => n.Outcome != Outcome.Right || n.Band == Band.Off).GroupBy(n => n.Bar).ToDictionary(g => g.Key, g => g.Count()), null);
        }
        // Round a loop, each time round played to its end is a pass, scored by itself: one whose last note is among those that
        // count. Any the run hadn't scored yet are now, any it scored after the last key was played go, and the run's result is
        // the last pass's, which is how the loop stood when it was left. Stopped in its first time round, the result is what was
        // played of that.
        IReadOnlyList<PlayedNote> resultKeys = run.Played;
        if (loop is not null && due.Count > 0)
        {
            passes.RemoveRange(Math.Min(whole, passes.Count), Math.Max(0, passes.Count - whole));
            while (passes.Count < whole) passes.Add(PassOf(Pass(music, run, passes.Count, expression: false)));
            if (whole > 0)
            {
                result = Pass(music, run, whole - 1, expression: true);
                // That pass's own keys, as they came: from half a window before its first note to half a window before the next's.
                var (opens, closes) = PassKeys(music, run, whole - 1);
                resultKeys = [.. run.Played.Where(p => p.OnNs >= opens && p.OnNs < closes)];
            }
        }
        var marks = MarksOf(music, result);
        if (result is not null && sheet is not null) await sheet.ShowMarks(marks);
        last = new PlayOutcome(PlayMode.InTime, result, null, run.Played, stoppedNs is not null, bar) { TimeAt = b => run.TimeAt(b - from), Loop = loop, Passes = [.. passes], Marks = marks, Judged = resultKeys };
        StateHasChanged();
        await OnFinished.InvokeAsync(last);
    }

    // The marks a result leaves on the music: a wrong note's key, a missed note, one off the beat early or late, the rest right.
    private List<SheetMark> MarksOf(PlayMusic music, PassageResult? result) => [.. (result?.Notes ?? []).Select(n => n.Outcome switch
    {
        Outcome.Wrong when n.Played is { } key => MarkOf(music, n.Id, LiveKind.Wrong, key, 0),
        Outcome.Missed => MarkOf(music, n.Id, LiveKind.Missed, null, 0),
        _ when n.Band == Band.Off => MarkOf(music, n.Id, n.ErrorPercent < 0 ? LiveKind.Early : LiveKind.Late, null, n.ErrorPercent ?? 0),
        _ => MarkOf(music, n.Id, LiveKind.Right, null, 0),
    })];

    // A time round In time as the bar and the screen keep it: right of its notes, right in time, what went wrong in each bar, and
    // the keys extra.
    private static PiecePass PassOf(PassageResult pass) => new(pass.Right, pass.Expected, pass.InTimeAccuracy) { Trouble = Trouble.Of(pass.Notes), Extra = pass.Extra };

    // Notes judged as they're played: marked, and where a slip stops the run, the first wrong or missed one stops it. A wrong key's
    // chord comes with it, so the run stops a moment after, with the rest of its keys.
    private async Task Judge(PlaySession run, IReadOnlyList<LiveMark> marks)
    {
        await Draw(marks);
        if (OnSlip is null || cut is not null || run != session || !Running) return;
        if (marks.FirstOrDefault(m => m.Kind is LiveKind.Wrong or LiveKind.Missed) is not { } slipped || !notes.TryGetValue(slipped.Id, out var note)) return;

        cut = new RunCut(run, note.Tick, note.Bar);
        if (playing is { } music && SheetOf() is { } sheet && !Settings.LiveMarks)
        {
            // Its mark shows whatever Settings say of the marks while you play: it's why the click stopped.
            await sheet.MarkLive([MarkOf(music, slipped.Id, slipped.Kind, slipped.Played, slipped.ErrorPercent)]);
        }
        if (slipped.Kind == LiveKind.Wrong) await Task.Delay(TimeSpan.FromTicks(WaitJudge.TogetherNs / 100));
        else await Task.Yield();
        if (cut?.Run == run && run == session) run.Finish();
    }

    /// <summary>
    /// Cuts the run where it is to go on from elsewhere, as a slip does: <see cref="OnSlip"/> is given what it played and says where
    /// (Lock in's spot clean so many times in a row, let go, or going a notch slower). A bar whose slips don't stop it stops.
    /// </summary>
    public async Task Cut()
    {
        if (OnSlip is null)
        {
            await Stop();
            return;
        }
        if (cut is not null || session is not { Phase: Phase.CountIn or Phase.Playing } run) return;

        cut = new RunCut(run, null, bar);
        // Not in the middle of what asked for it (a time round's being told, say): the run ends once that's done.
        await Task.Yield();
        if (cut?.Run == run && run == session) run.Finish();
    }

    // A run cut to go on from elsewhere: at a slip, or where the screen moved it on. What it played is scored as a run stopped there
    // and given to the screen (round a loop, any times round it played to their end that the screen hadn't been told of first),
    // its marks left as they were drawn; then, a moment later with the click stopped, it counts in again with the music the screen
    // gives, the same go at the piece. Stopped meanwhile, left, or given none, the run ends where it was cut.
    private async Task Cutting(PlaySession run, PlayMusic music, RunCut at, TaskCompletionSource completion, long version)
    {
        PlayOutcome? part = null;
        moving = true;
        try
        {
            ticker?.Dispose();
            ticker = null;
            if (SheetOf() is { } sheet) await sheet.StopCursor();
            part = last = Part(run, music, at);
            StateHasChanged();
            foreach (var pass in part.Passes.Skip(passesTold).ToList())
            {
                passesTold++;
                await OnPass.InvokeAsync(pass);
            }
            var next = !disposed && version == generation && OnSlip is { } ask ? await ask(part) : null;
            if (next is not null && !disposed && version == generation)
            {
                pausing = new CancellationTokenSource();
                StateHasChanged();
                try { await Task.Delay(CutPause, pausing.Token); }
                catch (OperationCanceledException) { }
                if (!disposed && version == generation)
                {
                    (cut, keepMarks, Continuing) = (null, true, true);
                    completion.TrySetResult();
                    try
                    {
                        if (await Run(next, listen: false, again: true)) return;
                    }
                    finally { Continuing = false; }
                }
            }
        }
        finally
        {
            moving = false;
            pausing = null;
        }

        // Stopped, left, or with nowhere to go on: the run ends where it was cut.
        cut = null;
        keepMarks = false;
        if (disposed || part is null)
        {
            completion.TrySetResult();
            return;
        }
        StateHasChanged();
        try { await OnFinished.InvokeAsync(part); completion.TrySetResult(); }
        catch (Exception error) { completion.TrySetException(error); throw; }
    }

    // What a run cut short played, scored as a run stopped there. At a slip, its notes up to the one slipped on (its chord's with
    // it), and round a loop the time round it cut short as a pass of its own; moved on by the screen, the notes due by the last key
    // played, and round a loop its times round played to their end, the run's result the last one's.
    private PlayOutcome Part(PlaySession run, PlayMusic music, RunCut at)
    {
        var from = music.FromTick / (double)music.BeatTicks;
        var beatNs = 60e9 / Tempo;
        var (timeAt, heardAt) = Judged(run, music);
        var damper = run.Damper.Select(d => (heardAt(d.DownNs), heardAt(d.UpNs))).ToList();
        PassageResult? Score(IReadOnlyList<ExpectedNote> due, IEnumerable<PlayedNote> keys) => due.Count == 0 ? null : PassageScorer.Score(due, timeAt, music.BeatTicks, beatNs, beatNs * music.Score.Meter.Beats,
            [.. keys.Select(p => p with { OnNs = heardAt(p.OnNs), OffNs = heardAt(p.OffNs) })], Settings.TimingOffsetMs, music.Ornamented, damper, null, null, music.Rolled);
        var lastKey = run.Played.Count == 0 ? long.MinValue : (long)(run.Played.Max(p => p.OnNs) - Settings.TimingOffsetMs * 1e6 + Grading.WindowNs(beatNs));
        List<ExpectedNote> due = at.Tick is { } tick ? [.. music.Notes.Where(n => n.Tick <= tick)] : [.. music.Notes.TakeWhile(n => run.TimeAt(n.Tick / (double)music.BeatTicks - from) <= lastKey)];

        PassageResult? result;
        PiecePass? cutShort = null;
        if (loop is null) result = Score(due, run.Played);
        else
        {
            // Round a loop: the times round before the slip's (or all the screen moved on after), each scored by itself; at a slip,
            // the time round it cut short, from its first note to the slip, with its own keys.
            var whole = at.Tick is { } slipped ? (slipped < passFrom ? 0 : (int)Math.Min(fullPassesAvailable, (slipped - passFrom) / passTicks)) : passes.Count;
            while (passes.Count < whole) passes.Add(PassOf(Pass(music, run, passes.Count, expression: false)));
            if (at.Tick is not null)
            {
                var start = due.Count > 0 && due[^1].Tick < passFrom ? long.MinValue : passFrom + passes.Count * passTicks;
                var opens = start == long.MinValue ? long.MinValue : PassKeys(music, run, passes.Count).Opens;
                result = Score([.. due.Where(n => n.Tick >= start)], run.Played.Where(p => p.OnNs >= opens));
                cutShort = result is null ? null : PassOf(result);
            }
            else result = passes.Count > 0 ? Pass(music, run, passes.Count - 1, expression: false) : Score(due, run.Played);
        }
        return new PlayOutcome(PlayMode.InTime, result, null, run.Played, true, at.Bar)
        {
            TimeAt = b => run.TimeAt(b - from), Loop = loop, Passes = [.. passes], Marks = MarksOf(music, result), Judged = run.Played, CutShort = cutShort, Slipped = at.Tick is not null,
        };
    }

    // When a time round a loop's own keys come, on the system clock: from half a window before its first note to half a window
    // before the next time round's first, so the next one's first keys aren't extra in it.
    private (double Opens, double Closes) PassKeys(PlayMusic music, PlaySession run, int index)
    {
        var (from, beatNs, start) = (music.FromTick / (double)music.BeatTicks, 60e9 / Tempo, passFrom + index * passTicks);
        var first = music.Notes.Where(n => n.Tick >= start && n.Tick < start + passTicks).Min(n => n.Tick);
        var half = Grading.WindowNs(beatNs) / 2 - Settings.TimingOffsetMs * 1e6;
        return (run.TimeAt(first / (double)music.BeatTicks - from) - half, run.TimeAt((first + passTicks) / (double)music.BeatTicks - from) - half);
    }

    // One time round a loop scored by itself: its notes against the keys played for them, those still down too. Its keys start
    // half a window before its first note, as any passage's do, and end half a window before the next time round's first, so
    // the next one's first keys aren't extra here. With its expression, for the summary; without, for the bar while the loop
    // goes on.
    private PassageResult Pass(PlayMusic music, PlaySession run, int index, bool expression)
    {
        var (from, beatNs, start) = (music.FromTick / (double)music.BeatTicks, 60e9 / Tempo, passFrom + index * passTicks);
        var notes = music.Notes.Where(n => n.Tick >= start && n.Tick < start + passTicks).ToList();
        var nextFirst = run.TimeAt((notes.Min(n => n.Tick) + passTicks) / (double)music.BeatTicks - from);
        var until = nextFirst - Grading.WindowNs(beatNs) / 2 + Settings.TimingOffsetMs * 1e6;
        var (timeAt, heardAt) = Judged(run, music);
        var played = run.PlayedSoFar(Clock.NowNs).Where(p => p.OnNs < until);
        var keys = played.Select(p => p with { OnNs = heardAt(p.OnNs), OffNs = heardAt(p.OffNs) }).ToList();
        var damper = run.Damper.Select(d => (heardAt(d.DownNs), heardAt(d.UpNs))).ToList();
        (int, int)? range = expression && Settings is { SoftVelocity: { } soft, LoudVelocity: { } loud } ? (soft, loud) : null;
        return PassageScorer.Score(notes, timeAt, music.BeatTicks, beatNs, beatNs * music.Score.Meter.Beats, keys, Settings.TimingOffsetMs, music.Ornamented, damper,
            expression ? Markings.Of(music.Score, notes) : null, range, music.Rolled);
    }

    // When the music's moments were due and when a key came, as a run is judged: the click's, or where the score marks a tempo
    // other than the one set, as though the run went at that one throughout, each moment, the music's and the keys', moved to where
    // it'd be at that tempo. So a note's timing is a share of the beat it was played in, and a beat's window one of it, whatever
    // the tempo there.
    private (Func<double, long> TimeAt, Func<long, long> HeardAt) Judged(PlaySession run, PlayMusic music)
    {
        var from = music.FromTick / (double)music.BeatTicks;
        if (!otherTempo) return (b => run.TimeAt(b - from), t => t);

        var (beatNs, offsetNs) = (60e9 / Tempo, (long)(Settings.TimingOffsetMs * 1e6));
        Func<double, long> timeAt = b => run.TimeAt(0) + (long)((b - from) * beatNs);
        Func<long, long> heardAt = t => run.TimeAt(0) + (long)(run.MusicBeatAt(t - offsetNs) * beatNs) + offsetNs;
        return (timeAt, heardAt);
    }

    // Wait for me: each key judged, marked, and the cursor moved on once a step's keys are all down together.
    private void Heard(MidiEvent e)
    {
        if (wait is not { } judge || e.Kind != MidiKind.NoteOn) return;

        _ = InvokeAsync(async () =>
        {
            if (wait != judge) return;

            heard.Add(new PlayedNote(e.Note, e.TimeNs, e.TimeNs, e.Velocity));
            var (marks, moved) = judge.Play(e.Note, e.TimeNs);
            await Draw(marks);
            if (wait != judge) return;
            // A chord played a key at a time has "together" over its top note until it's played so (a chord marked to be rolled,
            // "in one roll"). That's what to do next, not how a note went, so it shows whatever Settings says of the marks.
            var word = judge.Apart ? PlayMusic.SheetId(judge.Current.MaxBy(n => n.Midi)!.Id) : null;
            if ((word ?? hinted) is not null && SheetOf() is { } paper)
            {
                List<SheetMark> hints = hinted is not null && hinted != word ? [new SheetMark(hinted, "hint")] : [];
                if (word is not null) hints.Add(new SheetMark(word, "hint", judge.Rolling ? "in one roll" : "together"));
                await paper.MarkLive(hints);
                hinted = word;
            }
            if (!moved) return;
            // Round a loop, a step in the next time round means the one before it was played to its end: a pass, its marks as they
            // stand all its own.
            while (loop is not null && passes.Count < fullPassesAvailable && (judge.Done || judge.Current[0].Tick >= passFrom + (passes.Count + 1) * passTicks))
            {
                var pass = judge.Stretch(passFrom + passes.Count * passTicks, passFrom + (passes.Count + 1) * passTicks);
                passMarks = [.. drawn.Values];
                passes.Add(new PiecePass(pass.RightFirstTime, pass.Notes, null) { Trouble = Trouble.Of(passMarks, barOf), Seconds = pass.Seconds });
                if (judge.Done) break;
            }
            if (judge.Done)
            {
                await EndWait(false);
                return;
            }

            bar = judge.Current[0].Bar;
            StateHasChanged();
            if (SheetOf() is { } sheet) await sheet.CursorAt(PlayMusic.SheetId(judge.Current[0].Id));
        });
    }

    private async Task EndWait(bool stopped)
    {
        var version = generation;
        if (wait is not { } judge) return;
        var completion = savedCompletion;

        wait = null;
        Registry.DrillAnswer = null;
        // Round a loop, the run is its last time round played to its end, with that pass's marks, as In time's is. Stopped in its
        // first time round, it's what was played of that.
        long? lastPass = loop is not null && passes.Count > 0 ? passFrom + (passes.Count - 1) * passTicks : null;
        List<SheetMark> marks = lastPass is null ? [.. drawn.Values] : passMarks;
        if (SheetOf() is { } sheet)
        {
            await sheet.StopCursor();
            // Kept as the summary's, so they stay through a redraw.
            await sheet.ShowMarks(marks);
        }
        var result = lastPass is { } start ? judge.Stretch(start, start + passTicks) : judge.Result();
        last = new PlayOutcome(PlayMode.WaitForMe, null, result, [.. heard], stopped, bar) { Loop = loop, Passes = [.. passes], Marks = marks, Judged = [.. heard] };
        StateHasChanged();
        try { await OnFinished.InvokeAsync(last); completion?.TrySetResult(); }
        catch (Exception error) { completion?.TrySetException(error); throw; }
        if (!disposed && version == generation && playing is { } music) await Round(music);
    }

    // A run played to its end where the bar goes round (Again): counted, and started again. Stop is the way out; leaving ends it.
    private async Task Round(PlayMusic music)
    {
        if (disposed || (!Again && NextMusic is null) || last is not { Stopped: false } run) return;

        if (run.InTime is { } timed) runs.Add(new PiecePass(timed.Right, timed.Expected, timed.InTimeAccuracy));
        else if (run.Wait is { } waited) runs.Add(new PiecePass(waited.RightFirstTime, waited.Notes, null));
        await Run(NextMusic?.Invoke() ?? music, listen: false, again: true);
    }

    private async Task Draw(IReadOnlyList<LiveMark> marks)
    {
        if (marks.Count == 0 || playing is not { } music || SheetOf() is not { } sheet) return;

        var shown = marks.Select(m => MarkOf(music, m.Id, m.Kind, m.Played, m.ErrorPercent)).ToList();
        foreach (var mark in shown) drawn[mark.Id] = mark;
        // With the marks as you play off, they're kept all the same and shown when the run ends.
        if (Settings.LiveMarks && !Bare) await sheet.MarkLive(shown);
    }

    // A note's mark on the sheet. A wrong one shows the key played, a red head that many staff positions from the written one,
    // which turns grey, each named; an early or late one when it was played, a ring on its line. A note played again (a repeat)
    // marks the same note on the sheet, the latest time through.
    private SheetMark MarkOf(PlayMusic music, string id, LiveKind kind, int? key, double errorPercent)
    {
        var name = kind.ToString().ToLowerInvariant();
        var sheetId = PlayMusic.SheetId(id);
        if (kind == LiveKind.Wrong && key is { } played && pitches.TryGetValue(sheetId, out var written))
        {
            var spelled = music.Score.Key.Spell(played);
            return new SheetMark(sheetId, name, spelled.ToString(), spelled.Diatonic - written.Diatonic, Written: written.ToString());
        }
        return kind is LiveKind.Early or LiveKind.Late && notes.TryGetValue(id, out var note)
            ? new SheetMark(sheetId, name, Quarter: music.QuarterOf(note.Tick) + errorPercent / 100 * music.BeatTicks / Ticks.Quarter)
            : new SheetMark(sheetId, name);
    }

    public void Dispose()
    {
        var abandoned = Running || moving;
        generation++;
        requestedMove = null;
        disposed = true;
        pausing?.Cancel();
        StopMetronome();
        Lifecycle.Pausing -= Hush;
        Keyboard.Received -= Heard;
        Keyboard.Changed -= Plugged;
        if (wait is not null) Registry.DrillAnswer = null;
        ticker?.Dispose();
        session?.Dispose();
        if (abandoned) savedCompletion?.TrySetResult();
    }
}
