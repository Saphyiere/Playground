@using Prima.Core.Generation
@using Prima.Core.Music

@*
    What's chosen, at a glance, above the play bar: the key lit on a small keyboard and named, the hands drawn, then the rest (the
    form, the octaves, a family's own choices) as a word each with its picture, and Change, which opens them over the music.
    While a run plays nothing can be changed.
*@
<div class="choice-card">
    @if (Key is { } key)
    {
        <span class="mini-keys" aria-hidden="true">
            @foreach (var pc in WhitePcs)
            {
                <i class="@(pc == key.TonicPitchClass ? "on" : null)"></i>
            }
            @foreach (var (pc, at) in Blacks)
            {
                <b class="@(pc == key.TonicPitchClass ? "on" : null)" style="--at: @at"></b>
            }
        </span>
        <span class="choice-card-key"><strong class="exercise-key">@(KeyName ?? key.Name)</strong>@if (KeyNote is not null)
            {
                <small>@KeyNote</small>
            }</span>
        <span class="choice-card-sep" aria-hidden="true"></span>
    }
    @if (Hands is { } hands)
    {
        <span class="choice-card-hand">
            <span class="choice-card-hands" aria-hidden="true">
                @if (hands != HandUse.Right)
                {
                    <HandIcon />
                }
                @if (hands != HandUse.Left)
                {
                    <HandIcon Right="true" />
                }
            </span>
            @(hands switch { HandUse.Right => "Right", HandUse.Left => "Left", _ => "Both" })
        </span>
        @if (ChildContent is not null)
        {
            <span class="choice-card-sep" aria-hidden="true"></span>
        }
    }
    @if (ChildContent is not null)
    {
        <span class="choice-card-facts">@ChildContent</span>
    }
    <button type="button" class="mu-btn choice-change" aria-expanded="@(Open ? "true" : "false")" disabled="@Disabled" @onclick="() => OnChange.InvokeAsync()">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 16.2l.9-3.8 8.6-8.6a1.5 1.5 0 0 1 2.1 0l.8.8a1.5 1.5 0 0 1 0 2.1l-8.6 8.6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path d="M11.8 5.6l2.6 2.6" stroke="currentColor" stroke-width="1.8" /></svg>
        <span>Change</span>
    </button>
</div>

@code {
    /// <summary>The key, on the small keyboard and by name; none for a screen without one.</summary>
    [Parameter] public Key? Key { get; set; }

    /// <summary>The key's name where it's said otherwise ("C major, five fingers").</summary>
    [Parameter] public string? KeyName { get; set; }

    /// <summary>A word under the key's name: a minor scale's form.</summary>
    [Parameter] public string? KeyNote { get; set; }

    /// <summary>The hands; none for a screen without a choice of them.</summary>
    [Parameter] public HandUse? Hands { get; set; }

    /// <summary>The rest of what's chosen, a <c>choice-fact</c> each.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Whether Change is open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback OnChange { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private static readonly int[] WhitePcs = [0, 2, 4, 5, 7, 9, 11];
    private static readonly (int Pc, int At)[] Blacks = [(1, 1), (3, 2), (6, 4), (8, 5), (10, 6)];
}
