@* The tempo, the same on every screen that plays to one: slower and faster by a metronome's marks (20, 22, 24 … 60, 63, 66 …
   120, 126 … 208, 216 … 240), so each step is about the same share of the tempo, slow or fast (TempoMarks, in the core). *@
<span class="tempo-control">
    <button type="button" class="mu-btn" aria-label="Slower" disabled="@Disabled" @onclick="() => ValueChanged.InvokeAsync(TempoMarks.Down(Value))">−</button>
    @if (Figure)
    {
        <span class="tempo-figure" aria-label="@($"{Value:0} beats a minute")">@Value.ToString("0", CultureInfo.InvariantCulture)</span>
    }
    <button type="button" class="mu-btn" aria-label="Faster" disabled="@Disabled" @onclick="() => ValueChanged.InvokeAsync(TempoMarks.Up(Value))">+</button>
</span>

@code {
    [Parameter] public double Value { get; set; }

    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>The figure between − and +; off where the tempo shows already (in a field beside them).</summary>
    [Parameter] public bool Figure { get; set; } = true;
}
