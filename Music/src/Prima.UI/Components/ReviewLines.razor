@using Prima.Core.Practice

<p class="sum-point review-did"><span class="sum-key @(Review.Focus == ReviewFocus.None ? "good" : "bad")" aria-hidden="true"></span><span class="mu-readout-label">This run</span><span>@Review.Did</span></p>

@code {
    [Parameter, EditorRequired] public RunReview Review { get; set; } = null!;
}
