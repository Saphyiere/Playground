@using Prima.Core.Music

@*
    The key on an octave of the piano, each key named as the key it picks is written (D♭ major, C♯ minor): one tap is that key,
    wherever it is in the list. Major or Minor beside it where both are offered; a key with nothing offered in the mode showing is
    off. The key chosen is lit.
*@
<div class="key-piano" role="group" aria-label="The key">
    @for (var i = 0; i < 7; i++)
    {
        var key = Offered(WhitePcs[i]);
        <button type="button" class="key-piano-white" aria-pressed="@On(key == Value)" aria-label="@(key?.Name ?? $"{Names[WhitePcs[i]]}: not offered")" disabled="@(Disabled || key is null)" @onclick="() => Pick(key)">@Label(WhitePcs[i], key)</button>
    }
    @foreach (var (pc, at) in Blacks)
    {
        var key = Offered(pc);
        <button type="button" class="key-piano-black" style="--at: @at" aria-pressed="@On(key == Value)" aria-label="@(key?.Name ?? $"{Names[pc]}: not offered")" disabled="@(Disabled || key is null)" @onclick="() => Pick(key)">@Label(pc, key)</button>
    }
</div>
@if (BothModes)
{
    <div class="choice-set key-mode" role="group" aria-label="Major or minor">
        <button type="button" class="mu-toggle" aria-pressed="@On(!Value.Minor)" disabled="@Disabled" @onclick="() => Mode(false)"><span class="mu-led"></span>Major</button>
        <button type="button" class="mu-toggle" aria-pressed="@On(Value.Minor)" disabled="@Disabled" @onclick="() => Mode(true)"><span class="mu-led"></span>Minor</button>
    </div>
}

@code {
    /// <summary>The keys offered, majors and minors.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Key> Keys { get; set; } = [];

    [Parameter] public Key Value { get; set; }

    [Parameter] public EventCallback<Key> ValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    // The white keys' pitch classes, and each black key's with the white key it sits after.
    private static readonly int[] WhitePcs = [0, 2, 4, 5, 7, 9, 11];
    private static readonly (int Pc, int At)[] Blacks = [(1, 1), (3, 2), (6, 4), (8, 5), (10, 6)];
    private static readonly string[] Names = ["C", "C♯", "D", "E♭", "E", "F", "F♯", "G", "A♭", "A", "B♭", "B"];

    private bool BothModes => Keys.Any(k => k.Minor) && Keys.Any(k => !k.Minor);

    private static string On(bool on) => on ? "true" : "false";

    // The key offered on this piano key in the mode showing.
    private Key? Offered(int pc) => Keys.Where(k => k.TonicPitchClass == pc && k.Minor == Value.Minor).Cast<Key?>().FirstOrDefault();

    // A piano key's name: its key's tonic, spelled as that key spells it, or its usual name where there's none.
    private static string Label(int pc, Key? key) => key is { } k ? k.Name.Split(' ')[0] : Names[pc];

    private Task Pick(Key? key) => key is { } k && k != Value ? ValueChanged.InvokeAsync(k) : Task.CompletedTask;

    // The other mode: the same tonic where it's offered, else the key with the same signature, else the mode's first.
    private Task Mode(bool minor)
    {
        if (Value.Minor == minor) return Task.CompletedTask;
        var mode = Keys.Where(k => k.Minor == minor).ToList();
        if (mode.Count == 0) return Task.CompletedTask;
        var to = mode.FirstOrDefault(k => k.TonicPitchClass == Value.TonicPitchClass, mode.FirstOrDefault(k => k.Fifths == Value.Fifths, mode[0]));
        return ValueChanged.InvokeAsync(to);
    }
}
