@implements IAsyncDisposable
@inject PrimaStore Store
@inject IInferenceProvider Provider
@inject ConversionJobs Jobs
@inject IConversionHost ConversionHost
@inject IAssistKeyStore Keys
@inject IJSRuntime JS
@inject Prima.UI.Library.LibraryPrep Prep
@inject IKeyboard Keyboard
@inject IClock Clock
@inject Click Click
@inject PrimaSettings Settings
@inject SessionRegistry Registry
@inject Microsoft.Extensions.Logging.ILogger<ReadNotes> Logger
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Playground.AI.Assist
@using Prima.Core.Library
@using Prima.Core.Transcription

@* Conversion work belongs to the persisted job. This view prepares source boundaries and observes progress or reviews the result. *@
<div class="pdfread-cutter" aria-hidden="true">
    <PdfPages @ref="cutter" Data="Pdf" OnOpened="Opened" />
</div>

@if (error is not null)
{
    <div class="pdfread-error" role="alert">
        <h3><span class="pdfread-lamp fail"></span>Couldn't finish reading the notes</h3>
        <p>@error</p>
        @if (unsaved)
        {
            <div class="pdfread-actions">
                <button type="button" data-piano="off" class="mu-btn mu-primary" @onclick="SaveDraft">Save reading</button>
            </div>
        }
    </div>
}
@if (editingSource)
{
    <section class="reading-bar piece-bar pdfread-bar">
        <p class="piece-bar-title">@Piece.Title</p>
        <button type="button" data-piano="off" class="mu-btn piece-key" data-action="back-to-sheet" @onclick="Close">Back to sheet music</button>
    </section>
    <SourceBars SourceHash="@sourceHash" Cuts="cuts" Source="source" ReadingCounts="ReadingCounts" OnConfirmed="ConfirmSource" OnCancel="() => editingSource = false" />
}
else if (job is { State: not ConversionState.Ready })
{
    <section class="reading-bar piece-bar pdfread-bar" data-job-state="@job.State">
        <p class="piece-bar-title">@Piece.Title</p>
        <button type="button" data-piano="off" class="mu-btn piece-key" data-action="back-to-sheet" @onclick="Close">Back to sheet music</button>
        <div class="mu-readout"><span class="mu-readout-label">Conversion</span><span class="mu-readout-value">@job.State</span></div>
        <div class="mu-readout"><span class="mu-readout-label">Batches saved</span><span class="mu-readout-value">@job.Chunks.Count(c => c.Phase == ConversionPhase.Complete) of @job.Chunks.Count</span></div>
        <div class="mu-readout" data-cost-kind="job" data-cost-unknown="@(job.HasUnknownCost ? "true" : "false")"><span class="mu-readout-label">@(job.HasUnknownCost ? "Known subtotal · total uncertain" : "Known cost")</span><span class="mu-readout-value">@Money(job.KnownCost)@(job.HasUnknownCost ? " + unknown" : "")</span></div>
    </section>
    <section class="pdfread-progress">
        <p class="pdfread-words">You can leave this screen. Completed batches are saved on this tablet, and a notification will bring you back when conversion finishes. Cancel stops this conversion.</p>
        @if (job.Problem is { Length: > 0 } problem)
        {
            <div class="pdfread-error" role="alert"><p>@problem</p></div>
        }
        @if (job.State is ConversionState.Paused or ConversionState.Interrupted)
        {
            @if (job.HasUncertainRequest)
            {
                <p class="pdfread-words">The interrupted request may have been processed and billed by the provider. Resuming sends the unfinished batch again; completed batches are kept.</p>
                <button type="button" data-piano="off" class="mu-toggle" data-action="acknowledge-resend" aria-pressed="@(acknowledgeResend ? "true" : "false")" @onclick="() => acknowledgeResend = !acknowledgeResend"><span class="mu-led"></span>I understand this request may be charged again</button>
            }
            @if (job.NeedsRequestAllowance)
            {
                <button type="button" data-piano="off" class="mu-toggle" data-action="allow-additional-request" aria-pressed="@(allowAdditionalRequest ? "true" : "false")" @onclick="() => allowAdditionalRequest = !allowAdditionalRequest">
                    <span class="mu-led"></span>Allow one more request, up to @job.Options.Chunks.TargetOutputTokens.ToString("N0", CultureInfo.InvariantCulture) output tokens
                </button>
            }
            <div class="pdfread-actions">
                <button type="button" data-piano="off" class="mu-btn mu-primary" data-action="resume-conversion" disabled="@(starting || job.HasUncertainRequest && !acknowledgeResend || job.NeedsRequestAllowance && !allowAdditionalRequest)" @onclick="Resume">Resume conversion</button>
            </div>
        }
        <div class="pdfread-list">
            @foreach (var (chunk, index) in job.Chunks.Select((c, i) => (c, i)))
            {
                <div class="pdfread-row" data-chunk="@chunk.Chunk.Id" data-phase="@chunk.Phase">
                    <div class="pdfread-name"><strong>Batch @(index + 1)</strong><span>@chunk.Chunk.BarIds.Count bars</span></div>
                    <div class="pdfread-state">@(chunk.Phase switch { ConversionPhase.Read => "Waiting to read", ConversionPhase.Validate => "Checking notation", ConversionPhase.Render => "Drawing notation", _ => "Saved" })</div>
                </div>
            }
        </div>
        <div class="pdfread-actions">
            @if (job.State != ConversionState.Cancelled)
            {
                <button type="button" data-piano="off" class="mu-btn" data-action="cancel-conversion" disabled="@starting" @onclick="CancelJob">Cancel conversion</button>
            }
            else
            {
                <button type="button" data-piano="off" class="mu-btn" data-action="new-conversion" @onclick="NewConversion">Start a new conversion</button>
            }
        </div>
    </section>
}
else if (stage == Stage.Estimate)
{
    var batches = HasConfirmedSource ? ConversionChunks.Plan(source!, new ChunkLimits()).Count : 0;
    var plannedOptions = HasConfirmedSource ? ConversionOptions.ForSource(Provider.ProviderId, new InferenceSettings(model), source!) : null;
    <section class="reading-bar piece-bar pdfread-bar" aria-label="PDF conversion">
        <p class="piece-bar-title">@Piece.Title</p>
        <button type="button" data-piano="off" class="mu-btn piece-key" data-action="back-to-sheet" @onclick="Close">Back to sheet music</button>
    </section>
    <section class="pdfread-estimate" aria-labelledby="pdfread-heading">
        <figure class="pdfread-figure">
            <div class="pdfread-page" style="@($"aspect-ratio: {(from <= ratios.Count ? ratios[from - 1] : 210.0 / 297).ToString(CultureInfo.InvariantCulture)}")">
                @if (thumbnail is not null)
                {
                    <img src="@thumbnail" alt="@($"Page {from}, its systems boxed and numbered")" />
                }
                @foreach (var (system, i) in Regions(from).Select((s, i) => (s, i)))
                {
                    <div class="pdfread-box" style="@($"top: {Share(system.Top / PageHeight(from))}; height: {Share((system.Bottom - system.Top) / PageHeight(from))}")"><span>@(i + 1)</span></div>
                }
            </div>
            <figcaption class="pdfread-caption">What's sent: each system boxed here, as a picture.@(to > from ? $" Page {from} of {from}–{to}." : "")</figcaption>
        </figure>
        <div class="pdfread-plan">
            <h2 id="pdfread-heading" class="section-title">Convert PDF to notation</h2>
            @if (prepared && SystemsIn(from, to) == 0)
            {
                <div class="pdfread-error" role="alert">
                    <h3><span class="pdfread-lamp fail"></span>Couldn't find the staff lines</h3>
                    <p>Prima couldn't locate the music on these pages. An image-only PDF is supported; try a clearer image or choose pages containing sheet music. No request has been sent to the provider.</p>
                </div>
            }
            @if (pages > 1)
            {
                <div class="control-row">
                    <span class="control-label">Pages</span>
                    <span class="tempo-control">
                        <button type="button" data-piano="off" class="mu-btn" aria-label="Start a page earlier" disabled="@(from <= 1)" @onclick="() => SetPages(from - 1, to)">−</button>
                        <span class="tempo-figure">@from</span>
                        <button type="button" data-piano="off" class="mu-btn" aria-label="Start a page later" disabled="@(from >= to)" @onclick="() => SetPages(from + 1, to)">+</button>
                    </span>
                    <span class="control-value">to</span>
                    <span class="tempo-control">
                        <button type="button" data-piano="off" class="mu-btn" aria-label="End a page earlier" disabled="@(to <= from)" @onclick="() => SetPages(from, to - 1)">−</button>
                        <span class="tempo-figure">@to</span>
                        <button type="button" data-piano="off" class="mu-btn" aria-label="End a page later" disabled="@(to >= pages)" @onclick="() => SetPages(from, to + 1)">+</button>
                    </span>
                </div>
            }
            <div class="pdfread-screen">
                <div class="mu-readout"><span class="mu-readout-label">Pages</span><span class="mu-readout-value">@(to - from + 1)</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Batches</span><span class="mu-readout-value">@(batches == 0 ? "Confirm bars first" : batches)</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Output limit / batch</span><span class="mu-readout-value">12,000 tokens</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Run output allowance</span><span class="mu-readout-value">@(plannedOptions is null ? "—" : plannedOptions.OutputTokenBudget.ToString("N0", CultureInfo.InvariantCulture) + " tokens")</span></div>
                <div class="mu-readout"><span class="mu-readout-label">Run request allowance</span><span class="mu-readout-value">@(plannedOptions?.MaxRequests.ToString(CultureInfo.InvariantCulture) ?? "—")</span></div>
            </div>
            <label class="pdfread-label" for="conversion-model">Model · @Provider.ProviderId</label>
            <input id="conversion-model" type="text" data-piano="off" class="text-field" value="@model" @onchange="e => model = e.Value?.ToString()?.Trim() ?? string.Empty" />
            <p class="pdfread-words">@(HasConfirmedSource ? $"{source!.Bars.Count} PDF bars confirmed. You can adjust their boundaries before converting." : "Check the proposed bar boundaries before converting, so every bar keeps its place in the PDF.")</p>
            <div class="pdfread-actions">
                <button type="button" data-piano="off" class="mu-btn" data-action="edit-source" disabled="@(!prepared || SystemsIn(from, to) == 0)" @onclick="EditSource">Check bar boundaries</button>
            </div>
            @if (noKey)
            {
                <div class="pdfread-error" role="alert">
                    <h3><span class="pdfread-lamp fail"></span>No provider key on this tablet</h3>
                    <p>Add the provider API key in Settings before converting.</p>
                    <div class="pdfread-actions">
                        <a data-piano="off" class="mu-btn mu-primary" href="settings">Open Settings</a>
                    </div>
                </div>
            }
            else
            {
                <p class="pdfread-words">The model reads small batches of complete bars. Prima checks and saves each batch before continuing. Review the notation against the print before keeping it.</p>
                <p class="pdfread-words muted">Pressing Convert to notation sends the confirmed bar images to the selected provider. Conversion keeps running when you leave this screen; only Cancel stops it. Provider charges vary by model and token use.</p>
                <div class="pdfread-actions">
                    <button type="button" data-piano="off" class="mu-btn mu-primary" data-action="convert-start" disabled="@(starting || !prepared || SystemsIn(from, to) == 0 || !HasConfirmedSource || string.IsNullOrWhiteSpace(model))" @onclick="ReadAll">Convert to notation</button>
                </div>
            }
        </div>
    </section>
}
else
{
    var statuses = result?.Systems ?? [];
    var read = statuses.Count(s => s.Step is SystemStep.Done or SystemStep.Doubtful);
    <section class="reading-bar piece-bar pdfread-bar" aria-label="The reading">
        <p class="piece-bar-title">@Piece.Title</p>
        <button type="button" data-piano="off" class="mu-btn piece-key" data-action="back-to-sheet" @onclick="Close">Back to sheet music</button>
        <div class="mu-readout"><span class="mu-readout-label">Systems read</span><span class="mu-readout-value">@read of @statuses.Count</span></div>
        @if (result is not null)
        {
            var doubtful = result.Doubts.Select(d => (d.System, d.Page, d.Bar)).Distinct().Count();
            <div class="mu-readout @(doubtful > 0 ? "miss" : "")" data-flagged-bars="@doubtful"><span class="mu-readout-label">Flagged for review</span><span class="mu-readout-value">@(doubtful == 1 ? "1 bar" : $"{doubtful} bars")</span></div>
            <div class="mu-readout @(notationIssues.Count > 0 ? "miss" : "")" data-notation-issue-count="@notationIssues.Count"><span class="mu-readout-label">Notation checks</span><span class="mu-readout-value">@notationIssues.Count</span></div>
            <div class="mu-readout" data-cost-kind="reading" data-cost-unknown="@(!readingCostKnown ? "true" : "false")"><span class="mu-readout-label">@(readingCostKnown ? "Cost" : "Known subtotal · total uncertain")</span><span class="mu-readout-value">@Money(result.Cost)@(!readingCostKnown ? " + unknown" : "")</span></div>
            <div class="mu-readout"><span class="mu-readout-label">Took</span><span class="mu-readout-value">@Minutes(result.Took)</span></div>
            @if (job?.IsRecheck == true)
            {
                <div class="mu-readout" data-cost-kind="recheck" data-cost-unknown="@(job.HasUnknownCost ? "true" : "false")"><span class="mu-readout-label">@(job.HasUnknownCost ? "Recheck subtotal · total uncertain" : "Recheck cost")</span><span class="mu-readout-value">@Money(job.KnownCost)@(job.HasUnknownCost ? " + unknown" : "")</span></div>
            }
            <div class="piece-actions">
                @if (job is null)
                {
                    <button type="button" data-piano="off" class="mu-btn" data-action="edit-source" disabled="@(!prepared)" @onclick="EditSource">Check PDF bars</button>
                }
                <button type="button" data-piano="off" class="mu-btn" disabled="@(!CanListen || whole is null)" aria-label="@(CanListen ? "Listen: the piano plays the reading" : "Listen needs the piano, playing notes from the tablet (Settings)")" @onclick="() => Listen(null)">@(listeningFrom == 0 ? "Stop" : "Listen")</button>
                @if (job is not null)
                {
                    <button type="button" data-piano="off" class="mu-btn" data-action="new-conversion" @onclick="NewConversion">New conversion</button>
                    <button type="button" data-piano="off" class="mu-btn mu-primary" data-action="keep-reading" disabled="@(!result.Ok || keeping)" @onclick="Keep">@(keeping ? "Keeping…" : "Keep")</button>
                }
                else if (throwing)
                {
                    <button type="button" data-piano="off" class="mu-btn" @onclick="ThrowAway">Throw it away</button>
                    <button type="button" data-piano="off" class="mu-btn" @onclick="() => throwing = false">Keep reviewing</button>
                }
                else
                {
                    <button type="button" data-piano="off" class="mu-btn" @onclick="() => throwing = true">Throw away…</button>
                    <button type="button" data-piano="off" class="mu-btn mu-primary" disabled="@(!result.Ok || keeping)" @onclick="Keep">@(keeping ? "Keeping…" : "Keep")</button>
                }
            </div>
        }
    </section>

    @if (result is not null)
    {
        var failed = result.Systems.Where(s => s.Step == SystemStep.Failed).ToList();
        var numbered = failed.Count == 0;
        <section class="pdfread-review" aria-label="Each system's print and reading">
            @if (failed.Count > 0)
            {
                // What stopped it says what to do: the key in Settings, credit or the limit in the Console, or waiting a little.
                var rest = failed.Count == 1 ? "Read it again" : read == 0 ? $"Read all {failed.Count} again" : $"Read the other {failed.Count}";
                // The first system not read holds up the rest, which are read with its time signature; reading again starts with it.
                var waiting = failed.Count > 1 && result.Systems[0].Step == SystemStep.Failed ? "The rest wait for it, for the time signature only it prints. " : "";
                var (title, lamp, help, again) = result.StoppedBy switch
                {
                    AnswerKind.NoKey => ("No provider key on this tablet", "fail", "Add one in Settings.", rest),
                    AnswerKind.KeyRejected => ("The key wasn't accepted", "fail", "Check the provider API key in Settings.", rest),
                    AnswerKind.OutOfCredit => ("Out of credit", "fail", "Add credit in the provider's billing settings.", rest),
                    AnswerKind.SpendLimit => ("The spending limit is reached", "fail", "Review the provider account's spending limit.", rest),
                    AnswerKind.Busy => ("The provider is busy", "doubt", "Try again in a few minutes.", "Try again"),
                    AnswerKind.Offline => ("Offline", "doubt", "Check the connection, then try again.", "Try again"),
                    _ => (failed.Count == 1 ? "A system wasn't read" : $"{failed.Count} systems weren't read", "fail", "", rest),
                };
                <div class="pdfread-error pdfread-banner" role="alert">
                    <div>
                        <h3><span class="pdfread-lamp @lamp"></span>@title</h3>
                        <p>@result.Summary @waiting@help @(read > 0 ? "What's read is kept. " : "")Keep waits until every system has been read.</p>
                    </div>
                    <div class="pdfread-actions">
                        @if (result.StoppedBy is AnswerKind.NoKey or AnswerKind.KeyRejected)
                        {
                            <a data-piano="off" class="mu-btn mu-primary" href="settings">Open Settings</a>
                            <button type="button" data-piano="off" class="mu-btn" @onclick="NewConversion">@again</button>
                        }
                        else
                        {
                            <button type="button" data-piano="off" class="mu-btn mu-primary" @onclick="NewConversion">@again</button>
                        }
                    </div>
                </div>
            }
            @foreach (var (status, at) in result.Systems.Select((s, i) => (s, i)))
            {
                var key = (status.Page, status.Index);
                var reading = at < result.Readings.Count ? result.Readings[at] : null;
                var music = reviewMusic.GetValueOrDefault(key);
                var picked = selected is { } choice && ReferenceEquals(choice.Music, music) ? choice.Bar : (int?)null;
                var first = firstBars.GetValueOrDefault(key);
                var here = result.Doubts.Where(d => d.Page == status.Page && d.System == status.Index);
                // A draft saved before doubts knew their bar in their system has 0 there: its bar in the piece gives it.
                var doubts = here.Select(d => d.BarInSystem > 0 ? d : d with { BarInSystem = d.Bar - first + 1 }).ToList();
                var notation = notationIssues.Where(issue => issue.SystemIndex == at).ToList();
                // A system with none read before it waits for the time signature: the first, read again, carries on with the rest.
                var held = at > 0 && result.Readings.Take(at).All(r => r is null);
                <article class="pdfread-card" data-page="@status.Page" data-system="@status.Index" aria-label="@($"System {status.Index} of page {status.Page}: {Words(status).Title}")">
                    <div class="pdfread-pair">
                        <p class="pdfread-label"><span>Print · page @status.Page, system @status.Index</span><span>@(reading is null ? "" : !numbered ? $"{reading.Bars.Count} bars" : reading.Bars.Count == 1 ? $"Bar {first}" : $"Bars {first}–{first + reading.Bars.Count - 1}")</span></p>
                        @if (cuts.TryGetValue(key, out var cut))
                        {
                            <div class="pdfread-paper">
                                <img src="@cut.Url" alt="@($"System {status.Index} as printed")" />
                                @if (music is not null && picked is { } bar && MappedBar(music, bar) is { } mapped)
                                {
                                    <svg class="sheet-overlay" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true" data-source-bar="@mapped.Id">
                                        <rect class="sheet-outline" vector-effect="non-scaling-stroke" x="@((mapped.Bounds.X - cut.Bounds.X) / cut.Bounds.Width)" y="@((mapped.Bounds.Y - cut.Bounds.Y) / cut.Bounds.Height)"
                                              width="@(mapped.Bounds.Width / cut.Bounds.Width)" height="@(mapped.Bounds.Height / cut.Bounds.Height)" />
                                    </svg>
                                }
                            </div>
                        }
                        @if (music is not null)
                        {
                            <p class="pdfread-label"><span>Reading · engraved by Prima</span></p>
                            <Sheet @key="music" @ref="music.Sheet" Mei="@music.Mei" Measures="@music.Range" Layout="line"
                                   OnBarTapped="@(id => SelectBar(music, music.Bars.FirstOrDefault(b => b.Value == id).Key))"
                                   OnPainted="@(_ => ShowSelection(music))" />
                            <div class="pdfread-bars" role="group" aria-label="Select a bar in the reading">
                                @foreach (var bar in music.Bars.Keys)
                                {
                                    var issues = doubts.Count(d => d.BarInSystem == bar);
                                    var notationCount = notation.Count(issue => issue.BarIndex == bar);
                                    <button type="button" data-piano="off" class="mu-toggle" data-action="select-review-bar" data-bar="@bar" data-issues="@issues" data-notation-issues="@notationCount"
                                            aria-pressed="@(picked == bar ? "true" : "false")" @onclick="() => SelectBar(music, bar)">
                                        <span class="mu-led"></span>Bar @(numbered ? first + bar - 1 : bar)
                                        @if (issues > 0)
                                        {
                                            <span class="pdfread-issue-count" aria-label="@($"{issues} flagged concerns")">@issues</span>
                                        }
                                        @if (notationCount > 0)
                                        {
                                            <span class="pdfread-issue-count pdfread-notation-count" aria-label="@($"{notationCount} notation checks")" title="Notation checks">N @notationCount</span>
                                        }
                                    </button>
                                }
                            </div>
                            <p class="pdfread-words muted">@(source?.Revision == mappedSourceRevision && mappedSourceRevision is not null ? "Select a bar to see the PDF region you confirmed for it." : "Select a bar in the reading to inspect it. Its matching position in the PDF hasn't been verified, so the print stays unmarked.")</p>
                        }
                    </div>
                    <div class="pdfread-side">
                        <p class="pdfread-status"><span class="pdfread-lamp @(status.Step switch { SystemStep.Done => "done", SystemStep.Doubtful => "doubt", SystemStep.Failed => "fail", _ => "now" })"></span>@Words(status).Title</p>
                        @if (music is not null && picked is null)
                        {
                            <p class="pdfread-words muted">@doubts.Select(d => d.BarInSystem).Distinct().Count() bars flagged. Select any bar to review its concerns, including bars without a flag.</p>
                        }
                        @if (picked is { } selectedBar)
                        {
                            <p class="pdfread-label">Selected · bar @(numbered ? first + selectedBar - 1 : selectedBar)</p>
                            @foreach (var doubt in doubts.Where(d => d.BarInSystem == selectedBar))
                            {
                                <blockquote class="pdfread-quote" data-bar="@selectedBar" data-staff="@doubt.Staff"><b>@(doubt.Staff switch { 2 => "Lower staff", 1 => "Upper staff", _ => "Bar" }) · flagged concern</b>@doubt.Note</blockquote>
                            }
                            @if (doubts.All(d => d.BarInSystem != selectedBar))
                            {
                                <p class="pdfread-words muted">No model concerns or personal flags were recorded for this bar. Check it against the print before keeping the reading.</p>
                            }
                            @if (notation.Any(issue => issue.BarIndex == selectedBar))
                            {
                                <section class="pdfread-side" data-notation-bar="@selectedBar">
                                    <p class="pdfread-status"><span class="pdfread-lamp doubt"></span>Notation checks</p>
                                    <p class="pdfread-words muted">Detected by Prima from the written notation, separately from model confidence and your flags.</p>
                                    @foreach (var issue in notation.Where(issue => issue.BarIndex == selectedBar))
                                    {
                                        <blockquote class="pdfread-quote" data-notation-issue="@issue.Kind" data-staff="@issue.Staff" data-voice="@issue.Voice" data-event="@issue.EventIndex">
                                            <b>@(issue.Staff switch { 1 => "Upper staff", 2 => "Lower staff", _ => "Staff" }) · voice @issue.Voice · event @(issue.EventIndex + 1)</b>@issue.Message
                                        </blockquote>
                                    }
                                </section>
                            }
                        }
                        @if (Words(status).Detail is { Length: > 0 } detail)
                        {
                            <p class="pdfread-words muted">@detail</p>
                        }
                        @if (reading is not null || !held)
                        {
                            <div class="pdfread-actions">
                                @if (reading is not null)
                                {
                                    <button type="button" data-piano="off" class="mu-btn" disabled="@(!CanListen || whole is null)" @onclick="() => Listen(first)">@(listeningFrom == first ? "Stop" : numbered ? $"Listen from bar {first}" : "Listen from here")</button>
                                }
                                @if (!held && job is null)
                                {
                                    <button type="button" data-piano="off" class="mu-btn @(status.Step == SystemStep.Failed ? "mu-primary" : "")" @onclick="NewConversion">Start a new conversion</button>
                                }
                            </div>
                        }
                    </div>
                    @if (music is not null && picked is { } pickedBar && MappedBar(music, pickedBar) is { } reviewed && reviewInitial.Count > 0)
                    {
                        <div class="pdfread-review-controls">
                            <NotationReviewPanel PieceId="@Piece.Id" ReviewId="@ReviewId" Source="source!" Initial="reviewInitial" SelectedBarId="@reviewed.Id" OnChanged="ReviewChanged"
                                                 Proposal="job?.ProposedPatch" OnRecheck="PlanRecheck" />
                            @if (requestedRecheck is { } request && request.BarId == reviewed.Id)
                            {
                                <div class="pdfread-error">
                                    <p>Send this bar to @Provider.ProviderId using @model? The model's result will be a proposal for you to review. Other bars stay unchanged. This request allows up to 12,000 output tokens.</p>
                                    <div class="pdfread-actions">
