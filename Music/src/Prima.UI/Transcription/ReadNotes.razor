        firstBars.Clear();
        reviewMusic.Clear();
        selected = null;
        whole = null;
        if (read.Count == 0) return;

        var (score, starts) = ReadingScore.Build([.. read.Select(i => result.Readings[i]!)], Piece.Title);
        whole = score;
        for (var k = 0; k < read.Count; k++) firstBars[(result.Systems[read[k]].Page, result.Systems[read[k]].Index)] = starts[k];
        var mei = ReadingScore.Mei(score);
        var position = 0;
        var initial = new List<BarReplacement>();
        foreach (var i in read)
        {
            var key = (result.Systems[i].Page, result.Systems[i].Index);
            var bars = result.Readings[i]!.Bars;
            var ids = bars.Select((bar, offset) => (bar.Index, score.Bars[position + offset].Id)).ToDictionary(b => b.Index, b => b.Id);
            reviewMusic[key] = new ReviewMusic(key, mei, $"{position + 1}-{position + bars.Count}", ids);
            if (source is not null && source.Revision == mappedSourceRevision)
            {
