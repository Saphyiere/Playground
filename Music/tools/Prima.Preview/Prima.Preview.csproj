<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Prima's screens in a browser, for checking them from a cloud session. Not part of the app or its solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Prima.UI\Prima.UI.csproj" />
  </ItemGroup>

  <!-- The stand-in Claude's saved readings (PreviewClaude). -->
  <ItemGroup>
    <Content Update="Readings\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
